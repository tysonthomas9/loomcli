      <button type=\"submit\" class=\"btn btn-primary\" data-testid=\"auth-submit\">Sign up</button>\n      </form>\n      <button type=\"button\" class=\"btn btn-link\" id=\"auth-toggle\" data-testid=\"auth-toggle\">\n        Already have an account? Log in\n      </button>\n    </div>\n  </div>\n\n  <div id=\"onboarding\" class=\"onboarding\" hidden>\n    <div class=\"onboarding__panel\">\n      <header class=\"onboarding__header\">\n        <h1 class=\"auth-brand\">Huddle</h1>\n        <div class=\"onboarding__user-row\" id=\"onboarding-session-slot\"></div>\n      </header>\n      <section\n        id=\"empty-state-create-workspace\"\n        class=\"empty-state\"\n        data-testid=\"empty-state-create-workspace\"\n      >\n        <h2>Create a workspace</h2>\n        <p>Get started by creating a workspace, or join one with its slug.</p>\n      </section>\n      <form id=\"workspace-create-form\" data-testid=\"workspace-create-form\" novalidate>\n        <label class=\"field\">\n          <span>Slug</span>\n          <input type=\"text\" name=\"slug\" data-testid=\"workspace-slug\" spellcheck=\"false\" required />\n        </label>\n        <label class=\"field\">\n          <span>Name</span>\n          <input type=\"text\" name=\"name\" data-testid=\"workspace-name\" required />\n        </label>\n        <p id=\"workspace-create-error\" class=\"form-error\" data-testid=\"workspace-create-error\" hidden></p>\n        <button type=\"submit\" class=\"btn btn-primary\" data-testid=\"workspace-create-submit\">\n          Create workspace\n        </button>\n      </form>\n      <form id=\"join-workspace-form\" data-testid=\"join-workspace-form\" novalidate>\n        <h2>Join a workspace</h2>\n        <label class=\"field\">\n          <span>Workspace slug</span>\n          <input\n            type=\"text\"\n            name=\"slug\"\n            data-testid=\"join-workspace-slug\"\n            spellcheck=\"false\"\n            required\n          />\n        </label>\n        <p id=\"join-workspace-error\" class=\"form-error\" data-testid=\"join-workspace-error\" hidden></p>\n        <button type=\"submit\" class=\"btn btn-secondary\" data-testid=\"join-workspace-submit\">\n          Join workspace\n        </button>\n      </form>\n    </div>\n  </div>\n\n  <div id=\"shell\" class=\"shell\" hidden>\n    <aside class=\"sidebar\" aria-label=\"Workspace sidebar\">\n      <div class=\"sidebar__brand\">Huddle</div>\n      <div id=\"workspace-header\" class=\"workspace-header\" data-testid=\"workspace-header\"></div>\n      <nav class=\"sidebar__nav\" aria-label=\"Channels\">\n        <h2 class=\"sidebar__section-title\">Channels</h2>\n        <ul id=\"channel-list\" class=\"channel-list\" data-testid=\"channel-list\"></ul>\n        <h2 class=\"sidebar__section-title\">Direct messages</h2>\n        <ul id=\"dms-list\" class=\"channel-list\" data-testid=\"dms-list\"></ul>\n      </nav>\n      <div class=\"sidebar__footer\" id=\"shell-session-slot\"></div>\n    </aside>\n    <main id=\"message-pane\" class=\"message-pane\" data-testid=\"message-pane\">\n      <p class=\"message-pane__placeholder\">Select a channel</p>\n    </main>\n    <aside\n      id=\"thread-panel\"\n      class=\"thread-panel\"\n      data-testid=\"thread-panel\"\n      hidden\n      aria-hidden=\"true\"\n    >\n      <p class=\"thread-panel__placeholder\">Thread</p>\n    </aside>\n  </div>\n\n  <!-- Single session chrome so current-user / logout-btn testids stay unique -->\n  <div id=\"session-chrome\" hidden>\n    <span id=\"session-user\" data-testid=\"current-user\"></span>\n    <button type=\"button\" class=\"btn btn-ghost\" id=\"logout-btn\" data-testid=\"logout-btn\">\n      Log out\n    </button>\n  </div>\n\n  <script type=\"module\" src=\"/static/js/app.js\"></script>\n</body>\n</html>\n","isEmpty":false,"exceededLimit":false,"totalLines":141,"fileSize":5180,"path":"/work/critic-MARATHON-16-1/static/index.html","readRange":{"startLine":1,"endLine":1