{"type":"tool_call","subtype":"completed","call_id":"call-39da0399-e918-43a6-aa46-e27ced2ba374-8\nfc_0fb59f7a-e8ea-977f-a847-c25ed1db62dc_5","tool_call":{"readToolCall":{"args":{"path":"/work/critic-MARATHON-16-1/static/js/app.js"},"result":{"success":{"content":"/** Huddle SPA boot: token → /me → workspaces → shell or auth. */\n\nimport { api, ApiClientError } from \"./api.js\";\nimport { initAuthUi } from \"./auth_ui.js\";\nimport { initShell } from \"./shell.js\";\nimport { clearTokens, getToken } from \"./storage.js\";\n\nconst bootEl = document.getElementById(\"boot-placeholder\");\n\n/** @type {object|null} */\nlet user = null;\n/** @type {string|null} */\nlet token = null;\n\nfunction showBoot(show) {\n  bootEl.hidden = !show;\n}\n\nconst authUi = initAuthUi({\n  onAuthenticated({ user: nextUser, token: nextToken }) {\n    user = nextUser;\n    token = nextToken;\n    authUi.hide();\n    void afterAuth();\n  },\n});\n\nconst shell = initShell({\n  getToken: () => token || getToken(),\n  getUser: () => user,\n  onLogout() {\n    user = null;\n    token = null;\n    shell.hideAll();\n    authUi.show();\n  },\n  onUnauthorized() {\n    clearTokens();\n    user = null;\n    token = null;\n    shell.hideAll();\n    authUi.show();\n  },\n});\n\nasync function afterAuth() {\n  showBoot(true);\n  try {\n    await shell.loadAndPresent();\n  } catch (err) {\n    if (err instanceof ApiClientError && err.status === 401) {\n      clearTokens();\n      user = null;\n      token = null;\n      shell.hideAll();\n      authUi.show();\n      return;\n    }\n    // List failure with a valid session — show onboarding so user can retry create.\n    shell.showOnboarding();\n  } finally {\n    showBoot(false);\n  }\n}\n\nasync function boot() {\n  showBoot(true);\n  authUi.hide();\n  shell.hideAll();\n\n  token = getToken();\n  if (!token) {\n    showBoot(false);\n    authUi.show();\n    return;\n  }\n\n  try {\n    const data = await api(\"GET\", \"/api/auth/me\", { token });\n    user = data.user;\n    await shell.loadAndPresent();\n  } catch (err) {\n    if (err instanceof ApiClientError && err.status === 401) {\n      clearTokens();\n      user = null;\n      token = null;\n      authUi.show();\n    } else {\n      // Keep token on transient failures; surface auth so the user can recover.\n      user = null;\n      authUi.show();\n    }\n  } finally {\n    showBoot(false);\n  }\n}\n\nvoid boot();\n","isEmpty":false,"exceededLimit":false,"totalLines":99,"fileSize":2061,"path":"/work/critic-MARATHON-16-1/static/js/app.js","readRange":{"startLine":1,"endLine":99},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-39da0399-e918-43a6-aa46-e27ced2ba374-8\nfc_0fb59f7a-e8ea-977f-a847-c25ed1db62dc_5","startedAtMs":"1787441727305","completedAtMs":"1787441727608"},"model_call_id":"8050f64d-a0a5-415c-a800-5a4730031dd8-1-ok9q","session_id":"8c9f2801-d9d1-4b4e-ac13-8ec9ab25b62b","timestamp_ms":1787441727626}
