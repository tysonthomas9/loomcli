aemon`, `loom task`, `loom plan`, or any agent.\n- If you cannot complete the review, still write CRITIC-VERDICT.txt with\n  CHANGES-REQUESTED and the reason.\n","isEmpty":false,"exceededLimit":false,"totalLines":40,"fileSize":1854,"path":"/installed-agent/loom-marathon/prompts/critic.md","readRange":{"startLine":1,"endLine":40},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-068036ee-411a-4cee-9a71-6d657991a9a1-30\nfc_d0d74d1c-de16-9916-8f6b-3f156cfd7f79_1","startedAtMs":"1787439748497","completedAtMs":"1787439748556"},"model_call_id":"74e47ad1-74b8-4802-94bd-f29f104398ba-11-nlnx","session_id":"eac162ae-44f3-46d2-9d54-9072bc99fee4","timestamp_ms":1787439748577}
