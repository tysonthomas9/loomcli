cks against design contracts not fully covered by suite\nfrom pathlib import Path\nimport tempfile, sqlite3, hashlib\nfrom fastapi.testclient import TestClient\nfrom server.app import create_app\nfrom server.settings import Settings\n\nwith tempfile.TemporaryDirectory() as td:\n    cfg = Settings(node_id=0, port=8000, data_dir=td, redis_url='redis://127.0.0.1:6379/0')\n    c = TestClient(create_app(cfg))\n\n    # invalid JSON\n    r = c.post('/api/auth/register', content=b'{not json', headers={'Content-Type':'application/json'})\n    print('invalid json', r.status_code, r.text[:200])\n\n    # register then check token hashed in DB\n    r = c.post('/api/auth/register', json={'username':'ada','password':'password1'})\n    token = r.json()['token']\n    user = r.json()['user']\n    print('user id', user['id'], 'uuid-like', len(user['id'])==36)\n    conn = sqlite3.connect(f'{td}/huddle.sqlite')\n    th = conn.execute('SELECT token_hash FROM auth_tokens').fetchone()[0]\n    print('token plaintext in db?', token in th, 'hash match', th==hashlib.sha256(token.encode()).hexdigest())\n    ph = conn.execute('SELECT password_hash FROM users').fetchone()[0]\n    print('pw hash', ph[:40], '...')\n\n    # email never in responses\n    print('email in register?', 'email' in r.text)\n\n    # login mint new token both valid\n    r2 = c.post('/api/auth/login', json={'username':'ada','password':'password1'})\n    t2 = r2.json()['token']\n    assert t2 != token\n    for t in (token, t2):\n        m = c.get('/api/auth/me', headers={'Authorization': f'Bearer {t}'})\n        print('me', t[:8], m.status_code)\n\n    # Content-Type missing / form body\n    r = c.post('/api/auth/register', data='username=ada2&password=password1')\n    print('form body', r.status_code, r.text[:200])\n\n    # password echoed in error?\n    r = c.post('/api/auth/register', json={'username':'Ada','password':'password1'})\n    print('upper user', r.status_code, r.json())\n\n    # login empty password\n    r = c.post('/api/auth/login', json={'username':'ada','password':''})\n    print('empty pw login', r.status_code, r.json())\n\n    # login missing fields\n    r = c.post('/api/auth/login', json={})\n    print('empty login body', r.status_code, r.json())\n\n    # non-ascii bearer\n    try:\n        r = c.get('/api/auth/me', headers={'Authorization': 'Bearer café-token-xxxx'})\n        print('nonascii bearer', r.status_code, r.text[:200])\n    except Exception as e:\n        print('nonascii bearer EXC', type(e), e)\n\n    # Authorization with two spaces\n    r = c.get('/api/auth/me', headers={'Authorization': f'Bearer  {token}'})\n    print('double space bearer', r.status_code, r.json())\n\n    conn.close()\nPY\n","workingDirectory":"","exitCode":0,"signal":"","stdout":"invalid json 400 {\"error\":{\"code\":\"validation_error\",\"message\":\"1: JSON decode error\"}}\nuser id a81697f8-8f4b-4521-aa34-028bc5b612bf uuid-like True\ntoken plaintext in db? False hash match True\npw hash scrypt$N=2^14$r=8$p=1$KeIivYR2i8RNKdihgI ...\nemail in register? False\nme LPegYZLq 200\nme LE455rOT 200\nform body 400 {\"error\":{\"code\":\"validation_error\",\"message\":\"Input should be a valid dictionary or object to extract fields from\"}}\nupper user 400 {'error': {'code': 'validation_error', 'message': 'invalid username'}}\nempty pw login 400 {'error': {'code': 'validation_error', 'message': 'password is required'}}\nempty login body 400 {'error': {'code': 'validation_error', 'message': 'username: Field required'}}\nnonascii bearer EXC <class 'UnicodeEncodeError'> 'ascii' codec can't encode character '\\xe9' in position 10: ordinal not in range(128)\ndouble space bearer 401 {'error': {'code': 'unauthorized', 'message': 'unauthorized'}}\n","stderr":"/opt/venv/lib/python3.12/site-packages/fastapi/testclient.py:1: StarletteDeprecationWarning: Using `httpx` with `starlette.testclient` is deprecated; install `httpx2` instead.\n  from starlette.testclient import TestClient as TestClient  # noqa\n"