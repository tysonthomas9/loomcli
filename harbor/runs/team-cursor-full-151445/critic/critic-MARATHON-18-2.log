"redis://127.0.0.1:6379/0\",\n    )\n    return TestClient(create_app(cfg))\n\n\ndef test_root_serves_spa_html(client: TestClient) -> None:\n    root = client.get(\"/\")\n    assert root.status_code == 200\n    assert \"text/html\" in root.headers[\"content-type\"]\n    assert \"Huddle\" in root.text\n    assert \"Cluster node stub\" not in root.text\n    assert 'src=\"/static/js/app.js\"' in root.text\n    assert 'href=\"/static/css/app.css\"' in root.text","isEmpty":false,"exceededLimit":false,"totalLines":138,"fileSize":3850,"path":"/work/critic-MARATHON-18-2/tests/test_spa_shell.py","readRange":{"startLine":1,"endLine":80},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-7e6a5440-f2e9-4335-86bf-2a02309e054c-27\nfc_a4e84bb6-3b5b-9444-a6a6-8de05637ed5b_1","startedAtMs":"1787447901891","completedAtMs":"1787447902191"},"model_call_id":"51cc01bb-5c2b-48d1-8a21-dc3abf5ea0b5-9-x3kx","session_id":"a42df522-cd26-417c-87e5-65513de2eb14","timestamp_ms":1787447902214}
