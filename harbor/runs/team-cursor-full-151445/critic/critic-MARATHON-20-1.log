{"type":"tool_call","subtype":"completed","call_id":"call-8abd0db3-1c20-4645-94bd-c92e3dc30ca7-15\nfc_d2ef3718-7596-96f5-9c38-7ef01328d544_1","tool_call":{"readToolCall":{"args":{"path":"/work/critic-MARATHON-20-1/tests/test_cluster_boot.py"},"result":{"success":{"content":"\"\"\"Live-cluster checks for start.sh boot health, Redis, and stub GET /.\n\nVerifies MARATHON-2 / epic health+boot contract on fixed ports via a real\n./start.sh process tree (not TestClient).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport signal\nimport socket\nimport subprocess\nimport time\nfrom pathlib import Path\n\nimport httpx\nimport pytest\n\nAPP_ROOT = Path(__file__).resolve().parents[1]\nSTART_SH = APP_ROOT / \"start.sh\"\nPORTS = (8000, 8001, 8002)\nREDIS_PORT = 6379\nIRC_PORT = 6667\nBOOT_TIMEOUT_S = 60.0\n\n\ndef _port_free(port: int, host: str = \"127.0.0.1\") -> bool:\n    s = socket.socket()\n    try:\n        s.bind((host, port))\n        return True\n    except OSError:\n        return False\n    finally:\n        s.close()\n\n\ndef _wait_health(port: int, node_id: int, timeout: float = BOOT_TIMEOUT_S) -> dict:\n    deadline = time.monotonic() + timeout\n    url = f\"http://127.0.0.1:{port}/api/health\"\n    last_err: Exception | None = None\n    while time.monotonic() < deadline:\n        try:\n            with httpx.Client(timeout=1.0) as client:\n                r = client.get(url)\n            if r.status_code == 200:\n                body = r.json()\n                if body == {\"status\": \"ok\", \"node_id\": node_id}:\n                    return body\n                last_err = AssertionError(f\"unexpected health body on {port}: {body!r}\")\n        except Exception as exc:  # noqa: BLE001 — poll until ready\n            last_err = exc\n        time.sleep(0.2)\n    raise TimeoutError(\n        f\"health on :{port} did not become {{status:ok,node_id:{node_id}}} \"\n        f\"within {timeout}s; last={last_err!r}\"\n    )\n\n\n@pytest.fixture(scope=\"module\")\ndef cluster() -> subprocess.Popen[bytes]:\n    \"\"\"Boot ./start.sh once for the module; tear down the whole tree after.\"\"\"\n    assert START_SH.is_file(), f\"missing {START_SH}\"\n    assert os.access(START_SH, os.X_OK), f\"{START_SH} is not executable\"\n\n    # Prefer a clean slate; marathon-freeports is also run by the outer harness.\n    subprocess.run([\"marathon-freeports\"], check=False)\n\n    for port in (*PORTS, REDIS_PORT):\n        if not _port_free(port):\n            pytest.fail(f\"port {port} still busy before start.sh\")\n\n    log_path = APP_ROOT / \"data\" / \"run\" / \"qa-cluster-boot.log\"\n    log_path.parent.mkdir(parents=True, exist_ok=True)\n    log_f = open(log_path, \"wb\")  # noqa: SIM115 — closed in finally via terminate path\n    proc = subprocess.Popen(\n        [str(START_SH)],\n        cwd=str(APP_ROOT),\n        stdout=log_f,\n        stderr=subprocess.STDOUT,\n        start_new_session=True,\n    )\n    try:\n        for node_id, port in enumerate(PORTS):\n            _wait_health(port, node_id)\n        # Confirm supervisor is still the parent of the live tree.\n        assert proc.poll() is None, \"start.sh exited before health became ready\"\n        yield proc\n    finally:\n        if proc.poll() is None:\n            try:\n                os.killpg(proc.pid, signal.SIGTERM)\n            except ProcessLookupError:\n                pass\n            try:\n                proc.wait(timeout=10)\n            except subprocess.TimeoutExpired:\n                try:\n                    os.killpg(proc.pid, signal.SIGKILL)\n                except ProcessLookupError:\n                    pass\n                proc.wait(timeout=5)\n        log_f.close()\n        subprocess.run([\"marathon-freeports\"], check=False)\n\n\ndef test_start_sh_stays_alive_while_children_serve(cluster: subprocess.Popen[bytes]) -> None:\n    assert cluster.poll() is None\n    time.sleep(1.5)\n    assert cluster.poll() is None, \"start.sh exited while children should still serve\"\n    for node_id, port in enumerate(PORTS):\n        body = _wait_health(port, node_id, timeout=5.0)\n        assert body == {\"status\": \"ok\", \"node_id\": node_id}\n\n\n@pytest.mark.parametrize(\"node_id,port\", [(0, 8000), (1, 8001), (2, 8002)])\ndef test_health_returns_ok_with_matching_node_id(\n    cluster: subprocess.Popen[bytes], node_id: int, port: int\n) -> None:\n    del cluster  # fixture ensures cluster is up\n    with httpx.Client(timeout=5.0) as client:\n        r = client.get(f\"http://127.0.0.1:{port}/api/health\")\n    assert r.status_code == 200\n    assert \"application/json\" in r.headers.get(\"content-type\", \"\")\n    assert r.json() == {\"status\": \"ok\", \"node_id\": node_id}\n    # Exact key set / types (contract shape, not merely status 200).\n    payload = r.json()\n    assert set(payload.keys()) == {\"status\", \"node_id\"}\n    assert isinstance(payload[\"status\"], str)\n    assert isinstance(payload[\"node_id\"], int)\n\n\n@pytest.mark.parametrize(\"port\", PORTS)\ndef test_health_does_not_require_authorization(\n    cluster: subprocess.Popen[bytes], port: int\n) -> None:\n    del cluster\n    with httpx.Client(timeout=5.0) as client:\n        r = client.get(f\"http://127.0.0.1:{port}/api/health\")\n    assert r.status_code == 200\n    assert r.json()[\"status\"] == \"ok\"\n    # Explicit negative: unauthenticated request must not be 401/403.\n    assert r.status_code not in (401, 403)\n\n\ndef test_node_ids_are_not_swapped_across_ports(cluster: subprocess.Popen[bytes]) -> None:\n    del cluster\n    observed: dict[int, int] = {}\n    with httpx.Client(timeout=5.0) as client:\n        for port in PORTS:\n            body = client.get(f\"http://127.0.0.1:{port}/api/health\").json()\n            observed[port] = body[\"node_id\"]\n    assert observed == {8000: 0, 8001: 1, 8002: 2}\n    # Negative: no port may advertise another node's id.\n    for port, node_id in observed.items():\n        for other_port, other_id in observed.items():\n            if port != other_port:\n                assert node_id != other_id\n\n\ndef test_local_redis_ping_pong(cluster: subprocess.Popen[bytes]) -> None:\n    del cluster\n    result = subprocess.run(\n        [\"redis-cli\", \"-h\", \"127.0.0.1\", \"-p\", \"6379\", \"PING\"],\n        check=True,\n        capture_output=True,\n        text=True,\n        timeout=5,\n    )\n    assert result.stdout.strip() == \"PONG\"\n\n\n@pytest.mark.parametrize(\"port\", PORTS)\ndef test_root_returns_200_html(cluster: subprocess.Popen[bytes], port: int) -> None:\n    del cluster\n    with httpx.Client(timeout=5.0) as client:\n        r = client.get(f\"http://127.0.0.1:{port}/\")\n    assert r.status_code == 200\n    ctype = r.headers.get(\"content-type\", \"\")\n    assert \"text/html\" in ctype\n    assert \"<html\" in r.text.lower() or \"<!doctype html\" in r.text.lower()\n    assert \"Huddle\" in r.text\n\n\ndef test_cluster_does_not_bind_irc_port(cluster: subprocess.Popen[bytes]) -> None:\n    \"\"\"MARATHON-2 negative: boot must not bind :6667 (IRC is a later task).\"\"\"\n    del cluster\n    assert _port_free(IRC_PORT), \"port 6667 must remain free after cluster boot\"\n\n\ndef test_start_sh_has_no_docker_or_remote_redis_dependency() -> None:\n    \"\"\"Static negative: supervisor must be self-contained on localhost.\"\"\"\n    text = START_SH.read_text(encoding=\"utf-8\")\n    lowered = text.lower()\n    assert \"docker\" not in lowered\n    assert \"docker-compose\" not in lowered\n    assert \"podman\" not in lowered\n    # Redis must be local redis-server, not a remote hostname/service name.\n    assert \"redis-server\" in text\n    assert \"127.0.0.1\" in text\n\n\ndef test_durable_data_layout_after_boot(cluster: subprocess.Popen[bytes]) -> None:\n    del cluster\n    data = APP_ROOT / \"data\"\n    assert data.is_dir()\n    assert (data / \"huddle.sqlite\").is_file()\n    assert (data / \"redis\").is_dir()\n    assert (data / \"run\").is_dir()\n","isEmpty":false,"exceededLimit":false,"totalLines":211,"fileSize":7392,"path":"/work/critic-MARATHON-20-1/tests/test_cluster_boot.py","readRange":{"startLine":1,"endLine":211},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-8abd0db3-1c20-4645-94bd-c92e3dc30ca7-15\nfc_d2ef3718-7596-96f5-9c38-7ef01328d544_1","startedAtMs":"1787438781760","completedAtMs":"1787438781860"},"model_call_id":"c64c3111-59ba-494a-830c-f5095298259d-4-lwma","session_id":"6ee90dfc-ec75-48c4-8b56-cd9437a916e3","timestamp_ms":1787438781885}
{"type":"tool_call","subtype":"completed","call_id":"call-8abd0db3-1c20-4645-94bd-c92e3dc30ca7-16\nfc_d2ef3718-7596-96f5-9c38-7ef01328d544_2","tool_call":{"readToolCall":{"args":{"path":"/work/critic-MARATHON-20-1/tests/test_health.py"},"result":{"success":{"content":"\"\"\"Unit tests for Huddle node settings, health, and SQLite bootstrap.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport sqlite3\nfrom pathlib import Path\n\nimport pytest\nfrom fastapi.testclient import TestClient\n\nfrom server.app import create_app\nfrom server.db import ensure_bootstrap\nfrom server.settings import Settings, load_settings\n\n\ndef test_load_settings_maps_node_to_port(monkeypatch: pytest.MonkeyPatch) -> None:\n    monkeypatch.setenv(\"HUDDLE_NODE_ID\", \"1\")\n    monkeypatch.setenv(\"HUDDLE_PORT\", \"8001\")\n    monkeypatch.setenv(\"HUDDLE_DATA_DIR\", \"/tmp/huddle-test-data\")\n    cfg = load_settings()\n    assert cfg.node_id == 1\n    assert cfg.port == 8001\n    assert cfg.sqlite_path == \"/tmp/huddle-test-data/huddle.sqlite\"\n\n\ndef test_load_settings_rejects_node_port_mismatch(\n    monkeypatch: pytest.MonkeyPatch,\n) -> None:\n    monkeypatch.setenv(\"HUDDLE_NODE_ID\", \"0\")\n    monkeypatch.setenv(\"HUDDLE_PORT\", \"8001\")\n    with pytest.raises(SystemExit, match=\"requires port 8000\"):\n        load_settings()\n\n\ndef test_load_settings_requires_node_id(monkeypatch: pytest.MonkeyPatch) -> None:\n    monkeypatch.delenv(\"HUDDLE_NODE_ID\", raising=False)\n    with pytest.raises(SystemExit, match=\"HUDDLE_NODE_ID\"):\n        load_settings()\n\n\ndef test_health_and_root(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n    monkeypatch.setenv(\"HUDDLE_NODE_ID\", \"2\")\n    monkeypatch.setenv(\"HUDDLE_PORT\", \"8002\")\n    monkeypatch.setenv(\"HUDDLE_DATA_DIR\", str(tmp_path))\n    cfg = Settings(\n        node_id=2,\n        port=8002,\n        data_dir=str(tmp_path),\n        redis_url=\"redis://127.0.0.1:6379/0\",\n    )\n    client = TestClient(create_app(cfg))\n    health = client.get(\"/api/health\")\n    assert health.status_code == 200\n    assert health.headers[\"content-type\"].startswith(\"application/json\")\n    assert health.json() == {\"status\": \"ok\", \"node_id\": 2}\n    assert \"Authorization\" not in health.request.headers or True\n\n    root = client.get(\"/\")\n    assert root.status_code == 200\n    assert \"text/html\" in root.headers[\"content-type\"]\n    assert \"Huddle\" in root.text\n\n\ndef test_sqlite_bootstrap_wal(tmp_path: Path) -> None:\n    db_path = tmp_path / \"huddle.sqlite\"\n    ensure_bootstrap(str(db_path))\n    assert db_path.is_file()\n    conn = sqlite3.connect(str(db_path))\n    mode = conn.execute(\"PRAGMA journal_mode\").fetchone()[0]\n    assert mode.lower() == \"wal\"\n    rows = conn.execute(\"SELECT version FROM schema_migrations\").fetchall()\n    assert rows == [(0,)]\n    conn.close()\n\n\ndef test_each_node_id_in_health(tmp_path: Path) -> None:\n    for node_id in (0, 1, 2):\n        cfg = Settings(\n            node_id=node_id,\n            port=8000 + node_id,\n            data_dir=str(tmp_path / f\"n{node_id}\"),\n            redis_url=\"redis://127.0.0.1:6379/0\",\n        )\n        client = TestClient(create_app(cfg))\n        assert client.get(\"/api/health\").json() == {\"status\": \"ok\", \"node_id\": node_id}\n","isEmpty":false,"exceededLimit":false,"totalLines":87,"fileSize":2919,"path":"/work/critic-MARATHON-20-1/tests/test_health.py","readRange":{"startLine":1,"endLine":87},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-8abd0db3-1c20-4645-94bd-c92e3dc30ca7-16\nfc_d2ef3718-7596-96f5-9c38-7ef01328d544_2","startedAtMs":"1787438781767","completedAtMs":"1787438781861"},"model_call_id":"c64c3111-59ba-494a-830c-f5095298259d-4-lwma","session_id":"6ee90dfc-ec75-48c4-8b56-cd9437a916e3","timestamp_ms":1787438781887}
{"type":"tool_call","subtype":"completed","call_id":"call-8abd0db3-1c20-4645-94bd-c92e3dc30ca7-14\nfc_d2ef3718-7596-96f5-9c38-7ef01328d544_0","tool_call":{"shellToolCall":{"args":{"command":"cd /work/ws && loom data show MARATHON-20 --output json 2>/dev/null | head -c 50000; echo; loom data show MARATHON-2 --output json 2>/dev/null | head -c 80000","workingDirectory":"","timeout":30000,"toolCallId":"call-8abd0db3-1c20-4645-94bd-c92e3dc30ca7-14\nfc_d2ef3718-7596-96f5-9c38-7ef01328d544_0","simpleCommands":["cd","loom","head","echo","loom","head"],"hasInputRedirect":false,"hasOutputRedirect":true,"parsingResult":{"parsingFailed":false,"executableCommands":[{"name":"cd","args":[{"type":"word","value":"/work/ws"}],"fullText":"cd /work/ws"},{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"show"},{"type":"word","value":"MARATHON-20"},{"type":"word","value":"--output"},{"type":"word","value":"json"}],"fullText":"loom data show MARATHON-20 --output json"},{"name":"head","args":[{"type":"word","value":"-c"},{"type":"number","value":"50000"}],"fullText":"head -c 50000"},{"name":"echo","args":[],"fullText":"echo"},{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"show"},{"type":"word","value":"MARATHON-2"},{"type":"word","value":"--output"},{"type":"word","value":"json"}],"fullText":"loom data show MARATHON-2 --output json"},{"name":"head","args":[{"type":"word","value":"-c"},{"type":"number","value":"80000"}],"fullText":"head -c 80000"}],"hasRedirects":true,"hasCommandSubstitution":false,"allRedirectsAreDevNull":true,"redirects":[{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"},{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"}]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Fetch MARATHON-20 and epic data","closeStdin":true,"conversationId":"6ee90dfc-ec75-48c4-8b56-cd9437a916e3","adminCommandDenylist":[]},"result":{"success":{"command":"cd /work/ws && loom data show MARATHON-20 --output json 2>/dev/null | head -c 50000; echo; loom data show MARATHON-2 --output json 2>/dev/null | head -c 80000","workingDirectory":"","exitCode":0,"signal":"","stdout":"{\n  \"id\": \"MARATHON-20\",\n  \"title\": \"Verify: HTTP node and Redis SIGKILL respawn\",\n  \"status\": \"review\",\n  \"priority\": 1,\n  \"issue_type\": \"task\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"qa\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"has_design\": false,\n  \"created_at\": \"2026-08-22T22:37:07.490815704Z\",\n  \"updated_at\": \"2026-08-22T22:41:50.438165585Z\",\n  \"created_by\": \"marathon-harness\",\n  \"description\": \"On integrated head fba2eb6 (MARATHON-2), with /app/start.sh already running, verify resilience against the product specification:\\n1. SIGKILL one of the three HTTP node processes; within 60s that port's /api/health returns 200 with the same node_id as before; the other two nodes stay healthy throughout.\\n2. SIGKILL redis-server on 127.0.0.1:6379; without restarting start.sh, Redis must be respawned and PING succeed again.\\n3. Confirm port 6667 is not required for this integration (IRC not yet in scope) and that killing one HTTP node does not stop reads on the other two.\\nReport failures vs the epic resilience/respawn requirements for the scaffold.\",\n  \"comments\": [\n    {\n      \"id\": 6,\n      \"issue_id\": \"MARATHON-20\",\n      \"author\": \"qa-engineer-1\",\n      \"text\": \"IMPL-DONE attempt=1 commit=6762605cf150d3e84a88e6d4fcc7eae51e2ae348\",\n      \"created_at\": \"2026-08-22T22:41:50.4231526Z\"\n    }\n  ]\n}\n\n{\n  \"id\": \"MARATHON-2\",\n  \"title\": \"Scaffold cluster: start.sh, 3 HTTP nodes, Redis\",\n  \"status\": \"closed\",\n  \"priority\": 0,\n  \"issue_type\": \"task\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"backend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"design\": \"# MARATHON-2 — Scaffold cluster: start.sh, 3 HTTP nodes, Redis\\n\\n## Summary\\n\\nThis task boots the Huddle cluster so the verifier (and every later feature task) has a live, self-contained process tree: `/app/start.sh` stays in the foreground, supervises a local Redis on `127.0.0.1:6379` and three identical HTTP nodes on `127.0.0.1:8000/8001/8002`, and respawns any of those children after `SIGKILL`. Each node exposes a stub `GET /` and the contracted `GET /api/health`. The design also locks language/framework and the shared durable storage layout that Auth, messages, fan-out, IRC, and the SPA will all assume.\\n\\n## Technical Approach\\n\\n### Decision\\n\\n| Concern | Choice |\\n|--------|--------|\\n| Language / HTTP framework | **Python 3.12 + FastAPI + Uvicorn** |\\n| Shared durable store | **SQLite file** at `/app/data/huddle.sqlite` with **WAL** + busy timeout (shared by all nodes) |\\n| Cross-node transport | **Local Redis** on `127.0.0.1:6379` (pub/sub / coordination only — **not** source of truth) |\\n| Process supervisor | **`/app/start.sh`** (bash): create dirs, ensure venv+deps, start Redis + 3 Uvicorn workers, foreground wait loop with respawn |\\n| Runtime root | Repo root **is** `/app` when the verifier runs |\\n\\n### Why this stack\\n\\n- Epic/instruction leave language open; Python 3.12, `sqlite3`, and `redis-server` are already on the image. FastAPI covers REST + future WebSockets (Starlette) without a second runtime for the backend/IRC path.\\n- Redis outage requirements (MARATHON-14: writes and dense `seq` continue while Redis is dead) **forbid** using Redis as the durable store. SQLite on a shared filesystem path is the simplest self-contained SoT that all three processes can open.\\n- A shell supervisor matches the verifier contract (`./start.sh` foreground) and can respawn both HTTP and Redis without DinD or external orchestrators.\\n\\n### Alternatives considered\\n\\n| Alternative | Rejected because |\\n|------------|------------------|\\n| Node.js + Express/Fastify | Equally viable for HTTP/WS; would split backend (IRC later) across languages or force Node for IRC too. Python keeps one backend language. |\\n| Redis as primary DB | Contradicts Redis-`SIGKILL` resilience (writes must succeed without Redis). |\\n| Postgres / Docker services | Remote/DinD-ish; not self-contained on this image. |\\n| One process binding three ports | Harder crash isolation; grader kills **one** node and expects the other two to keep serving — three OS processes are required. |\\n| Systemd / supervisord | Extra dependency; bash loop is enough and stays in-repo. |\\n\\n### Trade-off accepted\\n\\nSQLite WAL under concurrent writers is correct for this density but needs disciplined `busy_timeout` / short transactions in later tasks. We accept that complexity over introducing another datastore. Dependency install on first boot (`pip install -r requirements.txt` into `/app/.venv`) adds a few seconds to cold start — acceptable vs baking undeclared global packages into the image.\\n\\n### Conventions fixed for sibling tasks (no sibling designs exist yet)\\n\\n1. Product name: **Huddle**.\\n2. API prefix: `/api/...`; JSON; REST status codes per epic instruction.\\n3. `node_id` ∈ `{0,1,2}` ↔ ports `{8000,8001,8002}` (never swap).\\n4. Durable SoT: SQLite under `/app/data/`; Redis is ephemeral fan-out only.\\n5. Health response is **not** resource-enveloped (explicit epic exception): `{\\\"status\\\":\\\"ok\\\",\\\"node_id\\\":N}`.\\n6. Env per process: `HUDDLE_NODE_ID`, `HUDDLE_PORT`, `HUDDLE_DATA_DIR` (default `/app/data`), `HUDDLE_REDIS_URL` (default `redis://127.0.0.1:6379/0`).\\n\\n## Interface Contracts\\n\\n### Seam: Verifier / browser ↔ HTTP nodes\\n\\n#### `GET /api/health`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Server (each node)** | Return `200` with `Content-Type: application/json` body exactly shaped as below. Does **not** require auth. Does **not** need to probe Redis or SQLite for this task (liveness of the HTTP process is enough). |\\n| **Client / grader** | `GET http://127.0.0.1:800{N}/api/health` and assert status + `node_id`. |\\n\\n**Response (200):**\\n```json\\n{\\\"status\\\": \\\"ok\\\", \\\"node_id\\\": 0}\\n```\\n- `status`: string, always `\\\"ok\\\"` when the process is serving this route.\\n- `node_id`: integer `0` | `1` | `2` matching the process’s configured node (port 8000→0, 8001→1, 8002→2).\\n\\n**Failure / slow behavior:**\\n- If the node process is dead (pre-respawn): TCP connection refused / reset. Clients retry; supervisor must restore the listener within **60s** of `SIGKILL`.\\n- If the node is overloaded: may delay; no special health degradation payload in this task.\\n- Wrong `node_id` for a port is a **hard fail** (misconfiguration), not a soft warning.\\n\\n#### `GET /`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Server** | `200` with an HTML document (text/html). Minimal stub page titled or branded “Huddle” so a browser fetch succeeds on every node. No SPA, no auth UI yet (MARATHON-16 owns that). |\\n| **Client** | Expects HTML 200; must not depend on specific `data-testid`s until the SPA task. |\\n\\n**Failure:** same as health — connection errors until respawn.\\n\\n### Seam: `start.sh` ↔ child processes\\n\\n| Child | Bind | Identity | Restart |\\n|-------|------|----------|---------|\\n| `redis-server` | `127.0.0.1:6379` | pidfile under `/app/data/run/redis.pid` | Respawning required after `SIGKILL` |\\n| Uvicorn node 0 | `127.0.0.1:8000` | `HUDDLE_NODE_ID=0` | Respawning within 60s |\\n| Uvicorn node 1 | `127.0.0.1:8001` | `HUDDLE_NODE_ID=1` | Respawning within 60s |\\n| Uvicorn node 2 | `127.0.0.1:8002` | `HUDDLE_NODE_ID=2` | Respawning within 60s |\\n\\n- `start.sh` remains the foreground PID the verifier tracks. It must not daemonize itself (`exit` only when shutting down).\\n- On `SIGINT`/`SIGTERM` to `start.sh`: stop children (TERM then KILL), then exit non-zero or zero consistently; do not leave orphans listening on the fixed ports.\\n- **No IRC listener in this task** (MARATHON-15). Port `6667` stays free.\\n\\n### Seam: HTTP nodes ↔ durable storage / Redis (layout only)\\n\\n- Nodes **may** open the SQLite file read/write in this task only to apply WAL pragmas / ensure the file exists; no product schema required yet beyond optional `schema_migrations` bootstrap (see Data Model).\\n- Nodes **need not** connect to Redis for health/stub routes. Redis must still be **running** (and respawned) so later fan-out tasks find it at the fixed address.\\n\\n## Data Model\\n\\n### Filesystem layout (authoritative)\\n\\n```\\n/app/\\n  start.sh                 # foreground supervisor (executable)\\n  requirements.txt         # fastapi, uvicorn[standard], ...\\n  .venv/                   # created at runtime by start.sh (gitignored)\\n  server/\\n    __init__.py\\n    settings.py            # reads HUDDLE_* env; paths; node_id/port validation\\n    app.py                 # FastAPI factory: GET /, GET /api/health\\n  data/                    # durable root (survives process restarts)\\n    huddle.sqlite          # shared DB (created on first start if missing)\\n    huddle.sqlite-wal      # WAL sidecar (runtime)\\n    huddle.sqlite-shm      # SHM sidecar (runtime)\\n    redis/\\n      redis.conf           # generated or checked-in local config\\n      dump.rdb             # optional RDB (runtime)\\n    files/                 # reserved for MARATHON-10 uploads (empty dir ok)\\n    run/                   # pidfiles, redis pid (runtime; gitignored contents)\\n  timer.sh                 # pre-existing harness helper — DO NOT MODIFY\\n```\\n\\n### SQLite\\n\\n- **Path:** `/app/data/huddle.sqlite` (override only via `HUDDLE_DATA_DIR`).\\n- **Pragmas (every node on connect):** `journal_mode=WAL`, `busy_timeout=5000` (or ≥5s), `foreign_keys=ON`, `synchronous=NORMAL`.\\n- **Schema in this task:** either (a) create an empty DB file with pragmas only, or (b) create a single bootstrap table:\\n  - `schema_migrations(version INTEGER PRIMARY KEY, applied_at TEXT NOT NULL)` with no product rows.\\n- **Product tables** (users, tokens, workspaces, …): **out of scope** — owned by MARATHON-3+.\\n- **Backward compatibility:** greenfield; no migration from a prior schema.\\n\\n### Redis\\n\\n- Bind **only** `127.0.0.1:6379` (no external interfaces).\\n- `dir` = `/app/data/redis`, `pidfile` = `/app/data/run/redis.pid`, `daemonize no` (supervised by `start.sh` as a background job via `\\u0026` + wait loop — Redis itself stays non-daemonized under the supervisor’s process group, or uses `daemonize no` and is backgrounded by the shell).\\n- **No application key schema** in this task. Persistence (RDB) may be enabled for convenience but must not be treated as SoT by later designs.\\n- AOF: optional; default off to keep boot simple unless implementer prefers AOF for local debugging.\\n\\n### Identity types (cluster-wide conventions for later tasks)\\n\\n| Field | Type | Notes |\\n|-------|------|-------|\\n| `node_id` | `int` 0..2 | Process-local, not stored in SQLite |\\n| Future resource `id` | stable string (ULID/UUID) | Not created here; document expectation only |\\n\\n## Files to Create / Files to Modify\\n\\n### Create\\n\\n| File | Change |\\n|------|--------|\\n| `start.sh` | Executable supervisor: resolve `APP_ROOT`, `mkdir -p` data dirs, create `/app/.venv` if missing, `pip install -r requirements.txt`, write/ensure `data/redis/redis.conf`, start `redis-server`, start three `uvicorn server.app:app --host 127.0.0.1 --port ...`, foreground respawn loop, signal cleanup. |\\n| `requirements.txt` | Pin flexible-but-declared deps: `fastapi`, `uvicorn[standard]`; optionally `redis` package now so MARATHON-14 does not re-litigate install (unused in stub routes is fine). |\\n| `server/__init__.py` | Empty or package marker. |\\n| `server/settings.py` | Load `HUDDLE_NODE_ID`, `HUDDLE_PORT`, `HUDDLE_DATA_DIR`; validate `node_id`∈{0,1,2} and port matches mapping; expose Redis URL and sqlite path helpers. |\\n| `server/app.py` | FastAPI app: `GET /api/health` → JSON contract; `GET /` → minimal HTML stub. |\\n| `data/redis/.gitkeep` | Ensure redis data dir exists in git. |\\n| `data/files/.gitkeep` | Reserve upload root for MARATHON-10. |\\n| `data/run/.gitkeep` | Runtime pid dir placeholder. |\\n| `data/redis/redis.conf` | **Either** commit a static conf **or** generate from `start.sh`; must bind 127.0.0.1:6379 and set `dir`/`pidfile` under `/app/data`. |\\n\\n### Modify\\n\\n| File | Change |\\n|------|--------|\\n| `.gitignore` | Ignore `/app/.venv/`, `data/**/*.sqlite*`, `data/redis/dump.rdb`, `data/redis/appendonly.aof`, `data/run/*.pid`, keep ignoring existing harness paths (`loom-prompts/`, etc.). Do **not** ignore `data/**/.gitkeep` or a committed `redis.conf` if checked in. |\\n\\n### Do not touch\\n\\n| File | Reason |\\n|------|--------|\\n| `timer.sh` | Harness time helper |\\n| `loom-prompts/**` | Agent prompts |\\n| IRC / SPA / Auth modules | Later tasks |\\n\\n## Sequencing and Cross-Task Seams\\n\\n### Build order for this task (single implementer)\\n\\n1. `requirements.txt` + `server/settings.py` + `server/app.py` (health + stub `/`).\\n2. `.gitignore` + `data/**/.gitkeep` (+ optional `redis.conf`).\\n3. `start.sh` supervisor last (wires everything).\\n4. Manual verify: boot, health on three ports, kill one uvicorn + redis, confirm respawn.\\n\\nParallelism inside the task: server package vs ignore/data layout can proceed in parallel; `start.sh` depends on both.\\n\\n### Downstream seams this task owns\\n\\n| Contract | Consumed by |\\n|----------|-------------|\\n| `start.sh` boots Redis + 3 nodes; health contract | Verifier, all backend tasks, QA |\\n| `HUDDLE_NODE_ID` / port mapping | Logging, future debugging; MARATHON-14 |\\n| `/app/data/huddle.sqlite` + WAL pragmas | MARATHON-3 (users/tokens), then all persistence tasks |\\n| Redis at `127.0.0.1:6379` supervised/respawned | MARATHON-13/14 (pub/sub); must already be up |\\n| Stub `GET /` | Replaced by MARATHON-16 SPA (same route) |\\n| FastAPI app factory in `server.app:app` | All later route modules mount on same app |\\n\\n### Must land before\\n\\n- **MARATHON-3** (Auth) is blocked on this task — needs live nodes + shared DB path.\\n- No other task should invent a second supervisor or a different port/node map.\\n\\n### Suggested follow-up cuts (do not implement here)\\n\\n- Product schema migrations framework details → first persistence task (MARATHON-3) can add Alembic/raw SQL migrations on the shared file.\\n- WebSocket / fan-out / IRC → MARATHON-13/14/15.\\n\\n## Out of Scope (Needs a Separate Task)\\n\\n| Item | Why excluded |\\n|------|----------------|\\n| Auth register/login/me (MARATHON-3) | Separate task; only needs our DB path + live nodes |\\n| Profiles, workspaces, channels, messages, DMs, files, search, groups | MARATHON-4…12 |\\n| WebSocket subscribe/resume + dense seq (MARATHON-13) | Depends on messages |\\n| Cross-node fan-out + Redis-outage behavior beyond respawn (MARATHON-14) | Needs events; this task only respawns Redis |\\n| IRC `:6667` (MARATHON-15) | Explicit later task; neighborhood/harness ports list includes 6667 but we must not bind it yet |\\n| SPA + `data-testid`s (MARATHON-16+) | Replaces stub `GET /` |\\n| `timer.sh` behavior | Harness-owned |\\n| Enveloped error JSON conventions beyond health | Defined in epic; apply starting with Auth |\\n| Neighborhood scan of repo code for `start.sh` / `redis` / `/api/health` | **No hits** in the empty baseline beyond `timer.sh` and empty `data/` — nothing else to exclude |\\n\\n**Neighborhood scan result:** baseline repo contains only `timer.sh`, empty `data/`, `.gitignore`, and `loom-prompts/`. No pre-existing HTTP server, Redis config, or health route to reconcile. Harness utilities `marathon-freeports` / `marathon-portlock` clear ports `{8000,8001,8002,6667,6379}` before verify — implementers must not rely on stale listeners.\\n\\n## Edge Cases \\u0026 Error Handling\\n\\n| Situation | Expected behavior |\\n|-----------|-------------------|\\n| Cold start, empty `data/` | `start.sh` creates dirs + sqlite file; starts Redis; starts 3 nodes; then blocks in wait/respawn loop. |\\n| Port 800x already busy at start | Fail fast: log which port, exit non-zero. Do not partially serve “whatever’s free.” (Verifier runs `marathon-freeports` first; residual busy = real error.) |\\n| Port 6379 busy at start with foreign process | Fail fast after brief retry; do not attach to unknown Redis. |\\n| HTTP child `SIGKILL` | Supervisor detects exit (wait/`SIGCHLD`/poll ≤2s); restart that node only with same `HUDDLE_NODE_ID`/port; listener restored in **\\u0026lt; 60s**. Other nodes uninterrupted. |\\n| Redis `SIGKILL` | Supervisor restarts `redis-server` with same conf. (Fan-out degradation during gap is MARATHON-14; here only respawn is required.) |\\n| Repeated crash loop | Keep respawning (with optional short backoff ≤2s) so the 60s window is met; log each restart to stdout/stderr (captured by verifier logs). |\\n| `start.sh` receives `SIGTERM`/`SIGINT` | Propagate shutdown to Redis + all nodes; wait briefly; `_exit`. No orphaned listeners. |\\n| `HUDDLE_NODE_ID` missing when launching uvicorn manually | `settings.py` aborts process startup with clear error (non-zero). `start.sh` always sets the env. |\\n| `node_id`/port mismatch (e.g. id=0 on 8001) | Refuse to start that process. |\\n| pip / venv failure | Exit non-zero before binding ports; do not hang silently. |\\n| SQLite locked during bootstrap | Retry within busy_timeout; if still failing, log and exit that node (supervisor will respawn). |\\n| Health called during startup race | Until bind completes, connection refused — acceptable. After bind, health must be correct. |\\n| Partial cluster (only 2 nodes up) | Allowed transiently during respawn; steady state is 3. |\\n| Writing product data | Not in this task; stub routes are read-only. |\\n\\n## Acceptance Criteria\\n\\n1. `test -x /app/start.sh` (or repo-root `start.sh` executable bit set).\\n2. Running `./start.sh` from `/app` does not exit on its own while children are healthy (foreground supervisor).\\n3. Within a short boot window (e.g. ≤30s cold including pip), all of the following succeed:\\n   - `curl -sf http://127.0.0.1:8000/api/health` → `200` JSON `status==\\\"ok\\\"` and `node_id==0`\\n   - same for `:8001` → `node_id==1`\\n   - same for `:8002` → `node_id==2`\\n4. `curl -sf http://127.0.0.1:8000/` (and 8001/8002) → `200` with `Content-Type` HTML (or text/html).\\n5. `redis-cli -h 127.0.0.1 -p 6379 PING` → `PONG` while `start.sh` is alive.\\n6. **HTTP respawn:** `SIGKILL` one uvicorn/node PID; without rerunning `start.sh`, within **60s** that port’s `/api/health` returns 200 with the **same** `node_id` as before. The other two ports remain healthy throughout.\\n7. **Redis respawn:** `SIGKILL` the redis-server PID; without rerunning `start.sh`, `PING` succeeds again after respawn (implementer should target well under 60s; epic’s 5s write continuity is **not** required until MARATHON-14).\\n8. **Negative:** `node_id` values must **not** be swapped across ports; health must **not** require `Authorization`.\\n9. **Negative:** `start.sh` must **not** depend on Docker, remote Redis, or network services outside localhost.\\n10. **Negative:** this task must **not** bind `:6667`.\\n11. Durable path `/app/data/` exists after boot; sqlite file present if bootstrap creates it.\\n12. No modifications to `timer.sh`.\\n\\n## Testing Strategy\\n\\n### Automated / scriptable checks (implementer or QA)\\n\\n```bash\\ncd /app \\u0026\\u0026 ./start.sh \\u0026\\n# wait for health on 8000/8001/8002\\nfor p in 0 1 2; do\\n  curl -sf \\\"http://127.0.0.1:800${p}/api/health\\\" | python3 -c \\\"import sys,json; d=json.load(sys.stdin); assert d=={'status':'ok','node_id':$p}\\\"\\ndone\\nredis-cli -h 127.0.0.1 -p 6379 PING | grep PONG\\n# kill one node\\nkill -9 \\\"$(pgrep -f 'uvicorn.*8001' | head -1)\\\"\\n# poll until 8001 health returns node_id 1 within 60s\\n# kill redis and poll PING\\n```\\n\\n### Manual verification\\n\\n1. Boot `./start.sh`; watch logs for three “Uvicorn running” lines and Redis ready.\\n2. Browser or curl `GET /` on each port — stub HTML loads.\\n3. `kill -9` a node; confirm curl failures then recovery \\u0026lt;60s.\\n4. `kill -9` redis; confirm `redis-cli PING` recovers via supervisor.\\n5. `kill` the `start.sh` process group; confirm ports are free (`marathon-freeports` / `ss`).\\n\\n### Out of scope for this task’s tests\\n\\nAuth flows, WS fan-out during Redis outage, IRC, SPA selectors — covered by later tasks/QA once those land.\",\n  \"design_format\": \"markdown\",\n  \"has_design\": true,\n  \"notes\": \"Implemented Python/FastAPI+Uvicorn cluster scaffold per design. start.sh supervises Redis :6379 + nodes 8000/8001/8002 with SIGKILL respawn. GET /api/health and stub GET / verified; unit tests in tests/test_health.py. SQLite WAL bootstrap at data/huddle.sqlite with schema_migrations.\",\n  \"created_at\": \"2026-08-22T22:16:49.780466332Z\",\n  \"updated_at\": \"2026-08-22T22:30:35.691Z\",\n  \"created_by\": \"marathon-harness\",\n  \"closed_at\": \"2026-08-22T22:30:35.691Z\",\n  \"close_reason\": \"integrated into /app by harness gate (attempt=1)\",\n  \"description\": \"Create /app/start.sh that stays in the foreground and keeps the cluster serving while alive. Launch three HTTP nodes on 127.0.0.1:8000, :8001, :8002 and a local redis-server on 127.0.0.1:6379. Self-contained (no remote services, no DinD). Respawning: if an HTTP node is SIGKILLed it must come back within 60s without external action; if Redis is SIGKILLed, start.sh must respawn it. Stub GET / on each node and GET /api/health returning 200 {status:ok, node_id} with node_id 0/1/2 matching ports 8000/8001/8002. Choose language/framework and shared durable storage layout for the cluster.\",\n  \"comments\": [\n    {\n      \"id\": 1,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"backend-dev-1\",\n      \"text\": \"IMPL-DONE attempt=1 commit=fba2eb628deb2875e1217dab3fbfeaec3179ae24\",\n      \"created_at\": \"2026-08-22T22:28:25.422547535Z\"\n    },\n    {\n      \"id\": 2,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"CRITIC REVIEW attempt=1 commit=fba2eb628deb2875e1217dab3fbfeaec3179ae24 APPROVED — start.sh foreground supervisor boots Redis+3 FastAPI/uvicorn nodes with correct health/HTML contracts, SQLite WAL layout, and SIGKILL respawn within 60s; timer.sh untouched; no :6667.\",\n      \"created_at\": \"2026-08-22T22:30:34.746435Z\"\n    },\n    {\n      \"id\": 3,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"INTEGRATED attempt=1 app_before=585944254f44b8b0b4a9b891ea1dafb0d1764f7e app_after=fba2eb628deb2875e1217dab3fbfeaec3179ae24\",\n      \"created_at\": \"2026-08-22T22:30:35.657530825Z\"\n    }\n  ]\n}\n","stderr":"","executionTime":153,"interleavedOutput":"{\n  \"id\": \"MARATHON-20\",\n  \"title\": \"Verify: HTTP node and Redis SIGKILL respawn\",\n  \"status\": \"review\",\n  \"priority\": 1,\n  \"issue_type\": \"task\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"qa\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"has_design\": false,\n  \"created_at\": \"2026-08-22T22:37:07.490815704Z\",\n  \"updated_at\": \"2026-08-22T22:41:50.438165585Z\",\n  \"created_by\": \"marathon-harness\",\n  \"description\": \"On integrated head fba2eb6 (MARATHON-2), with /app/start.sh already running, verify resilience against the product specification:\\n1. SIGKILL one of the three HTTP node processes; within 60s that port's /api/health returns 200 with the same node_id as before; the other two nodes stay healthy throughout.\\n2. SIGKILL redis-server on 127.0.0.1:6379; without restarting start.sh, Redis must be respawned and PING succeed again.\\n3. Confirm port 6667 is not required for this integration (IRC not yet in scope) and that killing one HTTP node does not stop reads on the other two.\\nReport failures vs the epic resilience/respawn requirements for the scaffold.\",\n  \"comments\": [\n    {\n      \"id\": 6,\n      \"issue_id\": \"MARATHON-20\",\n      \"author\": \"qa-engineer-1\",\n      \"text\": \"IMPL-DONE attempt=1 commit=6762605cf150d3e84a88e6d4fcc7eae51e2ae348\",\n      \"created_at\": \"2026-08-22T22:41:50.4231526Z\"\n    }\n  ]\n}\n\n{\n  \"id\": \"MARATHON-2\",\n  \"title\": \"Scaffold cluster: start.sh, 3 HTTP nodes, Redis\",\n  \"status\": \"closed\",\n  \"priority\": 0,\n  \"issue_type\": \"task\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"backend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"design\": \"# MARATHON-2 — Scaffold cluster: start.sh, 3 HTTP nodes, Redis\\n\\n## Summary\\n\\nThis task boots the Huddle cluster so the verifier (and every later feature task) has a live, self-contained process tree: `/app/start.sh` stays in the foreground, supervises a local Redis on `127.0.0.1:6379` and three identical HTTP nodes on `127.0.0.1:8000/8001/8002`, and respawns any of those children after `SIGKILL`. Each node exposes a stub `GET /` and the contracted `GET /api/health`. The design also locks language/framework and the shared durable storage layout that Auth, messages, fan-out, IRC, and the SPA will all assume.\\n\\n## Technical Approach\\n\\n### Decision\\n\\n| Concern | Choice |\\n|--------|--------|\\n| Language / HTTP framework | **Python 3.12 + FastAPI + Uvicorn** |\\n| Shared durable store | **SQLite file** at `/app/data/huddle.sqlite` with **WAL** + busy timeout (shared by all nodes) |\\n| Cross-node transport | **Local Redis** on `127.0.0.1:6379` (pub/sub / coordination only — **not** source of truth) |\\n| Process supervisor | **`/app/start.sh`** (bash): create dirs, ensure venv+deps, start Redis + 3 Uvicorn workers, foreground wait loop with respawn |\\n| Runtime root | Repo root **is** `/app` when the verifier runs |\\n\\n### Why this stack\\n\\n- Epic/instruction leave language open; Python 3.12, `sqlite3`, and `redis-server` are already on the image. FastAPI covers REST + future WebSockets (Starlette) without a second runtime for the backend/IRC path.\\n- Redis outage requirements (MARATHON-14: writes and dense `seq` continue while Redis is dead) **forbid** using Redis as the durable store. SQLite on a shared filesystem path is the simplest self-contained SoT that all three processes can open.\\n- A shell supervisor matches the verifier contract (`./start.sh` foreground) and can respawn both HTTP and Redis without DinD or external orchestrators.\\n\\n### Alternatives considered\\n\\n| Alternative | Rejected because |\\n|------------|------------------|\\n| Node.js + Express/Fastify | Equally viable for HTTP/WS; would split backend (IRC later) across languages or force Node for IRC too. Python keeps one backend language. |\\n| Redis as primary DB | Contradicts Redis-`SIGKILL` resilience (writes must succeed without Redis). |\\n| Postgres / Docker services | Remote/DinD-ish; not self-contained on this image. |\\n| One process binding three ports | Harder crash isolation; grader kills **one** node and expects the other two to keep serving — three OS processes are required. |\\n| Systemd / supervisord | Extra dependency; bash loop is enough and stays in-repo. |\\n\\n### Trade-off accepted\\n\\nSQLite WAL under concurrent writers is correct for this density but needs disciplined `busy_timeout` / short transactions in later tasks. We accept that complexity over introducing another datastore. Dependency install on first boot (`pip install -r requirements.txt` into `/app/.venv`) adds a few seconds to cold start — acceptable vs baking undeclared global packages into the image.\\n\\n### Conventions fixed for sibling tasks (no sibling designs exist yet)\\n\\n1. Product name: **Huddle**.\\n2. API prefix: `/api/...`; JSON; REST status codes per epic instruction.\\n3. `node_id` ∈ `{0,1,2}` ↔ ports `{8000,8001,8002}` (never swap).\\n4. Durable SoT: SQLite under `/app/data/`; Redis is ephemeral fan-out only.\\n5. Health response is **not** resource-enveloped (explicit epic exception): `{\\\"status\\\":\\\"ok\\\",\\\"node_id\\\":N}`.\\n6. Env per process: `HUDDLE_NODE_ID`, `HUDDLE_PORT`, `HUDDLE_DATA_DIR` (default `/app/data`), `HUDDLE_REDIS_URL` (default `redis://127.0.0.1:6379/0`).\\n\\n## Interface Contracts\\n\\n### Seam: Verifier / browser ↔ HTTP nodes\\n\\n#### `GET /api/health`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Server (each node)** | Return `200` with `Content-Type: application/json` body exactly shaped as below. Does **not** require auth. Does **not** need to probe Redis or SQLite for this task (liveness of the HTTP process is enough). |\\n| **Client / grader** | `GET http://127.0.0.1:800{N}/api/health` and assert status + `node_id`. |\\n\\n**Response (200):**\\n```json\\n{\\\"status\\\": \\\"ok\\\", \\\"node_id\\\": 0}\\n```\\n- `status`: string, always `\\\"ok\\\"` when the process is serving this route.\\n- `node_id`: integer `0` | `1` | `2` matching the process’s configured node (port 8000→0, 8001→1, 8002→2).\\n\\n**Failure / slow behavior:**\\n- If the node process is dead (pre-respawn): TCP connection refused / reset. Clients retry; supervisor must restore the listener within **60s** of `SIGKILL`.\\n- If the node is overloaded: may delay; no special health degradation payload in this task.\\n- Wrong `node_id` for a port is a **hard fail** (misconfiguration), not a soft warning.\\n\\n#### `GET /`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Server** | `200` with an HTML document (text/html). Minimal stub page titled or branded “Huddle” so a browser fetch succeeds on every node. No SPA, no auth UI yet (MARATHON-16 owns that). |\\n| **Client** | Expects HTML 200; must not depend on specific `data-testid`s until the SPA task. |\\n\\n**Failure:** same as health — connection errors until respawn.\\n\\n### Seam: `start.sh` ↔ child processes\\n\\n| Child | Bind | Identity | Restart |\\n|-------|------|----------|---------|\\n| `redis-server` | `127.0.0.1:6379` | pidfile under `/app/data/run/redis.pid` | Respawning required after `SIGKILL` |\\n| Uvicorn node 0 | `127.0.0.1:8000` | `HUDDLE_NODE_ID=0` | Respawning within 60s |\\n| Uvicorn node 1 | `127.0.0.1:8001` | `HUDDLE_NODE_ID=1` | Respawning within 60s |\\n| Uvicorn node 2 | `127.0.0.1:8002` | `HUDDLE_NODE_ID=2` | Respawning within 60s |\\n\\n- `start.sh` remains the foreground PID the verifier tracks. It must not daemonize itself (`exit` only when shutting down).\\n- On `SIGINT`/`SIGTERM` to `start.sh`: stop children (TERM then KILL), then exit non-zero or zero consistently; do not leave orphans listening on the fixed ports.\\n- **No IRC listener in this task** (MARATHON-15). Port `6667` stays free.\\n\\n### Seam: HTTP nodes ↔ durable storage / Redis (layout only)\\n\\n- Nodes **may** open the SQLite file read/write in this task only to apply WAL pragmas / ensure the file exists; no product schema required yet beyond optional `schema_migrations` bootstrap (see Data Model).\\n- Nodes **need not** connect to Redis for health/stub routes. Redis must still be **running** (and respawned) so later fan-out tasks find it at the fixed address.\\n\\n## Data Model\\n\\n### Filesystem layout (authoritative)\\n\\n```\\n/app/\\n  start.sh                 # foreground supervisor (executable)\\n  requirements.txt         # fastapi, uvicorn[standard], ...\\n  .venv/                   # created at runtime by start.sh (gitignored)\\n  server/\\n    __init__.py\\n    settings.py            # reads HUDDLE_* env; paths; node_id/port validation\\n    app.py                 # FastAPI factory: GET /, GET /api/health\\n  data/                    # durable root (survives process restarts)\\n    huddle.sqlite          # shared DB (created on first start if missing)\\n    huddle.sqlite-wal      # WAL sidecar (runtime)\\n    huddle.sqlite-shm      # SHM sidecar (runtime)\\n    redis/\\n      redis.conf           # generated or checked-in local config\\n      dump.rdb             # optional RDB (runtime)\\n    files/                 # reserved for MARATHON-10 uploads (empty dir ok)\\n    run/                   # pidfiles, redis pid (runtime; gitignored contents)\\n  timer.sh                 # pre-existing harness helper — DO NOT MODIFY\\n```\\n\\n### SQLite\\n\\n- **Path:** `/app/data/huddle.sqlite` (override only via `HUDDLE_DATA_DIR`).\\n- **Pragmas (every node on connect):** `journal_mode=WAL`, `busy_timeout=5000` (or ≥5s), `foreign_keys=ON`, `synchronous=NORMAL`.\\n- **Schema in this task:** either (a) create an empty DB file with pragmas only, or (b) create a single bootstrap table:\\n  - `schema_migrations(version INTEGER PRIMARY KEY, applied_at TEXT NOT NULL)` with no product rows.\\n- **Product tables** (users, tokens, workspaces, …): **out of scope** — owned by MARATHON-3+.\\n- **Backward compatibility:** greenfield; no migration from a prior schema.\\n\\n### Redis\\n\\n- Bind **only** `127.0.0.1:6379` (no external interfaces).\\n- `dir` = `/app/data/redis`, `pidfile` = `/app/data/run/redis.pid`, `daemonize no` (supervised by `start.sh` as a background job via `\\u0026` + wait loop — Redis itself stays non-daemonized under the supervisor’s process group, or uses `daemonize no` and is backgrounded by the shell).\\n- **No application key schema** in this task. Persistence (RDB) may be enabled for convenience but must not be treated as SoT by later designs.\\n- AOF: optional; default off to keep boot simple unless implementer prefers AOF for local debugging.\\n\\n### Identity types (cluster-wide conventions for later tasks)\\n\\n| Field | Type | Notes |\\n|-------|------|-------|\\n| `node_id` | `int` 0..2 | Process-local, not stored in SQLite |\\n| Future resource `id` | stable string (ULID/UUID) | Not created here; document expectation only |\\n\\n## Files to Create / Files to Modify\\n\\n### Create\\n\\n| File | Change |\\n|------|--------|\\n| `start.sh` | Executable supervisor: resolve `APP_ROOT`, `mkdir -p` data dirs, create `/app/.venv` if missing, `pip install -r requirements.txt`, write/ensure `data/redis/redis.conf`, start `redis-server`, start three `uvicorn server.app:app --host 127.0.0.1 --port ...`, foreground respawn loop, signal cleanup. |\\n| `requirements.txt` | Pin flexible-but-declared deps: `fastapi`, `uvicorn[standard]`; optionally `redis` package now so MARATHON-14 does not re-litigate install (unused in stub routes is fine). |\\n| `server/__init__.py` | Empty or package marker. |\\n| `server/settings.py` | Load `HUDDLE_NODE_ID`, `HUDDLE_PORT`, `HUDDLE_DATA_DIR`; validate `node_id`∈{0,1,2} and port matches mapping; expose Redis URL and sqlite path helpers. |\\n| `server/app.py` | FastAPI app: `GET /api/health` → JSON contract; `GET /` → minimal HTML stub. |\\n| `data/redis/.gitkeep` | Ensure redis data dir exists in git. |\\n| `data/files/.gitkeep` | Reserve upload root for MARATHON-10. |\\n| `data/run/.gitkeep` | Runtime pid dir placeholder. |\\n| `data/redis/redis.conf` | **Either** commit a static conf **or** generate from `start.sh`; must bind 127.0.0.1:6379 and set `dir`/`pidfile` under `/app/data`. |\\n\\n### Modify\\n\\n| File | Change |\\n|------|--------|\\n| `.gitignore` | Ignore `/app/.venv/`, `data/**/*.sqlite*`, `data/redis/dump.rdb`, `data/redis/appendonly.aof`, `data/run/*.pid`, keep ignoring existing harness paths (`loom-prompts/`, etc.). Do **not** ignore `data/**/.gitkeep` or a committed `redis.conf` if checked in. |\\n\\n### Do not touch\\n\\n| File | Reason |\\n|------|--------|\\n| `timer.sh` | Harness time helper |\\n| `loom-prompts/**` | Agent prompts |\\n| IRC / SPA / Auth modules | Later tasks |\\n\\n## Sequencing and Cross-Task Seams\\n\\n### Build order for this task (single implementer)\\n\\n1. `requirements.txt` + `server/settings.py` + `server/app.py` (health + stub `/`).\\n2. `.gitignore` + `data/**/.gitkeep` (+ optional `redis.conf`).\\n3. `start.sh` supervisor last (wires everything).\\n4. Manual verify: boot, health on three ports, kill one uvicorn + redis, confirm respawn.\\n\\nParallelism inside the task: server package vs ignore/data layout can proceed in parallel; `start.sh` depends on both.\\n\\n### Downstream seams this task owns\\n\\n| Contract | Consumed by |\\n|----------|-------------|\\n| `start.sh` boots Redis + 3 nodes; health contract | Verifier, all backend tasks, QA |\\n| `HUDDLE_NODE_ID` / port mapping | Logging, future debugging; MARATHON-14 |\\n| `/app/data/huddle.sqlite` + WAL pragmas | MARATHON-3 (users/tokens), then all persistence tasks |\\n| Redis at `127.0.0.1:6379` supervised/respawned | MARATHON-13/14 (pub/sub); must already be up |\\n| Stub `GET /` | Replaced by MARATHON-16 SPA (same route) |\\n| FastAPI app factory in `server.app:app` | All later route modules mount on same app |\\n\\n### Must land before\\n\\n- **MARATHON-3** (Auth) is blocked on this task — needs live nodes + shared DB path.\\n- No other task should invent a second supervisor or a different port/node map.\\n\\n### Suggested follow-up cuts (do not implement here)\\n\\n- Product schema migrations framework details → first persistence task (MARATHON-3) can add Alembic/raw SQL migrations on the shared file.\\n- WebSocket / fan-out / IRC → MARATHON-13/14/15.\\n\\n## Out of Scope (Needs a Separate Task)\\n\\n| Item | Why excluded |\\n|------|----------------|\\n| Auth register/login/me (MARATHON-3) | Separate task; only needs our DB path + live nodes |\\n| Profiles, workspaces, channels, messages, DMs, files, search, groups | MARATHON-4…12 |\\n| WebSocket subscribe/resume + dense seq (MARATHON-13) | Depends on messages |\\n| Cross-node fan-out + Redis-outage behavior beyond respawn (MARATHON-14) | Needs events; this task only respawns Redis |\\n| IRC `:6667` (MARATHON-15) | Explicit later task; neighborhood/harness ports list includes 6667 but we must not bind it yet |\\n| SPA + `data-testid`s (MARATHON-16+) | Replaces stub `GET /` |\\n| `timer.sh` behavior | Harness-owned |\\n| Enveloped error JSON conventions beyond health | Defined in epic; apply starting with Auth |\\n| Neighborhood scan of repo code for `start.sh` / `redis` / `/api/health` | **No hits** in the empty baseline beyond `timer.sh` and empty `data/` — nothing else to exclude |\\n\\n**Neighborhood scan result:** baseline repo contains only `timer.sh`, empty `data/`, `.gitignore`, and `loom-prompts/`. No pre-existing HTTP server, Redis config, or health route to reconcile. Harness utilities `marathon-freeports` / `marathon-portlock` clear ports `{8000,8001,8002,6667,6379}` before verify — implementers must not rely on stale listeners.\\n\\n## Edge Cases \\u0026 Error Handling\\n\\n| Situation | Expected behavior |\\n|-----------|-------------------|\\n| Cold start, empty `data/` | `start.sh` creates dirs + sqlite file; starts Redis; starts 3 nodes; then blocks in wait/respawn loop. |\\n| Port 800x already busy at start | Fail fast: log which port, exit non-zero. Do not partially serve “whatever’s free.” (Verifier runs `marathon-freeports` first; residual busy = real error.) |\\n| Port 6379 busy at start with foreign process | Fail fast after brief retry; do not attach to unknown Redis. |\\n| HTTP child `SIGKILL` | Supervisor detects exit (wait/`SIGCHLD`/poll ≤2s); restart that node only with same `HUDDLE_NODE_ID`/port; listener restored in **\\u0026lt; 60s**. Other nodes uninterrupted. |\\n| Redis `SIGKILL` | Supervisor restarts `redis-server` with same conf. (Fan-out degradation during gap is MARATHON-14; here only respawn is required.) |\\n| Repeated crash loop | Keep respawning (with optional short backoff ≤2s) so the 60s window is met; log each restart to stdout/stderr (captured by verifier logs). |\\n| `start.sh` receives `SIGTERM`/`SIGINT` | Propagate shutdown to Redis + all nodes; wait briefly; `_exit`. No orphaned listeners. |\\n| `HUDDLE_NODE_ID` missing when launching uvicorn manually | `settings.py` aborts process startup with clear error (non-zero). `start.sh` always sets the env. |\\n| `node_id`/port mismatch (e.g. id=0 on 8001) | Refuse to start that process. |\\n| pip / venv failure | Exit non-zero before binding ports; do not hang silently. |\\n| SQLite locked during bootstrap | Retry within busy_timeout; if still failing, log and exit that node (supervisor will respawn). |\\n| Health called during startup race | Until bind completes, connection refused — acceptable. After bind, health must be correct. |\\n| Partial cluster (only 2 nodes up) | Allowed transiently during respawn; steady state is 3. |\\n| Writing product data | Not in this task; stub routes are read-only. |\\n\\n## Acceptance Criteria\\n\\n1. `test -x /app/start.sh` (or repo-root `start.sh` executable bit set).\\n2. Running `./start.sh` from `/app` does not exit on its own while children are healthy (foreground supervisor).\\n3. Within a short boot window (e.g. ≤30s cold including pip), all of the following succeed:\\n   - `curl -sf http://127.0.0.1:8000/api/health` → `200` JSON `status==\\\"ok\\\"` and `node_id==0`\\n   - same for `:8001` → `node_id==1`\\n   - same for `:8002` → `node_id==2`\\n4. `curl -sf http://127.0.0.1:8000/` (and 8001/8002) → `200` with `Content-Type` HTML (or text/html).\\n5. `redis-cli -h 127.0.0.1 -p 6379 PING` → `PONG` while `start.sh` is alive.\\n6. **HTTP respawn:** `SIGKILL` one uvicorn/node PID; without rerunning `start.sh`, within **60s** that port’s `/api/health` returns 200 with the **same** `node_id` as before. The other two ports remain healthy throughout.\\n7. **Redis respawn:** `SIGKILL` the redis-server PID; without rerunning `start.sh`, `PING` succeeds again after respawn (implementer should target well under 60s; epic’s 5s write continuity is **not** required until MARATHON-14).\\n8. **Negative:** `node_id` values must **not** be swapped across ports; health must **not** require `Authorization`.\\n9. **Negative:** `start.sh` must **not** depend on Docker, remote Redis, or network services outside localhost.\\n10. **Negative:** this task must **not** bind `:6667`.\\n11. Durable path `/app/data/` exists after boot; sqlite file present if bootstrap creates it.\\n12. No modifications to `timer.sh`.\\n\\n## Testing Strategy\\n\\n### Automated / scriptable checks (implementer or QA)\\n\\n```bash\\ncd /app \\u0026\\u0026 ./start.sh \\u0026\\n# wait for health on 8000/8001/8002\\nfor p in 0 1 2; do\\n  curl -sf \\\"http://127.0.0.1:800${p}/api/health\\\" | python3 -c \\\"import sys,json; d=json.load(sys.stdin); assert d=={'status':'ok','node_id':$p}\\\"\\ndone\\nredis-cli -h 127.0.0.1 -p 6379 PING | grep PONG\\n# kill one node\\nkill -9 \\\"$(pgrep -f 'uvicorn.*8001' | head -1)\\\"\\n# poll until 8001 health returns node_id 1 within 60s\\n# kill redis and poll PING\\n```\\n\\n### Manual verification\\n\\n1. Boot `./start.sh`; watch logs for three “Uvicorn running” lines and Redis ready.\\n2. Browser or curl `GET /` on each port — stub HTML loads.\\n3. `kill -9` a node; confirm curl failures then recovery \\u0026lt;60s.\\n4. `kill -9` redis; confirm `redis-cli PING` recovers via supervisor.\\n5. `kill` the `start.sh` process group; confirm ports are free (`marathon-freeports` / `ss`).\\n\\n### Out of scope for this task’s tests\\n\\nAuth flows, WS fan-out during Redis outage, IRC, SPA selectors — covered by later tasks/QA once those land.\",\n  \"design_format\": \"markdown\",\n  \"has_design\": true,\n  \"notes\": \"Implemented Python/FastAPI+Uvicorn cluster scaffold per design. start.sh supervises Redis :6379 + nodes 8000/8001/8002 with SIGKILL respawn. GET /api/health and stub GET / verified; unit tests in tests/test_health.py. SQLite WAL bootstrap at data/huddle.sqlite with schema_migrations.\",\n  \"created_at\": \"2026-08-22T22:16:49.780466332Z\",\n  \"updated_at\": \"2026-08-22T22:30:35.691Z\",\n  \"created_by\": \"marathon-harness\",\n  \"closed_at\": \"2026-08-22T22:30:35.691Z\",\n  \"close_reason\": \"integrated into /app by harness gate (attempt=1)\",\n  \"description\": \"Create /app/start.sh that stays in the foreground and keeps the cluster serving while alive. Launch three HTTP nodes on 127.0.0.1:8000, :8001, :8002 and a local redis-server on 127.0.0.1:6379. Self-contained (no remote services, no DinD). Respawning: if an HTTP node is SIGKILLed it must come back within 60s without external action; if Redis is SIGKILLed, start.sh must respawn it. Stub GET / on each node and GET /api/health returning 200 {status:ok, node_id} with node_id 0/1/2 matching ports 8000/8001/8002. Choose language/framework and shared durable storage layout for the cluster.\",\n  \"comments\": [\n    {\n      \"id\": 1,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"backend-dev-1\",\n      \"text\": \"IMPL-DONE attempt=1 commit=fba2eb628deb2875e1217dab3fbfeaec3179ae24\",\n      \"created_at\": \"2026-08-22T22:28:25.422547535Z\"\n    },\n    {\n      \"id\": 2,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"CRITIC REVIEW attempt=1 commit=fba2eb628deb2875e1217dab3fbfeaec3179ae24 APPROVED — start.sh foreground supervisor boots Redis+3 FastAPI/uvicorn nodes with correct health/HTML contracts, SQLite WAL layout, and SIGKILL respawn within 60s; timer.sh untouched; no :6667.\",\n      \"created_at\": \"2026-08-22T22:30:34.746435Z\"\n    },\n    {\n      \"id\": 3,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"INTEGRATED attempt=1 app_before=585944254f44b8b0b4a9b891ea1dafb0d1764f7e app_after=fba2eb628deb2875e1217dab3fbfeaec3179ae24\",\n      \"created_at\": \"2026-08-22T22:30:35.657530825Z\"\n    }\n  ]\n}\n","localExecutionTimeMs":66},"isBackground":false},"description":"Fetch MARATHON-20 and epic data"},"hookAdditionalContexts":[],"toolCallId":"call-8abd0db3-1c20-4645-94bd-c92e3dc30ca7-14\nfc_d2ef3718-7596-96f5-9c38-7ef01328d544_0","startedAtMs":"1787438781759","completedAtMs":"1787438781912"},"model_call_id":"c64c3111-59ba-494a-830c-f5095298259d-4-lwma","session_id":"6ee90dfc-ec75-48c4-8b56-cd9437a916e3","timestamp_ms":1787438781942}
