{"type":"tool_call","subtype":"started","call_id":"call-da21a007-6000-4111-9ed2-80b1588b99da-17\nfc_10008dc8-67d1-990d-b1c2-17bd10220c4b_3","tool_call":{"shellToolCall":{"args":{"command":"ls /work/ws 2>/dev/null; find /work/ws -name '*MARATHON-2*' 2>/dev/null | head -30; find /work/origin.git -name '*MARATHON*' 2>/dev/null | head -20","workingDirectory":"","timeout":30000,"toolCallId":"call-da21a007-6000-4111-9ed2-80b1588b99da-17\nfc_10008dc8-67d1-990d-b1c2-17bd10220c4b_3","simpleCommands":["ls","find","head","find","head"],"hasInputRedirect":false,"hasOutputRedirect":true,"parsingResult":{"parsingFailed":false,"executableCommands":[{"name":"ls","args":[{"type":"word","value":"/work/ws"}],"fullText":"ls /work/ws"},{"name":"find","args":[{"type":"word","value":"/work/ws"},{"type":"word","value":"-name"},{"type":"raw_string","value":"'*MARATHON-2*'"}],"fullText":"find /work/ws -name '*MARATHON-2*'"},{"name":"head","args":[{"type":"number","value":"-30"}],"fullText":"head -30"},{"name":"find","args":[{"type":"word","value":"/work/origin.git"},{"type":"word","value":"-name"},{"type":"raw_string","value":"'*MARATHON*'"}],"fullText":"find /work/origin.git -name '*MARATHON*'"},{"name":"head","args":[{"type":"number","value":"-20"}],"fullText":"head -20"}],"hasRedirects":true,"hasCommandSubstitution":false,"allRedirectsAreDevNull":true,"redirects":[{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"},{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"},{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"}]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Locate MARATHON-2 task artifacts","closeStdin":true,"conversationId":"1706f026-8f01-4429-b299-50be710ed180","adminCommandDenylist":[]},"description":"Locate MARATHON-2 task artifacts"},"hookAdditionalContexts":