{"type":"tool_call","subtype":"completed","call_id":"call-776dfbae-860e-4c52-b8d8-1c672b42630f-3\nfc_62c8e917-f227-9812-9ac1-8b8d033650a5_1","tool_call":{"readToolCall":{"args":{"path":"/work/critic-MARATHON-2-1/server/app.py"},"result":{"success":{"content":"\"\"\"FastAPI application factory for a Huddle HTTP node.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nfrom contextlib import asynccontextmanager\nfrom typing import AsyncIterator\n\nfrom fastapi import FastAPI\nfrom fastapi.responses import HTMLResponse, JSONResponse\n\nfrom server import db\nfrom server.settings import Settings, load_settings\n\n\ndef create_app(settings: Settings | None = None) -> FastAPI:\n    \"\"\"Build the FastAPI app for one node.\"\"\"\n    cfg = settings if settings is not None else load_settings()\n\n    @asynccontextmanager\n    async def lifespan(_app: FastAPI) -> AsyncIterator[None]:\n        db.ensure_bootstrap(cfg.sqlite_path)\n        yield\n\n    application = FastAPI(title=\"Huddle\", lifespan=lifespan)\n    application.state.settings = cfg\n\n    @application.get(\"/api/health\")\n    def health() -> JSONResponse:\n        return JSONResponse(\n            content={\"status\": \"ok\", \"node_id\": cfg.node_id},\n            status_code=200,\n        )\n\n    @application.get(\"/\", response_class=HTMLResponse)\n    def root() -> HTMLResponse:\n        return HTMLResponse(\n            content=(\n                \"<!DOCTYPE html><html><head><title>Huddle</title></head>\"\n                \"<body><h1>Huddle</h1><p>Cluster node stub.</p></body></html>\"\n            ),\n            status_code=200,\n            media_type=\"text/html\",\n        )\n\n    return application\n\n\n# Uvicorn target: server.app:app (HUDDLE_NODE_ID must be set by start.sh).\n# Avoid constructing at import time during unit tests with no env.\napp: FastAPI | None\nif os.environ.get(\"HUDDLE_NODE_ID\"):\n    app = create_app()\nelse:\n    app = None\n","isEmpty":false,"exceededLimit":false,"totalLines":56,"fileSize":1613,"path":"/work/critic-MARATHON-2-1/server/app.py","readRange":{"startLine":1,"endLine":56},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-776dfbae-860e-4c52-b8d8-1c672b42630f-3\nfc_62c8e917-f227-9812-9ac1-8b8d033650a5_1","startedAtMs":"1787437737382","completedAtMs":"1787437737652"},"model_call_id":"7885dfe9-8692-4b19-9497-202e1aa2752e-1-cxek","session_id":"1706f026-8f01-4429-b299-50be710ed180","timestamp_ms":1787437737677}
