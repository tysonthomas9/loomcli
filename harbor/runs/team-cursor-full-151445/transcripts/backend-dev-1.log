turn True\n    return False\n\n\ndef _require_member_workspace(\n    conn: Any,\n    *,\n    slug: str,\n    user_id: str,\n) -> tuple[dict[str, Any], str]:\n    \"\"\"Resolve slug + membership. Non-members get 404 (do not leak existence).\"\"\"\n    workspace = workspaces_store.get_workspace_by_slug(conn, slug)\n    if workspace is None:\n        raise ApiError(404, \"not_found\", \"workspace not found\")","isEmpty":false,"exceededLimit":false,"totalLines":415,"fileSize":12292,"path":"/work/ws/worktrees/app/backend-dev-1/server/workspaces/routes.py","readRange":{"startLine":1,"endLine":80},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-c8994056-5b1e-4219-a264-ea5a11a5de7f-29\nfc_9f65be59-97ca-9164-8b4d-c1f1e5da6f59_1","startedAtMs":"1787445756537","completedAtMs":"1787445757531"},"model_call_id":"c218b17a-bebf-49fa-8762-54ad8e9c3c31-7-stx3","session_id":"5de21c73-718e-49ab-8d79-ce218632b44f","timestamp_ms":1787445757556}
