{"type":"tool_call","subtype":"started","call_id":"call-386c1c03-1c22-4f96-b1db-9227370a38ee-45\nfc_8a7e2e32-c5b2-913b-9787-b798ba75a5c9_2","tool_call":{"editToolCall":{"args":{"path":"/work/ws/worktrees/app/backend-dev-1/server/ws/hub.py","streamContent":"\"\"\"Process-local WebSocket connection hub (local fan-out only; M14 adds Redis).\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport logging\nimport threading\nfrom typing import Any\n\nlogger = logging.getLogger(__name__)\n\n# Cap pending outbound frames per connection; exceed → close slow consumer.\nOUTBOUND_QUEUE_MAX = 1000\n\n\nclass WsConnection:\n    \"\"\"One authenticated WebSocket and its subscription set.\"\"\"\n\n    def __init__(\n        self,\n        *,\n        websocket: Any,\n        user_id: str,\n        loop: asyncio.AbstractEventLoop,\n    ) -> None:\n        self.websocket = websocket\n        self.user_id = user_id\n        self.loop = loop\n        self.channels: set[str] = set()\n        self.queue: asyncio.Queue[dict[str, Any] | None] = asyncio.Queue(\n            maxsize=OUTBOUND_QUEUE_MAX\n        )\n        # Channels currently mid-resume: buffer live frames until resumed ack.\n        self.resuming: set[str] = set()\n        self.resume_buffer: dict[str, list[dict[str, Any]]] = {}\n        self._closing = False\n\n    def enqueue(self, frame: dict[str, Any]) -> None:\n        \"\"\"Thread-safe enqueue from sync HTTP handlers.\"\"\"\n        if self._closing:\n            return\n\n        def _put() -> None:\n            if self._closing:\n                return\n            try:\n                self.queue.put_nowait(frame)\n            except asyncio.QueueFull:\n                self._closing = True\n                try:\n                    self.queue.put_nowait(None)\n                except asyncio.QueueFull:\n                    pass\n                asyncio.create_task(\n                    self.websocket.close(code=1013, reason=\"slow consumer\")\n                )\n\n        try:\n            self.loop.call_soon_threadsafe(_put)\n        except RuntimeError:\n            logger.exception(\"hub enqueue failed: event loop closed\")\n\n\nclass Hub:\n    \"\"\"Registry of local WS connections for channel and global delivery.\"\"\"\n\n    def __init__(self) -> None:\n        self._lock = threading.Lock()\n        self._connections: set[WsConnection] = set()\n\n    def register(self, conn: WsConnection) -> None:\n        with self._lock:\n            self._connections.add(conn)\n\n    def unregister(self, conn: WsConnection) -> None:\n        with self._lock:\n            self._connections.discard(conn)\n\n    def subscribe(self, conn: WsConnection, channel_id: str) -> None:\n        conn.channels.add(channel_id)\n\n    def broadcast_channel(self, channel_id: str, frame: dict[str, Any]) -> None:\n        with self._lock:\n            targets = [c for c in self._connections if channel_id in c.channels]\n        for conn in targets:\n            if channel_id in conn.resuming:\n                conn.resume_buffer.setdefault(channel_id, []).append(frame)\n            else:\n                conn.enqueue(frame)\n\n    def broadcast_global(self, frame: dict[str, Any]) -> None:\n        with self._lock:\n            targets = list(self._connections)\n        for conn in targets:\n            conn.enqueue(frame)\n\n\n# One hub per process (shared by all create_app instances in-process).\nhub = Hub()\n"}},"hookAdditionalContexts":[],"toolCallId":"call-386c1c03-1c22-4f96-b1db-9227370a38ee-45\nfc_8a7e2e32-c5b2-913b-9787-b798ba75a5c9_2","startedAtMs":"1787448836494"},"model_call_id":"6def408b-6104-44a9-a526-9810f97b5511-10-kkne","session_id":"b76c730e-983d-4b18-9e06-1d6745c005de","timestamp_ms":1787448836545}
