           raise ApiError(404, \"not_found\", not_found)\n\n\ndef require_channel_message_write(\n    conn: sqlite3.Connection,\n    *,\n    channel: dict[str, Any],\n    user_id: str,\n    not_found: str = \"channel not found\",\n) -> None:\n    \"\"\"Channel member required; then assert writable (423 archived).\"\"\"\n    is_member = channels_store.is_channel_member(\n        conn, channel_id=channel[\"id\"], user_id=user_id\n    )\n    if not is_member:\n        role = workspaces_store.get_member_role(\n            conn, workspace_id=channel[\"workspace_id\"], user_id=user_id\n        )\n        if channel[\"is_private\"] or channel[\"is_dm\"]:\n            if role is None:","isEmpty":false,"exceededLimit":false,"totalLines":642,"fileSize":19568,"path":"/work/ws/worktrees/app/backend-dev-1/server/messages/store.py","readRange":{"startLine":1,"endLine":80},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-99a1f1c6-66bd-4e61-b814-6aae86780d97-23\nfc_00a0e908-9567-955e-9e37-cac3e667c045_5","startedAtMs":"1787448758279","completedAtMs":"1787448758355"},"model_call_id":"6def408b-6104-44a9-a526-9810f97b5511-5-4jev","session_id":"b76c730e-983d-4b18-9e06-1d6745c005de","timestamp_ms":1787448758379}
