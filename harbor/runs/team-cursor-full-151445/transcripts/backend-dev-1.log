ude_router(invitations_router)\n    application.include_router(channels_router)\n    application.include_router(dms_router)\n    application.include_router(messages_router)\n\n    @application.get(\"/api/health\")\n    def health() -> JSONResponse:\n        return JSONResponse(\n            content={\"status\": \"ok\", \"node_id\": cfg.node_id},\n            status_code=200,\n        )\n\n    @application.get(\"/\")\n    def root() -> FileResponse:\n        return FileResponse(\n            INDEX_HTML,\n            media_type=\"text/html\",\n        )\n\n    application.mount(\n        \"/static\",\n        StaticFiles(directory=str(STATIC_DIR)),\n        name=\"static\",\n    )\n\n    return application\n\n\n# Uvicorn target: server.app:app (HUDDLE_NODE_ID must be set by start.sh).\n# Avoid constructing at import time during unit tests with no env.\napp: FastAPI | None\nif os.environ.get(\"HUDDLE_NODE_ID\"):\n    app = create_app()\nelse:\n    app = None\n","message":"The file /work/ws/worktrees/app/backend-dev-1/server/app.py has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"call-7e179838-ce5f-4222-936a-437b3cea1af5-30\nfc_a847d1eb-9ba6-9f49-ab36-72a3e43323b1_3","startedAtMs":"1787446823859","completedAtMs":"1787446827202"},"model_call_id":"8e476999-2b8c-4e02-939d-1221ca0eaa72-7-x0k0","session_id":"aec3e14e-ecc5-40d6-b9d9-d0b4accedb3f","timestamp_ms":1787446827222}
