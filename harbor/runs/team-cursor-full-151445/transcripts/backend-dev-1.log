lue":"-100"}],"fullText":"head -100"}],"hasRedirects":false,"hasCommandSubstitution":false,"redirects":[]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Inspect rejected M18 commit changes","closeStdin":true,"conversationId":"12ba3f12-6cfa-4f54-b2fb-87efd92700d6","adminCommandDenylist":[]},"description":"Inspect rejected M18 commit changes"},"hookAdditionalContexts":[],"toolCallId":"call-1e64a2c8-5d76-49de-9229-318605fc17cf-6\nfc_199ed107-ed41-9047-b4e7-4dadedd735a2_0","startedAtMs":"1787447721855"},"model_call_id":"3beb2332-45ec-488d-928b-2b33d3bcc648-2-waja","session_id":"12ba3f12-6cfa-4f54-b2fb-87efd92700d6","timestamp_ms":1787447721902}
