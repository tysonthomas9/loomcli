d\": ..., \"message_id\": ...}\n\n    No-op until MARATHON-13. Must not raise after a successful HTTP commit.\n    \"\"\"\n    _ = channel_id, message_id\n    return None\n\n\ndef publish_reaction_changed(\n    *,\n    channel_id: str,\n    message_id: str,\n    reactions: list[dict[str, Any]],\n) -> None:\n    \"\"\"Notify that reactions on a message changed.\n\n    Intended payload (``seq`` assigned by MARATHON-13)::\n\n        {\n            \"type\": \"reaction.changed\",\n            \"channel_id\": ...,\n            \"message_id\": ...,\n            \"reactions\": [<ReactionObj>, ...]\n        }\n\n    No-op until MARATHON-13. Must not raise after a successful HTTP commit.\n    \"\"\"\n    _ = channel_id, message_id, reactions\n    return None\n","isEmpty":false,"exceededLimit":false,"totalLines":89,"fileSize":2324,"path":"/work/ws/worktrees/app/backend-dev-1/server/events.py","readRange":{"startLine":1,"endLine":89},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-51829b27-7680-4f78-97e0-8eebf95a6d17-52\nfc_af9a824a-6fa5-930a-945b-267a7b884b58_2","startedAtMs":"1787446000393","completedAtMs":"1787446000457"},"model_call_id":"c218b17a-bebf-49fa-8762-54ad8e9c3c31-16-sfjc","session_id":"5de21c73-718e-49ab-8d79-ce218632b44f","timestamp_ms":1787446000476}
