ent` is deprecated; install `httpx2` instead.\n  from starlette.testclient import TestClient as TestClient  # noqa\n('require_channel_message_write', True)\n('require_channel_message_read', True)\n('create_message', True)\n('list_channel_messages', True)\n('list_pins_for_channel', True)\n('list_pins_for_channel', True)\n('publish_message_created', True)\npost 200 {\"message\":{\"id\":\"8133a58f-28c6-4810-a492-d28c6dc3e115\",\"channel_id\":\"5b9ba0bf-53ca-4865-a4c1-7c70df8858a8\",\"author_id\":\"a0d5d200-f6bd-46c3-82c3-ee8bf2cb84cc\",\"author\":{\"id\":\"a0d5d200-f6bd-46c3-82c3-ee8bf2cb84cc\",\"username\":\"bob03\",\"display_name\":\"bob03\",\"timezone\":null,\"avatar_url\":null,\"status_text\":null,\"status_emoji\":null},\"body\":\"hello\",\"parent_id\":null,\"reply_count\":0,\"created_at\":\"2026-08-2\n","localExecutionTimeMs":308},"isBackground":false},"description":"Verify APIs and smoke message flow"},"hookAdditionalContexts":[],"toolCallId":"call-9eec4459-03d6-42ce-b2f8-9e7fbf3210b8-92\nfc_2dd7a554-e3c4-941c-88b3-395df96918c3_1","startedAtMs":"1787446236727","completedAtMs":"1787446237145"},"model_call_id":"c218b17a-bebf-49fa-8762-54ad8e9c3c31-39-1qig","session_id":"5de21c73-718e-49ab-8d79-ce218632b44f","timestamp_ms":1787446237174}
