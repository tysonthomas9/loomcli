s_router)\n    application.include_router(workspaces_router)\n    application.include_router(channels_router)\n    application.include_router(messages_router)\n\n    @application.get(\"/api/health\")\n    def health() -> JSONResponse:\n        return JSONResponse(\n            content={\"status\": \"ok\", \"node_id\": cfg.node_id},\n            status_code=200,\n        )\n\n    @application.get(\"/\")\n    def root() -> FileResponse:\n        return FileResponse(\n            INDEX_HTML,\n            media_type=\"text/html\",\n        )\n\n    application.mount(\n        \"/static\",\n        StaticFiles(directory=str(STATIC_DIR)),\n        name=\"static\",\n    )\n\n    return application\n\n\n# Uvicorn target: server.app:app (HUDDLE_NODE_ID must be set by start.sh).\n# Avoid constructing at import time during unit tests with no env.\napp: FastAPI | None\nif os.environ.get(\"HUDDLE_NODE_ID\"):\n    app = create_app()\nelse:\n    app = None\n","isEmpty":false,"exceededLimit":false,"totalLines":81,"fileSize":2569,"path":"/work/ws/worktrees/app/backend-dev-1/server/app.py","readRange":{"startLine":1,"endLine":81},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-3b1678ab-a074-4edd-a5c9-2a070542b995-10\nfc_04707843-9866-93e5-8c2d-914d823c6f0e_3","startedAtMs":"1787444083045","completedAtMs":"1787444083097"},"model_call_id":"0fbfa7d9-7075-4140-98fa-5162e36b06ee-2-1h3i","session_id":"0a8fcafb-36dc-47ae-b858-91f084f7ec96","timestamp_ms":1787444083115}
