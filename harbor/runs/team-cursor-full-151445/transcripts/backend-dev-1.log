 = 50 if limit is None else limit\n        messages = messages_store.list_channel_messages(\n            conn,\n            channel_id=channel[\"id\"],\n            limit=effective_limit,\n            before=before,\n        )\n        return {\"messages\": messages}\n    finally:\n        conn.close()\n\n\n@router.get(\"/{channel_id}/pins\")\ndef list_channel_pins("}},"hookAdditionalContexts":[],"toolCallId":"call-6f88b6e1-006c-4729-b643-f7616b96ed88-41\nfc_e37d6005-4918-9f64-b2f9-60da82db1474_2","startedAtMs":"1787445971143"},"model_call_id":"c218b17a-bebf-49fa-8762-54ad8e9c3c31-13-vda8","session_id":"5de21c73-718e-49ab-8d79-ce218632b44f","timestamp_ms":1787445971849}
