 .pytest_cache\ndrwx------.  5 root root  101 Aug 22 22:27 .venv\ndrwx------.  5 root root   64 Aug 23 00:22 data\ndrwxr-xr-x.  2 root root   33 Aug 22 22:15 loom-prompts\n-rw-------.  1 root root  119 Aug 22 22:23 requirements.txt\ndrwx------. 10 root root 4096 Aug 23 00:15 server\n-rwx------.  1 root root 4973 Aug 22 22:27 start.sh\ndrwx------.  4 root root   45 Aug 23 00:02 static\ndrwx------.  3 root root 4096 Aug 23 00:52 tests\n-rwxr-xr-x.  1 root root  558 Aug 22 22:15 timer.sh\nOn branch agents/MARATHON/backend-dev-1\nUntracked files:\n  (use \"git add <file>...\" to include in what will be committed)\n\tdata/run/m6-boundary/\n\tdata/run/qa-auth-cluster-token.log\n\tdata/run/qa-auth-live.log\n\tdata/run/qa-cluster-boot.log\n\tdata/run/qa-cluster-respawn.log\n\nnothing added to commit but untracked files present (use \"git add\" to track)\n071ff20 Implement messages, threads, and reactions REST API (MARATHON-8)\ne2ccc2e migration: add message reactions/files schema v5 (MARATHON-8)\n8176819 Implement user groups and workspace invitations (MARATHON-12)\naf0e0f1 migration: add user_groups and workspace_invitations schema v4 (MARATHON-12)\n7e8e165 Implement channel lifecycle, workspace join, and pins (MARATHON-7)\nagents/MARATHON/backend-dev-1\n","stderr":"","executionTime":289,"interleavedOutput":"/work/ws/worktrees/app/backend-dev-1\ntotal 40\ndrwxr-xr-x.  9 root root 4096 Aug 23 00:58 .\ndrwxr-xr-x.  6 root root   93 Aug 22 22:15 ..\n-rw-------.  1 root root  264 Aug 23 00:58 .agent.lock\n-rw-------.  1 root root    0 Aug 22 22:23 .agent.lock.flock\n-rw-r--r--.  1 root root   42 Aug 22 22:15 .git\n-rw-r--r--.  1 root root  229 Aug 22 22:24 .gitignore\ndrwx------.  3 root root   70 Aug 22 22:25 .pytest_cache\ndrwx------.  5 root root  101 Aug 22 22:27 .venv\ndrwx------.  5 root root   64 Aug 23 00:22 data\ndrwxr-xr-x.  2 root root   33 Aug 22 22:15 loom-prompts\n-rw-------.  1 root root  119 Aug 22 22:23 requirements.txt\ndrwx------. 10 root root 4096 Aug 23 00:15 server\n-rwx------.  1 root root 4973 Aug 22 22:27 start.sh\ndrwx------.  4 root root   45 Aug 23 00:02 static\ndrwx------.  3 root root 4096 Aug 23 00:52 tests\n-rwxr-xr-x.  1 root root  558 Aug 22 22:15 timer.sh\nOn branch agents/MARATHON/backend-dev-1\nUntracked files:\n  (use \"git add <file>...\" to include in what will be committed)\n\tdata/run/m6-boundary/\n\tdata/run/qa-auth-cluster-token.log\n\tdata/run/qa-auth-live.log\n\tdata/run/qa-cluster-boot.log\n\tdata/run/qa-cluster-respawn.log\n\nnothing added to commit but untracked files present (use \"git add\" to track)\n071ff20 Implement messages, threads, and reactions REST API (MARATHON-8)\ne2ccc2e migration: add message reactions/files schema v5 (MARATHON-8)\n8176819 Implement user groups and workspace invitations (MARATHON-12)\naf0e0f1 migration: add user_groups and workspace_invitations schema v4 (MARATHON-12)\n7e8e165 Implement channel lifecycle, workspace join, and pins (MARATHON-7)\nagents/MARATHON/backend-dev-1\n","localExecutionTimeMs":19},"isBackground":false},"description":"Check workspace and git state"},"hookAdditionalContexts":[],"toolCallId":"call-95bfa5da-5cca-419f-9185-a3c0e47b8546-1\nfc_bcbb95b3-1601-9cfa-a6ad-7ded72939036_1","startedAtMs":"1787446744606","completedAtMs":"1787446744895"},"model_call_id":"8e476999-2b8c-4e02-939d-1221ca0eaa72-0-o3dt","session_id":"aec3e14e-ecc5-40d6-b9d9-d0b4accedb3f","timestamp_ms":1787446744915}
{"type":"tool_call","subtype":"completed","call_id":"call-95bfa5da-5cca-419f-9185-a3c0e47b8546-0\nfc_bcbb95b3-1601-9cfa-a6ad-7ded72939036_0","tool_call":{"shellToolCall":{"args":{"command":"git merge --no-edit main && loom data show MARATHON-9 --output json && loom data show MARATHON --output json 2>/dev/null; loom data show MARATHON-9 2>/dev/null | head -200","workingDirectory":"","timeout":30000,"toolCallId":"call-95bfa5da-5cca-419f-9185-a3c0e47b8546-0\nfc_bcbb95b3-1601-9cfa-a6ad-7ded72939036_0","simpleCommands":["git","loom","loom","loom","head"],"hasInputRedirect":false,"hasOutputRedirect":true,"parsingResult":{"parsingFailed":false,"executableCommands":[{"name":"git","args":[{"type":"word","value":"merge"},{"type":"word","value":"--no-edit"},{"type":"word","value":"main"}],"fullText":"git merge --no-edit main"},{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"show"},{"type":"word","value":"MARATHON-9"},{"type":"word","value":"--output"},{"type":"word","value":"json"}],"fullText":"loom data show MARATHON-9 --output json"},{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"show"},{"type":"word","value":"MARATHON"},{"type":"word","value":"--output"},{"type":"word","value":"json"}],"fullText":"loom data show MARATHON --output json"},{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"show"},{"type":"word","value":"MARATHON-9"}],"fullText":"loom data show MARATHON-9"},{"name":"head","args":[{"type":"number","value":"-200"}],"fullText":"head -200"}],"hasRedirects":true,"hasCommandSubstitution":false,"allRedirectsAreDevNull":true,"redirects":[{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"},{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"}]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Merge main and show task details","closeStdin":true,"conversationId":"aec3e14e-ecc5-40d6-b9d9-d0b4accedb3f","adminCommandDenylist":[]},"result":{"success":{"command":"git merge --no-edit main && loom data show MARATHON-9 --output json && loom data show MARATHON --output json 2>/dev/null; loom data show MARATHON-9 2>/dev/null | head -200","workingDirectory":"","exitCode":0,"signal":"","stdout":"Already up to date.\n{\n  \"id\": \"MARATHON-9\",\n  \"title\": \"DMs: get-or-create DM channel\",\n  \"status\": \"in_progress\",\n  \"priority\": 2,\n  \"issue_type\": \"task\",\n  \"assignee\": \"backend-dev-1\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"backend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"design\": \"## Summary\\n\\nThis task adds authenticated **get-or-create** for 1:1 direct-message channels: `POST /api/dms` resolves a workspace-scoped DM between the caller and a peer `user_id`, returning the same `channel_id` for both directions and on every repeat call. The channel is persisted as a normal `channels` row with `is_dm=true` (and `is_private=true` for visibility), both users in `channel_members`, so existing channel/message authz (MARATHON-7/8) and the SPA `dms-list` split (MARATHON-16) work without a separate message transport. It does not build group DMs, DM UI, or message posting.\\n\\n## Technical Approach\\n\\n### Decision\\n\\n| Concern | Choice |\\n|--------|--------|\\n| Route | Top-level `POST /api/dms` (task-mandated), not nested under `/api/workspaces/{slug}` |\\n| Request body | `{ \\\"user_id\\\", \\\"workspace_id\\\" }` — both required UUID strings. Task text abbreviated `{user_id}`; **workspace is mandatory** because every channel row has non-null `workspace_id` (MARATHON-5) and the shell lists DMs per current workspace |\\n| Response | Always **200** `{ \\\"channel_id\\\": \\\"\\u003cuuid\\u003e\\\" }` (not `201`, not a full `ChannelObj` wrapper) |\\n| Pair identity | Canonical unordered pair: `user_lo, user_hi = sorted([caller_id, peer_id])` within a workspace |\\n| Dedup without competing for migration v4 | **No new table.** Deterministic synthetic `channels.name` under existing `UNIQUE(workspace_id, name)`: `dm-` + first 29 hex chars of `SHA-256(workspace_id \\\\|\\\\| \\\":\\\" \\\\|\\\\| user_lo \\\\|\\\\| \\\":\\\" \\\\|\\\\| user_hi)` (ASCII, lower hex). Satisfies `CHANNEL_NAME_RE` (`^[a-z0-9-]{2,32}$`). Lookup = `SELECT` by `(workspace_id, name, is_dm=1)` |\\n| Flags | Insert with `is_dm=1`, `is_private=1`, `topic=\\\"\\\"`, `is_archived=0` |\\n| Membership | On create: insert **both** users into `channel_members`. On get (existing row): **ensure** both memberships exist (re-add if a party previously `leave`d) |\\n| Package | New `server/dms/` router + thin store orchestration; channel row helpers live in `server/channels/store.py` next to `create_channel` |\\n| DM privacy vs workspace owner | **Tighten** read/mutate gates for `is_dm`: channel **membership required**; workspace `owner_id` alone must **not** bypass (diverges from private-channel owner bypass in MARATHON-7 — justified so DMs are not readable by the workspace owner) |\\n| List visibility | Keep/adjust `list_channels_for_workspace_user` so DMs never appear to non-members (defense in depth even if `is_private` were wrong) |\\n| Migration | **None** for the happy path (avoids collision with MARATHON-8 and MARATHON-12, both designed as **v4**). Optional later `dm_pairs` table is out of scope |\\n| Auth | Reuse `get_current_user`; error envelope `{error:{code,message}}` unchanged |\\n| Ids / time | UUID4 channel ids; `utc_now_z()` timestamps |\\n\\n### Alternatives considered\\n\\n| Alternative | Rejected because |\\n|-------------|------------------|\\n| Body only `{user_id}` with implicit workspace | Multi-workspace users make the pair ambiguous; channels are workspace-scoped |\\n| `POST /api/workspaces/{slug}/dms` | Contradicts task path `POST /api/dms` already reserved by MARATHON-7 out-of-scope |\\n| New `dm_pairs` table (migration) | Cleaner join, but **v4 is double-booked** by M8/M12; name-hash uniqueness reuses existing UNIQUE and ships without schema races |\\n| Username-based channel `name` for display | Usernames allow `_` and up to 32 chars; fail `CHANNEL_NAME_RE` / length; display is asymmetric per viewer anyway |\\n| Return full `{channel: ChannelObj}` | Task mandates `{channel_id}`; client refreshes workspace detail for list rows |\\n| Global (non-workspace) DMs | No place in current schema; SPA DMs are per-workspace sidebar |\\n\\n### Trade-off accepted\\n\\nOpaque synthetic `ChannelObj.name` for DMs (not a human display label). **MARATHON-17** must render DM sidebar labels from the peer `UserObj` (e.g. via `GET /api/channels/{id}/members` or members already known client-side), not from `name`. Until then, `dms-list` may show the synthetic name — acceptable for this backend-only task.\\n\\n## Interface Contracts\\n\\n### Shared conventions (inherited)\\n\\n- Bearer `Authorization` required → missing/invalid → **401** `unauthorized` (MARATHON-3).\\n- Errors: `{ \\\"error\\\": { \\\"code\\\": \\\"\\u003ccode\\u003e\\\", \\\"message\\\": \\\"\\u003chuman\\u003e\\\" } }` (MARATHON-3/4).\\n- Pydantic bodies: `extra=\\\"ignore\\\"`; unknown keys ignored.\\n- `ChannelObj` keys unchanged: `id`, `workspace_id`, `name`, `is_private`, `is_dm`, `topic`, `is_archived` (MARATHON-5/7).\\n- Timestamps UTC `YYYY-MM-DDTHH:MM:SSZ`.\\n\\n### Seam: Client ↔ `POST /api/dms`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Client** (MARATHON-17 / future) | While user picks a peer in the current workspace, `POST /api/dms` with bearer + JSON body. On **200**, store/use `channel_id` (navigate message pane, refresh workspace detail so `dms-list` updates). Disable submit while in flight; do not invent a local channel id. |\\n| **Server** | Validate body; authorize workspace membership for caller + peer; get-or-create DM; return `{channel_id}` only. |\\n\\n**Request**\\n\\n```http\\nPOST /api/dms\\nAuthorization: Bearer \\u003ctoken\\u003e\\nContent-Type: application/json\\n```\\n\\n```json\\n{\\n  \\\"user_id\\\": \\\"\\u003cpeer-user-uuid\\u003e\\\",\\n  \\\"workspace_id\\\": \\\"\\u003cworkspace-uuid\\u003e\\\"\\n}\\n```\\n\\n| Field | Type | Required | Rules |\\n|-------|------|----------|-------|\\n| `user_id` | string | yes | Peer user id; must exist; must not equal caller; must be a `workspace_members` row for `workspace_id` |\\n| `workspace_id` | string | yes | Existing workspace id; caller must be a member |\\n\\n**Response 200**\\n\\n```json\\n{ \\\"channel_id\\\": \\\"\\u003cuuid\\u003e\\\" }\\n```\\n\\nExact key: `channel_id` only (no `channel` object, no extra fields required).\\n\\n**Status / error matrix**\\n\\n| Condition | Status | `code` | Notes |\\n|-----------|--------|--------|-------|\\n| Success (create or existing) | **200** | — | Same id both directions / repeats |\\n| Missing/invalid bearer | **401** | `unauthorized` | |\\n| Missing field / wrong type / empty string | **400** | `validation_error` | FastAPI envelope or explicit `ApiError` |\\n| `user_id` == caller | **400** | `validation_error` | Message e.g. `cannot dm yourself` |\\n| Unknown `workspace_id` or caller not a workspace member | **404** | `not_found` | Message `workspace not found` (no existence leak) |\\n| Unknown `user_id` **or** peer not a member of that workspace | **404** | `not_found` | Message `user not found` (do not distinguish “exists globally but not in workspace”) |\\n| SQLite busy after timeout | fail closed | — | Same as other routes; no partial membership |\\n\\n**Not used:** **403** for “peer not in workspace” (prefer 404 to match workspace non-member leak policy). Guests **may** DM other workspace members (no role gate beyond membership).\\n\\n### Seam: DM channel appearance on `GET /api/workspaces/{slug}`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Server** | After create, both members see a `ChannelObj` with `is_dm=true` in `channels` (subject to archive filter). Non-members must **not** see it. |\\n| **Client** (MARATHON-16 already) | Split `is_dm === true` → `dms-list`, else → `channel-list`. |\\n\\n### Seam: Authz tweaks for `is_dm` (server-owned)\\n\\nFor any existing channel route that today allows **workspace owner without channel membership** on private channels, when `channel.is_dm` is true:\\n\\n- **Require** `channel_members` row for the caller.\\n- If workspace member but not channel member → **403** `forbidden` (same message family as private denial is fine).\\n- If not a workspace member → **404** `not_found`.\\n\\nApplies at least to: channel members list, PATCH topic, GET pins, pin/unpin message, and (when MARATHON-8 lands) message read/write helpers — document for M8 implementer: **DM ⇒ member-only, no owner bypass**.\\n\\n`POST /api/channels/{id}/join` on a DM remains **403** for non-members (MARATHON-7); get-or-create is the only supported add path.\\n\\n### Client slow / fail summary\\n\\n| Condition | Client behavior |\\n|-----------|-----------------|\\n| In flight | Disable “open DM” control; keep prior `dms-list` |\\n| 401 | Re-auth (MARATHON-16) |\\n| 400 | Show `error.message`; stay on picker |\\n| 404 | Show not-found / peer unavailable; do not add sidebar row |\\n| Network / 5xx / timeout | Retry; do not assume channel exists until **200** |\\n| 200 | Use `channel_id`; optionally re-fetch workspace detail |\\n\\n## Data Model\\n\\n### No new migration (preferred)\\n\\nUses existing v2 tables:\\n\\n- `channels` — new rows with `is_dm=1`, `is_private=1`, synthetic `name`, empty `topic`\\n- `channel_members` — exactly the two participants (after ensure-membership)\\n- `workspaces` / `workspace_members` / `users` — authz only\\n\\n### Synthetic name algorithm (normative)\\n\\n```\\nuser_lo, user_hi = sorted([caller_id, peer_id])  # lexicographic UUID string order\\ndigest = SHA-256( f\\\"{workspace_id}:{user_lo}:{user_hi}\\\".encode(\\\"utf-8\\\") ).hexdigest()\\nname = \\\"dm-\\\" + digest[:29]   # length 32; charset [a-z0-9-]\\n```\\n\\nInvariant: name depends only on `(workspace_id, unordered user pair)` — **not** on who called.\\n\\n### Channel row fields on create\\n\\n| Field | Value |\\n|-------|--------|\\n| `id` | new UUID4 |\\n| `workspace_id` | from body |\\n| `name` | synthetic as above |\\n| `is_private` | `1` |\\n| `is_dm` | `1` |\\n| `topic` | `\\\"\\\"` |\\n| `is_archived` | `0` |\\n| `created_at` / `updated_at` | `utc_now_z()` |\\n\\n### List-query defense (in scope)\\n\\nUpdate `list_channels_for_workspace_user` visibility predicate from “public OR member” to:\\n\\n- visible if **member**, OR\\n- visible if **`is_dm=0` AND `is_private=0`** (true public)\\n\\nEquivalently: `(c.is_dm = 0 AND c.is_private = 0) OR cm.user_id IS NOT NULL`.\\n\\n### Schema change summary\\n\\n| Change | Compatible? |\\n|--------|-------------|\\n| No DDL | **Yes** |\\n| List SQL predicate tighten | **Yes** — only hides rows that should not have been visible |\\n| DM owner-bypass removal | Behavior change for owners on `is_dm` only |\\n\\n### Invariants\\n\\n1. At most one `is_dm` channel per `(workspace_id, unordered user pair)` (enforced by deterministic name + UNIQUE).\\n2. `POST .../channels` still forces `is_dm=false` (MARATHON-7).\\n3. Get-or-create never creates a second row for the same pair.\\n4. After a successful `POST /api/dms`, both users have `channel_members` rows.\\n5. `ChannelObj.is_dm === true` for these rows; SPA list split continues to work.\\n\\n## Files to Create / Files to Modify\\n\\n### Create\\n\\n| File | Change |\\n|------|--------|\\n| `server/dms/__init__.py` | Package marker / docstring: DM get-or-create owned here |\\n| `server/dms/routes.py` | `APIRouter(prefix=\\\"/api/dms\\\")`; `POST \\\"\\\"` handler; pydantic body; transaction; map errors |\\n| `server/dms/store.py` | `canonical_dm_name(...)`; `get_or_create_dm_channel(conn, *, workspace_id, caller_id, peer_id) -\\u003e channel_id`; peer/workspace checks raising `ApiError` |\\n| `tests/test_dms.py` | Contract tests (see Testing Strategy) |\\n\\n### Modify\\n\\n| File | Change |\\n|------|--------|\\n| `server/app.py` | `include_router` for dms router |\\n| `server/channels/store.py` | Add `create_dm_channel(...)` (bypass public name validation path used by user-created channels **or** validate synthetic name after generation); fix `list_channels_for_workspace_user` predicate for DM/private; optional `find_dm_by_name` |\\n| `server/channels/routes.py` | In `_require_channel_read_access`, pin list, PATCH, leave as needed: **`is_dm` ⇒ membership required** (no owner-only bypass) |\\n| `server/messages/routes.py` | Same DM membership rule in `_require_pin_access` (and document for M8 shared helper) |\\n\\n### Do not touch\\n\\n| File | Reason |\\n|------|--------|\\n| `static/**` | MARATHON-17 owns DM picker UI; M16 list split already correct |\\n| `server/db.py` | No migration in this design |\\n| `server/auth/**`, `server/users/**` | Consume `get_user_by_id` / deps only |\\n| Message CRUD routes | MARATHON-8 |\\n| IRC / WS / Redis | MARATHON-13/14/15 |\\n\\n## Sequencing and Cross-Task Seams\\n\\n### Build order (this task)\\n\\n1. `channels/store.py` — `create_dm_channel` + list predicate.\\n2. `dms/store.py` + `dms/routes.py` + mount in `app.py`.\\n3. Authz tighten for `is_dm` in channel/message routes.\\n4. `tests/test_dms.py` (+ any small assertion updates if list tests assume old predicate).\\n\\n### Parallelism\\n\\n- Independent of MARATHON-8 message CRUD **except** shared DM authz rule (coordinate via this design’s Interface Contracts).\\n- Independent of MARATHON-12 groups/invitations.\\n- MARATHON-17 can stub against this contract once merged.\\n\\n### Cross-task seams\\n\\n| Contract | Owner | Consumer |\\n|----------|-------|----------|\\n| `POST /api/dms` → `{channel_id}` | **MARATHON-9** | MARATHON-17 (DM open), graders |\\n| `ChannelObj.is_dm` + list visibility | MARATHON-5/7 + **this list fix** | MARATHON-16 shell, MARATHON-17 |\\n| DM member-only authz (no owner bypass) | **MARATHON-9** | MARATHON-8 message helpers must match |\\n| Message post in DM channel | MARATHON-8 | Needs channel membership (created here) |\\n| DM display labels / picker UI | MARATHON-17 | Uses `channel_id` + members/profiles |\\n\\n### Declared dependents\\n\\n- MARATHON-17 (SPA channels/DMs UX)\\n- MARATHON-8 (messages in DM channels; authz note)\\n\\n### Follow-up cuts (do not implement here)\\n\\n- Group DMs / multi-user conversations.\\n- `dm_pairs` table if hash-in-name is ever insufficient.\\n- Forbidding archive/leave on DMs.\\n- Client-side peer label rendering.\\n\\n## Out of Scope (Needs a Separate Task)\\n\\n| Item | File / pattern | Why excluded |\\n|------|----------------|--------------|\\n| SPA DM picker / open-DM button / peer label | `static/js/*`, MARATHON-17 | Frontend task; shell already has empty-capable `dms-list` |\\n| Message send/list inside DM | MARATHON-8 | Separate REST surface |\\n| Search / read_state / slash | MARATHON-11 | |\\n| WS fan-out `channel` events | MARATHON-13/14 | |\\n| IRC DM mapping | MARATHON-15 | |\\n| Group DMs | — | Not in task |\\n| Changing private-channel **owner** bypass for non-DM privates | `channels/routes.py` | Keep MARATHON-7 behavior for `is_private \\u0026\\u0026 !is_dm` |\\n| `POST /api/channels` creating `is_dm` | already forbidden | Remains forbidden |\\n| Migration v4/v5 DDL | `server/db.py` | Avoid M8/M12 version collision; name uniqueness sufficient |\\n| `channel-add-member-*` for DMs | SPA hooks | DMs are pair-only via this endpoint |\\n\\n**Neighborhood scan account**\\n\\n| Hit | Disposition |\\n|-----|-------------|\\n| `server/channels/store.py` `is_dm` always false on create; list predicate | **In scope** — DM create helper + list fix |\\n| `server/channels/routes.py` private/DM treated alike; owner bypass | **In scope** — DM membership tighten |\\n| `server/messages/routes.py` private/DM pin authz | **In scope** — same DM rule |\\n| `server/db.py` `is_dm` column | **Unchanged** |\\n| `static/js/shell.js` `dms-list` / `is_dm` split | **Out of scope** — already correct |\\n| `tests/test_channels.py` `is_dm is False` on normal create | **Out of scope** — keep; add `test_dms.py` |\\n| `tests/test_spa_shell.py` / `test_workspaces.py` `is_dm` assertions | **Out of scope** unless list predicate breaks a fixture |\\n| Grep: no `/api/dms` router yet | Greenfield `server/dms` |\\n| MARATHON-7/8/16 designs reserving `POST /api/dms` | **This task** |\\n\\n## Edge Cases \\u0026 Error Handling\\n\\n| Situation | Expected behavior |\\n|-----------|-------------------|\\n| A→B then B→A | Same `channel_id` |\\n| Repeat A→B | Same `channel_id`; **200**; no second row |\\n| Concurrent A→B and B→A | One INSERT wins; loser hits UNIQUE/`IntegrityError` on `(workspace_id,name)` → re-SELECT by name → return existing id (no **500**) |\\n| Caller left DM earlier | Ensure re-INSERT `channel_members` for caller (and peer if missing); return same id |\\n| Peer left DM earlier | Same ensure-both-memberships |\\n| Self `user_id` | **400** `validation_error` |\\n| Peer not in workspace | **404** `user not found` |\\n| Caller not in workspace | **404** `workspace not found` |\\n| Archived DM exists | Still return its `channel_id` (do not create replacement). Messaging may **423** via existing guard (MARATHON-7/8) |\\n| Workspace owner not in DM opens channel routes | **403** (member of ws) / **404** (stranger) — **not** owner bypass |\\n| Guest DMs a member | **200** if both are workspace members |\\n| Extra body keys | Ignored |\\n| `workspace_id` is a slug string | **404** (id lookup fails) — clients must send UUID `workspace.id` |\\n| User creates public channel whose name collides with a DM hash | Astronomically unlikely; if IntegrityError on DM insert and re-read finds non-`is_dm` row → **409** `conflict` with clear message (abort; do not hijack) |\\n| Unauthenticated | **401** |\\n\\n## Acceptance Criteria\\n\\n1. Authenticated `POST /api/dms` with `{user_id, workspace_id}` for two distinct workspace members → **200** `{ \\\"channel_id\\\": \\\"\\u003cuuid\\u003e\\\" }`.\\n2. Calling again with the same pair (same caller) → **200** with **identical** `channel_id`.\\n3. Peer calling with the caller’s id (swapped direction) → **200** with the **same** `channel_id`.\\n4. `GET /api/workspaces/{slug}` as either participant includes a channel with that id where `is_dm === true` (and typically `is_private === true`).\\n5. A third workspace member’s workspace detail must **NOT** include that DM channel.\\n6. Persisted row has `is_dm=1` (verify via API list/detail or DB in tests).\\n7. Self-DM → **400** `validation_error`; must **NOT** create a channel.\\n8. Unknown peer id → **404**; must **NOT** create a channel.\\n9. Peer registered globally but not in workspace → **404**; must **NOT** create a channel.\\n10. Caller not in workspace → **404**.\\n11. Unauthenticated → **401**.\\n12. After participant `POST /api/channels/{id}/leave`, a subsequent `POST /api/dms` for the same pair returns the **same** `channel_id` and restores membership (subsequent channel member list / message write authz succeeds for that user).\\n13. Workspace owner who is **not** a DM member must **NOT** read DM pins/members via owner bypass (**403** or **404** per rules above).\\n14. Negative: `POST /api/workspaces/{slug}/channels` still cannot create `is_dm=true` channels.\\n15. Negative: response must **NOT** require a `channel` object key for success (only `channel_id`).\\n\\n## Testing Strategy\\n\\n### Automated (`tests/test_dms.py`)\\n\\n- Happy path create + idempotent repeat + reverse direction same id.\\n- Both users see DM on workspace detail; third member does not.\\n- Self / missing peer / non-member peer / non-member caller / unauthenticated.\\n- Leave then get-or-create restores membership.\\n- Owner-without-membership denied on `GET /api/channels/{id}/members` (or pins) for the DM.\\n- Optional: concurrent create smoke (two threads) still yields one row.\\n- Regression: existing `tests/test_channels.py` / `test_workspaces.py` stay green.\\n\\n### Manual / cluster\\n\\n1. Register users A,B,C; create workspace; add B and C as members.\\n2. On `:8000`, A `POST /api/dms` with B → note `channel_id`.\\n3. On `:8001`, B `POST /api/dms` with A → same id (shared SQLite).\\n4. A and B `GET` workspace detail → DM present; C’s detail → absent.\\n5. Confirm `is_dm` true in listed channel object.\\n\\n### Human verify\\n\\n- No SPA change required; `curl`/httpie against any node with bearer token is enough for this task.\",\n  \"design_format\": \"markdown\",\n  \"has_design\": true,\n  \"notes\": \"Design complete for POST /api/dms get-or-create. Key decisions: body requires user_id+workspace_id (workspace-scoped channels); always 200 {channel_id}; dedupe via deterministic dm- name hash (no migration — avoids M8/M12 v4 clash); is_dm+is_private; ensure both memberships; tighten DM authz to members-only (no workspace-owner bypass). Handed to review; implementer label remains backend.\",\n  \"created_at\": \"2026-08-22T22:17:16.921652889Z\",\n  \"updated_at\": \"2026-08-23T00:46:55.100701683Z\",\n  \"created_by\": \"marathon-harness\",\n  \"description\": \"POST /api/dms {user_id} → 200 {channel_id}. Same channel id both directions and on repeated calls. Channel is_dm=true.\",\n  \"comments\": [\n    {\n      \"id\": 43,\n      \"issue_id\": \"MARATHON-9\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"DESIGN-AUTO-APPROVED pass=23\",\n      \"created_at\": \"2026-08-23T00:46:55.111821897Z\"\n    }\n  ]\n}\nID:       MARATHON-9\nTitle:    DMs: get-or-create DM channel\nStatus:   in_progress\nPriority: 2\nType:     task\nAssignee: backend-dev-1\nOwner:    marathon-harness\nParent:   MARATHON-1\nLabels:   [backend]\n\nDescription:\nPOST /api/dms {user_id} → 200 {channel_id}. Same channel id both directions and on repeated calls. Channel is_dm=true.\n\nDesign (--design):\n## Summary\n\nThis task adds authenticated **get-or-create** for 1:1 direct-message channels: `POST /api/dms` resolves a workspace-scoped DM between the caller and a peer `user_id`, returning the same `channel_id` for both directions and on every repeat call. The channel is persisted as a normal `channels` row with `is_dm=true` (and `is_private=true` for visibility), both users in `channel_members`, so existing channel/message authz (MARATHON-7/8) and the SPA `dms-list` split (MARATHON-16) work without a separate message transport. It does not build group DMs, DM UI, or message posting.\n\n## Technical Approach\n\n### Decision\n\n| Concern | Choice |\n|--------|--------|\n| Route | Top-level `POST /api/dms` (task-mandated), not nested under `/api/workspaces/{slug}` |\n| Request body | `{ \"user_id\", \"workspace_id\" }` — both required UUID strings. Task text abbreviated `{user_id}`; **workspace is mandatory** because every channel row has non-null `workspace_id` (MARATHON-5) and the shell lists DMs per current workspace |\n| Response | Always **200** `{ \"channel_id\": \"<uuid>\" }` (not `201`, not a full `ChannelObj` wrapper) |\n| Pair identity | Canonical unordered pair: `user_lo, user_hi = sorted([caller_id, peer_id])` within a workspace |\n| Dedup without competing for migration v4 | **No new table.** Deterministic synthetic `channels.name` under existing `UNIQUE(workspace_id, name)`: `dm-` + first 29 hex chars of `SHA-256(workspace_id \\|\\| \":\" \\|\\| user_lo \\|\\| \":\" \\|\\| user_hi)` (ASCII, lower hex). Satisfies `CHANNEL_NAME_RE` (`^[a-z0-9-]{2,32}$`). Lookup = `SELECT` by `(workspace_id, name, is_dm=1)` |\n| Flags | Insert with `is_dm=1`, `is_private=1`, `topic=\"\"`, `is_archived=0` |\n| Membership | On create: insert **both** users into `channel_members`. On get (existing row): **ensure** both memberships exist (re-add if a party previously `leave`d) |\n| Package | New `server/dms/` router + thin store orchestration; channel row helpers live in `server/channels/store.py` next to `create_channel` |\n| DM privacy vs workspace owner | **Tighten** read/mutate gates for `is_dm`: channel **membership required**; workspace `owner_id` alone must **not** bypass (diverges from private-channel owner bypass in MARATHON-7 — justified so DMs are not readable by the workspace owner) |\n| List visibility | Keep/adjust `list_channels_for_workspace_user` so DMs never appear to non-members (defense in depth even if `is_private` were wrong) |\n| Migration | **None** for the happy path (avoids collision with MARATHON-8 and MARATHON-12, both designed as **v4**). Optional later `dm_pairs` table is out of scope |\n| Auth | Reuse `get_current_user`; error envelope `{error:{code,message}}` unchanged |\n| Ids / time | UUID4 channel ids; `utc_now_z()` timestamps |\n\n### Alternatives considered\n\n| Alternative | Rejected because |\n|-------------|------------------|\n| Body only `{user_id}` with implicit workspace | Multi-workspace users make the pair ambiguous; channels are workspace-scoped |\n| `POST /api/workspaces/{slug}/dms` | Contradicts task path `POST /api/dms` already reserved by MARATHON-7 out-of-scope |\n| New `dm_pairs` table (migration) | Cleaner join, but **v4 is double-booked** by M8/M12; name-hash uniqueness reuses existing UNIQUE and ships without schema races |\n| Username-based channel `name` for display | Usernames allow `_` and up to 32 chars; fail `CHANNEL_NAME_RE` / length; display is asymmetric per viewer anyway |\n| Return full `{channel: ChannelObj}` | Task mandates `{channel_id}`; client refreshes workspace detail for list rows |\n| Global (non-workspace) DMs | No place in current schema; SPA DMs are per-workspace sidebar |\n\n### Trade-off accepted\n\nOpaque synthetic `ChannelObj.name` for DMs (not a human display label). **MARATHON-17** must render DM sidebar labels from the peer `UserObj` (e.g. via `GET /api/channels/{id}/members` or members already known client-side), not from `name`. Until then, `dms-list` may show the synthetic name — acceptable for this backend-only task.\n\n## Interface Contracts\n\n### Shared conventions (inherited)\n\n- Bearer `Authorization` required → missing/invalid → **401** `unauthorized` (MARATHON-3).\n- Errors: `{ \"error\": { \"code\": \"<code>\", \"message\": \"<human>\" } }` (MARATHON-3/4).\n- Pydantic bodies: `extra=\"ignore\"`; unknown keys ignored.\n- `ChannelObj` keys unchanged: `id`, `workspace_id`, `name`, `is_private`, `is_dm`, `topic`, `is_archived` (MARATHON-5/7).\n- Timestamps UTC `YYYY-MM-DDTHH:MM:SSZ`.\n\n### Seam: Client ↔ `POST /api/dms`\n\n| Side | Responsibility |\n|------|----------------|\n| **Client** (MARATHON-17 / future) | While user picks a peer in the current workspace, `POST /api/dms` with bearer + JSON body. On **200**, store/use `channel_id` (navigate message pane, refresh workspace detail so `dms-list` updates). Disable submit while in flight; do not invent a local channel id. |\n| **Server** | Validate body; authorize workspace membership for caller + peer; get-or-create DM; return `{channel_id}` only. |\n\n**Request**\n\n```http\nPOST /api/dms\nAuthorization: Bearer <token>\nContent-Type: application/json\n```\n\n```json\n{\n  \"user_id\": \"<peer-user-uuid>\",\n  \"workspace_id\": \"<workspace-uuid>\"\n}\n```\n\n| Field | Type | Required | Rules |\n|-------|------|----------|-------|\n| `user_id` | string | yes | Peer user id; must exist; must not equal caller; must be a `workspace_members` row for `workspace_id` |\n| `workspace_id` | string | yes | Existing workspace id; caller must be a member |\n\n**Response 200**\n\n```json\n{ \"channel_id\": \"<uuid>\" }\n```\n\nExact key: `channel_id` only (no `channel` object, no extra fields required).\n\n**Status / error matrix**\n\n| Condition | Status | `code` | Notes |\n|-----------|--------|--------|-------|\n| Success (create or existing) | **200** | — | Same id both directions / repeats |\n| Missing/invalid bearer | **401** | `unauthorized` | |\n| Missing field / wrong type / empty string | **400** | `validation_error` | FastAPI envelope or explicit `ApiError` |\n| `user_id` == caller | **400** | `validation_error` | Message e.g. `cannot dm yourself` |\n| Unknown `workspace_id` or caller not a workspace member | **404** | `not_found` | Message `workspace not found` (no existence leak) |\n| Unknown `user_id` **or** peer not a member of that workspace | **404** | `not_found` | Message `user not found` (do not distinguish “exists globally but not in workspace”) |\n| SQLite busy after timeout | fail closed | — | Same as other routes; no partial membership |\n\n**Not used:** **403** for “peer not in workspace” (prefer 404 to match workspace non-member leak policy). Guests **may** DM other workspace members (no role gate beyond membership).\n\n### Seam: DM channel appearance on `GET /api/workspaces/{slug}`\n\n| Side | Responsibility |\n|------|----------------|\n| **Server** | After create, both members see a `ChannelObj` with `is_dm=true` in `channels` (subject to archive filter). Non-members must **not** see it. |\n| **Client** (MARATHON-16 already) | Split `is_dm === true` → `dms-list`, else → `channel-list`. |\n\n### Seam: Authz tweaks for `is_dm` (server-owned)\n\nFor any existing channel route that today allows **workspace owner without channel membership** on private channels, when `channel.is_dm` is true:\n\n- **Require** `channel_members` row for the caller.\n- If workspace member but not channel member → **403** `forbidden` (same message family as private denial is fine).\n- If not a workspace member → **404** `not_found`.\n\nApplies at least to: channel members list, PATCH topic, GET pins, pin/unpin message, and (when MARATHON-8 lands) message read/write helpers — document for M8 implementer: **DM ⇒ member-only, no owner bypass**.\n\n`POST /api/channels/{id}/join` on a DM remains **403** for non-members (MARATHON-7); get-or-create is the only supported add path.\n\n### Client slow / fail summary\n\n| Condition | Client behavior |\n|-----------|-----------------|\n| In flight | Disable “open DM” control; keep prior `dms-list` |\n| 401 | Re-auth (MARATHON-16) |\n| 400 | Show `error.message`; stay on picker |\n| 404 | Show not-found / peer unavailable; do not add sidebar row |\n| Network / 5xx / timeout | Retry; do not assume channel exists until **200** |\n| 200 | Use `channel_id`; optionally re-fetch workspace detail |\n\n## Data Model\n\n### No new migration (preferred)\n\nUses existing v2 tables:\n\n- `channels` — new rows with `is_dm=1`, `is_private=1`, synthetic `name`, empty `topic`\n- `channel_members` — exactly the two participants (after ensure-membership)\n- `workspaces` / `workspace_members` / `users` — authz only\n\n### Synthetic name algorithm (normative)\n\n```\nuser_lo, user_hi = sorted([caller_id, peer_id])  # lexicographic UUID string order\ndigest = SHA-256( f\"{workspace_id}:{user_lo}:{user_hi}\".encode(\"utf-8\") ).hexdigest()\nname = \"dm-\" + digest[:29]   # length 32; charset [a-z0-9-]\n```\n\nInvariant: name depends only on `(workspace_id, unordered user pair)` — **not** on who called.\n\n### Channel row fields on create\n\n| Field | Value |\n|-------|--------|\n| `id` | new UUID4 |\n| `workspace_id` | from body |\n| `name` | synthetic as above |\n| `is_private` | `1` |\n| `is_dm` | `1` |\n| `topic` | `\"\"` |\n| `is_archived` | `0` |\n| `created_at` / `updated_at` | `utc_now_z()` |\n\n### List-query defense (in scope)\n\nUpdate `list_channels_for_workspace_user` visibility predicate from “public OR member” to:\n\n- visible if **member**, OR\n- visible if **`is_dm=0` AND `is_private=0`** (true public)\n\nEquivalently: `(c.is_dm = 0 AND c.is_private = 0) OR cm.user_id IS NOT NULL`.\n\n### Schema change summary\n\n| Change | Compatible? |\n|--------|-------------|\n| No DDL | **Yes** |\n| List SQL predicate tighten | **Yes** — only hides rows that should not have been visible |\n| DM owner-bypass removal | Behavior change for owners on `is_dm` only |\n\n### Invariants\n\n1. At most one `is_dm` channel per `(workspace_id, unordered user pair)` (enforced by deterministic name + UNIQUE).\n2. `POST .../channels` still forces `is_dm=false` (MARATHON-7).\n3. Get-or-create never creates a second row for the same pair.\n4. After a successful `POST /api/dms`, both users have `channel_members` rows.\n5. `ChannelObj.is_dm === true` for these rows; SPA list split continues to work.\n\n","stderr":"time=2026-08-23T00:59:04.881Z level=INFO msg=\"opened existing embedded fleet-db client\" url=http://127.0.0.1:44829\n","executionTime":342,"interleavedOutput":"Already up to date.\ntime=2026-08-23T00:59:04.881Z level=INFO msg=\"opened existing embedded fleet-db client\" url=http://127.0.0.1:44829\n{\n  \"id\": \"MARATHON-9\",\n  \"title\": \"DMs: get-or-create DM channel\",\n  \"status\": \"in_progress\",\n  \"priority\": 2,\n  \"issue_type\": \"task\",\n  \"assignee\": \"backend-dev-1\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"backend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"design\": \"## Summary\\n\\nThis task adds authenticated **get-or-create** for 1:1 direct-message channels: `POST /api/dms` resolves a workspace-scoped DM between the caller and a peer `user_id`, returning the same `channel_id` for both directions and on every repeat call. The channel is persisted as a normal `channels` row with `is_dm=true` (and `is_private=true` for visibility), both users in `channel_members`, so existing channel/message authz (MARATHON-7/8) and the SPA `dms-list` split (MARATHON-16) work without a separate message transport. It does not build group DMs, DM UI, or message posting.\\n\\n## Technical Approach\\n\\n### Decision\\n\\n| Concern | Choice |\\n|--------|--------|\\n| Route | Top-level `POST /api/dms` (task-mandated), not nested under `/api/workspaces/{slug}` |\\n| Request body | `{ \\\"user_id\\\", \\\"workspace_id\\\" }` — both required UUID strings. Task text abbreviated `{user_id}`; **workspace is mandatory** because every channel row has non-null `workspace_id` (MARATHON-5) and the shell lists DMs per current workspace |\\n| Response | Always **200** `{ \\\"channel_id\\\": \\\"\\u003cuuid\\u003e\\\" }` (not `201`, not a full `ChannelObj` wrapper) |\\n| Pair identity | Canonical unordered pair: `user_lo, user_hi = sorted([caller_id, peer_id])` within a workspace |\\n| Dedup without competing for migration v4 | **No new table.** Deterministic synthetic `channels.name` under existing `UNIQUE(workspace_id, name)`: `dm-` + first 29 hex chars of `SHA-256(workspace_id \\\\|\\\\| \\\":\\\" \\\\|\\\\| user_lo \\\\|\\\\| \\\":\\\" \\\\|\\\\| user_hi)` (ASCII, lower hex). Satisfies `CHANNEL_NAME_RE` (`^[a-z0-9-]{2,32}$`). Lookup = `SELECT` by `(workspace_id, name, is_dm=1)` |\\n| Flags | Insert with `is_dm=1`, `is_private=1`, `topic=\\\"\\\"`, `is_archived=0` |\\n| Membership | On create: insert **both** users into `channel_members`. On get (existing row): **ensure** both memberships exist (re-add if a party previously `leave`d) |\\n| Package | New `server/dms/` router + thin store orchestration; channel row helpers live in `server/channels/store.py` next to `create_channel` |\\n| DM privacy vs workspace owner | **Tighten** read/mutate gates for `is_dm`: channel **membership required**; workspace `owner_id` alone must **not** bypass (diverges from private-channel owner bypass in MARATHON-7 — justified so DMs are not readable by the workspace owner) |\\n| List visibility | Keep/adjust `list_channels_for_workspace_user` so DMs never appear to non-members (defense in depth even if `is_private` were wrong) |\\n| Migration | **None** for the happy path (avoids collision with MARATHON-8 and MARATHON-12, both designed as **v4**). Optional later `dm_pairs` table is out of scope |\\n| Auth | Reuse `get_current_user`; error envelope `{error:{code,message}}` unchanged |\\n| Ids / time | UUID4 channel ids; `utc_now_z()` timestamps |\\n\\n### Alternatives considered\\n\\n| Alternative | Rejected because |\\n|-------------|------------------|\\n| Body only `{user_id}` with implicit workspace | Multi-workspace users make the pair ambiguous; channels are workspace-scoped |\\n| `POST /api/workspaces/{slug}/dms` | Contradicts task path `POST /api/dms` already reserved by MARATHON-7 out-of-scope |\\n| New `dm_pairs` table (migration) | Cleaner join, but **v4 is double-booked** by M8/M12; name-hash uniqueness reuses existing UNIQUE and ships without schema races |\\n| Username-based channel `name` for display | Usernames allow `_` and up to 32 chars; fail `CHANNEL_NAME_RE` / length; display is asymmetric per viewer anyway |\\n| Return full `{channel: ChannelObj}` | Task mandates `{channel_id}`; client refreshes workspace detail for list rows |\\n| Global (non-workspace) DMs | No place in current schema; SPA DMs are per-workspace sidebar |\\n\\n### Trade-off accepted\\n\\nOpaque synthetic `ChannelObj.name` for DMs (not a human display label). **MARATHON-17** must render DM sidebar labels from the peer `UserObj` (e.g. via `GET /api/channels/{id}/members` or members already known client-side), not from `name`. Until then, `dms-list` may show the synthetic name — acceptable for this backend-only task.\\n\\n## Interface Contracts\\n\\n### Shared conventions (inherited)\\n\\n- Bearer `Authorization` required → missing/invalid → **401** `unauthorized` (MARATHON-3).\\n- Errors: `{ \\\"error\\\": { \\\"code\\\": \\\"\\u003ccode\\u003e\\\", \\\"message\\\": \\\"\\u003chuman\\u003e\\\" } }` (MARATHON-3/4).\\n- Pydantic bodies: `extra=\\\"ignore\\\"`; unknown keys ignored.\\n- `ChannelObj` keys unchanged: `id`, `workspace_id`, `name`, `is_private`, `is_dm`, `topic`, `is_archived` (MARATHON-5/7).\\n- Timestamps UTC `YYYY-MM-DDTHH:MM:SSZ`.\\n\\n### Seam: Client ↔ `POST /api/dms`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Client** (MARATHON-17 / future) | While user picks a peer in the current workspace, `POST /api/dms` with bearer + JSON body. On **200**, store/use `channel_id` (navigate message pane, refresh workspace detail so `dms-list` updates). Disable submit while in flight; do not invent a local channel id. |\\n| **Server** | Validate body; authorize workspace membership for caller + peer; get-or-create DM; return `{channel_id}` only. |\\n\\n**Request**\\n\\n```http\\nPOST /api/dms\\nAuthorization: Bearer \\u003ctoken\\u003e\\nContent-Type: application/json\\n```\\n\\n```json\\n{\\n  \\\"user_id\\\": \\\"\\u003cpeer-user-uuid\\u003e\\\",\\n  \\\"workspace_id\\\": \\\"\\u003cworkspace-uuid\\u003e\\\"\\n}\\n```\\n\\n| Field | Type | Required | Rules |\\n|-------|------|----------|-------|\\n| `user_id` | string | yes | Peer user id; must exist; must not equal caller; must be a `workspace_members` row for `workspace_id` |\\n| `workspace_id` | string | yes | Existing workspace id; caller must be a member |\\n\\n**Response 200**\\n\\n```json\\n{ \\\"channel_id\\\": \\\"\\u003cuuid\\u003e\\\" }\\n```\\n\\nExact key: `channel_id` only (no `channel` object, no extra fields required).\\n\\n**Status / error matrix**\\n\\n| Condition | Status | `code` | Notes |\\n|-----------|--------|--------|-------|\\n| Success (create or existing) | **200** | — | Same id both directions / repeats |\\n| Missing/invalid bearer | **401** | `unauthorized` | |\\n| Missing field / wrong type / empty string | **400** | `validation_error` | FastAPI envelope or explicit `ApiError` |\\n| `user_id` == caller | **400** | `validation_error` | Message e.g. `cannot dm yourself` |\\n| Unknown `workspace_id` or caller not a workspace member | **404** | `not_found` | Message `workspace not found` (no existence leak) |\\n| Unknown `user_id` **or** peer not a member of that workspace | **404** | `not_found` | Message `user not found` (do not distinguish “exists globally but not in workspace”) |\\n| SQLite busy after timeout | fail closed | — | Same as other routes; no partial membership |\\n\\n**Not used:** **403** for “peer not in workspace” (prefer 404 to match workspace non-member leak policy). Guests **may** DM other workspace members (no role gate beyond membership).\\n\\n### Seam: DM channel appearance on `GET /api/workspaces/{slug}`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Server** | After create, both members see a `ChannelObj` with `is_dm=true` in `channels` (subject to archive filter). Non-members must **not** see it. |\\n| **Client** (MARATHON-16 already) | Split `is_dm === true` → `dms-list`, else → `channel-list`. |\\n\\n### Seam: Authz tweaks for `is_dm` (server-owned)\\n\\nFor any existing channel route that today allows **workspace owner without channel membership** on private channels, when `channel.is_dm` is true:\\n\\n- **Require** `channel_members` row for the caller.\\n- If workspace member but not channel member → **403** `forbidden` (same message family as private denial is fine).\\n- If not a workspace member → **404** `not_found`.\\n\\nApplies at least to: channel members list, PATCH topic, GET pins, pin/unpin message, and (when MARATHON-8 lands) message read/write helpers — document for M8 implementer: **DM ⇒ member-only, no owner bypass**.\\n\\n`POST /api/channels/{id}/join` on a DM remains **403** for non-members (MARATHON-7); get-or-create is the only supported add path.\\n\\n### Client slow / fail summary\\n\\n| Condition | Client behavior |\\n|-----------|-----------------|\\n| In flight | Disable “open DM” control; keep prior `dms-list` |\\n| 401 | Re-auth (MARATHON-16) |\\n| 400 | Show `error.message`; stay on picker |\\n| 404 | Show not-found / peer unavailable; do not add sidebar row |\\n| Network / 5xx / timeout | Retry; do not assume channel exists until **200** |\\n| 200 | Use `channel_id`; optionally re-fetch workspace detail |\\n\\n## Data Model\\n\\n### No new migration (preferred)\\n\\nUses existing v2 tables:\\n\\n- `channels` — new rows with `is_dm=1`, `is_private=1`, synthetic `name`, empty `topic`\\n- `channel_members` — exactly the two participants (after ensure-membership)\\n- `workspaces` / `workspace_members` / `users` — authz only\\n\\n### Synthetic name algorithm (normative)\\n\\n```\\nuser_lo, user_hi = sorted([caller_id, peer_id])  # lexicographic UUID string order\\ndigest = SHA-256( f\\\"{workspace_id}:{user_lo}:{user_hi}\\\".encode(\\\"utf-8\\\") ).hexdigest()\\nname = \\\"dm-\\\" + digest[:29]   # length 32; charset [a-z0-9-]\\n```\\n\\nInvariant: name depends only on `(workspace_id, unordered user pair)` — **not** on who called.\\n\\n### Channel row fields on create\\n\\n| Field | Value |\\n|-------|--------|\\n| `id` | new UUID4 |\\n| `workspace_id` | from body |\\n| `name` | synthetic as above |\\n| `is_private` | `1` |\\n| `is_dm` | `1` |\\n| `topic` | `\\\"\\\"` |\\n| `is_archived` | `0` |\\n| `created_at` / `updated_at` | `utc_now_z()` |\\n\\n### List-query defense (in scope)\\n\\nUpdate `list_channels_for_workspace_user` visibility predicate from “public OR member” to:\\n\\n- visible if **member**, OR\\n- visible if **`is_dm=0` AND `is_private=0`** (true public)\\n\\nEquivalently: `(c.is_dm = 0 AND c.is_private = 0) OR cm.user_id IS NOT NULL`.\\n\\n### Schema change summary\\n\\n| Change | Compatible? |\\n|--------|-------------|\\n| No DDL | **Yes** |\\n| List SQL predicate tighten | **Yes** — only hides rows that should not have been visible |\\n| DM owner-bypass removal | Behavior change for owners on `is_dm` only |\\n\\n### Invariants\\n\\n1. At most one `is_dm` channel per `(workspace_id, unordered user pair)` (enforced by deterministic name + UNIQUE).\\n2. `POST .../channels` still forces `is_dm=false` (MARATHON-7).\\n3. Get-or-create never creates a second row for the same pair.\\n4. After a successful `POST /api/dms`, both users have `channel_members` rows.\\n5. `ChannelObj.is_dm === true` for these rows; SPA list split continues to work.\\n\\n## Files to Create / Files to Modify\\n\\n### Create\\n\\n| File | Change |\\n|------|--------|\\n| `server/dms/__init__.py` | Package marker / docstring: DM get-or-create owned here |\\n| `server/dms/routes.py` | `APIRouter(prefix=\\\"/api/dms\\\")`; `POST \\\"\\\"` handler; pydantic body; transaction; map errors |\\n| `server/dms/store.py` | `canonical_dm_name(...)`; `get_or_create_dm_channel(conn, *, workspace_id, caller_id, peer_id) -\\u003e channel_id`; peer/workspace checks raising `ApiError` |\\n| `tests/test_dms.py` | Contract tests (see Testing Strategy) |\\n\\n### Modify\\n\\n| File | Change |\\n|------|--------|\\n| `server/app.py` | `include_router` for dms router |\\n| `server/channels/store.py` | Add `create_dm_channel(...)` (bypass public name validation path used by user-created channels **or** validate synthetic name after generation); fix `list_channels_for_workspace_user` predicate for DM/private; optional `find_dm_by_name` |\\n| `server/channels/routes.py` | In `_require_channel_read_access`, pin list, PATCH, leave as needed: **`is_dm` ⇒ membership required** (no owner-only bypass) |\\n| `server/messages/routes.py` | Same DM membership rule in `_require_pin_access` (and document for M8 shared helper) |\\n\\n### Do not touch\\n\\n| File | Reason |\\n|------|--------|\\n| `static/**` | MARATHON-17 owns DM picker UI; M16 list split already correct |\\n| `server/db.py` | No migration in this design |\\n| `server/auth/**`, `server/users/**` | Consume `get_user_by_id` / deps only |\\n| Message CRUD routes | MARATHON-8 |\\n| IRC / WS / Redis | MARATHON-13/14/15 |\\n\\n## Sequencing and Cross-Task Seams\\n\\n### Build order (this task)\\n\\n1. `channels/store.py` — `create_dm_channel` + list predicate.\\n2. `dms/store.py` + `dms/routes.py` + mount in `app.py`.\\n3. Authz tighten for `is_dm` in channel/message routes.\\n4. `tests/test_dms.py` (+ any small assertion updates if list tests assume old predicate).\\n\\n### Parallelism\\n\\n- Independent of MARATHON-8 message CRUD **except** shared DM authz rule (coordinate via this design’s Interface Contracts).\\n- Independent of MARATHON-12 groups/invitations.\\n- MARATHON-17 can stub against this contract once merged.\\n\\n### Cross-task seams\\n\\n| Contract | Owner | Consumer |\\n|----------|-------|----------|\\n| `POST /api/dms` → `{channel_id}` | **MARATHON-9** | MARATHON-17 (DM open), graders |\\n| `ChannelObj.is_dm` + list visibility | MARATHON-5/7 + **this list fix** | MARATHON-16 shell, MARATHON-17 |\\n| DM member-only authz (no owner bypass) | **MARATHON-9** | MARATHON-8 message helpers must match |\\n| Message post in DM channel | MARATHON-8 | Needs channel membership (created here) |\\n| DM display labels / picker UI | MARATHON-17 | Uses `channel_id` + members/profiles |\\n\\n### Declared dependents\\n\\n- MARATHON-17 (SPA channels/DMs UX)\\n- MARATHON-8 (messages in DM channels; authz note)\\n\\n### Follow-up cuts (do not implement here)\\n\\n- Group DMs / multi-user conversations.\\n- `dm_pairs` table if hash-in-name is ever insufficient.\\n- Forbidding archive/leave on DMs.\\n- Client-side peer label rendering.\\n\\n## Out of Scope (Needs a Separate Task)\\n\\n| Item | File / pattern | Why excluded |\\n|------|----------------|--------------|\\n| SPA DM picker / open-DM button / peer label | `static/js/*`, MARATHON-17 | Frontend task; shell already has empty-capable `dms-list` |\\n| Message send/list inside DM | MARATHON-8 | Separate REST surface |\\n| Search / read_state / slash | MARATHON-11 | |\\n| WS fan-out `channel` events | MARATHON-13/14 | |\\n| IRC DM mapping | MARATHON-15 | |\\n| Group DMs | — | Not in task |\\n| Changing private-channel **owner** bypass for non-DM privates | `channels/routes.py` | Keep MARATHON-7 behavior for `is_private \\u0026\\u0026 !is_dm` |\\n| `POST /api/channels` creating `is_dm` | already forbidden | Remains forbidden |\\n| Migration v4/v5 DDL | `server/db.py` | Avoid M8/M12 version collision; name uniqueness sufficient |\\n| `channel-add-member-*` for DMs | SPA hooks | DMs are pair-only via this endpoint |\\n\\n**Neighborhood scan account**\\n\\n| Hit | Disposition |\\n|-----|-------------|\\n| `server/channels/store.py` `is_dm` always false on create; list predicate | **In scope** — DM create helper + list fix |\\n| `server/channels/routes.py` private/DM treated alike; owner bypass | **In scope** — DM membership tighten |\\n| `server/messages/routes.py` private/DM pin authz | **In scope** — same DM rule |\\n| `server/db.py` `is_dm` column | **Unchanged** |\\n| `static/js/shell.js` `dms-list` / `is_dm` split | **Out of scope** — already correct |\\n| `tests/test_channels.py` `is_dm is False` on normal create | **Out of scope** — keep; add `test_dms.py` |\\n| `tests/test_spa_shell.py` / `test_workspaces.py` `is_dm` assertions | **Out of scope** unless list predicate breaks a fixture |\\n| Grep: no `/api/dms` router yet | Greenfield `server/dms` |\\n| MARATHON-7/8/16 designs reserving `POST /api/dms` | **This task** |\\n\\n## Edge Cases \\u0026 Error Handling\\n\\n| Situation | Expected behavior |\\n|-----------|-------------------|\\n| A→B then B→A | Same `channel_id` |\\n| Repeat A→B | Same `channel_id`; **200**; no second row |\\n| Concurrent A→B and B→A | One INSERT wins; loser hits UNIQUE/`IntegrityError` on `(workspace_id,name)` → re-SELECT by name → return existing id (no **500**) |\\n| Caller left DM earlier | Ensure re-INSERT `channel_members` for caller (and peer if missing); return same id |\\n| Peer left DM earlier | Same ensure-both-memberships |\\n| Self `user_id` | **400** `validation_error` |\\n| Peer not in workspace | **404** `user not found` |\\n| Caller not in workspace | **404** `workspace not found` |\\n| Archived DM exists | Still return its `channel_id` (do not create replacement). Messaging may **423** via existing guard (MARATHON-7/8) |\\n| Workspace owner not in DM opens channel routes | **403** (member of ws) / **404** (stranger) — **not** owner bypass |\\n| Guest DMs a member | **200** if both are workspace members |\\n| Extra body keys | Ignored |\\n| `workspace_id` is a slug string | **404** (id lookup fails) — clients must send UUID `workspace.id` |\\n| User creates public channel whose name collides with a DM hash | Astronomically unlikely; if IntegrityError on DM insert and re-read finds non-`is_dm` row → **409** `conflict` with clear message (abort; do not hijack) |\\n| Unauthenticated | **401** |\\n\\n## Acceptance Criteria\\n\\n1. Authenticated `POST /api/dms` with `{user_id, workspace_id}` for two distinct workspace members → **200** `{ \\\"channel_id\\\": \\\"\\u003cuuid\\u003e\\\" }`.\\n2. Calling again with the same pair (same caller) → **200** with **identical** `channel_id`.\\n3. Peer calling with the caller’s id (swapped direction) → **200** with the **same** `channel_id`.\\n4. `GET /api/workspaces/{slug}` as either participant includes a channel with that id where `is_dm === true` (and typically `is_private === true`).\\n5. A third workspace member’s workspace detail must **NOT** include that DM channel.\\n6. Persisted row has `is_dm=1` (verify via API list/detail or DB in tests).\\n7. Self-DM → **400** `validation_error`; must **NOT** create a channel.\\n8. Unknown peer id → **404**; must **NOT** create a channel.\\n9. Peer registered globally but not in workspace → **404**; must **NOT** create a channel.\\n10. Caller not in workspace → **404**.\\n11. Unauthenticated → **401**.\\n12. After participant `POST /api/channels/{id}/leave`, a subsequent `POST /api/dms` for the same pair returns the **same** `channel_id` and restores membership (subsequent channel member list / message write authz succeeds for that user).\\n13. Workspace owner who is **not** a DM member must **NOT** read DM pins/members via owner bypass (**403** or **404** per rules above).\\n14. Negative: `POST /api/workspaces/{slug}/channels` still cannot create `is_dm=true` channels.\\n15. Negative: response must **NOT** require a `channel` object key for success (only `channel_id`).\\n\\n## Testing Strategy\\n\\n### Automated (`tests/test_dms.py`)\\n\\n- Happy path create + idempotent repeat + reverse direction same id.\\n- Both users see DM on workspace detail; third member does not.\\n- Self / missing peer / non-member peer / non-member caller / unauthenticated.\\n- Leave then get-or-create restores membership.\\n- Owner-without-membership denied on `GET /api/channels/{id}/members` (or pins) for the DM.\\n- Optional: concurrent create smoke (two threads) still yields one row.\\n- Regression: existing `tests/test_channels.py` / `test_workspaces.py` stay green.\\n\\n### Manual / cluster\\n\\n1. Register users A,B,C; create workspace; add B and C as members.\\n2. On `:8000`, A `POST /api/dms` with B → note `channel_id`.\\n3. On `:8001`, B `POST /api/dms` with A → same id (shared SQLite).\\n4. A and B `GET` workspace detail → DM present; C’s detail → absent.\\n5. Confirm `is_dm` true in listed channel object.\\n\\n### Human verify\\n\\n- No SPA change required; `curl`/httpie against any node with bearer token is enough for this task.\",\n  \"design_format\": \"markdown\",\n  \"has_design\": true,\n  \"notes\": \"Design complete for POST /api/dms get-or-create. Key decisions: body requires user_id+workspace_id (workspace-scoped channels); always 200 {channel_id}; dedupe via deterministic dm- name hash (no migration — avoids M8/M12 v4 clash); is_dm+is_private; ensure both memberships; tighten DM authz to members-only (no workspace-owner bypass). Handed to review; implementer label remains backend.\",\n  \"created_at\": \"2026-08-22T22:17:16.921652889Z\",\n  \"updated_at\": \"2026-08-23T00:46:55.100701683Z\",\n  \"created_by\": \"marathon-harness\",\n  \"description\": \"POST /api/dms {user_id} → 200 {channel_id}. Same channel id both directions and on repeated calls. Channel is_dm=true.\",\n  \"comments\": [\n    {\n      \"id\": 43,\n      \"issue_id\": \"MARATHON-9\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"DESIGN-AUTO-APPROVED pass=23\",\n      \"created_at\": \"2026-08-23T00:46:55.111821897Z\"\n    }\n  ]\n}\nID:       MARATHON-9\nTitle:    DMs: get-or-create DM channel\nStatus:   in_progress\nPriority: 2\nType:     task\nAssignee: backend-dev-1\nOwner:    marathon-harness\nParent:   MARATHON-1\nLabels:   [backend]\n\nDescription:\nPOST /api/dms {user_id} → 200 {channel_id}. Same channel id both directions and on repeated calls. Channel is_dm=true.\n\nDesign (--design):\n## Summary\n\nThis task adds authenticated **get-or-create** for 1:1 direct-message channels: `POST /api/dms` resolves a workspace-scoped DM between the caller and a peer `user_id`, returning the same `channel_id` for both directions and on every repeat call. The channel is persisted as a normal `channels` row with `is_dm=true` (and `is_private=true` for visibility), both users in `channel_members`, so existing channel/message authz (MARATHON-7/8) and the SPA `dms-list` split (MARATHON-16) work without a separate message transport. It does not build group DMs, DM UI, or message posting.\n\n## Technical Approach\n\n### Decision\n\n| Concern | Choice |\n|--------|--------|\n| Route | Top-level `POST /api/dms` (task-mandated), not nested under `/api/workspaces/{slug}` |\n| Request body | `{ \"user_id\", \"workspace_id\" }` — both required UUID strings. Task text abbreviated `{user_id}`; **workspace is mandatory** because every channel row has non-null `workspace_id` (MARATHON-5) and the shell lists DMs per current workspace |\n| Response | Always **200** `{ \"channel_id\": \"<uuid>\" }` (not `201`, not a full `ChannelObj` wrapper) |\n| Pair identity | Canonical unordered pair: `user_lo, user_hi = sorted([caller_id, peer_id])` within a workspace |\n| Dedup without competing for migration v4 | **No new table.** Deterministic synthetic `channels.name` under existing `UNIQUE(workspace_id, name)`: `dm-` + first 29 hex chars of `SHA-256(workspace_id \\|\\| \":\" \\|\\| user_lo \\|\\| \":\" \\|\\| user_hi)` (ASCII, lower hex). Satisfies `CHANNEL_NAME_RE` (`^[a-z0-9-]{2,32}$`). Lookup = `SELECT` by `(workspace_id, name, is_dm=1)` |\n| Flags | Insert with `is_dm=1`, `is_private=1`, `topic=\"\"`, `is_archived=0` |\n| Membership | On create: insert **both** users into `channel_members`. On get (existing row): **ensure** both memberships exist (re-add if a party previously `leave`d) |\n| Package | New `server/dms/` router + thin store orchestration; channel row helpers live in `server/channels/store.py` next to `create_channel` |\n| DM privacy vs workspace owner | **Tighten** read/mutate gates for `is_dm`: channel **membership required**; workspace `owner_id` alone must **not** bypass (diverges from private-channel owner bypass in MARATHON-7 — justified so DMs are not readable by the workspace owner) |\n| List visibility | Keep/adjust `list_channels_for_workspace_user` so DMs never appear to non-members (defense in depth even if `is_private` were wrong) |\n| Migration | **None** for the happy path (avoids collision with MARATHON-8 and MARATHON-12, both designed as **v4**). Optional later `dm_pairs` table is out of scope |\n| Auth | Reuse `get_current_user`; error envelope `{error:{code,message}}` unchanged |\n| Ids / time | UUID4 channel ids; `utc_now_z()` timestamps |\n\n### Alternatives considered\n\n| Alternative | Rejected because |\n|-------------|------------------|\n| Body only `{user_id}` with implicit workspace | Multi-workspace users make the pair ambiguous; channels are workspace-scoped |\n| `POST /api/workspaces/{slug}/dms` | Contradicts task path `POST /api/dms` already reserved by MARATHON-7 out-of-scope |\n| New `dm_pairs` table (migration) | Cleaner join, but **v4 is double-booked** by M8/M12; name-hash uniqueness reuses existing UNIQUE and ships without schema races |\n| Username-based channel `name` for display | Usernames allow `_` and up to 32 chars; fail `CHANNEL_NAME_RE` / length; display is asymmetric per viewer anyway |\n| Return full `{channel: ChannelObj}` | Task mandates `{channel_id}`; client refreshes workspace detail for list rows |\n| Global (non-workspace) DMs | No place in current schema; SPA DMs are per-workspace sidebar |\n\n### Trade-off accepted\n\nOpaque synthetic `ChannelObj.name` for DMs (not a human display label). **MARATHON-17** must render DM sidebar labels from the peer `UserObj` (e.g. via `GET /api/channels/{id}/members` or members already known client-side), not from `name`. Until then, `dms-list` may show the synthetic name — acceptable for this backend-only task.\n\n## Interface Contracts\n\n### Shared conventions (inherited)\n\n- Bearer `Authorization` required → missing/invalid → **401** `unauthorized` (MARATHON-3).\n- Errors: `{ \"error\": { \"code\": \"<code>\", \"message\": \"<human>\" } }` (MARATHON-3/4).\n- Pydantic bodies: `extra=\"ignore\"`; unknown keys ignored.\n- `ChannelObj` keys unchanged: `id`, `workspace_id`, `name`, `is_private`, `is_dm`, `topic`, `is_archived` (MARATHON-5/7).\n- Timestamps UTC `YYYY-MM-DDTHH:MM:SSZ`.\n\n### Seam: Client ↔ `POST /api/dms`\n\n| Side | Responsibility |\n|------|----------------|\n| **Client** (MARATHON-17 / future) | While user picks a peer in the current workspace, `POST /api/dms` with bearer + JSON body. On **200**, store/use `channel_id` (navigate message pane, refresh workspace detail so `dms-list` updates). Disable submit while in flight; do not invent a local channel id. |\n| **Server** | Validate body; authorize workspace membership for caller + peer; get-or-create DM; return `{channel_id}` only. |\n\n**Request**\n\n```http\nPOST /api/dms\nAuthorization: Bearer <token>\nContent-Type: application/json\n```\n\n```json\n{\n  \"user_id\": \"<peer-user-uuid>\",\n  \"workspace_id\": \"<workspace-uuid>\"\n}\n```\n\n| Field | Type | Required | Rules |\n|-------|------|----------|-------|\n| `user_id` | string | yes | Peer user id; must exist; must not equal caller; must be a `workspace_members` row for `workspace_id` |\n| `workspace_id` | string | yes | Existing workspace id; caller must be a member |\n\n**Response 200**\n\n```json\n{ \"channel_id\": \"<uuid>\" }\n```\n\nExact key: `channel_id` only (no `channel` object, no extra fields required).\n\n**Status / error matrix**\n\n| Condition | Status | `code` | Notes |\n|-----------|--------|--------|-------|\n| Success (create or existing) | **200** | — | Same id both directions / repeats |\n| Missing/invalid bearer | **401** | `unauthorized` | |\n| Missing field / wrong type / empty string | **400** | `validation_error` | FastAPI envelope or explicit `ApiError` |\n| `user_id` == caller | **400** | `validation_error` | Message e.g. `cannot dm yourself` |\n| Unknown `workspace_id` or caller not a workspace member | **404** | `not_found` | Message `workspace not found` (no existence leak) |\n| Unknown `user_id` **or** peer not a member of that workspace | **404** | `not_found` | Message `user not found` (do not distinguish “exists globally but not in workspace”) |\n| SQLite busy after timeout | fail closed | — | Same as other routes; no partial membership |\n\n**Not used:** **403** for “peer not in workspace” (prefer 404 to match workspace non-member leak policy). Guests **may** DM other workspace members (no role gate beyond membership).\n\n### Seam: DM channel appearance on `GET /api/workspaces/{slug}`\n\n| Side | Responsibility |\n|------|----------------|\n| **Server** | After create, both members see a `ChannelObj` with `is_dm=true` in `channels` (subject to archive filter). Non-members must **not** see it. |\n| **Client** (MARATHON-16 already) | Split `is_dm === true` → `dms-list`, else → `channel-list`. |\n\n### Seam: Authz tweaks for `is_dm` (server-owned)\n\nFor any existing channel route that today allows **workspace owner without channel membership** on private channels, when `channel.is_dm` is true:\n\n- **Require** `channel_members` row for the caller.\n- If workspace member but not channel member → **403** `forbidden` (same message family as private denial is fine).\n- If not a workspace member → **404** `not_found`.\n\nApplies at least to: channel members list, PATCH topic, GET pins, pin/unpin message, and (when MARATHON-8 lands) message read/write helpers — document for M8 implementer: **DM ⇒ member-only, no owner bypass**.\n\n`POST /api/channels/{id}/join` on a DM remains **403** for non-members (MARATHON-7); get-or-create is the only supported add path.\n\n### Client slow / fail summary\n\n| Condition | Client behavior |\n|-----------|-----------------|\n| In flight | Disable “open DM” control; keep prior `dms-list` |\n| 401 | Re-auth (MARATHON-16) |\n| 400 | Show `error.message`; stay on picker |\n| 404 | Show not-found / peer unavailable; do not add sidebar row |\n| Network / 5xx / timeout | Retry; do not assume channel exists until **200** |\n| 200 | Use `channel_id`; optionally re-fetch workspace detail |\n\n## Data Model\n\n### No new migration (preferred)\n\nUses existing v2 tables:\n\n- `channels` — new rows with `is_dm=1`, `is_private=1`, synthetic `name`, empty `topic`\n- `channel_members` — exactly the two participants (after ensure-membership)\n- `workspaces` / `workspace_members` / `users` — authz only\n\n### Synthetic name algorithm (normative)\n\n```\nuser_lo, user_hi = sorted([caller_id, peer_id])  # lexicographic UUID string order\ndigest = SHA-256( f\"{workspace_id}:{user_lo}:{user_hi}\".encode(\"utf-8\") ).hexdigest()\nname = \"dm-\" + digest[:29]   # length 32; charset [a-z0-9-]\n```\n\nInvariant: name depends only on `(workspace_id, unordered user pair)` — **not** on who called.\n\n### Channel row fields on create\n\n| Field | Value |\n|-------|--------|\n| `id` | new UUID4 |\n| `workspace_id` | from body |\n| `name` | synthetic as above |\n| `is_private` | `1` |\n| `is_dm` | `1` |\n| `topic` | `\"\"` |\n| `is_archived` | `0` |\n| `created_at` / `updated_at` | `utc_now_z()` |\n\n### List-query defense (in scope)\n\nUpdate `list_channels_for_workspace_user` visibility predicate from “public OR member” to:\n\n- visible if **member**, OR\n- visible if **`is_dm=0` AND `is_private=0`** (true public)\n\nEquivalently: `(c.is_dm = 0 AND c.is_private = 0) OR cm.user_id IS NOT NULL`.\n\n### Schema change summary\n\n| Change | Compatible? |\n|--------|-------------|\n| No DDL | **Yes** |\n| List SQL predicate tighten | **Yes** — only hides rows that should not have been visible |\n| DM owner-bypass removal | Behavior change for owners on `is_dm` only |\n\n### Invariants\n\n1. At most one `is_dm` channel per `(workspace_id, unordered user pair)` (enforced by deterministic name + UNIQUE).\n2. `POST .../channels` still forces `is_dm=false` (MARATHON-7).\n3. Get-or-create never creates a second row for the same pair.\n4. After a successful `POST /api/dms`, both users have `channel_members` rows.\n5. `ChannelObj.is_dm === true` for these rows; SPA list split continues to work.\n\n","localExecutionTimeMs":54},"isBackground":false},"description":"Merge main and show task details"},"hookAdditionalContexts":[],"toolCallId":"call-95bfa5da-5cca-419f-9185-a3c0e47b8546-0\nfc_bcbb95b3-1601-9cfa-a6ad-7ded72939036_0","startedAtMs":"1787446744587","completedAtMs":"1787446744929"},"model_call_id":"8e476999-2b8c-4e02-939d-1221ca0eaa72-0-o3dt","session_id":"aec3e14e-ecc5-40d6-b9d9-d0b4accedb3f","timestamp_ms":1787446744954}
