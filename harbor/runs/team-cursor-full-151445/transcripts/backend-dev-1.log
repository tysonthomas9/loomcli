stable ids, UTC timestamps. UI: stable data-testid/selectors for CUA/Playwright at 1280x900.\",\n  \"dependents\": [\n    {\n      \"issue_id\": \"MARATHON-10\",\n      \"depends_on_id\": \"MARATHON-1\",\n      \"type\": \"parent-child\",\n      \"title\": \"Files: upload, metadata, download, attach\",\n      \"status\": \"open\",\n      \"priority\": 2,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T22:17:16.937791398Z\",\n      \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-11\",\n      \"depends_on_id\": \"MARATHON-1\",\n      \"type\": \"parent-child\",\n      \"title\": \"Search, slash commands, mentions, read state\",\n      \"status\": \"open\",\n      \"priority\": 1,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T22:17:16.95794646Z\",\n      \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-12\",\n      \"depends_on_id\": \"MARATHON-1\",\n      \"type\": \"parent-child\",\n      \"title\": \"User groups and workspace invitations\",\n      \"status\": \"review\",\n      \"priority\": 1,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T22:17:16.983999583Z\",\n      \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-13\",\n      \"depends_on_id\": \"MARATHON-1\",\n      \"type\": \"parent-child\",\n      \"title\": \"WebSocket subscribe/resume and dense channel seq\",\n      \"status\": \"open\",\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T22:17:29.968254993Z\",\n      \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-14\",\n      \"depends_on_id\": \"MARATHON-1\",\n      \"type\": \"parent-child\",\n      \"title\": \"Cross-node fan-out and Redis-outage resilience\",\n      \"status\": \"open\",\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T22:17:29.988892308Z\",\n      \"created_by\": \"marathon-harness\"\n    },