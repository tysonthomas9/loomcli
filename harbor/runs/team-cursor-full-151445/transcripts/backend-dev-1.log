{"type":"tool_call","subtype":"started","call_id":"call-03f2577b-a068-448c-bb62-a99abbbe0485-46\nfc_b71d8671-5cb2-9da6-914f-3a01b9c908be_0","tool_call":{"editToolCall":{"args":{"path":"/work/ws/worktrees/app/backend-dev-1/server/events.py","streamContent":"\"\"\"Durable channel events, dense seq, and local WebSocket delivery (MARATHON-13).\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport sqlite3\nfrom typing import Any\n\nfrom server.db import utc_now_z\n\nlogger = logging.getLogger(__name__)\n\nCHANNEL_EVENT_RETAIN = 10_000\n\n\ndef get_head_seq(conn: sqlite3.Connection, channel_id: str) -> int:\n    \"\"\"Current dense head for channel (0 if no events yet).\"\"\"\n    row = conn.execute(\n        \"SELECT head_seq FROM channel_seq WHERE channel_id = ?\",\n        (channel_id,),\n    ).fetchone()\n    if row is None:\n        return 0\n    return int(row[\"head_seq\"])\n\n\ndef get_tail_seq(conn: sqlite3.Connection, channel_id: str) -> int | None:\n    \"\"\"Minimum retained seq for channel, or None when head is 0.\"\"\"\n    head = get_head_seq(conn, channel_id)\n    if head == 0:\n        return None\n    row = conn.execute(\n        \"SELECT MIN(seq) AS tail FROM channel_events WHERE channel_id = ?\",\n        (channel_id,),\n    ).fetchone()\n    if row is None or row[\"tail\"] is None:\n        return 1\n    return int(row[\"tail\"])\n\n\ndef list_events_after(\n    conn: sqlite3.Connection, *, channel_id: str, since_seq: int, head_seq: int\n) -> list[dict[str, Any]]:\n    \"\"\"Load wire frames with seq in (since_seq, head_seq], ascending.\"\"\"\n    rows = conn.execute(\n        \"\"\"\n        SELECT channel_id, seq, type, payload_json\n        FROM channel_events\n        WHERE channel_id = ? AND seq > ? AND seq <= ?\n        ORDER BY seq ASC\n        \"\"\",\n        (channel_id, since_seq, head_seq),\n    ).fetchall()\n    frames: list[dict[str, Any]] = []\n    for row in rows:\n        payload = json.loads(row[\"payload_json\"])\n        frame: dict[str, Any] = {\n            \"type\": row[\"type\"],\n            \"seq\": int(row[\"seq\"]),\n            \"channel_id\": row[\"channel_id\"],\n        }\n        frame.update(payload)\n        frames.append(frame)\n    return frames\n\n\ndef append_channel_event(\n    conn: sqlite3.Connection,\n    *,\n    channel_id: str,\n    event_type: str,\n    payload: dict[str, Any],\n) -> dict[str, Any]:\n    \"\"\"Allocate next dense seq, insert log row, prune; return wire frame.\n\n    Must run inside the same write transaction as the mutation.\n    \"\"\"\n    conn.execute(\n        \"\"\"\n        INSERT INTO channel_seq (channel_id, head_seq)\n        VALUES (?, 1)\n        ON CONFLICT(channel_id) DO UPDATE SET\n            head_seq = head_seq + 1\n        \"\"\",\n        (channel_id,),\n    )\n    row = conn.execute(\n        \"SELECT head_seq FROM channel_seq WHERE channel_id = ?\",\n        (channel_id,),\n    ).fetchone()\n    assert row is not None\n    seq = int(row[\"head_seq\"])\n    now = utc_now_z()\n    conn.execute(\n        \"\"\"\n        INSERT INTO channel_events (channel_id, seq, type, payload_json, created_at)\n        VALUES (?, ?, ?, ?, ?)\n        \"\"\",\n        (channel_id, seq, event_type, json.dumps(payload, separators=(\",\", \":\")), now),\n    )\n    # Retain last CHANNEL_EVENT_RETAIN events: prune seq < head - RETAIN + 1.\n    if seq > CHANNEL_EVENT_RETAIN:\n        cutoff = seq - CHANNEL_EVENT_RETAIN + 1\n        conn.execute(\n            \"DELETE FROM channel_events WHERE channel_id = ? AND seq < ?\",\n            (channel_id, cutoff),\n        )\n    frame: dict[str, Any] = {\n        \"type\": event_type,\n        \"seq\": seq,\n        \"channel_id\": channel_id,\n    }\n    frame.update(payload)\n    return frame\n\n\ndef deliver(frame: dict[str, Any]) -> None:\n    \"\"\"Post-commit local hub delivery. Never raises. Redis hook is a no-op (M14).\"\"\"\n    try:\n        _deliver_local(frame)\n        _redis_publish_stub(frame)\n    except Exception:\n        logger.exception(\"events.deliver failed\")\n\n\ndef _deliver_local(frame: dict[str, Any]) -> None:\n    from server.ws.hub import hub\n\n    if frame.get(\"type\") == \"user.updated\":\n        hub.broadcast_global(frame)\n        return\n    channel_id = frame.get(\"channel_id\")\n    if isinstance(channel_id, str) and channel_id:\n        hub.broadcast_channel(channel_id, frame)\n\n\ndef _redis_publish_stub(_frame: dict[str, Any]) -> None:\n    \"\"\"Placeholder for MARATHON-14 Redis pub/sub fan-out.\"\"\"\n    return None\n\n\ndef publish_user_updated(user: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Build channel-less profile frame (no seq). Caller delivers after commit.\"\"\"\n    return {\"type\": \"user.updated\", \"user\": user}\n\n\ndef publish_message_created(\n    conn: sqlite3.Connection, *, channel_id: str, message: dict[str, Any]\n) -> dict[str, Any]:\n    \"\"\"Append message.created inside the open write transaction.\"\"\"\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"message.created\",\n        payload={\"message\": message},\n    )\n\n\ndef publish_message_updated(\n    conn: sqlite3.Connection, *, channel_id: str, message: dict[str, Any]\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"message.updated\",\n        payload={\"message\": message},\n    )\n\n\ndef publish_message_deleted(\n    conn: sqlite3.Connection, *, channel_id: str, message_id: str\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"message.deleted\",\n        payload={\"message_id\": message_id},\n    )\n\n\ndef publish_reaction_changed(\n    conn: sqlite3.Connection,\n    *,\n    channel_id: str,\n    message_id: str,\n    reactions: list[dict[str, Any]],\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"reaction.changed\",\n        payload={\"message_id\": message_id, \"reactions\": reactions},\n    )\n\n\ndef publish_membership_joined(\n    conn: sqlite3.Connection, *, channel_id: str, user: dict[str, Any]\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"membership.joined\",\n        payload={\"user\": user},\n    )\n\n\ndef publish_membership_left(\n    conn: sqlite3.Connection, *, channel_id: str, user_id: str\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"membership.left\",\n        payload={\"user_id\": user_id},\n    )\n\n\ndef publish_channel_created(\n    conn: sqlite3.Connection, *, channel: dict[str, Any]\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel[\"id\"],\n        event_type=\"channel.created\",\n        payload={\"channel\": channel},\n    )\n\n\ndef publish_channel_updated(\n    conn: sqlite3.Connection, *, channel: dict[str, Any]\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel[\"id\"],\n        event_type=\"channel.updated\",\n        payload={\"channel\": channel},\n    )\n\n\ndef publish_channel_archived(\n    conn: sqlite3.Connection, *, channel: dict[str, Any]\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel[\"id\"],\n        event_type=\"channel.archived\",\n        payload={\"channel\": channel},\n    )\n\n\ndef publish_channel_unarchived(\n    conn: sqlite3.Connection, *, channel: dict[str, Any]\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel[\"id\"],\n        event_type=\"channel.unarchived\",\n        payload={\"channel\": channel},\n    )\n\n\ndef publish_channel_pin_added(\n    conn: sqlite3.Connection,\n    *,\n    channel_id: str,\n    message_id: str,\n    pinned_by: str,\n    pinned_at: str,\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"channel.pin_added\",\n        payload={\n            \"message_id\": message_id,\n            \"pinned_by\": pinned_by,\n            \"pinned_at\": pinned_at,\n        },\n    )\n\n\ndef publish_channel_pin_removed(\n    conn: sqlite3.Connection, *, channel_id: str, message_id: str\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"channel.pin_removed\",\n        payload={\"message_id\": message_id},\n    )\n"}},"hookAdditionalContexts":[],"toolCallId":"call-03f2577b-a068-448c-bb62-a99abbbe0485-46\nfc_b71d8671-5cb2-9da6-914f-3a01b9c908be_0","startedAtMs":"1787448862188"},"model_call_id":"6def408b-6104-44a9-a526-9810f97b5511-11-ogak","session_id":"b76c730e-983d-4b18-9e06-1d6745c005de","timestamp_ms":1787448888466}
{"type":"tool_call","subtype":"started","call_id":"call-03f2577b-a068-448c-bb62-a99abbbe0485-47\nfc_b71d8671-5cb2-9da6-914f-3a01b9c908be_1","tool_call":{"editToolCall":{"args":{"path":"/work/ws/worktrees/app/backend-dev-1/server/ws/routes.py","streamContent":"\"\"\"Authenticated WebSocket: subscribe / resume / live frames (MARATHON-13).\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport json\nimport logging\nfrom typing import Any\n\nfrom fastapi import APIRouter, WebSocket, WebSocketDisconnect\nfrom starlette.websockets import WebSocketState\n\nfrom server import db, events\nfrom server.auth import tokens, users\nfrom server.channels import store as channels_store\nfrom server.errors import ApiError\nfrom server.messages import store as messages_store\nfrom server.settings import Settings\nfrom server.ws.hub import WsConnection, hub\n\nlogger = logging.getLogger(__name__)\n\nrouter = APIRouter(tags=[\"ws\"])\n\n\ndef _settings(websocket: WebSocket) -> Settings:\n    return websocket.app.state.settings\n\n\nasync def _reject_unauthorized(websocket: WebSocket) -> None:\n    \"\"\"Reject upgrade: prefer close 4401 without application frames.\"\"\"\n    try:\n        if websocket.client_state == WebSocketState.CONNECTING:\n            await websocket.close(code=4401, reason=\"unauthorized\")\n        elif websocket.client_state == WebSocketState.CONNECTED:\n            await websocket.close(code=4401, reason=\"unauthorized\")\n    except Exception:\n        logger.debug(\"ws unauthorized close failed\", exc_info=True)\n\n\nasync def _send_json(websocket: WebSocket, payload: dict[str, Any]) -> None:\n    await websocket.send_text(json.dumps(payload, separators=(\",\", \":\")))\n\n\nasync def _send_error(\n    websocket: WebSocket, *, code: str, message: str\n) -> None:\n    await _send_json(\n        websocket, {\"type\": \"error\", \"code\": code, \"message\": message}\n    )\n\n\ndef _resolve_user(settings: Settings, raw_token: str | None) -> dict[str, Any] | None:\n    if raw_token is None:\n        return None\n    token = raw_token.strip() if isinstance(raw_token, str) else \"\"\n    if not token or any(ch.isspace() for ch in raw_token):\n        # Whitespace anywhere in the raw token is invalid (same as bearer).\n        return None\n    conn = db.connect(settings.sqlite_path)\n    try:\n        user_id = tokens.resolve_user_id(conn, token)\n        if user_id is None:\n            return None\n        return users.get_user_by_id(conn, user_id)\n    finally:\n        conn.close()\n\n\ndef _authorize_channel_read(\n    settings: Settings, *, channel_id: str, user_id: str\n) -> None:\n    \"\"\"Raise ApiError with same codes as message/pin read.\"\"\"\n    conn = db.connect(settings.sqlite_path)\n    try:\n        channel = channels_store.get_channel(conn, channel_id)\n        if channel is None:\n            raise ApiError(404, \"not_found\", \"channel not found\")\n        messages_store.require_channel_message_read(\n            conn, channel=channel, user_id=user_id\n        )\n    finally:\n        conn.close()\n\n\n@router.websocket(\"/api/ws\")\nasync def websocket_endpoint(websocket: WebSocket) -> None:\n    settings = _settings(websocket)\n    raw_token = websocket.query_params.get(\"token\")\n    user = _resolve_user(settings, raw_token)\n    if user is None:\n        await _reject_unauthorized(websocket)\n        return\n\n    await websocket.accept()\n    loop = asyncio.get_running_loop()\n    conn = WsConnection(websocket=websocket, user_id=user[\"id\"], loop=loop)\n    hub.register(conn)\n\n    sender = asyncio.create_task(_outbound_loop(conn))\n    try:\n        while True:\n            message = await websocket.receive()\n            if message.get(\"type\") == \"websocket.disconnect\":\n                break\n            if \"bytes\" in message and message[\"bytes\"] is not None:\n                # Binary frames ignored (no error).\n                continue\n            text = message.get(\"text\")\n            if text is None:\n                continue\n            await _handle_client_text(conn, settings, text)\n    except WebSocketDisconnect:\n        pass\n    except Exception:\n        logger.exception(\"ws connection error\")\n    finally:\n        hub.unregister(conn)\n        sender.cancel()\n        try:\n            await sender\n        except asyncio.CancelledError:\n            pass\n        try:\n            if websocket.client_state == WebSocketState.CONNECTED:\n                await websocket.close()\n        except Exception:\n            pass\n\n\nasync def _outbound_loop(conn: WsConnection) -> None:\n    while True:\n        frame = await conn.queue.get()\n        if frame is None:\n            return\n        try:\n            await _send_json(conn.websocket, frame)\n        except Exception:\n            return\n\n\nasync def _handle_client_text(\n    conn: WsConnection, settings: Settings, text: str\n) -> None:\n    try:\n        data = json.loads(text)\n    except json.JSONDecodeError:\n        await _send_error(\n            conn.websocket, code=\"validation_error\", message=\"invalid json\"\n        )\n        return\n    if not isinstance(data, dict):\n        await _send_error(\n            conn.websocket, code=\"validation_error\", message=\"invalid json\"\n        )\n        return\n\n    msg_type = data.get(\"type\")\n    if msg_type == \"subscribe\":\n        await _handle_subscribe(conn, settings, data)\n    elif msg_type == \"resume\":\n        await _handle_resume(conn, settings, data)\n    else:\n        await _send_error(\n            conn.websocket, code=\"validation_error\", message=\"unknown type\"\n        )\n\n\nasync def _handle_subscribe(\n    conn: WsConnection, settings: Settings, data: dict[str, Any]\n) -> None:\n    channel_id = data.get(\"channel_id\")\n    if not isinstance(channel_id, str) or not channel_id:\n        await _send_error(\n            conn.websocket,\n            code=\"validation_error\",\n            message=\"channel_id is required\",\n        )\n        return\n    try:\n        _authorize_channel_read(\n            settings, channel_id=channel_id, user_id=conn.user_id\n        )\n    except ApiError as exc:\n        await _send_error(conn.websocket, code=exc.code, message=exc.message)\n        return\n\n    db_conn = db.connect(settings.sqlite_path)\n    try:\n        head = events.get_head_seq(db_conn, channel_id)\n    finally:\n        db_conn.close()\n\n    hub.subscribe(conn, channel_id)\n    await _send_json(\n        conn.websocket,\n        {\"type\": \"subscribed\", \"channel_id\": channel_id, \"head_seq\": head},\n    )\n\n\nasync def _handle_resume(\n    conn: WsConnection, settings: Settings, data: dict[str, Any]\n) -> None:\n    channel_id = data.get(\"channel_id\")\n    if not isinstance(channel_id, str) or not channel_id:\n        await _send_error(\n            conn.websocket,\n            code=\"validation_error\",\n            message=\"channel_id is required\",\n        )\n        return\n\n    since_raw = data.get(\"since_seq\")\n    if isinstance(since_raw, bool) or not isinstance(since_raw, int):\n        await _send_error(\n            conn.websocket,\n            code=\"validation_error\",\n            message=\"since_seq must be a non-negative integer\",\n        )\n        return\n    since_seq = since_raw\n    if since_seq < 0:\n        await _send_error(\n            conn.websocket,\n            code=\"validation_error\",\n            message=\"since_seq must be a non-negative integer\",\n        )\n        return\n\n    try:\n        _authorize_channel_read(\n            settings, channel_id=channel_id, user_id=conn.user_id\n        )\n    except ApiError as exc:\n        await _send_error(conn.websocket, code=exc.code, message=exc.message)\n        return\n\n    db_conn = db.connect(settings.sqlite_path)\n    try:\n        head = events.get_head_seq(db_conn, channel_id)\n        tail = events.get_tail_seq(db_conn, channel_id)\n\n        if since_seq > head:\n            await _send_error(\n                conn.websocket,\n                code=\"validation_error\",\n                message=\"since_seq ahead of head\",\n            )\n            return\n\n        # Success path (including gap): subscribe.\n        was_subscribed = channel_id in conn.channels\n        hub.subscribe(conn, channel_id)\n        conn.resuming.add(channel_id)\n        conn.resume_buffer.setdefault(channel_id, [])\n\n        try:\n            if head == 0:\n                await _send_json(\n                    conn.websocket,\n                    {\n                        \"type\": \"resumed\",\n                        \"channel_id\": channel_id,\n                        \"head_seq\": 0,\n                    },\n                )\n            elif tail is not None and since_seq < tail:\n                await _send_json(\n                    conn.websocket,\n                    {\n                        \"type\": \"resume.gap\",\n                        \"channel_id\": channel_id,\n                        \"head_seq\": head,\n                        \"tail_seq\": tail,\n                    },\n                )\n                await _send_json(\n                    conn.websocket,\n                    {\n                        \"type\": \"resumed\",\n                        \"channel_id\": channel_id,\n                        \"head_seq\": head,\n                    },\n                )\n            else:\n                replay = events.list_events_after(\n                    db_conn,\n                    channel_id=channel_id,\n                    since_seq=since_seq,\n                    head_seq=head,\n                )\n                for frame in replay:\n                    await _send_json(conn.websocket, frame)\n                await _send_json(\n                    conn.websocket,\n                    {\n                        \"type\": \"resumed\",\n                        \"channel_id\": channel_id,\n                        \"head_seq\": head,\n                    },\n                )\n        finally:\n            buffered = conn.resume_buffer.pop(channel_id, [])\n            conn.resuming.discard(channel_id)\n            for frame in buffered:\n                await _send_json(conn.websocket, frame)\n            _ = was_subscribed\n    finally:\n        db_conn.close()\n"}},"hookAdditionalContexts":[],"toolCallId":"call-03f2577b-a068-448c-bb62-a99abbbe0485-47\nfc_b71d8671-5cb2-9da6-914f-3a01b9c908be_1","startedAtMs":"1787448888439"},"model_call_id":"6def408b-6104-44a9-a526-9810f97b5511-11-ogak","session_id":"b76c730e-983d-4b18-9e06-1d6745c005de","timestamp_ms":1787448888491}
{"type":"tool_call","subtype":"completed","call_id":"call-03f2577b-a068-448c-bb62-a99abbbe0485-46\nfc_b71d8671-5cb2-9da6-914f-3a01b9c908be_0","tool_call":{"editToolCall":{"args":{"path":"/work/ws/worktrees/app/backend-dev-1/server/events.py","streamContent":"\"\"\"Durable channel events, dense seq, and local WebSocket delivery (MARATHON-13).\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport sqlite3\nfrom typing import Any\n\nfrom server.db import utc_now_z\n\nlogger = logging.getLogger(__name__)\n\nCHANNEL_EVENT_RETAIN = 10_000\n\n\ndef get_head_seq(conn: sqlite3.Connection, channel_id: str) -> int:\n    \"\"\"Current dense head for channel (0 if no events yet).\"\"\"\n    row = conn.execute(\n        \"SELECT head_seq FROM channel_seq WHERE channel_id = ?\",\n        (channel_id,),\n    ).fetchone()\n    if row is None:\n        return 0\n    return int(row[\"head_seq\"])\n\n\ndef get_tail_seq(conn: sqlite3.Connection, channel_id: str) -> int | None:\n    \"\"\"Minimum retained seq for channel, or None when head is 0.\"\"\"\n    head = get_head_seq(conn, channel_id)\n    if head == 0:\n        return None\n    row = conn.execute(\n        \"SELECT MIN(seq) AS tail FROM channel_events WHERE channel_id = ?\",\n        (channel_id,),\n    ).fetchone()\n    if row is None or row[\"tail\"] is None:\n        return 1\n    return int(row[\"tail\"])\n\n\ndef list_events_after(\n    conn: sqlite3.Connection, *, channel_id: str, since_seq: int, head_seq: int\n) -> list[dict[str, Any]]:\n    \"\"\"Load wire frames with seq in (since_seq, head_seq], ascending.\"\"\"\n    rows = conn.execute(\n        \"\"\"\n        SELECT channel_id, seq, type, payload_json\n        FROM channel_events\n        WHERE channel_id = ? AND seq > ? AND seq <= ?\n        ORDER BY seq ASC\n        \"\"\",\n        (channel_id, since_seq, head_seq),\n    ).fetchall()\n    frames: list[dict[str, Any]] = []\n    for row in rows:\n        payload = json.loads(row[\"payload_json\"])\n        frame: dict[str, Any] = {\n            \"type\": row[\"type\"],\n            \"seq\": int(row[\"seq\"]),\n            \"channel_id\": row[\"channel_id\"],\n        }\n        frame.update(payload)\n        frames.append(frame)\n    return frames\n\n\ndef append_channel_event(\n    conn: sqlite3.Connection,\n    *,\n    channel_id: str,\n    event_type: str,\n    payload: dict[str, Any],\n) -> dict[str, Any]:\n    \"\"\"Allocate next dense seq, insert log row, prune; return wire frame.\n\n    Must run inside the same write transaction as the mutation.\n    \"\"\"\n    conn.execute(\n        \"\"\"\n        INSERT INTO channel_seq (channel_id, head_seq)\n        VALUES (?, 1)\n        ON CONFLICT(channel_id) DO UPDATE SET\n            head_seq = head_seq + 1\n        \"\"\",\n        (channel_id,),\n    )\n    row = conn.execute(\n        \"SELECT head_seq FROM channel_seq WHERE channel_id = ?\",\n        (channel_id,),\n    ).fetchone()\n    assert row is not None\n    seq = int(row[\"head_seq\"])\n    now = utc_now_z()\n    conn.execute(\n        \"\"\"\n        INSERT INTO channel_events (channel_id, seq, type, payload_json, created_at)\n        VALUES (?, ?, ?, ?, ?)\n        \"\"\",\n        (channel_id, seq, event_type, json.dumps(payload, separators=(\",\", \":\")), now),\n    )\n    # Retain last CHANNEL_EVENT_RETAIN events: prune seq < head - RETAIN + 1.\n    if seq > CHANNEL_EVENT_RETAIN:\n        cutoff = seq - CHANNEL_EVENT_RETAIN + 1\n        conn.execute(\n            \"DELETE FROM channel_events WHERE channel_id = ? AND seq < ?\",\n            (channel_id, cutoff),\n        )\n    frame: dict[str, Any] = {\n        \"type\": event_type,\n        \"seq\": seq,\n        \"channel_id\": channel_id,\n    }\n    frame.update(payload)\n    return frame\n\n\ndef deliver(frame: dict[str, Any]) -> None:\n    \"\"\"Post-commit local hub delivery. Never raises. Redis hook is a no-op (M14).\"\"\"\n    try:\n        _deliver_local(frame)\n        _redis_publish_stub(frame)\n    except Exception:\n        logger.exception(\"events.deliver failed\")\n\n\ndef _deliver_local(frame: dict[str, Any]) -> None:\n    from server.ws.hub import hub\n\n    if frame.get(\"type\") == \"user.updated\":\n        hub.broadcast_global(frame)\n        return\n    channel_id = frame.get(\"channel_id\")\n    if isinstance(channel_id, str) and channel_id:\n        hub.broadcast_channel(channel_id, frame)\n\n\ndef _redis_publish_stub(_frame: dict[str, Any]) -> None:\n    \"\"\"Placeholder for MARATHON-14 Redis pub/sub fan-out.\"\"\"\n    return None\n\n\ndef publish_user_updated(user: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Build channel-less profile frame (no seq). Caller delivers after commit.\"\"\"\n    return {\"type\": \"user.updated\", \"user\": user}\n\n\ndef publish_message_created(\n    conn: sqlite3.Connection, *, channel_id: str, message: dict[str, Any]\n) -> dict[str, Any]:\n    \"\"\"Append message.created inside the open write transaction.\"\"\"\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"message.created\",\n        payload={\"message\": message},\n    )\n\n\ndef publish_message_updated(\n    conn: sqlite3.Connection, *, channel_id: str, message: dict[str, Any]\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"message.updated\",\n        payload={\"message\": message},\n    )\n\n\ndef publish_message_deleted(\n    conn: sqlite3.Connection, *, channel_id: str, message_id: str\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"message.deleted\",\n        payload={\"message_id\": message_id},\n    )\n\n\ndef publish_reaction_changed(\n    conn: sqlite3.Connection,\n    *,\n    channel_id: str,\n    message_id: str,\n    reactions: list[dict[str, Any]],\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"reaction.changed\",\n        payload={\"message_id\": message_id, \"reactions\": reactions},\n    )\n\n\ndef publish_membership_joined(\n    conn: sqlite3.Connection, *, channel_id: str, user: dict[str, Any]\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"membership.joined\",\n        payload={\"user\": user},\n    )\n\n\ndef publish_membership_left(\n    conn: sqlite3.Connection, *, channel_id: str, user_id: str\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"membership.left\",\n        payload={\"user_id\": user_id},\n    )\n\n\ndef publish_channel_created(\n    conn: sqlite3.Connection, *, channel: dict[str, Any]\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel[\"id\"],\n        event_type=\"channel.created\",\n        payload={\"channel\": channel},\n    )\n\n\ndef publish_channel_updated(\n    conn: sqlite3.Connection, *, channel: dict[str, Any]\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel[\"id\"],\n        event_type=\"channel.updated\",\n        payload={\"channel\": channel},\n    )\n\n\ndef publish_channel_archived(\n    conn: sqlite3.Connection, *, channel: dict[str, Any]\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel[\"id\"],\n        event_type=\"channel.archived\",\n        payload={\"channel\": channel},\n    )\n\n\ndef publish_channel_unarchived(\n    conn: sqlite3.Connection, *, channel: dict[str, Any]\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel[\"id\"],\n        event_type=\"channel.unarchived\",\n        payload={\"channel\": channel},\n    )\n\n\ndef publish_channel_pin_added(\n    conn: sqlite3.Connection,\n    *,\n    channel_id: str,\n    message_id: str,\n    pinned_by: str,\n    pinned_at: str,\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"channel.pin_added\",\n        payload={\n            \"message_id\": message_id,\n            \"pinned_by\": pinned_by,\n            \"pinned_at\": pinned_at,\n        },\n    )\n\n\ndef publish_channel_pin_removed(\n    conn: sqlite3.Connection, *, channel_id: str, message_id: str\n) -> dict[str, Any]:\n    return append_channel_event(\n        conn,\n        channel_id=channel_id,\n        event_type=\"channel.pin_removed\",\n        payload={\"message_id\": message_id},\n    )\n"},"result":{"success":{"path":"/work/ws/worktrees/app/backend-dev-1/server/events.py","linesAdded":255,"linesRemoved":52,"diffString":"--- a//work/ws/worktrees/app/backend-dev-1/server/events.py\n+++ b//work/ws/worktrees/app/backend-dev-1/server/events.py\n@@ -1,88 +1,291 @@\n-\"\"\"Internal event publish hooks (fan-out wired by MARATHON-13/14).\"\"\"\n+\"\"\"Durable channel events, dense seq, and local WebSocket delivery (MARATHON-13).\"\"\"\n \n from __future__ import annotations\n \n+import json\n+import logging\n+import sqlite3\n from typing import Any\n \n+from server.db import utc_now_z\n \n-def publish_user_updated(user: dict[str, Any]) -> None:\n-    \"\"\"Notify subscribers that a user's public profile changed.\n+logger = logging.getLogger(__name__)\n \n-    Intended payload (no ``channel_id`` / ``seq`` — profile events are not\n-    channel-sequenced)::\n+CHANNEL_EVENT_RETAIN = 10_000\n \n-        {\"type\": \"user.updated\", \"user\": <UserObj>}\n \n-    No-op until MARATHON-13/14 replace this with Redis pub/sub + WebSocket\n-    fan-out. Must not raise after a successful HTTP commit.\n-    \"\"\"\n-    _ = user\n-    return None\n+def get_head_seq(conn: sqlite3.Connection, channel_id: str) -> int:\n+    \"\"\"Current dense head for channel (0 if no events yet).\"\"\"\n+    row