alue, int):\n        raise ApiError(400, \"validation_error\", f\"invalid {field}\")\n    if value < minimum or value > maximum:\n        raise ApiError(400, \"validation_error\", f\"invalid {field}\")\n    return value\n\n\ndef _resolve_invite_target(\n    conn: sqlite3.Connection,\n    *,\n    invited_user_id: Any,\n    invited_username: Any,\n) -> tuple[str | None, str | None]:\n    \"\"\"Resolve optional target fields to (user_id, username) or (None, None).\"\"\"\n    has_id = invited_user_id is not None\n    has_name = invited_username is not None\n    if not has_id and not has_name:\n        return None, None","isEmpty":false,"exceededLimit":false,"totalLines":321,"fileSize":10100,"path":"/work/ws/worktrees/app/backend-dev-1/server/invitations/store.py","readRange":{"startLine":1,"endLine":80},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-e53018a2-03e1-42fe-b5a9-b97487e19599-57\nfc_72d07867-fbe6-98ed-94a5-b77c05c93355_2","startedAtMs":"1787444468822","completedAtMs":"1787444470069"},"model_call_id":"0fbfa7d9-7075-4140-98fa-5162e36b06ee-19-ond9","session_id":"0a8fcafb-36dc-47ae-b858-91f084f7ec96","timestamp_ms":1787444470091}
