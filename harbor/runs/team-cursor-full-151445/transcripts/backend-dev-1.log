port sys,json; d=json.load(sys.stdin); print('notes:', d.get('notes','')[:3000]); print('---'); print('depends:', d.get('depends_on')); print('status:', d.get('status'))\"","workingDirectory":"","exitCode":0,"signal":"","stdout":"notes: \n---\ndepends: None\nstatus: open\n","stderr":"","executionTime":101,"interleavedOutput":"notes: \n---\ndepends: None\nstatus: open\n","localExecutionTimeMs":55},"isBackground":false},"description":"Show epic notes and status"},"hookAdditionalContexts":[],"toolCallId":"call-8532c71d-0064-4c32-a25e-48db9c100d4e-4\nfc_6df5e98e-22ab-9648-95be-0a169f0796e1_0","startedAtMs":"1787441755485","completedAtMs":"1787441755587"},"model_call_id":"0e5d6113-cc95-4dd0-a688-ccf905e49208-2-ly3q","session_id":"6d466b8b-84ad-4a35-92ac-b8e56b93b2c8","timestamp_ms":1787441755603}
