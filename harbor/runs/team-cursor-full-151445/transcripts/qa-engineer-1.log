(\n        \"/api/auth/register\",\n        json={\n            \"username\": \"ada\",\n            \"password\": \"password1\",\n            \"display_name\": \"Ada Lovelace\",\n            \"extra_ignored\": True,\n        },\n    )\n    assert resp.status_code == 201\n    assert resp.json()[\"user\"][\"display_name\"] == \"Ada Lovelace\"\n\n\ndef test_register_blank_display_name_defaults(tmp_path: Path) -> None:\n    client = _client(tmp_path)\n    resp = client.post(\n        \"/api/auth/register\",\n        json={\"username\": \"ada\", \"password\": \"password1\", \"display_name\": \"   \"},\n    )\n    assert resp.status_code == 201\n    assert resp.json()[\"user\"][\"display_name\"] == \"ada\"\n\n\ndef test_duplicate_username_409(tmp_path: Path) -> None:\n    client = _client(tmp_path)\n    assert (\n        client.post(\n            \"/api/auth/register\",\n            json={\"username\": \"ada\", \"password\": \"password1\"},\n        ).status_code\n        == 201\n    )\n    resp = client.post(\n        \"/api/auth/register\",\n        json={\"username\": \"ada\", \"password\": \"password2\"},\n    )\n    assert resp.status_code == 409\n    assert resp.json() == {\n        \"error\": {\"code\": \"conflict\", \"message\": \"username already taken\"}\n    }\n\n\n@pytest.mark.parametrize(\n    \"payload\",\n    [","isEmpty":false,"exceededLimit":false,"totalLines":288,"fileSize":8871,"path":"/work/ws/worktrees/app/qa-engineer-1/tests/test_auth.py","readRange":{"startLine":1,"endLine":100},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-57d383b8-0c4f-42cc-a3e3-17b0d2c2b5c3-7\nfc_cc079122-a40c-9cb4-8e56-c1abc4d3464a_1","startedAtMs":"1787439372931","completedAtMs":"1787439373238"},"model_call_id":"e6415d24-8be3-4826-9603-694013bcc595-2-6nqh","session_id":"fe35582b-006f-4c2f-b4e7-6140f718cf8a","timestamp_ms":1787439373258}
