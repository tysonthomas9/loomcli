-bg-warm: #e8e0d4;\n  --color-surface: #faf7f2;\n  --color-sidebar: #1f4d46;\n  --color-sidebar-text: #e8f2ef;\n  --color-sidebar-muted: #9bb8b1;\n  --color-sidebar-hover: #2a6259;\n  --color-accent: #c45c26;\n  --color-accent-hover: #a84b1c;\n  --color-text: #1a1a18;\n  --color-text-muted: #5c5a54;\n  --color-border: #d4cdc0;\n  --color-error: #9b1c1c;\n  --color-error-bg: #fce8e8;\n  --color-focus: #2a6f66;\n  --font-display: \"Source Serif 4\", \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif;\n  --font-body: \"IBM Plex Sans\", \"Segoe UI\", \"Helvetica Neue\", sans-serif;\n  --sidebar-width: 240px;\n  --thread-width: 320px;\n  --radius: 6px;\n  --space-1: 0.25rem;\n  --space-2: 0.5rem;\n  --space-3: 0.75rem;\n  --space-4: 1rem;\n  --space-5: 1.5rem;\n  --space-6: 2rem;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nhtml,\nbody {\n  margin: 0;\n  min-height: 100%;\n  height: 100%;\n}\n\nbody {\n  font-family: var(--font-body);\n  color: var(--color-text);\n  background:\n    radial-gradient(ellipse at 12% 0%, rgba(31, 77, 70, 0.12), transparent 50%),\n    radial-gradient(ellipse at 90% 10%, rgba(196, 92, 38, 0.1), transparent 45%),\n    linear-gradient(165deg, var(--color-bg) 0%, var(--color-bg-warm) 100%);\n  line-height: 1.45;\n}\n\n[hidden] {\n  display: none !important;\n}\n\n.boot-placeholder {\n  display: grid;\n  place-items: center;\n  min-height: 100vh;\n  font-family: var(--font-display);\n  font-size: 1.25rem;\n  color: var(--color-text-muted);\n}\n\n.auth-brand {\n  font-family: var(--font-display);\n  font-weight: 700;\n  font-size: 2rem;\n  letter-spacing: -0.02em;\n  margin: 0 0 var(--space-2);\n  color: var(--color-sidebar);\n}\n\n.auth-subtitle {\n  margin: 0 0 var(--space-5);\n  color: var(--color-text-muted);\n}\n\n.auth-modal {\n  position: fixed;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: var(--space-4);\n  background: rgba(26, 26, 24, 0.35);\n  z-index: 100;\n}\n\n.auth-modal__pa