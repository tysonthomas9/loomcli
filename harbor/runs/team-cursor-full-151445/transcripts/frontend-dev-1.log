ld\">\n          <span>Display name</span>\n          <input\n            type=\"text\"\n            name=\"display_name\"\n            data-testid=\"auth-display-name\"\n            autocomplete=\"nickname\"\n          />\n        </label>\n        <label class=\"field\">\n          <span>Password</span>\n          <input\n            type=\"password\"\n            name=\"password\"\n            data-testid=\"auth-password\"\n            autocomplete=\"current-password\"\n            required\n          />\n        </label>\n        <p id=\"auth-error\" class=\"form-error\" data-testid=\"auth-error\" hidden></p>\n        <button type=\"submit\" class=\"btn btn-primary\" data-testid=\"auth-submit\">Sign up</button>\n      </form>\n      <button type=\"button\" class=\"btn btn-link\" id=\"auth-toggle\" data-testid=\"auth-toggle\">\n        Already have an account? Log in\n      </button>\n    </div>\n  </div>\n\n  <div id=\"onboarding\" class=\"onboarding\" hidden>\n    <div class=\"onboarding__panel\">\n      <header class=\"onboarding__header\">\n        <h1 class=\"auth-brand\">Huddle</h1>\n        <div class=\"onboarding__user-row\" id=\"onboarding-session-slot\"></div>\n      </header>\n      <section\n        id=\"empty-state-create-workspace\"\n        class=\"empty-state\"\n        data-testid=\"empty-state-create-workspace\"\n      >\n        <h2>Create a workspace</h2>\n        <p>Get started by creating a workspace, or join one with its slug.</p>\n      </section>\n      <form id=\"workspace-create-form\" data-testid=\"workspace-create-form\" novalidate>\n        <label class=\"field\">\n          <span>Slug</span>\n          <input type=\"text\" name=\"slug\" data-testid=\"workspace-slug\" spellcheck=\"false\" required />\n        </label>\n        <label class=\"field\">\n          <span>Name</span>\n          <input type=\"text\" name=\"name\" data-testid=\"workspace-name\" required />\n        </label>\n        <p id=\"workspace-create-error\" class=\"form-error\" data-testid=\"workspace-create-error\" hidden></p>\n        <button type=\"submit\" class=\"btn btn-primary\" data-testid=\"workspace-create-submit\">\n          Create workspace\n        </button>\n      </form>\n      <form id=\"join-workspace-form\" data-testid=\"join-workspace-form\" novalidate>\n        <h2>Join a workspace</h2>\n        <label class=\"field\">\n          <span>Workspace slug</span>\n          <input\n            type=\"text\"\n            name=\"slug\"\n            data-testid=\"join-workspace-slug\"\n            spellcheck=\"false\"\n            required\n          />\n        </label>\n        <p id=\"join-workspace-error\" class=\"form-error\" data-testid=\"join-workspace-error\" hidden></p>\n        <button type=\"submit\" class=\"btn btn-secondary\" data-testid=\"join-workspace-submit\">\n          Join workspace\n        </button>\n      </form>\n      <form id=\"invitation-accept-form\" data-testid=\"invitation-accept-form\" novalidate>\n        <h2>Accept an invitation</h2>\n        <label class=\"field\">\n          <span>Invitation code</span>\n          <input\n            type=\"text\"\n            name=\"code\"\n            data-testid=\"invitation-accept-code\"\n            spellcheck=\"false\"\n            required\n            autocomplete=\"off\"\n          />\n        </label>\n        <p\n          id=\"invitation-accept-error\"\n          class=\"form-error\"\n          data-testid=\"invitation-accept-error\"\n          hidden\n        ></p>\n        <button type=\"submit\" class=\"btn btn-secondary\" data-testid=\"invitation-accept-submit\">\n          Accept invitation\n        </button>\n      </form>\n    </div>\n  </div>\n\n  <div id=\"shell\" class=\"shell\" hidden>\n    <aside class=\"sidebar\" aria-label=\"Workspace sidebar\">\n      <div class=\"sidebar__brand\">Huddle</div>\n      <div id=\"workspace-header\" class=\"workspace-header\" data-testid=\"workspace-header\">\n        <span id=\"workspace-header-label\" class=\"workspace-header__label\"></span>\n        <button\n          type=\"button\"\n          class=\"btn btn-ghost workspace-header__settings\"\n          data-testid=\"workspace-settings-btn\"\n          hidden\n        >\n          Settings\n        </button>\n      </div>\n      <nav class=\"sidebar__nav\" aria-label=\"Channels\">\n        <h2 class=\"sidebar__section-title\">Channels</h2>\n        <ul id=\"channel-list\" class=\"channel-list\" data-testid=\"channel-list\"></ul>\n        <h2 class=\"sidebar__section-title\">Direct messages</h2>\n        <ul id=\"dms-list\" class=\"channel-list\" data-testid=\"dms-list\"></ul>\n      </nav>\n      <div class=\"sidebar__footer\" id=\"shell-session-slot\"></div>\n    </aside>\n    <main id=\"message-pane\" class=\"message-pane\" data-testid=\"message-pane\">\n      <header id=\"message-pane-header\" class=\"message-pane__header\" hidden>\n        <h2 id=\"message-pane-title\" class=\"message-pane__title\"></h2>\n        <button\n          type=\"button\"\n          class=\"btn btn-ghost\"\n          data-testid=\"channel-settings-btn\"\n          hidden\n        >\n          Channel settings\n        </button>\n      </header>\n      <p class=\"message-pane__placeholder\">Select a channel</p>\n    </main>\n    <aside\n      id=\"thread-panel\"\n      class=\"thread-panel\"\n      data-testid=\"thread-panel\"\n      hidden\n      aria-hidden=\"true\"\n    >\n      <p class=\"thread-panel__placeholder\">Thread</p>\n    </aside>\n  </div>\n\n  <!-- Workspace settings modal -->\n  <div\n    id=\"workspace-settings-modal\"\n    class=\"settings-modal\"\n    data-testid=\"workspace-settings-modal\"\n    hidden\n  >\n    <div\n      class=\"settings-modal__panel\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"workspace-settings-title\"\n    >\n      <header class=\"settings-modal__header\">\n        <h2 id=\"workspace-settings-title\">Workspace settings</h2>\n        <button\n          type=\"button\"\n          class=\"btn btn-ghost\"\n          data-testid=\"workspace-settings-close\"\n          aria-label=\"Close workspace settings\"\n        >\n          Close\n        </button>\n      </header>\n      <div class=\"settings-tabs\" role=\"tablist\" aria-label=\"Workspace settings tabs\">\n        <button\n          type=\"button\"\n          class=\"settings-tab\"\n          role=\"tab\"\n          data-testid=\"settings-tab-general\"\n          data-tab=\"general\"\n          aria-selected=\"true\"\n        >\n          General\n        </button>\n        <button\n          type=\"button\"\n          class=\"settings-tab\"\n          role=\"tab\"\n          data-testid=\"settings-tab-members\"\n          data-tab=\"members\"\n          aria-selected=\"false\"\n        >\n          Members\n        </button>\n        <button\n          type=\"button\"\n          class=\"settings-tab\"\n          role=\"tab\"\n          data-testid=\"settings-tab-invitations\"\n          data-tab=\"invitations\"\n          aria-selected=\"false\"\n        >\n          Invitations\n        </button>\n      </div>\n\n      <div\n        class=\"settings-panel\"\n        data-testid=\"settings-panel-general\"\n        data-panel=\"general\"\n        role=\"tabpanel\"\n      >\n        <form id=\"settings-general-form\" novalidate>\n          <label class=\"field\">\n            <span>Name</span>\n            <input type=\"text\" data-testid=\"settings-name\" name=\"name\" required />\n          </label>\n          <label class=\"field\">\n            <span>Join mode</span>\n            <select data-testid=\"settings-join-mode\" name=\"join_mode\">\n              <option value=\"open\">Open</option>\n              <option value=\"invite_only\">Invite only</option>\n            </select>\n          </label>\n          <p\n            class=\"form-error\"\n            data-testid=\"settings-general-error\"\n            hidden\n          ></p>\n          <p\n            class=\"form-success\"\n            data-testid=\"settings-general-success\"\n            hidden\n            aria-live=\"polite\"\n          ></p>\n          <button type=\"submit\" class=\"btn btn-primary\" data-testid=\"settings-general-save\">\n            Save\n          </button>\n        </form>\n      </div>\n\n      <div\n        class=\"settings-panel\"\n        data-testid=\"settings-panel-members\"\n        data-panel=\"members\"\n        role=\"tabpanel\"\n        hidden\n      >\n        <p data-testid=\"settings-members-loading\" class=\"settings-loading\" hidden>\n          Loading members…\n        </p>\n        <p class=\"form-error\" data-testid=\"settings-members-error\" hidden></p>\n        <ul\n          class=\"settings-list\"\n          data-testid=\"settings-members-list\"\n        ></ul>\n        <div class=\"settings-transfer\" data-testid=\"settings-transfer-owner\" hidden>\n          <h3>Transfer ownership</h3>\n          <label class=\"field\">\n            <span>New owner (admin)</span>\n            <select data-testid=\"settings-transfer-owner-select\"></select>\n          </label>\n          <p class=\"form-error\" data-testid=\"settings-transfer-error\" hidden></p>\n          <button\n            type=\"button\"\n            class=\"btn btn-secondary\"\n            data-testid=\"settings-transfer-owner-submit\"\n          >\n            Transfer ownership\n          </button>\n        </div>\n      </div>\n\n      <div\n        class=\"settings-panel\"\n        data-testid=\"settings-panel-invitations\"\n        data-panel=\"invitations\"\n        role=\"tabpanel\"\n        hidden\n      >\n        <p id=\"invitations-admin-only\" class=\"settings-muted\" hidden>\n          Admins only\n        </p>\n        <form\n          id=\"create-invitation-form\"\n          data-testid=\"create-invitation-form\"\n          novalidate\n        >\n          <label class=\"field\">\n            <span>Max uses</span>\n            <input\n              type=\"number\"\n              min=\"1\"\n              data-testid=\"invitation-max-uses\"\n              name=\"max_uses\"\n            />\n          </label>\n          <label class=\"field\">\n            <span>Expires in (seconds)</span>\n            <input\n              type=\"number\"\n              min=\"1\"\n              data-testid=\"invitation-expires-seconds\"\n              name=\"expires_in_seconds\"\n            />\n          </label>\n          <label class=\"field\">\n            <span>Target username (optional)</span>\n            <input\n              type=\"text\"\n              data-testid=\"invitation-username\"\n              name=\"invited_username\"\n              spellcheck=\"false\"\n            />\n          </label>\n          <p class=\"form-error\" data-testid=\"invitation-create-error\" hidden></p>\n          <button\n            type=\"submit\"\n            class=\"btn btn-primary\"\n            data-testid=\"invitation-create-submit\"\n          >\n            Create invitation\n          </button>\n        </form>\n        <p class=\"form-error\" data-testid=\"invitation-list-error\" hidden></p>\n        <ul class=\"settings-list\" data-testid=\"invitation-list\"></ul>\n      </div>\n    </div>\n  </div>\n\n  <!-- Channel settings modal -->\n  <div\n    id=\"channel-settings-modal\"\n    class=\"settings-modal\"\n    data-testid=\"channel-settings-modal\"\n    hidden\n  >\n    <div\n      class=\"settings-modal__panel\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"channel-settings-title\"\n    >\n      <header class=\"settings-modal__header\">\n        <h2 id=\"channel-settings-title\">Channel settings</h2>\n        <button\n          type=\"button\"\n          class=\"btn btn-ghost\"\n          data-testid=\"channel-settings-close\"\n          aria and aria-label=\"Close channel settings\"\n        >\n          Close\n        </button>\n      </header>\n\n      <label class=\"field\">\n        <span>Topic</span>\n        <input type=\"text\" data-testid=\"settings-topic\" name=\"topic\" />\n      </label>\n      <p class=\"form-error\" data-testid=\"settings-topic-error\" hidden></p>\n      <button type=\"button\" class=\"btn btn-primary\" data-testid=\"settings-topic-save\">\n        Save topic\n      </button>\n\n      <div class=\"settings-archive-row\">\n        <button type=\"button\" class=\"btn btn-secondary\" data-testid=\"settings-archive\" hidden>\n          Archive channel\n        </button>\n        <button type=\"button\" class=\"btn btn-secondary\" data-testid=\"settings-unarchive\" hidden>\n          Unarchive channel\n        </button>\n        <p class=\"form-error\" data-testid=\"settings-archive-error\" hidden></p>\n      </div>\n\n      <h3 class=\"settings-section-title\">Members</h3>\n      <p class=\"form-error\" data-testid=\"channel-members-error\" hidden></p>\n      <ul class=\"settings-list\" data-testid=\"channel-members-list\"></ul>\n\n      <form id=\"channel-add-member-form\" class=\"channel-add-member\" novalidate>\n        <label class=\"field\">\n          <span>Add member (username)</span>\n          <input\n            type=\"text\"\n            data-testid=\"channel-add-member-input\"\n            name=\"username\"\n            spellcheck=\"false\"\n          />\n        </label>\n        <p class=\"form-error\" data-testid=\"channel-add-member-error\" hidden></p>\n        <button\n          type=\"submit\"\n          class=\"btn btn-primary\"\n          data-testid=\"channel-add-member-submit\"\n        >\n          Add member\n        </button>\n      </form>\n    </div>\n  </div>\n\n  <!-- Single session chrome so current-user / logout-btn testids stay unique -->\n  <div id=\"session-chrome\" hidden>\n    <span id=\"session-user\" data-testid=\"current-user\"></span>\n    <button type=\"button\" class=\"btn btn-ghost\" id=\"logout-btn\" data-testid=\"logout-btn\">\n      Log out\n    </button>\n  </div>