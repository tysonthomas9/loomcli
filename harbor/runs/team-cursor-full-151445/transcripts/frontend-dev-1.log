ken });\n    user = data.user;\n    await shell.loadAndPresent();\n  } catch (err) {\n    if (err instanceof ApiClientError && err.status === 401) {\n      clearTokens();\n      user = null;\n      token = null;\n      authUi.show();\n    } else {\n      // Keep token on transient failures; surface auth so the user can recover.\n      user = null;\n      authUi.show();\n    }\n  } finally {\n    showBoot(false);\n  }\n}\n\nvoid boot();\n","isEmpty":false,"exceededLimit":false,"totalLines":99,"fileSize":2061,"path":"/work/ws/worktrees/app/frontend-dev-1/static/js/app.js","readRange":{"startLine":1,"endLine":99},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-3c685555-7d25-490a-86f2-c008e946aff2-12\nfc_c01698b7-8f17-999a-8c79-57b94b212a38_0","startedAtMs":"1787446038899","completedAtMs":"1787446039045"},"model_call_id":"fcdb3401-605b-4a9a-943c-0d19c998aa57-3-9eo1","session_id":"4a95564d-2984-4fcb-a28e-1c59619053d4","timestamp_ms":1787446039065}
