  color: var(--color-sidebar);\n}\n\n.auth-subtitle {\n  margin: 0 0 var(--space-5);\n  color: var(--color-text-muted);\n}\n\n.auth-modal {\n  position: fixed;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: var(--space-4);\n  background: rgba(26, 26, 24, 0.35);\n  z-index: 100;\n}\n\n.auth-modal__panel,\n.onboarding__panel {\n  width: min(420px, 100%);\n  padding: var(--space-6);\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius);\n  box-shadow: 0 12px 40px rgba(26, 26, 24, 0.12);\n}\n\n.onboarding {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n  padding: var(--space-4);\n}\n\n.onboarding__header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--space-3);\n  margin-bottom: var(--space-5);\n}\n\n.onboarding__user-row {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: var(--space-2);\n  font-size: 0.875rem;\n}\n\n.empty-state {\n  margin-bottom: var(--space-5);\n}\n\n.empty-state h2,\n#join-workspace-form h2 {\n  font-family: var(--font-display);\n  font-size: 1.25rem;\n  margin: 0 0 var(--space-2);\n}\n\n.empty-state p {\n  margin: 0;\n  color: var(--color-text-muted);\n}\n\n.field {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-1);\n  margin-bottom: var(--space-3);\n  font-size: 0.875rem;\n  font-weight: 500;\n}\n\n.field input {\n  font: inherit;\n  font-weight: 400;\n  padding: 0.55rem 0.7rem;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius);\n  background: #fff;\n  color: var(--color-text);\n}\n\n.field input:focus {\n  outline: 2px solid var(--color-focus);\n  outline-offset: 1px;\n  border-color: var(--color-focus);\n}\n\n.form-error {\n  margin: 0 0 var(--space-3);\n  padding: var(--space-2) var(--space-3);\n  background: var(--color-error-bg);\n  color: var(--color-error);\n  border-radius: var(--radius);\n  font-size: 0.875rem;\n}\n\n.btn {\n  font: inherit;\n  cursor: pointer;\n  border-radius: var(--radius);\n  border: 1px solid transparent;\n  padding: 0.55rem 1rem;\n}\n\n.btn:focus-visible {\n  outline: 2px solid var(--color-focus);\n  outline-offset: 2px;\n}\n\n.btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.btn-primary {\n  width: 100%;\n  background: var(--color-accent);\n  color: #fff;\n  font-weight: 600;\n}\n\n.btn-primary:hover:not(:disabled) {\n  background: var(--color-accent-hover);\n}\n\n.btn-secondary {\n  width: 100%;\n  background: var(--color-sidebar);\n  color: var(--color-sidebar-text);\n  font-weight: 600;\n}\n\n.btn-secondary:hover:not(:disabled) {\n  background: var(--color-sidebar-hover);\n}\n\n.btn-link {\n  display: block;\n  width: 100%;\n  margin-top: var(--space-4);\n  background: transparent;\n  color: var(--color-sidebar);\n  text-decoration: underline;\n  text-underline-offset: 3px;\n  border: 0;\n  padding: var(--space-2);\n}\n\n.btn-ghost {\n  background: transparent;\n  color: inherit;\n  border: 1px solid currentColor;\n  padding: 0.3rem 0.65rem;\n  font-size: 0.8125rem;\n  opacity: 0.9;\n}\n\n.btn-ghost:hover:not(:disabled) {\n  opacity: 1;\n}\n\n#join-workspace-form {\n  margin-top: var(--space-6);\n  padding-top: var(--space-5);\n  border-top: 1px solid var(--color-border);\n}\n\n/* Three-pane shell at 1280×900 */\n.shell {\n  display: flex;\n  height: 100vh;\n  width: 100%;\n  overflow: hidden;\n  background: var(--color-surface);\n}\n\n.sidebar {\n  flex: 0 0 var(--sidebar-width);\n  width: var(--sidebar-width);\n  display: flex;\n  flex-direction: column;\n  background: var(--color-sidebar);\n  color: var(--color-sidebar-text);\n  padding: var(--space-4) var(--space-3);\n  min-width: 0;\n}\n\n.sidebar__brand {\n  font-family: var(--font-display);\n  font-size: 1.35rem;\n  font-weight: 700;\n  margin-bottom: var(--space-4);\n}\n\n.workspace-header {\n  font-weight: 600;\n  font-size: 1rem;\n  padding-bottom: var(--space-3);\n  margin-bottom: var(--space-3);\n  border-bottom: 1px solid rgba(232, 242, 239, 0.2);\n  word-break: break-word;\n}\n\n.sidebar__nav {\n  flex: 1;\n  overflow-y: auto;\n  min-height: 0;\n}\n\n.sidebar__section-title {\n  margin: var(--space-3) 0 var(--space-2);\n  font-size: 0.7rem;\n  font-weight: 600;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  color: var(--color-sidebar-muted);\n}\n\n.channel-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  /* Keep empty list containers visible for layout + CUA selectors */\n  min-height: 1.5rem;\n}\n\n.channel-list li {\n  margin: 0;\n}\n\n.channel-list button {\n  display: block;\n  width: 100%;\n  text-align: left;\n  font: inherit;\n  color: var(--color-sidebar-text);\n  background: transparent;\n  border: 0;\n  border-radius: var(--radius);\n  padding: 0.4rem 0.55rem;\n  cursor: pointer;\n}\n\n.channel-list button:hover,\n.channel-list button:focus-visible {\n  background: var(--color-sidebar-hover);\n  outline: none;\n}\n\n.sidebar__footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-2);\n  padding-top: var(--space-3);\n  border-top: 1px solid rgba(232, 242, 239, 0.2);\n  font-size: 0.8125rem;\n}\n\n.sidebar__footer .btn-ghost {\n  color: var(--color-sidebar-text);\n  border-color: rgba(232, 242, 239, 0.45);\n}\n\n.message-pane {\n  flex: 1 1 auto;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  background: var(--color-surface);\n  border-left: 1px solid var(--color-border);\n}\n\n.message-pane__placeholder {\n  margin: auto;\n  color: var(--color-text-muted);\n  font-size: 1rem;\n}\n\n.thread-panel {\n  flex: 0 0 var(--thread-width);\n  width: var(--thread-width);\n  border-left: 1px solid var(--color-border);\n  background: #fff;\n  padding: var(--space-4);\n}\n\n.thread-panel__placeholder {\n  color: var(--color-text-muted);\n  margin: 0;\n}\n\n@media (max-width: 900px) {\n  .shell {\n    flex-direction: column;\n  }\n\n  .sidebar {\n    flex: