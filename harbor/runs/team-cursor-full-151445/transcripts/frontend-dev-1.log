tinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"},{"operator":">&","destinationFds":[2],"targetNodeType":"word","targetText":"dev/null"},{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"}]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Merge main and show task details","closeStdin":true,"conversationId":"75b83ce2-263e-490f-8522-60490e83f05e","adminCommandDenylist":[]},"result":{"success":{"command":"cd /work/ws/worktrees/app/frontend-dev-1 && git merge --no-edit main && loom data show MARATHON-16 --output json 2>/dev/null | head -c 50000; echo; loom data comments MARATHON-16 2>/dev/null || loom data show MARATHON-16 2>&dev/null | head -200","workingDirectory":"","exitCode":0,"signal":"","stdout":"Updating 5859442..15b3c8e\nFast-forward\n .gitignore                       |  15 ++\n data/files/.gitkeep              |   0\n data/redis/.gitkeep              |   0\n data/redis/redis.conf            |   9 +\n data/run/.gitkeep                |   0\n requirements.txt                 |   5 +\n server/__init__.py               |   1 +\n server/app.py                    |  68 ++++++\n server/auth/__init__.py          |   6 +\n server/auth/deps.py              |  48 +++++\n server/auth/passwords.py         |  64 ++++++\n server/auth/routes.py            |  98 +++++++++\n server/auth/tokens.py            |  42 ++++\n server/auth/users.py             | 218 ++++++++++++++++++++\n server/channels/__init__.py      |   1 +\n server/channels/store.py         | 134 ++++++++++++\n server/db.py                     | 224 ++++++++++++++++++++\n server/errors.py                 |  57 +++++\n server/events.py                 |  20 ++\n server/settings.py               |  86 ++++++++\n server/users/__init__.py         |   5 +\n server/users/routes.py           |  78 +++++++\n server/workspaces/__init__.py    |   5 +\n server/workspaces/routes.py      | 117 +++++++++++\n server/workspaces/store.py       | 139 +++++++++++++\n start.sh                         | 217 +++++++++++++++++++\n tests/__init__.py                |   0\n tests/test_auth.py               | 287 ++++++++++++++++++++++++++\n tests/test_auth_cluster_token.py | 255 +++++++++++++++++++++++\n tests/test_auth_live.py          | 298 ++++++++++++++++++++++++++\n tests/test_cluster_boot.py       | 210 +++++++++++++++++++\n tests/test_cluster_respawn.py    | 284 +++++++++++++++++++++++++\n tests/test_health.py             |  86 ++++++++\n tests/test_profiles.py           | 341 ++++++++++++++++++++++++++++++\n tests/test_workspaces.py         | 436 +++++++++++++++++++++++++++++++++++++++\n 35 files changed, 3854 insertions(+)\n create mode 100644 .gitignore\n create mode 100644 data/files/.gitkeep\n create mode 100644 data/redis/.gitkeep\n create mode 100644 data/redis/redis.conf\n create mode 100644 data/run/.gitkeep\n create mode 100644 requirements.txt\n create mode 100644 server/__init__.py\n create mode 100644 server/app.py\n create mode 100644 server/auth/__init__.py\n create mode 100644 server/auth/deps.py\n create mode 100644 server/auth/passwords.py\n create mode 100644 server/auth/routes.py\n create mode 100644 server/auth/tokens.py\n create mode 100644 server/auth/users.py\n create mode 100644 server/channels/__init__.py\n create mode 100644 server/channels/store.py\n create mode 100644 server/db.py\n create mode 100644 server/errors.py\n create mode 100644 server/events.py\n create mode 100644 server/settings.py\n create mode 100644 server/users/__init__.py\n create mode 100644 server/users/routes.py\n create mode 100644 server/workspaces/__init__.py\n create mode 100644 server/workspaces/routes.py\n create mode 100644 server/workspaces/store.py\n create mode 100755 start.sh\n create mode 100644 tests/__init__.py\n create mode 100644 tests/test_auth.py\n create mode 100644 tests/test_auth_cluster_token.py\n create mode 100644 tests/test_auth_live.py\n create mode 100644 tests/test_cluster_boot.py\n create mode 100644 tests/test_cluster_respawn.py\n create mode 100644 tests/test_health.py\n create mode 100644 tests/test_profiles.py\n create mode 100644 tests/test_workspaces.py\n{\n  \"id\": \"MARATHON-16\",\n  \"title\": \"SPA: auth, token storage, workspace shell\",\n  \"status\": \"in_progress\",\n  \"priority\": 1,\n  \"issue_type\": \"task\",\n  \"assignee\": \"frontend-dev-1\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"frontend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"design\": \"# MARATHON-16 — SPA: auth, token storage, workspace shell\\n\\n## Summary\\n\\nReplace the stub `GET /` HTML with a zero-build Huddle SPA served identically from every HTTP node. The SPA owns browser session lifecycle (register → auto-login, login, logout), durable bearer storage under `localStorage` key `huddle.token` (with documented read fallbacks), restoration of the last workspace after logout/login, and the three-pane workspace shell (coloured sidebar + main message pane + on-demand thread panel) with the epic’s stable `data-testid` selectors so CUA/Playwright can drive auth and workspace onboarding at 1280×900. Messaging, channel CRUD UI, and settings modals remain later SPA tasks; this task only mounts their shell slots and wires the seams that already exist (Auth + Workspaces APIs).\\n\\n## Technical Approach\\n\\n### Decision\\n\\n| Concern | Choice |\\n|--------|--------|\\n| Delivery | **Static SPA** under `/app/static/` served by FastAPI; `GET /` returns `static/index.html` on every node |\\n| Frontend stack | **Vanilla HTML + CSS + ES modules** — no Node, no bundler, no React |\\n| API access | Same-origin relative `/api/...` (works on `:8000`/`:8001`/`:8002` without CORS or hard-coded ports) |\\n| Auth header | `Authorization: Bearer \\u003ctoken\\u003e` exactly as MARATHON-3 |\\n| Token storage | Write **`localStorage[\\\"huddle.token\\\"]`**; read primary then accepted fallbacks (below) |\\n| Workspace restore | Persist **`localStorage[\\\"huddle.workspaceSlug\\\"]`** across logout; re-select after next login |\\n| Routing | **Hash routes** (`#/`, `#/w/{slug}`) — no server path rewrite; refresh-safe on any node |\\n| Selectors | Stable **`data-testid=\\\"\\u003cname\\u003e\\\"`** attributes matching the task list exactly |\\n| Shell layout | Fixed three-pane: sidebar (coloured) \\\\| message pane \\\\| thread panel (hidden until opened) |\\n\\n### Why\\n\\n- Epic requires browser UI at `GET /` with stable selectors; MARATHON-2 explicitly deferred SPA to this task and left a stub.\\n- Zero-build static assets keep `start.sh` / Python-only ops unchanged (no second runtime), matching MARATHON-2’s self-contained cluster.\\n- Same-origin `/api` + shared SQLite tokens already work cross-node (MARATHON-3/22); the SPA must not invent per-node cookies or JWT.\\n- Hash routing avoids FastAPI catch-all complexity and keeps `GET /api/*` unambiguous.\\n- Writing only `huddle.token` while accepting read fallbacks matches the task wording and MARATHON-3’s named key without breaking graders that seed alternate keys.\\n\\n### Alternatives considered\\n\\n| Alternative | Rejected because |\\n|------------|------------------|\\n| React/Vite SPA with build step | Requires Node in `start.sh` / image; epic forbids remote services and prefers self-contained boot |\\n| Cookie/session auth | Contradicts bearer + `huddle.token` contract already locked by MARATHON-3 |\\n| Path-based SPA routes (`/w/acme`) without catch-all | Refresh on deep links 404 unless every node mounts a rewrite; hash is simpler |\\n| Server-rendered auth forms | Breaks SPA continuity for MARATHON-17/18 and CUA driving a single document |\\n| Invent join/members REST in this task | Owned by MARATHON-6/7/12; SPA locks client seam only |\\n\\n### Trade-off accepted\\n\\nJoin-workspace UI is **mounted and wired** to a join REST seam that MARATHON-7 (open-workspace auto-onboard / join) must implement. Until that endpoint exists, submit shows the server error envelope (or a clear network failure). Create-workspace is the fully working onboarding path today. We accept temporary join failures over inventing a second membership SoT in the SPA task.\\n\\n### Conventions inherited (must not diverge)\\n\\nFrom **MARATHON-2**: Product **Huddle**; `GET /` is HTML 200 on every node; `/api/...` JSON; no DinD.\\n\\nFrom **MARATHON-3**: `UserObj` key set; `{error:{code,message}}`; register/login `{user,token}`; `/api/auth/me`; bearer parsing; username/password validation rules; store token as `huddle.token`.\\n\\nFrom **MARATHON-4**: Same `UserObj`; profile PATCH not required in this shell (settings UI is MARATHON-18).\\n\\nFrom **MARATHON-5**: `WorkspaceObj` / `ChannelObj` / full `ReadStateEntry`; `POST/GET /api/workspaces`, `GET /api/workspaces/{slug}`; create body `{slug,name}`; non-member detail → 404.\\n\\n## Interface Contracts\\n\\n### Selector contract (SPA ↔ grader / CUA)\\n\\nAll names below are **`data-testid` values**. They must be present in the DOM when the corresponding UI state is visible (not merely in JS strings). Prefer exactly these strings — no prefixes.\\n\\n| `data-testid` | When visible | Role |\\n|---------------|--------------|------|\\n| `auth-modal` | Unauthenticated (or forced re-auth) | Modal/dialog wrapping the auth form |\\n| `auth-form` | Inside auth modal | `\\u003cform\\u003e` for register or login |\\n| `auth-submit` | Inside auth form | Submit control |\\n| `auth-toggle` | Inside auth modal | Control that switches register ↔ login mode |\\n| `auth-error` | After failed auth attempt | Visible text node showing `error.message` (or client validation message). **Must not** be empty/invisible on 400/401/409. |\\n| `workspace-create-form` | Authenticated empty / onboarding | Form to create workspace (`slug` + `name`) |\\n| `empty-state-create-workspace` | Authenticated with **zero** workspaces | Empty-state control/region that focuses or reveals create form |\\n| `join-workspace-form` | Authenticated empty / onboarding | Form to join by workspace slug |\\n| `join-workspace-slug` | Inside join form | Text input for slug |\\n| `join-workspace-submit` | Inside join form | Submit control |\\n| `join-workspace-error` | After failed join | Visible error text |\\n| `current-user` | Authenticated shell | Shows session user’s `display_name` (fallback `username`) |\\n| `logout-btn` | Authenticated shell | Clears token and returns to auth modal |\\n| `workspace-header` | Authenticated **with** current workspace | Shows workspace identity (`name` and/or `slug`) |\\n| `channel-list` | Authenticated with current workspace | Container for non-DM channels (may be empty of children until channels load / MARATHON-17) |\\n| `dms-list` | Authenticated with current workspace | Container for DM channels (empty until MARATHON-9/17) |\\n\\n**Auth form fields (required for drivability, not all named in the task list):**\\n\\n| `data-testid` | Element |\\n|---------------|---------|\\n| `auth-username` | Username input |\\n| `auth-password` | Password input |\\n| `auth-display-name` | Optional display name; **visible in register mode only** |\\n\\n**Workspace create fields:**\\n\\n| `data-testid` | Element |\\n|---------------|---------|\\n| `workspace-slug` | Slug input |\\n| `workspace-name` | Name input |\\n| `workspace-create-submit` | Submit |\\n| `workspace-create-error` | Visible error |\\n\\n**Shell slots for dependents (mount now, behavior later):**\\n\\n| `data-testid` | Behavior in this task |\\n|---------------|----------------------|\\n| `message-pane` | Always present when shell is shown; may show placeholder copy (“Select a channel” / empty). **No** message composer required here. |\\n| `thread-panel` | Present in DOM; **`hidden` / not displayed** by default (`display:none` or equivalent). MARATHON-17 opens it. |\\n\\n### Token storage contract (browser ↔ SPA)\\n\\n| Operation | Behavior |\\n|-----------|----------|\\n| **Write (register/login success)** | `localStorage.setItem(\\\"huddle.token\\\", token)` where `token` is the opaque string from the API. Also remove stale fallback keys if present (optional hygiene). |\\n| **Read (boot / API client)** | First non-empty string among, in order: `huddle.token`, `huddle_token`, `token`. Treat whitespace-only as missing. |\\n| **Clear (logout or 401 from `/me`)** | Remove **all** of: `huddle.token`, `huddle_token`, `token`. |\\n| **Workspace slug persist** | On successful workspace select/create/restore: `localStorage.setItem(\\\"huddle.workspaceSlug\\\", slug)`. **Do not** clear this on logout (required for “logout/login restores same workspace”). |\\n| **Negative** | Must **not** store the bearer in cookies, `sessionStorage` only, or URL query strings. |\\n\\n### Seam: Browser ↔ `GET /` (and static assets)\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Server (each node)** | `GET /` → **200** `text/html` document that boots the SPA (title/brand includes **Huddle**). Serve `/static/*` assets with correct MIME types. No auth required. |\\n| **Client** | Load JS; run boot sequence below. |\\n\\n**Failure / slow:** TCP errors until node respawn (≤60s) — same as MARATHON-2. Asset 404 → blank UI; implementer must keep relative paths correct.\\n\\n### Seam: SPA ↔ `POST /api/auth/register`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Client** | Body `{username, password, display_name?}` matching MARATHON-3. Disable `auth-submit` while in flight. On **201**: store token, set session user from `user`, close/hide auth modal, continue boot (list workspaces). On **400/409**: show `error.message` in `auth-error` (visible). On network/5xx: show a generic visible error in `auth-error`. |\\n| **Server** | Unchanged (MARATHON-3). |\\n\\n**Auto-login:** Register success **is** login — do **not** require a second login call. Token from register response is sufficient.\\n\\n### Seam: SPA ↔ `POST /api/auth/login`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Client** | Body `{username, password}`. Same storage + navigation as register. On **401/400**: visible `auth-error` with `error.message`. |\\n| **Server** | Unchanged. |\\n\\n### Seam: SPA ↔ `GET /api/auth/me`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Client** | On boot if a token is readable: call with bearer. While pending: show a lightweight boot placeholder; **do not** flash the auth modal if a token exists. On **200**: set session user from `user`. On **401**: clear all token keys; show auth modal. |\\n| **Server** | Unchanged. |\\n\\n### Seam: SPA ↔ `GET /api/workspaces` / `POST /api/workspaces` / `GET /api/workspaces/{slug}`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Client** | All calls send bearer. **List** after auth: if `workspaces.length === 0`, show empty state (`empty-state-create-workspace` + create + join forms). If non-empty: prefer `huddle.workspaceSlug` if it appears in the list; else first list item (sorted as server returns). **Create**: `POST` `{slug,name}`; on **201** persist slug, load detail, enter shell. On **400/409** show `workspace-create-error`. **Detail**: populate `workspace-header`, split `channels` into `channel-list` (`is_dm === false`) and `dms-list` (`is_dm === true`); ignore `read_state` badges in this task (optional no-op). On detail **404**: clear invalid stored slug, fall back to list/empty. On any **401**: logout locally. |\\n| **Server** | Unchanged (MARATHON-5). |\\n\\n**Channel row markup (minimal, for MARATHON-17):** each channel entry **should** expose `data-channel-id=\\\"{id}\\\"` and `data-channel-name=\\\"{name}\\\"` when listed. Display name may show `#` prefix for non-DM; stored `name` remains without `#`.\\n\\n### Seam: SPA ↔ `POST /api/workspaces/{slug}/join` (client locked here; server owned by MARATHON-7)\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Client** | Body `{}` (ignore extras). Bearer required. Disable submit while in flight. On **200** with `{workspace: WorkspaceObj}` (optional `channels` / `read_state` if server returns them): persist slug, enter shell (fetch detail if channels omitted). On **4xx**: show `error.message` in `join-workspace-error`. |\\n| **Server (MARATHON-7)** | For `join_mode=open`, add caller as `member` if not already; return 200. For `invite_only`, **403** (invitations are MARATHON-12). Unknown slug → **404** envelope. Idempotent if already a member → **200**. |\\n\\n**Until MARATHON-7 lands:** SPA still renders join controls; failed submit must surface a visible error (not a silent no-op).\\n\\n### HTTP client rules (SPA owns)\\n\\n1. `Content-Type: application/json` on POST bodies.\\n2. Parse JSON error envelope; never assume FastAPI `detail`.\\n3. Timeouts: recommend ~15s; on abort/network error show visible error on the active form.\\n4. Do not retry 401/409 blindly; do not infinite-retry `/me`.\\n\\n### Auth modal UX\\n\\n- Default mode on first visit: **register** (sign-up), matching “Sign-up form with visible error…”.\\n- `auth-toggle` switches to login and back; update submit label/copy accordingly.\\n- Client-side pre-check may mirror username/password rules for faster UX, but **server messages win** on response.\\n\\n## Data Model\\n\\n### Browser (no SQLite changes in this task)\\n\\n| Key | Type | Lifetime | Notes |\\n|-----|------|----------|-------|\\n| `localStorage[\\\"huddle.token\\\"]` | string | Until logout / 401 | Canonical bearer |\\n| `localStorage[\\\"huddle_token\\\"]` | string | Read fallback only | Accepted fallback |\\n| `localStorage[\\\"token\\\"]` | string | Read fallback only | Accepted fallback |\\n| `localStorage[\\\"huddle.workspaceSlug\\\"]` | string | Survives logout | Last workspace slug |\\n\\n### In-memory SPA state (not persisted)\\n\\n| Field | Type | Notes |\\n|-------|------|-------|\\n| `user` | `UserObj` \\\\| null | From register/login/`/me` |\\n| `workspaces` | `WorkspaceObj[]` | From list |\\n| `currentWorkspace` | `WorkspaceObj` \\\\| null | Selected |\\n| `channels` | `ChannelObj[]` | From detail |\\n| `authMode` | `\\\"register\\\"` \\\\| `\\\"login\\\"` | Modal mode |\\n| `threadOpen` | boolean | Default `false` |\\n\\n### Server schema\\n\\n**No migration.** This task does not alter SQLite. Backward compatible with migrations v0–v2.\\n\\n## Files to Create / Files to Modify\\n\\n### Create\\n\\n| File | Change |\\n|------|--------|\\n| `static/index.html` | SPA shell markup: auth modal, empty/onboarding, three-pane layout; all required `data-testid`s; `\\u003ctitle\\u003eHuddle\\u003c/title\\u003e`; script `type=\\\"module\\\"` entry. |\\n| `static/css/app.css` | Layout for 1280×900: coloured sidebar (≥~220px), message pane flex-grow, thread panel (~320px) hidden by default; auth modal overlay; visible error styles (not `visibility:hidden` when populated). |\\n| `static/js/storage.js` | Token read/write/clear with fallbacks; workspace slug get/set. |\\n| `static/js/api.js` | `api(method, path, {token, body})` → JSON; maps envelope errors. |\\n| `static/js/auth_ui.js` | Register/login toggle, submit handlers, auto-login on register, error rendering. |\\n| `static/js/shell.js` | Empty state, create/join forms, workspace header, channel/dms lists, logout, hash routing. |\\n| `static/js/app.js` | Boot: read token → `/me` → list → restore slug → render. |\\n\\n(Implementer may collapse JS files if behavior and selectors match; names above are the preferred split.)\\n\\n### Modify\\n\\n| File | Change |\\n|------|--------|\\n| `server/app.py` | Replace inline stub HTML with `FileResponse` to `static/index.html` (path resolved from app root). Mount `StaticFiles` at `/static` pointing at `static/`. Keep `/api/health` and routers unchanged. Ensure `/` is registered **before** any catch-all; do not shadow `/api/*`. |\\n| `tests/test_health.py` | Keep asserting `GET /` 200 HTML + `\\\"Huddle\\\"` in body (still true). Optionally assert a stable selector string appears in HTML (e.g. `data-testid=\\\"auth-form\\\"`) — recommended, not mandatory if covered by a new SPA test file. |\\n| `tests/test_spa_shell.py` (create) | TestClient: `/` contains required testids; `/static/...` 200; optional auth flow via API + HTML presence (no browser required for unit). |\\n\\n### Do not modify\\n\\n| File | Reason |\\n|------|--------|\\n| `server/auth/*`, `server/workspaces/*`, `server/users/*` | Contracts already shipped; SPA is consumer only |\\n| `start.sh` | No build step to add |\\n| `timer.sh` | Harness-owned |\\n\\n## Sequencing and Cross-Task Seams\\n\\n### Build order within this task\\n\\n1. Static files + `app.py` serve path (unblocks `GET /` HTML checks).\\n2. `storage.js` + `api.js`.\\n3. Auth modal + register/login/`/me` boot.\\n4. Workspace list/create/empty state + slug restore.\\n5. Shell chrome (sidebar colour, header, channel/dms lists, logout, thread slot).\\n6. Join form wired to join seam (tolerate backend absence via visible error).\\n\\n### Parallelism\\n\\n- Can implement entirely in parallel with MARATHON-6/8/9/10/… **except** join success depends on MARATHON-7’s open-workspace join/auto-onboard.\\n- MARATHON-17/18 **must** land after this shell (they depend on this task).\\n\\n### Seams this task owns for dependents\\n\\n| Contract | Consumer |\\n|----------|----------|\\n| `data-testid` shell + auth set above | QA / CUA; MARATHON-17/18 |\\n| `huddle.token` + fallbacks + `huddle.workspaceSlug` | All later SPA tasks |\\n| Hash route `#/w/{slug}` + in-memory workspace/channel selection hooks | MARATHON-17 |\\n| Hidden `thread-panel` slot | MARATHON-17 |\\n| `channel-list` / `dms-list` containers + `data-channel-id` | MARATHON-17 |\\n| Client call shape `POST /api/workspaces/{slug}/join` | MARATHON-7 must implement server |\\n\\n### Split follow-ups (already exist — do not recreate)\\n\\n- **MARATHON-17** — messages, threads, reactions, channel create/switch UI inside this shell.\\n- **MARATHON-18** — workspace/channel settings modals.\\n- **MARATHON-7** — server join / open auto-onboard so join form succeeds.\\n\\n## Out of Scope (Needs a Separate Task)\\n\\n| Item | Where found | Why excluded |\\n|------|-------------|--------------|\\n| Message composer, edit/delete, reactions, emoji picker | MARATHON-17 description; no message routes yet (MARATHON-8 open) | Dependent SPA task |\\n| Opening/populating `thread-panel` with replies | MARATHON-17 | Shell only mounts hidden slot |\\n| Workspace settings / invitations UI (`workspace-settings-modal`, invitation testids) | MARATHON-18; APIs MARATHON-6/12 | Different task |\\n| Channel create/join/leave/archive/pins REST | `server/channels/store.py` helpers only; no routes | MARATHON-7 |\\n| DM get-or-create | No DM API | MARATHON-9; `dms-list` stays empty-capable |\\n| Profile PATCH UI | `PATCH /api/users/me` exists | MARATHON-18 / settings |\\n| WebSocket subscribe/resume | No WS routes | MARATHON-13 |\\n| Logout token revoke API | MARATHON-3 explicitly out of scope | Client clears storage only |\\n| IRC / Redis fan-out UI | Cluster tasks | Unrelated |\\n| Stub text “Cluster node stub.” | `server/app.py` | Replaced by SPA in this task (in scope to remove) |\\n\\nNeighborhood scan accounted for: `HTMLResponse` stub in `server/app.py`; `tests/test_health.py` + `tests/test_cluster_boot.py` `GET /` HTML assertions (remain valid if brand “Huddle” + HTML document preserved); no existing `static/` tree; no `localStorage` / `data-testid` hits in-repo yet.\\n\\n## Edge Cases \\u0026 Error Handling\\n\\n| Case | Expected behavior |\\n|------|-------------------|\\n| Invalid register username/password (client or 400) | Show message in **visible** `auth-error`; stay on form; do **not** store token |\\n| Register username taken (409) | Visible `auth-error` with server message; no token write |\\n| Login bad credentials (401) | Visible `auth-error`; no token write |\\n| Register success | Store token; treat as logged in; **no** manual login step |\\n| Boot with valid token | `/me` then workspace flow; auth modal **not** shown |\\n| Boot with garbage token | `/me` 401 → clear tokens → auth modal |\\n| Boot with fallback key only (`token` set, `huddle.token` absent) | Read fallback; on next successful login/register rewrite canonical `huddle.token` |\\n| Logout | Clear token keys; show auth modal; **keep** `huddle.workspaceSlug`; clear in-memory user/channels |\\n| Login after logout with same user | Restore workspace from `huddle.workspaceSlug` if still a member; else first workspace or empty state |\\n| Stored slug for workspace user left / never joined | Detail 404 → drop slug selection; re-list; do not loop |\\n| Create workspace validation/conflict | Visible `workspace-create-error`; remain on form |\\n| Join before MARATHON-7 (404/405/network) | Visible `join-workspace-error`; do not fake membership client-side |\\n| API slow | Disable active submit; keep prior UI; no double-submit |\\n| `GET /` on :8001/:8002 | Same SPA bytes/behavior as :8000 |\\n| Thread panel default | Not visible; must **not** cover message pane at 1280×900 |\\n| Empty channel/dms lists | Containers still present with testids; empty children OK |\\n| Password in DOM errors | Never echo password into `auth-error` |\\n| Unknown JSON fields from server | Ignore extras; do not crash |\\n| `include_archived` | Shell detail calls **omit** query (default hide archived) |\\n\\n## Acceptance Criteria\\n\\n1. `GET http://127.0.0.1:800{0,1,2}/` → **200** HTML containing brand **Huddle** and bootstraps the SPA (script/CSS load without 404).\\n2. Unauthenticated visit shows `auth-modal`, `auth-form`, `auth-submit`, `auth-toggle`.\\n3. Sign-up with invalid input (e.g. short password) shows a **visible** error (readable in `auth-error` / form error UI); must **not** set `huddle.token`.\\n4. Sign-up with valid input → **201** path: token stored at `localStorage[\\\"huddle.token\\\"]` (len ≥ 16); user is logged in **without** a separate login submit; auth modal dismissed.\\n5. `auth-toggle` switches to login; successful login also stores `huddle.token` and enters authenticated UI.\\n6. Authenticated zero-workspace state exposes `empty-state-create-workspace`, `workspace-create-form`, and `join-workspace-form` / `join-workspace-slug` / `join-workspace-submit`.\\n7. Creating a workspace via the form calls `POST /api/workspaces` and then shows shell with `workspace-header`, `channel-list`, `dms-list`, `current-user`, `logout-btn`, `message-pane`, and hidden `thread-panel`.\\n8. Sidebar is visually distinct (coloured) from the message pane; workspace identity appears in the sidebar/`workspace-header`.\\n9. Logout via `logout-btn` clears bearer storage (all token keys) and returns to auth UI; `huddle.workspaceSlug` remains.\\n10. Logging in again as the same user restores the previous workspace (same slug in header/lists) without manually re-picking, when membership still exists.\\n11. Layout is usable at **1280×900** without requiring horizontal scrolling for the three-pane shell (thread collapsed).\\n12. Negative: authenticated API calls must **not** omit the `Authorization` header when a token is present.\\n13. Negative: must **not** leave the MARATHON-2 stub-only body (“Cluster node stub”) as the sole `GET /` content.\\n14. Negative: must **not** require Node/npm to build assets for `start.sh` boot.\\n15. Reading a bearer from fallback key `token` or `huddle_token` still authenticates on boot if `/me` succeeds.\\n\\n## Testing Strategy\\n\\n### Automated\\n\\n- Extend/keep `tests/test_health.py` + cluster boot: `GET /` HTML 200 + Huddle.\\n- Add `tests/test_spa_shell.py` (TestClient): document contains critical `data-testid`s; `/static/js/app.js` (or chosen entry) returns 200; optional flow register via API then assert token key documented (storage is browser-only — HTML/API integration is enough at unit layer).\\n\\n### Manual / CUA (primary)\\n\\n1. `./start.sh`; open `http://127.0.0.1:8000/` at 1280×900.\\n2. Register invalid user → see error; register valid → land in empty/create state; confirm DevTools `localStorage[\\\"huddle.token\\\"]`.\\n3. Create workspace → sidebar shows name/slug; `#general` appears under `channel-list`.\\n4. Logout → login → same workspace restored.\\n5. Repeat load on `:8001` with same token (paste or shared storage isn’t cross-port — instead register on 8000, copy token into 8001 `localStorage`, reload) → `/me` works (cluster SoT).\\n6. Confirm thread panel not visible; message pane placeholder visible.\\n7. Toggle auth register/login; confirm selectors exist for Playwright (`document.querySelector('[data-testid=\\\"auth-form\\\"]')` etc.).\\n\\n### Out of test scope here\\n\\nFull message/thread/reaction flows (MARATHON-17); settings/invitations (MARATHON-18); successful open-workspace join (blocked on MARATHON-7 server).\",\n  \"design_format\": \"markdown\",\n  \"has_design\": true,\n  \"notes\": \"Design complete for SPA auth/token/shell. Zero-build static SPA at GET /; huddle.token + fallbacks; three-pane shell + stable data-testids. Join form wired to POST /api/workspaces/{slug}/join (server owned by MARATHON-7). Ready for lead review — keep frontend label for implementer after architect approval.\",\n  \"created_at\": \"2026-08-22T22:17:47.179119571Z\",\n  \"updated_at\": \"2026-08-22T23:29:16.855680095Z\",\n  \"created_by\": \"marathon-harness\",\n  \"description\": \"Serve SPA from GET / on any node. Sign-up form with visible error on invalid input; auto-login on success. Logout/login restores same workspace. Store bearer in localStorage huddle.token (or accepted fallbacks). Three-pane layout shell: coloured sidebar + message pane + on-demand thread panel. Workspace identity in sidebar. Stable selectors: auth-form, auth-submit, auth-toggle, auth-modal, workspace-create-form, empty-state-create-workspace, join-workspace-*, current-user, logout-btn, workspace-header, channel-list, dms-list. Drivable at 1280x900.\",\n  \"dependents\": [\n    {\n      \"issue_id\": \"MARATHON-17\",\n      \"depends_on_id\": \"MARATHON-16\",\n      \"type\": \"blocks\",\n      \"title\": \"SPA: channels, messages, threads, reactions\",\n      \"status\": \"open\",\n      \"priority\": 1,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T22:17:56.201269638Z\",\n      \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-18\",\n      \"depends_on_id\": \"MARATHON-16\",\n      \"type\": \"blocks\",\n      \"title\": \"SPA: workspace and channel settings UI\",\n      \"status\": \"open\",\n      \"priority\": 2,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T22:17:56.275071493Z\",\n      \"created_by\": \"marathon-harness\"\n    }\n  ],\n  \"comments\": [\n    {\n      \"id\": 26,\n      \"issue_id\": \"MARATHON-16\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"DESIGN-AUTO-APPROVED pass=11\",\n      \"created_at\": \"2026-08-22T23:29:16.865171828Z\"\n    }\n  ]\n}\n\nThe 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\n","stderr":"","executionTime":395,"interleavedOutput":"Updating 5859442..15b3c8e\nFast-forward\n .gitignore                       |  15 ++\n data/files/.gitkeep              |   0\n data/redis/.gitkeep              |   0\n data/redis/redis.conf            |   9 +\n data/run/.gitkeep                |   0\n requirements.txt                 |   5 +\n server/__init__.py               |   1 +\n server/app.py                    |  68 ++++++\n server/auth/__init__.py          |   6 +\n server/auth/deps.py              |  48 +++++\n server/auth/passwords.py         |  64 ++++++\n server/auth/routes.py            |  98 +++++++++\n server/auth/tokens.py            |  42 ++++\n server/auth/users.py             | 218 ++++++++++++++++++++\n server/channels/__init__.py      |   1 +\n server/channels/store.py         | 134 ++++++++++++\n server/db.py                     | 224 ++++++++++++++++++++\n server/errors.py                 |  57 +++++\n server/events.py                 |  20 ++\n server/settings.py               |  86 ++++++++\n server/users/__init__.py         |   5 +\n server/users/routes.py           |  78 +++++++\n server/workspaces/__init__.py    |   5 +\n server/workspaces/routes.py      | 117 +++++++++++\n server/workspaces/store.py       | 139 +++++++++++++\n start.sh                         | 217 +++++++++++++++++++\n tests/__init__.py                |   0\n tests/test_auth.py               | 287 ++++++++++++++++++++++++++\n tests/test_auth_cluster_token.py | 255 +++++++++++++++++++++++\n tests/test_auth_live.py          | 298 ++++++++++++++++++++++++++\n tests/test_cluster_boot.py       | 210 +++++++++++++++++++\n tests/test_cluster_respawn.py    | 284 +++++++++++++++++++++++++\n tests/test_health.py             |  86 ++++++++\n tests/test_profiles.py           | 341 ++++++++++++++++++++++++++++++\n tests/test_workspaces.py         | 436 +++++++++++++++++++++++++++++++++++++++\n 35 files changed, 3854 insertions(+)\n create mode 100644 .gitignore\n create mode 100644 data/files/.gitkeep\n create mode 100644 data/redis/.gitkeep\n create mode 100644 data/redis/redis.conf\n create mode 100644 data/run/.gitkeep\n create mode 100644 requirements.txt\n create mode 100644 server/__init__.py\n create mode 100644 server/app.py\n create mode 100644 server/auth/__init__.py\n create mode 100644 server/auth/deps.py\n create mode 100644 server/auth/passwords.py\n create mode 100644 server/auth/routes.py\n create mode 100644 server/auth/tokens.py\n create mode 100644 server/auth/users.py\n create mode 100644 server/channels/__init__.py\n create mode 100644 server/channels/store.py\n create mode 100644 server/db.py\n create mode 100644 server/errors.py\n create mode 100644 server/events.py\n create mode 100644 server/settings.py\n create mode 100644 server/users/__init__.py\n create mode 100644 server/users/routes.py\n create mode 100644 server/workspaces/__init__.py\n create mode 100644 server/workspaces/routes.py\n create mode 100644 server/workspaces/store.py\n create mode 100755 start.sh\n create mode 100644 tests/__init__.py\n create mode 100644 tests/test_auth.py\n create mode 100644 tests/test_auth_cluster_token.py\n create mode 100644 tests/test_auth_live.py\n create mode 100644 tests/test_cluster_boot.py\n create mode 100644 tests/test_cluster_respawn.py\n create mode 100644 tests/test_health.py\n create mode 100644 tests/test_profiles.py\n create mode 100644 tests/test_workspaces.py\n{\n  \"id\": \"MARATHON-16\",\n  \"title\": \"SPA: auth, token storage, workspace shell\",\n  \"status\": \"in_progress\",\n  \"priority\": 1,\n  \"issue_type\": \"task\",\n  \"assignee\": \"frontend-dev-1\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"frontend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"design\": \"# MARATHON-16 — SPA: auth, token storage, workspace shell\\n\\n## Summary\\n\\nReplace the stub `GET /` HTML with a zero-build Huddle SPA served identically from every HTTP node. The SPA owns browser session lifecycle (register → auto-login, login, logout), durable bearer storage under `localStorage` key `huddle.token` (with documented read fallbacks), restoration of the last workspace after logout/login, and the three-pane workspace shell (coloured sidebar + main message pane + on-demand thread panel) with the epic’s stable `data-testid` selectors so CUA/Playwright can drive auth and workspace onboarding at 1280×900. Messaging, channel CRUD UI, and settings modals remain later SPA tasks; this task only mounts their shell slots and wires the seams that already exist (Auth + Workspaces APIs).\\n\\n## Technical Approach\\n\\n### Decision\\n\\n| Concern | Choice |\\n|--------|--------|\\n| Delivery | **Static SPA** under `/app/static/` served by FastAPI; `GET /` returns `static/index.html` on every node |\\n| Frontend stack | **Vanilla HTML + CSS + ES modules** — no Node, no bundler, no React |\\n| API access | Same-origin relative `/api/...` (works on `:8000`/`:8001`/`:8002` without CORS or hard-coded ports) |\\n| Auth header | `Authorization: Bearer \\u003ctoken\\u003e` exactly as MARATHON-3 |\\n| Token storage | Write **`localStorage[\\\"huddle.token\\\"]`**; read primary then accepted fallbacks (below) |\\n| Workspace restore | Persist **`localStorage[\\\"huddle.workspaceSlug\\\"]`** across logout; re-select after next login |\\n| Routing | **Hash routes** (`#/`, `#/w/{slug}`) — no server path rewrite; refresh-safe on any node |\\n| Selectors | Stable **`data-testid=\\\"\\u003cname\\u003e\\\"`** attributes matching the task list exactly |\\n| Shell layout | Fixed three-pane: sidebar (coloured) \\\\| message pane \\\\| thread panel (hidden until opened) |\\n\\n### Why\\n\\n- Epic requires browser UI at `GET /` with stable selectors; MARATHON-2 explicitly deferred SPA to this task and left a stub.\\n- Zero-build static assets keep `start.sh` / Python-only ops unchanged (no second runtime), matching MARATHON-2’s self-contained cluster.\\n- Same-origin `/api` + shared SQLite tokens already work cross-node (MARATHON-3/22); the SPA must not invent per-node cookies or JWT.\\n- Hash routing avoids FastAPI catch-all complexity and keeps `GET /api/*` unambiguous.\\n- Writing only `huddle.token` while accepting read fallbacks matches the task wording and MARATHON-3’s named key without breaking graders that seed alternate keys.\\n\\n### Alternatives considered\\n\\n| Alternative | Rejected because |\\n|------------|------------------|\\n| React/Vite SPA with build step | Requires Node in `start.sh` / image; epic forbids remote services and prefers self-contained boot |\\n| Cookie/session auth | Contradicts bearer + `huddle.token` contract already locked by MARATHON-3 |\\n| Path-based SPA routes (`/w/acme`) without catch-all | Refresh on deep links 404 unless every node mounts a rewrite; hash is simpler |\\n| Server-rendered auth forms | Breaks SPA continuity for MARATHON-17/18 and CUA driving a single document |\\n| Invent join/members REST in this task | Owned by MARATHON-6/7/12; SPA locks client seam only |\\n\\n### Trade-off accepted\\n\\nJoin-workspace UI is **mounted and wired** to a join REST seam that MARATHON-7 (open-workspace auto-onboard / join) must implement. Until that endpoint exists, submit shows the server error envelope (or a clear network failure). Create-workspace is the fully working onboarding path today. We accept temporary join failures over inventing a second membership SoT in the SPA task.\\n\\n### Conventions inherited (must not diverge)\\n\\nFrom **MARATHON-2**: Product **Huddle**; `GET /` is HTML 200 on every node; `/api/...` JSON; no DinD.\\n\\nFrom **MARATHON-3**: `UserObj` key set; `{error:{code,message}}`; register/login `{user,token}`; `/api/auth/me`; bearer parsing; username/password validation rules; store token as `huddle.token`.\\n\\nFrom **MARATHON-4**: Same `UserObj`; profile PATCH not required in this shell (settings UI is MARATHON-18).\\n\\nFrom **MARATHON-5**: `WorkspaceObj` / `ChannelObj` / full `ReadStateEntry`; `POST/GET /api/workspaces`, `GET /api/workspaces/{slug}`; create body `{slug,name}`; non-member detail → 404.\\n\\n## Interface Contracts\\n\\n### Selector contract (SPA ↔ grader / CUA)\\n\\nAll names below are **`data-testid` values**. They must be present in the DOM when the corresponding UI state is visible (not merely in JS strings). Prefer exactly these strings — no prefixes.\\n\\n| `data-testid` | When visible | Role |\\n|---------------|--------------|------|\\n| `auth-modal` | Unauthenticated (or forced re-auth) | Modal/dialog wrapping the auth form |\\n| `auth-form` | Inside auth modal | `\\u003cform\\u003e` for register or login |\\n| `auth-submit` | Inside auth form | Submit control |\\n| `auth-toggle` | Inside auth modal | Control that switches register ↔ login mode |\\n| `auth-error` | After failed auth attempt | Visible text node showing `error.message` (or client validation message). **Must not** be empty/invisible on 400/401/409. |\\n| `workspace-create-form` | Authenticated empty / onboarding | Form to create workspace (`slug` + `name`) |\\n| `empty-state-create-workspace` | Authenticated with **zero** workspaces | Empty-state control/region that focuses or reveals create form |\\n| `join-workspace-form` | Authenticated empty / onboarding | Form to join by workspace slug |\\n| `join-workspace-slug` | Inside join form | Text input for slug |\\n| `join-workspace-submit` | Inside join form | Submit control |\\n| `join-workspace-error` | After failed join | Visible error text |\\n| `current-user` | Authenticated shell | Shows session user’s `display_name` (fallback `username`) |\\n| `logout-btn` | Authenticated shell | Clears token and returns to auth modal |\\n| `workspace-header` | Authenticated **with** current workspace | Shows workspace identity (`name` and/or `slug`) |\\n| `channel-list` | Authenticated with current workspace | Container for non-DM channels (may be empty of children until channels load / MARATHON-17) |\\n| `dms-list` | Authenticated with current workspace | Container for DM channels (empty until MARATHON-9/17) |\\n\\n**Auth form fields (required for drivability, not all named in the task list):**\\n\\n| `data-testid` | Element |\\n|---------------|---------|\\n| `auth-username` | Username input |\\n| `auth-password` | Password input |\\n| `auth-display-name` | Optional display name; **visible in register mode only** |\\n\\n**Workspace create fields:**\\n\\n| `data-testid` | Element |\\n|---------------|---------|\\n| `workspace-slug` | Slug input |\\n| `workspace-name` | Name input |\\n| `workspace-create-submit` | Submit |\\n| `workspace-create-error` | Visible error |\\n\\n**Shell slots for dependents (mount now, behavior later):**\\n\\n| `data-testid` | Behavior in this task |\\n|---------------|----------------------|\\n| `message-pane` | Always present when shell is shown; may show placeholder copy (“Select a channel” / empty). **No** message composer required here. |\\n| `thread-panel` | Present in DOM; **`hidden` / not displayed** by default (`display:none` or equivalent). MARATHON-17 opens it. |\\n\\n### Token storage contract (browser ↔ SPA)\\n\\n| Operation | Behavior |\\n|-----------|----------|\\n| **Write (register/login success)** | `localStorage.setItem(\\\"huddle.token\\\", token)` where `token` is the opaque string from the API. Also remove stale fallback keys if present (optional hygiene). |\\n| **Read (boot / API client)** | First non-empty string among, in order: `huddle.token`, `huddle_token`, `token`. Treat whitespace-only as missing. |\\n| **Clear (logout or 401 from `/me`)** | Remove **all** of: `huddle.token`, `huddle_token`, `token`. |\\n| **Workspace slug persist** | On successful workspace select/create/restore: `localStorage.setItem(\\\"huddle.workspaceSlug\\\", slug)`. **Do not** clear this on logout (required for “logout/login restores same workspace”). |\\n| **Negative** | Must **not** store the bearer in cookies, `sessionStorage` only, or URL query strings. |\\n\\n### Seam: Browser ↔ `GET /` (and static assets)\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Server (each node)** | `GET /` → **200** `text/html` document that boots the SPA (title/brand includes **Huddle**). Serve `/static/*` assets with correct MIME types. No auth required. |\\n| **Client** | Load JS; run boot sequence below. |\\n\\n**Failure / slow:** TCP errors until node respawn (≤60s) — same as MARATHON-2. Asset 404 → blank UI; implementer must keep relative paths correct.\\n\\n### Seam: SPA ↔ `POST /api/auth/register`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Client** | Body `{username, password, display_name?}` matching MARATHON-3. Disable `auth-submit` while in flight. On **201**: store token, set session user from `user`, close/hide auth modal, continue boot (list workspaces). On **400/409**: show `error.message` in `auth-error` (visible). On network/5xx: show a generic visible error in `auth-error`. |\\n| **Server** | Unchanged (MARATHON-3). |\\n\\n**Auto-login:** Register success **is** login — do **not** require a second login call. Token from register response is sufficient.\\n\\n### Seam: SPA ↔ `POST /api/auth/login`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Client** | Body `{username, password}`. Same storage + navigation as register. On **401/400**: visible `auth-error` with `error.message`. |\\n| **Server** | Unchanged. |\\n\\n### Seam: SPA ↔ `GET /api/auth/me`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Client** | On boot if a token is readable: call with bearer. While pending: show a lightweight boot placeholder; **do not** flash the auth modal if a token exists. On **200**: set session user from `user`. On **401**: clear all token keys; show auth modal. |\\n| **Server** | Unchanged. |\\n\\n### Seam: SPA ↔ `GET /api/workspaces` / `POST /api/workspaces` / `GET /api/workspaces/{slug}`\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Client** | All calls send bearer. **List** after auth: if `workspaces.length === 0`, show empty state (`empty-state-create-workspace` + create + join forms). If non-empty: prefer `huddle.workspaceSlug` if it appears in the list; else first list item (sorted as server returns). **Create**: `POST` `{slug,name}`; on **201** persist slug, load detail, enter shell. On **400/409** show `workspace-create-error`. **Detail**: populate `workspace-header`, split `channels` into `channel-list` (`is_dm === false`) and `dms-list` (`is_dm === true`); ignore `read_state` badges in this task (optional no-op). On detail **404**: clear invalid stored slug, fall back to list/empty. On any **401**: logout locally. |\\n| **Server** | Unchanged (MARATHON-5). |\\n\\n**Channel row markup (minimal, for MARATHON-17):** each channel entry **should** expose `data-channel-id=\\\"{id}\\\"` and `data-channel-name=\\\"{name}\\\"` when listed. Display name may show `#` prefix for non-DM; stored `name` remains without `#`.\\n\\n### Seam: SPA ↔ `POST /api/workspaces/{slug}/join` (client locked here; server owned by MARATHON-7)\\n\\n| Side | Responsibility |\\n|------|----------------|\\n| **Client** | Body `{}` (ignore extras). Bearer required. Disable submit while in flight. On **200** with `{workspace: WorkspaceObj}` (optional `channels` / `read_state` if server returns them): persist slug, enter shell (fetch detail if channels omitted). On **4xx**: show `error.message` in `join-workspace-error`. |\\n| **Server (MARATHON-7)** | For `join_mode=open`, add caller as `member` if not already; return 200. For `invite_only`, **403** (invitations are MARATHON-12). Unknown slug → **404** envelope. Idempotent if already a member → **200**. |\\n\\n**Until MARATHON-7 lands:** SPA still renders join controls; failed submit must surface a visible error (not a silent no-op).\\n\\n### HTTP client rules (SPA owns)\\n\\n1. `Content-Type: application/json` on POST bodies.\\n2. Parse JSON error envelope; never assume FastAPI `detail`.\\n3. Timeouts: recommend ~15s; on abort/network error show visible error on the active form.\\n4. Do not retry 401/409 blindly; do not infinite-retry `/me`.\\n\\n### Auth modal UX\\n\\n- Default mode on first visit: **register** (sign-up), matching “Sign-up form with visible error…”.\\n- `auth-toggle` switches to login and back; update submit label/copy accordingly.\\n- Client-side pre-check may mirror username/password rules for faster UX, but **server messages win** on response.\\n\\n## Data Model\\n\\n### Browser (no SQLite changes in this task)\\n\\n| Key | Type | Lifetime | Notes |\\n|-----|------|----------|-------|\\n| `localStorage[\\\"huddle.token\\\"]` | string | Until logout / 401 | Canonical bearer |\\n| `localStorage[\\\"huddle_token\\\"]` | string | Read fallback only | Accepted fallback |\\n| `localStorage[\\\"token\\\"]` | string | Read fallback only | Accepted fallback |\\n| `localStorage[\\\"huddle.workspaceSlug\\\"]` | string | Survives logout | Last workspace slug |\\n\\n### In-memory SPA state (not persisted)\\n\\n| Field | Type | Notes |\\n|-------|------|-------|\\n| `user` | `UserObj` \\\\| null | From register/login/`/me` |\\n| `workspaces` | `WorkspaceObj[]` | From list |\\n| `currentWorkspace` | `WorkspaceObj` \\\\| null | Selected |\\n| `channels` | `ChannelObj[]` | From detail |\\n| `authMode` | `\\\"register\\\"` \\\\| `\\\"login\\\"` | Modal mode |\\n| `threadOpen` | boolean | Default `false` |\\n\\n### Server schema\\n\\n**No migration.** This task does not alter SQLite. Backward compatible with migrations v0–v2.\\n\\n## Files to Create / Files to Modify\\n\\n### Create\\n\\n| File | Change |\\n|------|--------|\\n| `static/index.html` | SPA shell markup: auth modal, empty/onboarding, three-pane layout; all required `data-testid`s; `\\u003ctitle\\u003eHuddle\\u003c/title\\u003e`; script `type=\\\"module\\\"` entry. |\\n| `static/css/app.css` | Layout for 1280×900: coloured sidebar (≥~220px), message pane flex-grow, thread panel (~320px) hidden by default; auth modal overlay; visible error styles (not `visibility:hidden` when populated). |\\n| `static/js/storage.js` | Token read/write/clear with fallbacks; workspace slug get/set. |\\n| `static/js/api.js` | `api(method, path, {token, body})` → JSON; maps envelope errors. |\\n| `static/js/auth_ui.js` | Register/login toggle, submit handlers, auto-login on register, error rendering. |\\n| `static/js/shell.js` | Empty state, create/join forms, workspace header, channel/dms lists, logout, hash routing. |\\n| `static/js/app.js` | Boot: read token → `/me` → list → restore slug → render. |\\n\\n(Implementer may collapse JS files if behavior and selectors match; names above are the preferred split.)\\n\\n### Modify\\n\\n| File | Change |\\n|------|--------|\\n| `server/app.py` | Replace inline stub HTML with `FileResponse` to `static/index.html` (path resolved from app root). Mount `StaticFiles` at `/static` pointing at `static/`. Keep `/api/health` and routers unchanged. Ensure `/` is registered **before** any catch-all; do not shadow `/api/*`. |\\n| `tests/test_health.py` | Keep asserting `GET /` 200 HTML + `\\\"Huddle\\\"` in body (still true). Optionally assert a stable selector string appears in HTML (e.g. `data-testid=\\\"auth-form\\\"`) — recommended, not mandatory if covered by a new SPA test file. |\\n| `tests/test_spa_shell.py` (create) | TestClient: `/` contains required testids; `/static/...` 200; optional auth flow via API + HTML presence (no browser required for unit). |\\n\\n### Do not modify\\n\\n| File | Reason |\\n|------|--------|\\n| `server/auth/*`, `server/workspaces/*`, `server/users/*` | Contracts already shipped; SPA is consumer only |\\n| `start.sh` | No build step to add |\\n| `timer.sh` | Harness-owned |\\n\\n## Sequencing and Cross-Task Seams\\n\\n### Build order within this task\\n\\n1. Static files + `app.py` serve path (unblocks `GET /` HTML checks).\\n2. `storage.js` + `api.js`.\\n3. Auth modal + register/login/`/me` boot.\\n4. Workspace list/create/empty state + slug restore.\\n5. Shell chrome (sidebar colour, header, channel/dms lists, logout, thread slot).\\n6. Join form wired to join seam (tolerate backend absence via visible error).\\n\\n### Parallelism\\n\\n- Can implement entirely in parallel with MARATHON-6/8/9/10/… **except** join success depends on MARATHON-7’s open-workspace join/auto-onboard.\\n- MARATHON-17/18 **must** land after this shell (they depend on this task).\\n\\n### Seams this task owns for dependents\\n\\n| Contract | Consumer |\\n|----------|----------|\\n| `data-testid` shell + auth set above | QA / CUA; MARATHON-17/18 |\\n| `huddle.token` + fallbacks + `huddle.workspaceSlug` | All later SPA tasks |\\n| Hash route `#/w/{slug}` + in-memory workspace/channel selection hooks | MARATHON-17 |\\n| Hidden `thread-panel` slot | MARATHON-17 |\\n| `channel-list` / `dms-list` containers + `data-channel-id` | MARATHON-17 |\\n| Client call shape `POST /api/workspaces/{slug}/join` | MARATHON-7 must implement server |\\n\\n### Split follow-ups (already exist — do not recreate)\\n\\n- **MARATHON-17** — messages, threads, reactions, channel create/switch UI inside this shell.\\n- **MARATHON-18** — workspace/channel settings modals.\\n- **MARATHON-7** — server join / open auto-onboard so join form succeeds.\\n\\n## Out of Scope (Needs a Separate Task)\\n\\n| Item | Where found | Why excluded |\\n|------|-------------|--------------|\\n| Message composer, edit/delete, reactions, emoji picker | MARATHON-17 description; no message routes yet (MARATHON-8 open) | Dependent SPA task |\\n| Opening/populating `thread-panel` with replies | MARATHON-17 | Shell only mounts hidden slot |\\n| Workspace settings / invitations UI (`workspace-settings-modal`, invitation testids) | MARATHON-18; APIs MARATHON-6/12 | Different task |\\n| Channel create/join/leave/archive/pins REST | `server/channels/store.py` helpers only; no routes | MARATHON-7 |\\n| DM get-or-create | No DM API | MARATHON-9; `dms-list` stays empty-capable |\\n| Profile PATCH UI | `PATCH /api/users/me` exists | MARATHON-18 / settings |\\n| WebSocket subscribe/resume | No WS routes | MARATHON-13 |\\n| Logout token revoke API | MARATHON-3 explicitly out of scope | Client clears storage only |\\n| IRC / Redis fan-out UI | Cluster tasks | Unrelated |\\n| Stub text “Cluster node stub.” | `server/app.py` | Replaced by SPA in this task (in scope to remove) |\\n\\nNeighborhood scan accounted for: `HTMLResponse` stub in `server/app.py`; `tests/test_health.py` + `tests/test_cluster_boot.py` `GET /` HTML assertions (remain valid if brand “Huddle” + HTML document preserved); no existing `static/` tree; no `localStorage` / `data-testid` hits in-repo yet.\\n\\n## Edge Cases \\u0026 Error Handling\\n\\n| Case | Expected behavior |\\n|------|-------------------|\\n| Invalid register username/password (client or 400) | Show message in **visible** `auth-error`; stay on form; do **not** store token |\\n| Register username taken (409) | Visible `auth-error` with server message; no token write |\\n| Login bad credentials (401) | Visible `auth-error`; no token write |\\n| Register success | Store token; treat as logged in; **no** manual login step |\\n| Boot with valid token | `/me` then workspace flow; auth modal **not** shown |\\n| Boot with garbage token | `/me` 401 → clear tokens → auth modal |\\n| Boot with fallback key only (`token` set, `huddle.token` absent) | Read fallback; on next successful login/register rewrite canonical `huddle.token` |\\n| Logout | Clear token keys; show auth modal; **keep** `huddle.workspaceSlug`; clear in-memory user/channels |\\n| Login after logout with same user | Restore workspace from `huddle.workspaceSlug` if still a member; else first workspace or empty state |\\n| Stored slug for workspace user left / never joined | Detail 404 → drop slug selection; re-list; do not loop |\\n| Create workspace validation/conflict | Visible `workspace-create-error`; remain on form |\\n| Join before MARATHON-7 (404/405/network) | Visible `join-workspace-error`; do not fake membership client-side |\\n| API slow | Disable active submit; keep prior UI; no double-submit |\\n| `GET /` on :8001/:8002 | Same SPA bytes/behavior as :8000 |\\n| Thread panel default | Not visible; must **not** cover message pane at 1280×900 |\\n| Empty channel/dms lists | Containers still present with testids; empty children OK |\\n| Password in DOM errors | Never echo password into `auth-error` |\\n| Unknown JSON fields from server | Ignore extras; do not crash |\\n| `include_archived` | Shell detail calls **omit** query (default hide archived) |\\n\\n## Acceptance Criteria\\n\\n1. `GET http://127.0.0.1:800{0,1,2}/` → **200** HTML containing brand **Huddle** and bootstraps the SPA (script/CSS load without 404).\\n2. Unauthenticated visit shows `auth-modal`, `auth-form`, `auth-submit`, `auth-toggle`.\\n3. Sign-up with invalid input (e.g. short password) shows a **visible** error (readable in `auth-error` / form error UI); must **not** set `huddle.token`.\\n4. Sign-up with valid input → **201** path: token stored at `localStorage[\\\"huddle.token\\\"]` (len ≥ 16); user is logged in **without** a separate login submit; auth modal dismissed.\\n5. `auth-toggle` switches to login; successful login also stores `huddle.token` and enters authenticated UI.\\n6. Authenticated zero-workspace state exposes `empty-state-create-workspace`, `workspace-create-form`, and `join-workspace-form` / `join-workspace-slug` / `join-workspace-submit`.\\n7. Creating a workspace via the form calls `POST /api/workspaces` and then shows shell with `workspace-header`, `channel-list`, `dms-list`, `current-user`, `logout-btn`, `message-pane`, and hidden `thread-panel`.\\n8. Sidebar is visually distinct (coloured) from the message pane; workspace identity appears in the sidebar/`workspace-header`.\\n9. Logout via `logout-btn` clears bearer storage (all token keys) and returns to auth UI; `huddle.workspaceSlug` remains.\\n10. Logging in again as the same user restores the previous workspace (same slug in header/lists) without manually re-picking, when membership still exists.\\n11. Layout is usable at **1280×900** without requiring horizontal scrolling for the three-pane shell (thread collapsed).\\n12. Negative: authenticated API calls must **not** omit the `Authorization` header when a token is present.\\n13. Negative: must **not** leave the MARATHON-2 stub-only body (“Cluster node stub”) as the sole `GET /` content.\\n14. Negative: must **not** require Node/npm to build assets for `start.sh` boot.\\n15. Reading a bearer from fallback key `token` or `huddle_token` still authenticates on boot if `/me` succeeds.\\n\\n## Testing Strategy\\n\\n### Automated\\n\\n- Extend/keep `tests/test_health.py` + cluster boot: `GET /` HTML 200 + Huddle.\\n- Add `tests/test_spa_shell.py` (TestClient): document contains critical `data-testid`s; `/static/js/app.js` (or chosen entry) returns 200; optional flow register via API then assert token key documented (storage is browser-only — HTML/API integration is enough at unit layer).\\n\\n### Manual / CUA (primary)\\n\\n1. `./start.sh`; open `http://127.0.0.1:8000/` at 1280×900.\\n2. Register invalid user → see error; register valid → land in empty/create state; confirm DevTools `localStorage[\\\"huddle.token\\\"]`.\\n3. Create workspace → sidebar shows name/slug; `#general` appears under `channel-list`.\\n4. Logout → login → same workspace restored.\\n5. Repeat load on `:8001` with same token (paste or shared storage isn’t cross-port — instead register on 8000, copy token into 8001 `localStorage`, reload) → `/me` works (cluster SoT).\\n6. Confirm thread panel not visible; message pane placeholder visible.\\n7. Toggle auth register/login; confirm selectors exist for Playwright (`document.querySelector('[data-testid=\\\"auth-form\\\"]')` etc.).\\n\\n### Out of test scope here\\n\\nFull message/thread/reaction flows (MARATHON-17); settings/invitations (MARATHON-18); successful open-workspace join (blocked on MARATHON-7 server).\",\n  \"design_format\": \"markdown\",\n  \"has_design\": true,\n  \"notes\": \"Design complete for SPA auth/token/shell. Zero-build static SPA at GET /; huddle.token + fallbacks; three-pane shell + stable data-testids. Join form wired to POST /api/workspaces/{slug}/join (server owned by MARATHON-7). Ready for lead review — keep frontend label for implementer after architect approval.\",\n  \"created_at\": \"2026-08-22T22:17:47.179119571Z\",\n  \"updated_at\": \"2026-08-22T23:29:16.855680095Z\",\n  \"created_by\": \"marathon-harness\",\n  \"description\": \"Serve SPA from GET / on any node. Sign-up form with visible error on invalid input; auto-login on success. Logout/login restores same workspace. Store bearer in localStorage huddle.token (or accepted fallbacks). Three-pane layout shell: coloured sidebar + message pane + on-demand thread panel. Workspace identity in sidebar. Stable selectors: auth-form, auth-submit, auth-toggle, auth-modal, workspace-create-form, empty-state-create-workspace, join-workspace-*, current-user, logout-btn, workspace-header, channel-list, dms-list. Drivable at 1280x900.\",\n  \"dependents\": [\n    {\n      \"issue_id\": \"MARATHON-17\",\n      \"depends_on_id\": \"MARATHON-16\",\n      \"type\": \"blocks\",\n      \"title\": \"SPA: channels, messages, threads, reactions\",\n      \"status\": \"open\",\n      \"priority\": 1,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T22:17:56.201269638Z\",\n      \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-18\",\n      \"depends_on_id\": \"MARATHON-16\",\n      \"type\": \"blocks\",\n      \"title\": \"SPA: workspace and channel settings UI\",\n      \"status\": \"open\",\n      \"priority\": 2,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T22:17:56.275071493Z\",\n      \"created_by\": \"marathon-harness\"\n    }\n  ],\n  \"comments\": [\n    {\n      \"id\": 26,\n      \"issue_id\": \"MARATHON-16\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"DESIGN-AUTO-APPROVED pass=11\",\n      \"created_at\": \"2026-08-22T23:29:16.865171828Z\"\n    }\n  ]\n}\n\nThe 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\n","localExecutionTimeMs":72},"isBackground":false},"description":"Merge main and show task details"},"hookAdditionalContexts":[],"toolCallId":"call-a2510450-571c-4efe-bf38-22c27da06015-0\nfc_5e4ac960-b1cb-95ad-83c9-ed05a0fe503b_0","startedAtMs":"1787441372621","completedAtMs":"1787441373017"},"model_call_id":"c781bfeb-1694-425e-b8b9-b03c753b4006-0-9996","session_id":"75b83ce2-263e-490f-8522-60490e83f05e","timestamp_ms":1787441373059}
