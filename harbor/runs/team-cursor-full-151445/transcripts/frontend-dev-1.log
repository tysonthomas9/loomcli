{"type":"tool_call","subtype":"started","call_id":"call-cc7b1488-4801-4188-8eaf-d1f6deaf26d5-21\nfc_d1bad0a1-c942-9708-8a3c-4b155d46ca51_0","tool_call":{"editToolCall":{"args":{"path":"/work/ws/worktrees/app/frontend-dev-1/server/channels/store.py","streamContent":"def _row_to_read_state_entry(\n    row: sqlite3.Row | dict[str, Any] | None, *, channel_id: str\n) -> dict[str, Any]:\n    if row is None:\n        return {\n            \"channel_id\": channel_id,\n            \"last_read_seq\": 0,\n            \"unread_count\": 0,\n            \"mention_count\": 0,\n        }\n    get = row.__getitem__\n    unread = get(\"unread_count\")\n    mention = get(\"mention_count\")\n    return {\n        \"channel_id\": get(\"channel_id\") if \"channel_id\" in row.keys() else channel_id,  # type: ignore[union-attr]\n        \"last_read_seq\": int(get(\"last_read_seq\") or 0),\n        \"unread_count\": int(0 if unread is None else unread),\n        \"mention_count\": int(0 if mention is None else mention),\n    }\n\n\ndef get_read_state_entry(\n    conn: sqlite3.Connection, *, channel_id: str, user_id: str\n) -> dict[str, Any]:\n    \"\"\"Return ReadStateEntry for caller; defaults to zeros when no row.\"\"\"\n    row = conn.execute(\n        \"\"\"\n        SELECT channel_id, last_read_seq, unread_count, mention_count\n        FROM channel_read_state\n        WHERE channel_id = ? AND user_id = ?\n        \"\"\",\n        (channel_id, user_id),\n    ).fetchone()\n    return _row_to_read_state_entry(row, channel_id=channel_id)\n\n\ndef _channel_events_table_exists(conn: sqlite3.Connection) -> bool:\n    row = conn.execute(\n        \"\"\"\n        SELECT 1 FROM sqlite_master\n        WHERE type = 'table' AND name = 'channel_events'\n        \"\"\"\n    ).fetchone()\n    return row is not None\n\n\ndef _recompute_counts_from_events(\n    conn: sqlite3.Connection,\n    *,\n    channel_id: str,\n    user_id: str,\n    after_seq: int,\n) -> tuple[int, int]:\n    \"\"\"Recompute unread/mention from channel_events when M13 tables exist.\"\"\"\n    rows = conn.execute(\n        \"\"\"\n        SELECT seq, type, payload_json\n        FROM channel_events\n        WHERE channel_id = ? AND seq > ? AND type = 'message.created'\n        ORDER BY seq ASC\n        \"\"\",\n        (channel_id, after_seq),\n    ).fetchall()\n    unread = 0\n    mention = 0\n    for row in rows:\n        unread += 1\n        payload_raw = row[\"payload_json\"]\n        if not payload_raw:\n            continue\n        try:\n            import json\n\n            payload = json.loads(payload_raw)\n        except (TypeError, ValueError):\n            continue\n        message = payload.get(\"message\") if isinstance(payload, dict) else None\n        if not isinstance(message, dict):\n            continue\n        mentions = message.get(\"mentions\")\n        if isinstance(mentions, list) and user_id in mentions:\n            mention += 1\n    return unread, mention\n\n\ndef upsert_advance_read_state(\n    conn: sqlite3.Connection,\n    *,\n    channel_id: str,\n    user_id: str,\n    last_read_seq: int,\n) -> dict[str, Any]:\n    \"\"\"Advance read cursor (never backwards). Returns ReadStateEntry.\"\"\"\n    if (\n        not isinstance(last_read_seq, int)\n        or isinstance(last_read_seq, bool)\n        or last_read_seq < 0\n    ):\n        raise ApiError(400, \"validation_error\", \"invalid last_read_seq\")\n\n    current = get_read_state_entry(conn, channel_id=channel_id, user_id=user_id)\n    if last_read_seq < current[\"last_read_seq\"]:\n        return current\n\n    new_cursor = last_read_seq\n    if new_cursor == current[\"last_read_seq\"] and conn.execute(\n        \"\"\"\n        SELECT 1 FROM channel_read_state\n        WHERE channel_id = ? AND user_id = ?\n        \"\"\",\n        (channel_id, user_id),\n    ).fetchone() is not None:\n        # Same cursor and row exists — still allow recompute/zero path when\n        # client posts the current cursor to clear (advance path only when\n        # request >= current; equal counts as \"advanced\" for mark-read).\n        pass\n\n    if _channel_events_table_exists(conn):\n        unread, mention = _recompute_counts_from_events(\n            conn,\n            channel_id=channel_id,\n            user_id=user_id,\n            after_seq=new_cursor,\n        )\n    else:\n        unread, mention = 0, 0\n\n    now = utc_now_z()\n    conn.execute(\n        \"\"\"\n        INSERT INTO channel_read_state (\n            channel_id, user_id, last_read_seq, unread_count, mention_count,\n            updated_at\n        ) VALUES (?, ?, ?, ?, ?, ?)\n        ON CONFLICT(channel_id, user_id) DO UPDATE SET\n            last_read_seq = excluded.last_read_seq,\n            unread_count = excluded.unread_count,\n            mention_count = excluded.mention_count,\n            updated_at = excluded.updated_at\n        \"\"\",\n        (channel_id, user_id, new_cursor, unread, mention, now),\n    )\n    return {\n        \"channel_id\": channel_id,\n        \"last_read_seq\": new_cursor,\n        \"unread_count\": unread,\n        \"mention_count\": mention,\n    }\n\n\ndef bump_unread_for_message(\n    conn: sqlite3.Connection,\n    *,\n    channel_id: str,\n    author_id: str,\n    mention_user_ids: list[str],\n) -> None:\n    \"\"\"Increment unread (and mention when applicable) for other channel members.\"\"\"\n    mention_set = set(mention_user_ids)\n    rows = conn.execute(\n        \"\"\"\n        SELECT user_id FROM channel_members\n        WHERE channel_id = ? AND user_id != ?\n        \"\"\",\n        (channel_id, author_id),\n    ).fetchall()\n    now = utc_now_z()\n    for row in rows:\n        member_id = row[\"user_id\"]\n        mention_bump = 1 if member_id in mention_set else 0\n        conn.execute(\n            \"\"\"\n            INSERT INTO channel_read_state (\n                channel_id, user_id, last_read_seq, unread_count, mention_count,\n                updated_at\n            ) VALUES (?, ?, 0, 1, ?, ?)\n            ON CONFLICT(channel_id, user_id) DO UPDATE SET\n                unread_count = unread_count + 1,\n                mention_count = mention_count + excluded.mention_count,\n                updated_at = excluded.updated_at\n            \"\"\",\n            (channel_id, member_id, mention_bump, now),\n        )\n\n\ndef list_read_state_for_channels(\n    conn: sqlite3.Connection,\n    *,\n    user_id: str,\n    channel_ids: list[str],\n) -> list[dict[str, Any]]:\n    \"\"\"Full ReadStateEntry list for caller, only for the given visible channel ids.\"\"\"\n    if not channel_ids:\n        return []\n    placeholders = \",\".join(\"?\" for _ in channel_ids)\n    rows = conn.execute(\n        f\"\"\"\n        SELECT channel_id, last_read_seq, unread_count, mention_count\n        FROM channel_read_state\n        WHERE user_id = ?\n          AND channel_id IN ({placeholders})\n        ORDER BY channel_id ASC\n        \"\"\",\n        (user_id, *channel_ids),\n    ).fetchall()\n    entries: list[dict[str, Any]] = []\n    for row in rows:\n        entries.append(_row_to_read_state_entry(row, channel_id=row[\"channel_id\"]))\n    return entries"}},"hookAdditionalContexts":[],"toolCallId":"call-cc7b1488-4801-4188-8eaf-d1f6deaf26d5-21\nfc_d1bad0a1-c942-9708-8a3c-4b155d46ca51_0","startedAtMs":"1787448841506"},"model_call_id":"3bd2270e-ce83-412d-96ec-753a4a8b6e30-6-n3ar","session_id":"3b1cca86-e2c4-4155-803f-216a5e66f757","timestamp_ms":1787448841543}
