ode = (envelope && envelope.code) || \"http_error\";\n    const message =\n      (envelope && envelope.message) ||\n      `Request failed (${response.status})`;\n    throw new ApiClientError(response.status, code, message, data);\n  }\n\n  return data;\n}\n","isEmpty":false,"exceededLimit":false,"totalLines":72,"fileSize":1891,"path":"/work/ws/worktrees/app/app-architect-1/static/js/api.js","readRange":{"startLine":1,"endLine":72},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-8813a1a2-6d22-4d9a-8be0-e8fbdd3d4e93-30\nfc_6b3ad4d0-25b2-9e6f-85c5-0cc47c6b29f8_0","startedAtMs":"1787448210395","completedAtMs":"1787448210466"},"model_call_id":"ab9a4556-2cd1-430e-8cba-93dc22d517bb-8-p6c8","session_id":"27ef4deb-7d8c-45c3-96ef-6099aabacf08","timestamp_ms":1787448210493}
