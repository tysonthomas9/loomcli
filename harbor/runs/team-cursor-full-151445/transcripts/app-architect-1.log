 JSONResponse:\n        return JSONResponse(\n            content={\"status\": \"ok\", \"node_id\": cfg.node_id},\n            status_code=200,\n        )\n\n    @application.get(\"/\")\n    def root() -> FileResponse:\n        return FileResponse(\n            INDEX_HTML,\n            media_type=\"text/html\",\n        )\n\n    application.mount(\n        \"/static\",\n        StaticFiles(directory=str(STATIC_DIR)),\n        name=\"static\",\n    )\n\n    return application\n\n\n# Uvicorn target: server.app:app (HUDDLE_NODE_ID must be set by start.sh).\n# Avoid constructing at import time during unit tests with no env.\napp: FastAPI | None\nif os.environ.get(\"HUDDLE_NODE_ID\"):\n    app = create_app()\nelse:\n    app = None\n","isEmpty":false,"exceededLimit":false,"totalLines":77,"fileSize":2351,"path":"/work/ws/worktrees/app/app-architect-1/server/app.py","readRange":{"startLine":1,"endLine":77},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-a6432862-5794-46b5-b81d-b2bac06ff17f-39\nfc_ed1add3f-b95e-94d0-8d93-759ed4a281be_2","startedAtMs":"1787442950254","completedAtMs":"1787442950311"},"model_call_id":"438a6877-8e55-4735-9a6e-84c06d232d5b-14-s6r0","session_id":"f5e6916f-935a-4f8e-a49f-5fc028dab3e9","timestamp_ms":1787442950335}
