ode = (envelope && envelope.code) || \"http_error\";\n    const message =\n      (envelope && envelope.message) ||\n      `Request failed (${response.status})`;\n    throw new ApiClientError(response.status, code, message, data);\n  }\n\n  return data;\n}\n","isEmpty":false,"exceededLimit":false,"totalLines":72,"fileSize":1891,"path":"/work/ws/worktrees/app/app-architect-1/static/js/api.js","readRange":{"startLine":1,"endLine":72},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-8fe80199-f1d9-4b77-a0f6-d088ee1d13d3-42\nfc_ab13a12b-b58d-99ff-8948-b42ca0bad2b2_2","startedAtMs":"1787445063296","completedAtMs":"1787445063766"},"model_call_id":"9f6c9f7b-0f6e-481b-af84-0b50164c6a84-14-vcfl","session_id":"83d80305-f80e-4005-a214-b95749113409","timestamp_ms":1787445063787}
