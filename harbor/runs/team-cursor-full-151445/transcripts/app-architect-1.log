`topic` default `\"\"`; `is_dm=false`; creator in `channel_members`.","contentTruncated":false,"isContextLine":false},{"lineNumber":520,"content":"2. Duplicate channel name in workspace → **409** `conflict`.","contentTruncated":false,"isContextLine":false},{"lineNumber":521,"content":"3. Invalid kebab name or topic > 250 → **400** `validation_error`.","contentTruncated":false,"isContextLine":false}]}],"totalLines":16,"totalMatchedLines":16,"clientTruncated":false,"ripgrepTruncated":false}}}}}},"hookAdditionalContexts":[],"toolCallId":"call-78225085-3d28-418e-b6f7-3d9a1ea01878-47\nfc_446ae43f-337e-9205-9640-31e4fc47203e_4","startedAtMs":"1787447806926","completedAtMs":"1787447807319"},"model_call_id":"03dd848d-d7bd-4877-bfbf-ce6458bc28c6-14-uwdb","session_id":"8d1f97e9-e376-440d-a791-e2992491ec56","timestamp_ms":1787447807342}
