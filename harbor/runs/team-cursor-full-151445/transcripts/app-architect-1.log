AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n  -o, --output string       Output format: text|json (default \"text\")\n      --server string       Loom server base URL (or LOOM_SERVER_URL env var)\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n","localExecutionTimeMs":90},"isBackground":false},"description":"Check loom update design flags"},"hookAdditionalContexts":[],"toolCallId":"call-02bbe7bc-c5be-4ede-9708-4150ac0df1ff-20\nfc_52e332db-a39e-920e-b221-4f53f84639c0_0","startedAtMs":"1787439279865","completedAtMs":"1787439280023"},"model_call_id":"cbbf853b-a840-46f0-9a2b-21d12888bf73-6-51yn","session_id":"19c28e8f-4a6a-4050-b949-adbad7131377","timestamp_ms":1787439280049}
