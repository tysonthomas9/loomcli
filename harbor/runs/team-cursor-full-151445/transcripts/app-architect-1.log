tMs":"1787444710569"},"model_call_id":"b6dbef0b-e6fb-4ca9-8c38-d48246858510-6-pwxe","session_id":"3f743427-f194-44bc-92dc-836b7b6940f7","timestamp_ms":1787444710591}
