+\n server/users/routes.py           |  78 +++++++\n server/workspaces/__init__.py    |   5 +\n server/workspaces/routes.py      | 117 +++++++++++\n server/workspaces/store.py       | 139 +++++++++++++\n tests/test_auth.py               |   1 +\n tests/test_auth_cluster_token.py | 255 +++++++++++++++++++++++\n tests/test_auth_live.py          | 298 ++++++++++++++++++++++++++\n tests/test_profiles.py           | 341 ++++++++++++++++++++++++++++++\n tests/test_workspaces.py         | 436 +++++++++++++++++++++++++++++++++++++++\n 17 files changed, 2019 insertions(+), 3 deletions(-)\n create mode 100644 server/channels/__init__.py\n create mode 100644 server/channels/store.py\n create mode 100644 server/events.py\n create mode 100644 server/users/__init__.py\n create mode 100644 server/users/routes.py\n create mode 100644 server/workspaces/__init__.py\n create mode 100644 server/workspaces/routes.py\n create mode 100644 server/workspaces/store.py\n create mode 100644 tests/test_auth_cluster_token.py\n create mode 100644 tests/test_auth_live.py\n create mode 100644 tests/test_profiles.py\n create mode 100644 tests/test_workspaces.py\n{\n  \"id\": \"MARATHON-16\",\n  \"title\": \"SPA: auth, token storage, workspace shell\",\n  \"status\": \"in_progress\",\n  \"priority\": 1,\n  \"issue_type\": \"task\",\n  \"assignee\": \"app-architect-1\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"architect\",\n    \"frontend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"has_design\": false,\n  \"created_at\": \"2026-08-22T22:17:47.179119571Z\",\n  \"updated_at\": \"2026-08-22T22:17:47.179119571Z\",\n  \"created_by\": \"marathon-harness\",\n  \"description\": \"Serve SPA from GET / on any node. Sign-up form with visible error on invalid input; auto-login on success. Logout/login restores same workspace. Store bearer in localStorage huddle.token (or accepted fallbacks). Three-pane layout shell: coloured sidebar + message pane + on-demand thread panel. Workspace identity in sidebar. Stable selectors: auth-form, auth-submit, auth-toggle, auth-modal, workspace-create-form, empty-state-create-workspace, join-workspace-*, current-user, logout-btn, workspace-header, channel-list, dms-list. Drivable at 1280x900.\",\n  \"dependents\": [\n    {\n      \"issue_id\": \"MARATHON-17\",\n      \"depends_on_id\": \"MARATHON-16\",\n      \"type\": \"blocks\",\n      \"title\": \"SPA: channels, messages, threads, reactions\",\n      \"status\": \"open\",\n      \"priority\": 1,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T22:17:56.201269638Z\",\n      \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-18\",\n      \"depends_on_id\": \"MARATHON-16\",\n      \"type\": \"blocks\",\n      \"title\": \"SPA: workspace and channel settings UI\",\n      \"status\": \"open\",\n      \"priority\": 2,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T22:17:56.275071493Z\",\n      \"created_by\": \"marathon-harness\"\n    }\n  ]\n}\nThe 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\n","stderr":"time=2026-08-22T23:11:48.838Z level=INFO msg=\"opened existing embedded fleet-db client\" url=http://127.0.0.1:44829\n","executionTime":377,"interleavedOutput":"Updating 00d49c6..15b3c8e\nFast-forward\n server/app.py                    |   4 +\n server/auth/users.py             |  98 +++++++++\n server/channels/__init__.py      |   1 +\n server/channels/store.py         | 134 ++++++++++++\n server/db.py                     |  83 ++++++++\n server/errors.py                 |   7 +-\n server/events.py                 |  20 ++\n server/users/__init__.py         |   5 +\n server/users/routes.py           |  78 +++++++\n server/workspaces/__init__.py    |   5 +\n server/workspaces/routes.py      | 117 +++++++++++\n server/workspaces/store.py       | 139 +++++++++++++\n tests/test_auth.py               |   1 +\n tests/test_auth_cluster_token.py | 255 +++++++++++++++++++++++\n tests/test_auth_live.py          | 298 ++++++++++++++++++++++++++\n tests/test_profiles.py           | 341 ++++++++++++++++++++++++++++++\n tests/test_workspaces.py         | 436 +++++++++++++++++++++++++++++++++++++++\n 17 files changed, 2019 insertions(+), 3 deletions(-)\n create mode 100644 server/channels/__init__.py\n create mode 100644 server/channels/store.py\n create mode 100644 server/events.py\n create mode 100644 server/users/__init__.py\n create mode 100644 server/users/routes.py\n create mode 100644 server/workspaces/__init__.py\n create mode 100644 server/workspaces/routes.py\n create mode 100644 server/workspaces/store.py\n create mode 100644 tests/test_auth_cluster_token.py\n create mode 100644 tests/test_auth_live.py\n create mode 100644 tests/test_profiles.py\n create mode 100644 tests/test_workspaces.py\ntime=2026-08-22T23:11:48.838Z level=INFO msg=\"opened existing embedded fleet-db client\" url=http://127.0.0.1:44829\n{\n  \"id\": \"MARATHON-16\",\n  \"title\": \"SPA: auth, token storage, workspace shell\",\n  \"status\": \"in_progress\",\n  \"priority\": 1,\n  \"issue_type\": \"task\",\n  \"assignee\": \"app-architect-1\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"architect\",\n    \"frontend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"has_design\": false,\n  \"created_at\": \"2026-08-22T22:17:47.179119571Z\",\n  \"updated_at\": \"2026-08-22T22:17:47.179119571Z\",\n  \"created_by\": \"marathon-harness\",\n  \"description\": \"Serve SPA from GET / on any node. Sign-up form with visible error on invalid input; auto-login on success. Logout/login restores same workspace. Store bearer in localStorage huddle.token (or accepted fallbacks). Three-pane layout shell: coloured sidebar + message pane + on-demand thread panel. Workspace identity in sidebar. Stable selectors: auth-form, auth-submit, auth-toggle, auth-modal, workspace-create-form, empty-state-create-workspace, join-workspace-*, current-user, logout-btn, workspace-header, channel-list, dms-list. Drivable at 1280x900.\",\n  \"dependents\": [\n    {\n      \"issue_id\": \"MARATHON-17\",\n      \"depends_on_id\": \"MARATHON-16\",\n      \"type\": \"blocks\",\n      \"title\": \"SPA: channels, messages, threads, reactions\",\n      \"status\": \"open\",\n      \"priority\": 1,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T22:17:56.201269638Z\",\n      \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-18\",\n      \"depends_on_id\": \"MARATHON-16\",\n      \"type\": \"blocks\",\n      \"title\": \"SPA: workspace and channel settings UI\",\n      \"status\": \"open\",\n      \"priority\": 2,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T22:17:56.275071493Z\",\n      \"created_by\": \"marathon-harness\"\n    }\n  ]\n}\nThe 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\n","localExecutionTimeMs":52},"isBackground":false},"description":"Sync main; show task and loom data"},"hookAdditionalContexts":[],"toolCallId":"call-2c56b04d-0971-4dca-b9be-85a9a183522d-0\nfc_f48d1174-df81-91b5-97a3-b133c3e9ac4a_0","startedAtMs":"1787440308499","completedAtMs":"1787440308876"},"model_call_id":"a74d7e62-a08d-4d88-aaf5-b4d85b65652b-0-d4tm","session_id":"ce65663b-c70a-428f-a8bb-f87b51fd396c","timestam