:\n        channel = _require_channel(conn, channel_id)\n        messages_store.require_channel_message_read(\n            conn, channel=channel, user_id=caller[\"id\"]\n        )\n        effective_limit = 50 if limit is None else limit\n        messages = messages_store.list_channel_messages(\n            conn,\n            channel_id=channel[\"id\"],\n            limit=effective_limit,\n            before=before,\n        )\n        return {\"messages\": messages}\n    finally:\n        conn.close()\n\n\n@router.get(\"/{channel_id}/pins\")\ndef list_channel_pins(\n    channel_id: str,\n    request: Request,\n    caller: dict[str, Any] = Depends(get_current_user),","isEmpty":false,"exceededLimit":false,"totalLines":447,"fileSize":14056,"path":"/work/ws/worktrees/app/app-architect-1/server/channels/routes.py","readRange":{"startLine":320,"endLine":399},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-fabad56c-f135-414d-92a6-405c9667b3c8-57\nfc_c982e02d-3f42-9e67-89de-dfeb57d0f351_2","startedAtMs":"1787447834834","completedAtMs":"1787447835473"},"model_call_id":"03dd848d-d7bd-4877-bfbf-ce6458bc28c6-16-1wjx","session_id":"8d1f97e9-e376-440d-a791-e2992491ec56","timestamp_ms":1787447835495}
