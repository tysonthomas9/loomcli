        lines = _ss_listen_lines(port)\n+        assert lines, f\"expected a listener on :{port}\"\n+        joined = \"\\n\".join(lines)\n+        assert \"127.0.0.1\" in joined or \"[::1]\" in joined or \"127.0.0.1\".encode().hex()\n+        # Reject wildcard binds used for the HTTP nodes.\n+        assert \"0.0.0.0:\" + str(port) not in joined\n+        assert \"*:\" + str(port) not in joined.replace(\"0.0.0.0\", \"*\")\n+        # ss often shows 0.0.0.0:* for local-only incorrectly; also probe bind.\n+        # If bound only to 127.0.0.1, connecting via a non-loopback strategy is hard;\n+        # confirm socket connect to 127.0.0.1 works and ss line includes 127.0.0.1.\n+        assert \"127.0.0.1:\" + str(port) in joined\n+\n+\n+class TestApiRouterSeam:\n+    def test_api_package_exposes_aggregation_router(self):\n+        from huddle.api import api_router\n+\n+        assert api_router is not None\n+        paths = []\n+        for route in api_router.routes:\n+            path = getattr(route, \"path\", None)\n+            if path:\n+                paths.append(path)\n+        assert \"/health\" in paths\n+\n+\n+class TestNodeKillResilience:\n+    def test_killing_one_node_leaves_other_two_healthy(self, cluster):\n+        victim_port = 8001\n+        survivors = [8000, 8002]\n+        pids = _listener_pids(victim_port)\n+        assert pids, f\"no listener PID on {victim_port}\"\n+        for pid in pids:\n+            os.kill(pid, signal.SIGKILL)\n+\n+        # Survivors must remain healthy without waiting for restart.\n+        deadline = time.monotonic() + 5.0\n+        saw_survivor_ok = False\n+        while time.monotonic() < deadline:\n+            if all(_health_ok(p, PORT_TO_NODE[p]) for p in survivors):\n+                saw_survivor_ok = True\n+                break\n+            time.sleep(0.2)\n+        assert saw_survivor_ok, \"other nodes stopped answering health after one node SIGKILL\"\n+\n+        # Victim returns within 60s with the same node_id.\n+        assert _wait(\n+            lambda: _health_ok(victim_port, PORT_TO_NODE[victim_port]),\n+            RESTART_TIMEOUT_S,\n+        ), f\"node on :{victim_port} did not recover within {RESTART_TIMEOUT_S}s\"\n+\n+        # Negative: recovered node must not flip identity.\n+        status, payload = _get_health(victim_port)\n+        assert status == 200\n+        assert payload[\"node_id\"] == 1\n+        assert payload[\"node_id\"] not in (0, 2)\n+\n+    def test_port_8000_node_id_not_1_or_2_after_restart(self, cluster):\n+        pids = _listener_pids(8000)\n+        assert pids\n+        for pid in pids:\n+            os.kill(pid, signal.SIGKILL)\n+        assert _wait(lambda: _health_ok(8000, 0), RESTART_TIMEOUT_S)\n+        status, payload = _get_health(8000)\n+        assert status == 200\n+        assert payload[\"node_id\"] == 0\n+        assert payload[\"node_id\"] not in (1, 2)\n+\n+\n+class TestRedisKillResilience:\n+    def test_killing_redis_does_not_fail_health(self, cluster):\n+        # Ensure Redis is up, then kill it.\n+        assert _redis_pong()\n+        redis_pids = _listener_pids(6379)\n+        assert redis_pids, \"no redis listener PID\"\n+        for pid in redis_pids:\n+            os.kill(pid, signal.SIGKILL)\n+\n+        # Health must stay 200 while Redis is down (negative criterion 11).\n+        # Give a brief window after kill for the process to die.\n+        assert _wait(lambda: not _redis_pong(), 5.0), \"Redis did not die after SIGKILL\"\n+\n+        failures = []\n+        for port in PORTS:\n+            status, payload = _get_health(port)\n+            if status != 200 or payload != {\"status\": \"ok\", \"node_id\": PORT_TO_NODE[port]}:\n+                failures.append((port, status, payload))\n+        assert not failures, f\"health failed during Redis outage: {failures}\"\n+\n+        # start.sh must respawn Redis.\n+        assert _wait(_redis_pong, RESTART_TIMEOUT_S), (\n+            f\"Redis did not accept PING again within {RESTART_TIMEOUT_S}s\"\n+        )\n+        # Health still good after respawn.\n+        assert all(_health_ok(p, PORT_TO_NODE[p]) for p in PORTS)","afterFullFileContent":"\"\"\"Integration tests for MARATHON-2 cluster scaffold (start.sh, health, Redis).\n\nAcceptance criteria under test (from MARATHON-2 design):\n1. start.sh is executable\n2. GET /api/health on :8000/:8001/:8002 → 200 {\"status\":\"ok\",\"node_id\":0|1|2}\n3. redis-cli PING → PONG on 127.0.0.1:6379\n4. start.sh stays in the foreground while the cluster serves\n5. node_id is a JSON number; body has exactly status + node_id\n6. SIGKILL one HTTP node → other two stay healthy; killed node returns ≤60s same node_id\n7. SIGKILL Redis → /api/health still 200; Redis PING returns after respawn\n8. No Docker / remote services required\n9. api_router aggregation seam exists for sibling routes\n10. Negative: HTTP nodes bind 127.0.0.1, not 0.0.0.0\n11. Negative: /api/health must not 5xx solely because Redis is down\n12. Negative: port 8000 must not report node_id 1 or 2 after restart\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport signal\nimport socket\nimport subprocess\nimport time\nimport urllib.error\nimport urllib.request\nfrom pathlib import Path\n\nimport pytest\n\nREPO_ROOT = Path(__file__).resolve().parents[1]\nSTART_SH = REPO_ROOT / \"start.sh\"\nPORTS = (8000, 8001, 8002)\nPORT_TO_NODE = {8000: 0, 8001: 1, 8002: 2}\nREADY_TIMEOUT_S = 90.0\nRESTART_TIMEOUT_S = 60.0\n\n\ndef _freeports() -> None:\n    subprocess.run([\"marathon-freeports\"], check=False, cwd=REPO_ROOT)\n\n\ndef _wait(predicate, timeout: float, interval: float = 0.25) -> bool:\n    deadline = time.monotonic() + timeout\n    while time.monotonic() < deadline:\n        if predicate():\n            return True\n        time.sleep(interval)\n    return False\n\n\ndef _get_health(port: int) -> tuple[int, dict | None]:\n    url = f\"http://127.0.0.1:{port}/api/health\"\n    try:\n        with urllib.request.urlopen(url, timeout=2) as resp:\n            body = resp.read().decode()\n            return resp.status, json.loads(body)\n    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError, json.JSONDecodeError, OSError):\n        return -1, None\n\n\ndef _health_ok(port: int, expected_node: int) -> bool:\n    status, payload = _get_health(port)\n    return (\n        status == 200\n        and isinstance(payload, dict)\n        and payload.get(\"status\") == \"ok\"\n        and payload.get(\"node_id\") == expected_node\n        and isinstance(payload.get(\"node_id\"), int)\n    )\n\n\ndef _redis_pong() -> bool:\n    try:\n        out = subprocess.check_output(\n            [\"redis-cli\", \"-h\", \"127.0.0.1\", \"-p\", \"6379\", \"PING\"],\n            text=True,\n            timeout=2,\n            stderr=subprocess.DEVNULL,\n        )\n        return out.strip() == \"PONG\"\n    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError, OSError):\n        return False\n\n\ndef _listener_pids(port: int) -> set[int]:\n    \"\"\"Return PIDs listening on TCP port via /proc (ss may lack process names).\"\"\"\n    pids: set[int] = set()\n    hex_port = f\"{port:04X}\"\n    inodes: set[str] = set()\n    for path in (\"/proc/net/tcp\", \"/proc/net/tcp6\"):\n        try:\n            lines = Path(path).read_text().splitlines()[1:]\n        except OSError:\n            continue\n        for line in lines:\n            parts = line.split()\n            if len(parts) < 10:\n                continue\n            local = parts[1]\n            state = parts[3]\n            if state != \"0A\":  # LISTEN\n                continue\n            if local.rsplit(\":\", 1)[-1].upper() != hex_port:\n                continue\n            inodes.add(parts[9])\n\n    for proc in Path(\"/proc\").iterdir():\n        if not proc.name.isdigit():\n            continue\n        fd_dir = proc / \"fd\"\n        try:\n            for fd in fd_dir.iterdir():\n                try:\n                    target = os.readlink(fd)\n                except OSError:\n                    continue\n                if target.startswith(\"socket:[\") and target[8:-1] in inodes:\n                    pids.add(int(proc.name))\n        except OSError:\n            continue\n    return pids\n\n\ndef _ss_listen_lines(port: int) -> list[str]:\n    try:\n        out = subprocess.check_output(\n            [\"ss\", \"-ltn\", f\"sport = :{port}\"],\n            text=True,\n            stderr=subprocess.DEVNULL,\n        )\n    except (subprocess.CalledProcessError, FileNotFoundError):\n        return []\n    return [ln for ln in out.splitlines() if f\":{port}\" in ln]\n\n\n@pytest.fixture(scope=\"module\")\ndef cluster():\n    \"\"\"Boot ./start.sh under marathon-portlock; tear down on exit.\"\"\"\n    assert START_SH.is_file(), f\"missing {START_SH}\"\n    _freeports()\n\n    # Hold the port lock for the whole module so sibling workers cannot steal ports.\n    lock_proc = subprocess.Popen(\n        [\n            \"bash\",\n            \"-c\",\n            # flock FD 9 for the duration; start.sh is the supervised child.\n            \"exec 9>/work/.app-ports.lock; flock 9; exec ./start.sh\",\n        ],\n        cwd=REPO_ROOT,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        start_new_session=True,\n    )\n\n    def ready() -> bool:\n        if lock_proc.poll() is not None:\n            return False\n        return all(_health_ok(p, PORT_TO_NODE[p]) for p in PORTS) and _redis_pong()\n\n    if not _wait(ready, READY_TIMEOUT_S):\n        stderr = \"\"\n        try:\n            # Process may still be running; drain what we can without blocking forever.\n            if lock_proc.poll() is not None and lock_proc.stderr:\n                stderr = lock_proc.stderr.read().decode(errors=\"replace\")[-4000:]\n        except OSError:\n            pass\n        # Force teardown\n        try:\n            os.killpg(lock_proc.pid, signal.SIGKILL)\n        except OSError:\n            lock_proc.kill()\n        _freeports()\n        pytest.fail(\n            f\"cluster failed to become ready within {READY_TIMEOUT_S}s \"\n            f\"(start.sh exit={lock_proc.poll()}). stderr tail:\\n{stderr}\"\n        )\n\n    yield lock_proc\n\n    try:\n        os.killpg(lock_proc.pid, signal.SIGTERM)\n    except OSError:\n        pass\n    try:\n        lock_proc.wait(timeout=10)\n    except subprocess.TimeoutExpired:\n        try:\n            os.killpg(lock_proc.pid, signal.SIGKILL)\n        except OSError:\n            lock_proc.kill()\n    _freeports()\n\n\nclass TestStartShBasics:\n    def test_start_sh_is_executable(self):\n        assert START_SH.is_file()\n        assert os.access(START_SH, os.X_OK), \"start.sh must be executable (test -x)\"\n\n    def test_start_sh_stays_in_foreground_while_serving(self, cluster):\n        # Supervisor must still be alive; a daemonizing script would have exited.\n        assert cluster.poll() is None, \"start.sh exited while cluster should stay foreground\"\n        assert all(_health_ok(p, PORT_TO_NODE[p]) for p in PORTS)\n        time.sleep(1.5)\n        assert cluster.poll() is None, \"start.sh backgrounded/exited after serving began\"\n\n\nclass TestHealthContract:\n    @pytest.mark.parametrize(\"port,node_id\", [(8000, 0), (8001, 1), (8002, 2)])\n    def test_health_returns_ok_with_port_mapped_node_id(self, cluster, port, node_id):\n        status, payload = _get_health(port)\n        assert status == 200\n        assert payload == {\"status\": \"ok\", \"node_id\": node_id}\n        assert isinstance(payload[\"node_id\"], int)\n        assert not isinstance(payload[\"node_id\"], bool)\n\n    @pytest.mark.parametrize(\"port\", PORTS)\n    def test_health_body_has_exactly_status_and_node_id(self, cluster, port):\n        status, payload = _get_health(port)\n        assert status == 200\n        assert set(payload.keys()) == {\"status\", \"node_id\"}\n\n\nclass TestRedis:\n    def test_local_redis_ping_returns_pong(self, cluster):\n        assert _redis_pong()\n\n\nclass TestNoRemoteOrDocker:\n    def test_start_sh_does_not_invoke_docker(self):\n        text = START_SH.read_text()\n        lowered = text.lower()\n        assert \"docker\" not in lowered\n        assert \"compose\" not in lowered\n\n    def test_cluster_serves_without_docker_socket(self, cluster):\n        # Behavioral: we are serving with no DinD; docker.sock need not exist.\n        assert all(_health_ok(p, PORT_TO_NODE[p]) for p in PORTS)\n        assert _redis_pong()\n\n\nclass TestBindAddress:\n    @pytest.mark.parametrize(\"port\", PORTS)\n    def test_http_node_listens_on_127_0_0_1_not_all_interfaces(self, cluster, port):\n        lines = _ss_listen_lines(port)\n        assert lines, f\"expected a listener on :{port}\"\n        joined = \"\\n\".join(lines)\n        assert \"127.0.0.1\" in joined or \"[::1]\" in joined or \"127.0.0.1\".encode().hex()\n        # Reject wildcard binds used for the HTTP nodes.\n        assert \"0.0.0.0:\" + str(port) not in joined\n        assert \"*:\" + str(port) not in joined.replace(\"0.0.0.0\", \"*\")\n        # ss often shows 0.0.0.0:* for local-only incorrectly; also probe bind.\n        # If bound only to 127.0.0.1, connecting via a non-loopback strategy is hard;\n        # confirm socket connect to 127.0.0.1 works and ss line includes 127.0.0.1.\n        assert \"127.0.0.1:\" + str(port) in joined\n\n\nclass TestApiRouterSeam:\n    def test_api_package_exposes_aggregation_router(self):\n        from huddle.api import api_router\n\n        assert api_router is not None\n        paths = []\n        for route in api_router.routes:\n            path = getattr(route, \"path\", None)\n            if path:\n                paths.append(path)\n        assert \"/health\" in paths\n\n\nclass TestNodeKillResilience:\n    def test_killing_one_node_leaves_other_two_healthy(self, cluster):\n        victim_port = 8001\n        survivors = [8000, 8002]\n        pids = _listener_pids(victim_port)\n        assert pids, f\"no listener PID on {victim_port}\"\n        for pid in pids:\n            os.kill(pid, signal.SIGKILL)\n\n        # Survivors must remain healthy without waiting for restart.\n        deadline = time.monotonic() + 5.0\n        saw_survivor_ok = False\n        while time.monotonic() < deadline:\n            if all(_health_ok(p, PORT_TO_NODE[p]) for p in survivors):\n                saw_survivor_ok = True\n                break\n            time.sleep(0.2)\n        assert saw_survivor_ok, \"other nodes stopped answering health after one node SIGKILL\"\n\n        # Victim returns within 60s with the same node_id.\n        assert _wait(\n            lambda: _health_ok(victim_port, PORT_TO_NODE[victim_port]),\n            RESTART_TIMEOUT_S,\n        ), f\"node on :{victim_port} did not recover within {RESTART_TIMEOUT_S}s\"\n\n        # Negative: recovered node must not flip identity.\n        status, payload = _get_health(victim_port)\n        assert status == 200\n        assert payload[\"node_id\"] == 1\n        assert payload[\"node_id\"] not in (0, 2)\n\n    def test_port_8000_node_id_not_1_or_2_after_restart(self, cluster):\n        pids = _listener_pids(8000)\n        assert pids\n        for pid in pids:\n            os.kill(pid, signal.SIGKILL)\n        assert _wait(lambda: _health_ok(8000, 0), RESTART_TIMEOUT_S)\n        status, payload = _get_health(8000)\n        assert status == 200\n        assert payload[\"node_id\"] == 0\n        assert payload[\"node_id\"] not in (1, 2)\n\n\nclass TestRedisKillResilience:\n    def test_killing_redis_does_not_fail_health(self, cluster):\n        # Ensure Redis is up, then kill it.\n        assert _redis_pong()\n        redis_pids = _listener_pids(6379)\n        assert redis_pids, \"no redis listener PID\"\n        for pid in redis_pids:\n            os.kill(pid, signal.SIGKILL)\n\n        # Health must stay 200 while Redis is down (negative criterion 11).\n        # Give a brief window after kill for the process to die.\n        assert _wait(lambda: not _redis_pong(), 5.0), \"Redis did not die after SIGKILL\"\n\n        failures = []\n        for port in PORTS:\n            status, payload = _get_health(port)\n            if status != 200 or payload != {\"status\": \"ok\", \"node_id\": PORT_TO_NODE[port]}:\n                failures.append((port, status, payload))\n        assert not failures, f\"health failed during Redis outage: {failures}\"\n\n        # start.sh must respawn Redis.\n        assert _wait(_redis_pong, RESTART_TIMEOUT_S), (\n            f\"Redis did not accept PING again within {RESTART_TIMEOUT_S}s\"\n        )\n        # Health still good after respawn.\n        assert all(_health_ok(p, PORT_TO_NODE[p]) for p in PORTS)\n","message":"Wrote contents to /work/ws/worktrees/app/qa-engineer-1/tests/test_cluster_scaffold.py"}}},"hookAdditionalContexts":[],"toolCallId":"call-67814f23-1e43-4cc6-b5ae-12685f2b9dcf-17\nfc_bba3e8de-0da1-9ba9-95fa-8a003198dbfb_1","startedAtMs":"1787424907830","completedAtMs":"1787424908147"},"model_call_id":"ca2893d9-1962-425a-9440-f809b382e327-6-5poa","session_id":"ce28c44e-7f76-437a-a029-5c7b877887a7","timestamp_ms":1787424908176}
