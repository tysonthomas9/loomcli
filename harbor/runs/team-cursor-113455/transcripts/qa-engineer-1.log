  \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-8\",\n      \"depends_on_id\": \"MARATHON-1\",\n      \"type\": \"parent-child\",\n      \"title\": \"Messages: post, list, edit, delete\",\n      \"status\": \"open\",\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T18:37:18.592697241Z\",\n      \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-9\",\n      \"depends_on_id\": \"MARATHON-1\",\n      \"type\": \"parent-child\",\n      \"title\": \"DMs: get-or-create pairwise DM channel\",\n      \"status\": \"open\",\n      \"priority\": 1,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T18:37:18.606944448Z\",\n      \"created_by\": \"marathon-harness\"\n    }\n  ]\n}\ntotal 36\ndrwxr-xr-x. 6 root root 4096 Aug 22 18:53 .\ndrwxr-xr-x. 6 root root   93 Aug 22 18:35 ..\n-rw-------. 1 root root  264 Aug 22 18:52 .agent.lock\n-rw-------. 1 root root    0 Aug 22 18:52 .agent.lock.flock\n-rw-r--r--. 1 root root   42 Aug 22 18:35 .git\n-rw-r--r--. 1 root root  135 Aug 22 18:53 .gitignore\ndrwxr-xr-x. 2 root root   22 Aug 22 18:53 data\ndrwxr-xr-x. 3 root root   86 Aug 22 18:53 huddle\ndrwxr-xr-x. 2 root root   24 Aug 22 18:35 loom-prompts\n-rw-r--r--. 1 root root   56 Aug 22 18:53 requirements.txt\n-rwxr-xr-x. 1 root root 4746 Aug 22 18:53 start.sh\n-rwxr-xr-x. 1 root root  558 Aug 22 18:35 timer.sh\ndrwxr-xr-x. 2 root root 4096 Aug 22 18:53 vendor\n./.git\n./timer.sh\n./.gitignore\n./data/.gitkeep\n./huddle/__init__.py\n./huddle/__main__.py\n./huddle/api/__init__.py\n./huddle/api/health.py\n./huddle/app.py\n./huddle/config.py\n./requirements.txt\n./start.sh\n./vendor/annotated_types-0.8.0-py3-none-any.whl\n./vendor/anyio-4.14.2-py3-none-any.whl\n./vendor/click-8.4.2-py3-none-any.whl\n./vendor/fastapi-0.115.8-py3-none-any.whl\n./vendor/h11-0.16.0-py3-none-any.whl\n./vendor/httptools-0.8.0-cp312-cp312-manylinux2014_aarch64.manylinux_2_17_aarch64.manylinux_2_28_aarch6