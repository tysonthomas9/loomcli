{"type":"tool_call","subtype":"started","call_id":"call-bdf29da9-7679-4f2d-aef3-3c273a906b99-15\nfc_fb686662-7141-94fd-8d26-a0383bc50430_2","tool_call":{"editToolCall":{"args":{"path":"/work/ws/worktrees/app/backend-dev-1/tests/test_health_unit.py","streamContent":"\"\"\"Unit tests for HUDDLE_* config and /api/health.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\n\nimport pytest\nfrom fastapi.testclient import TestClient\n\nfrom huddle.app import create_app\nfrom huddle.config import ConfigError, load_settings\n\n\n@pytest.fixture(autouse=True)\ndef _clear_huddle_env(monkeypatch: pytest.MonkeyPatch) -> None:\n    for key in list(os.environ):\n        if key.startswith(\"HUDDLE_\") or key == \"APP_ROOT\":\n            monkeypatch.delenv(key, raising=False)\n\n\ndef test_load_settings_port_to_node_id(monkeypatch: pytest.MonkeyPatch) -> None:\n    for port, node_id in ((8000, 0), (8001, 1), (8002, 2)):\n        monkeypatch.setenv(\"HUDDLE_NODE_ID\", str(node_id))\n        monkeypatch.setenv(\"HUDDLE_PORT\", str(port))\n        monkeypatch.setenv(\"HUDDLE_HOST\", \"127.0.0.1\")\n        monkeypatch.setenv(\"HUDDLE_REDIS_URL\", \"redis://127.0.0.1:6379/0\")\n        monkeypatch.setenv(\"HUDDLE_DATA_DIR\", \"/app/data\")\n        settings = load_settings()\n        assert settings.node_id == node_id\n        assert settings.port == port\n        assert settings.host == \"127.0.0.1\"\n\n\ndef test_load_settings_rejects_mismatched_env(monkeypatch: pytest.MonkeyPatch) -> None:\n    monkeypatch.setenv(\"HUDDLE_NODE_ID\", \"0\")\n    monkeypatch.setenv(\"HUDDLE_PORT\", \"8001\")\n    with pytest.raises(ConfigError, match=\"disagrees\"):\n        load_settings()\n\n\ndef test_load_settings_rejects_missing_env() -> None:\n    with pytest.raises(ConfigError, match=\"HUDDLE_NODE_ID\"):\n        load_settings()\n\n\ndef test_health_returns_exact_payload(monkeypatch: pytest.MonkeyPatch) -> None:\n    monkeypatch.setenv(\"HUDDLE_NODE_ID\", \"1\")\n    monkeypatch.setenv(\"HUDDLE_PORT\", \"8001\")\n    monkeypatch.setenv(\"HUDDLE_DATA_DIR\", \"/tmp/huddle-test-data\")\n    client = TestClient(create_app())\n    response = client.get(\"/api/health\")\n    assert response.status_code == 200\n    assert response.headers[\"content-type\"].startswith(\"application/json\")\n    assert response.json() == {\"status\": \"ok\", \"node_id\": 1}\n\n\n@pytest.mark.parametrize(\n    (\"node_id\", \"port\"),\n    [(0, 8000), (1, 8001), (2, 8002)],\n)\ndef test_health_node_id_for_each_port(\n    monkeypatch: pytest.MonkeyPatch, node_id: int, port: int\n) -> None:\n    monkeypatch.setenv(\"HUDDLE_NODE_ID\", str(node_id))\n    monkeypatch.setenv(\"HUDDLE_PORT\", str(port))\n    monkeypatch.setenv(\"HUDDLE_DATA_DIR\", \"/tmp/huddle-test-data\")\n    client = TestClient(create_app())\n    body = client.get(\"/api/health\").json()\n    assert body == {\"status\": \"ok\", \"node_id\": node_id}\n    assert isinstance(body[\"node_id\"], int)\n"}},"hookAdditionalContexts":[],"toolCallId":"call-bdf29da9-7679-4f2d-aef3-3c273a906b99-15\nfc_fb686662-7141-94fd-8d26-a0383bc50430_2","startedAtMs":"1787424200048"},"model_call_id":"9ccf14b6-189b-44f9-b601-35a694d0c399-6-n551","session_id":"8443c196-4754-4f0c-b903-f1fed9d6be91","timestamp_ms":1787424218200}
{"type":"tool_call","subtype":"started","call_id":"call-bdf29da9-7679-4f2d-aef3-3c273a906b99-16\nfc_fb686662-7141-94fd-8d26-a0383bc50430_3","tool_call":{"editToolCall":{"args":{"path":"/work/ws/worktrees/app/backend-dev-1/tests/test_cluster_integration.py","streamContent":"\"\"\"Integration smoke: start.sh brings up health + Redis and restarts children.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport signal\nimport subprocess\nimport time\nfrom pathlib import Path\n\nimport pytest\n\nAPP_ROOT = Path(__file__).resolve().parents[1]\nSTART_SH = APP_ROOT / \"start.sh\"\n\n\ndef _curl_health(port: int) -> tuple[int, dict]:\n    proc = subprocess.run(\n        [\"curl\", \"-s\", \"-w\", \"\\n%{http_code}\", f\"http://127.0.0.1:{port}/api/health\"],\n        capture_output=True,\n        text=True,\n        timeout=5,\n        check=False,\n    )\n    lines = proc.stdout.strip().splitlines()\n    if len(lines) < 2:\n        return 0, {}\n    code = int(lines[-1])\n    try:\n        body = json.loads(\"\\n\".join(lines[:-1]))\n    except json.JSONDecodeError:\n        body = {}\n    return code, body\n\n\ndef _wait_health(port: int, node_id: int, timeout: float = 30.0) -> dict:\n    deadline = time.time() + timeout\n    last: dict = {}\n    while time.time() < deadline:\n        code, body = _curl_health(port)\n        last = body\n        if code == 200 and body.get(\"status\") == \"ok\" and body.get(\"node_id\") == node_id:\n            return body\n        time.sleep(0.25)\n    raise AssertionError(f\"port {port} not healthy with node_id={node_id}; last={last!r}\")\n\n\ndef _redis_ping() -> bool:\n    proc = subprocess.run(\n        [\"redis-cli\", \"-h\", \"127.0.0.1\", \"-p\", \"6379\", \"PING\"],\n        capture_output=True,\n        text=True,\n        timeout=5,\n        check=False,\n    )\n    return proc.stdout.strip() == \"PONG\"\n\n\ndef _wait_redis(timeout: float = 30.0) -> None:\n    deadline = time.time() + timeout\n    while time.time() < deadline:\n        if _redis_ping():\n            return\n        time.sleep(0.25)\n    raise AssertionError(\"Redis did not become ready\")\n\n\ndef _listener_pid(port: int) -> int | None:\n    proc = subprocess.run(\n        [\"ss\", \"-ltnp\"],\n        capture_output=True,\n        text=True,\n        timeout=5,\n        check=False,\n    )\n    for line in proc.stdout.splitlines():\n        if f\":{port}\" not in line:\n            continue\n        # users:((\"python\",pid=1234,fd=...))\n        if \"pid=\" in line:\n            part = line.split(\"pid=\")[1]\n            digits = \"\".join(ch for ch in part if ch.isdigit())\n            if digits:\n                return int(digits)\n    return None\n\n\n@pytest.fixture(scope=\"module\")\ndef cluster():\n    \"\"\"Boot start.sh under marathon-portlock; tear down after tests.\"\"\"\n    free = subprocess.run([\"marathon-freeports\"], capture_output=True, text=True)\n    assert free.returncode == 0, free.stderr\n\n    env = os.environ.copy()\n    proc = subprocess.Popen(\n        [\"marathon-portlock\", str(START_SH)],\n        cwd=str(APP_ROOT),\n        env=env,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.STDOUT,\n        text=True,\n        start_new_session=True,\n    )\n    try:\n        for port, node_id in ((8000, 0), (8001, 1), (8002, 2)):\n            _wait_health(port, node_id, timeout=60.0)\n        _wait_redis(timeout=30.0)\n        yield proc\n    finally:\n        try:\n            os.killpg(proc.pid, signal.SIGTERM)\n        except ProcessLookupError:\n            pass\n        try:\n            proc.wait(timeout=15)\n        except subprocess.TimeoutExpired:\n            os.killpg(proc.pid, signal.SIGKILL)\n            proc.wait(timeout=5)\n        subprocess.run([\"marathon-freeports\"], capture_output=True, text=True)\n\n\ndef test_start_sh_is_executable() -> None:\n    assert START_SH.is_file()\n    assert os.access(START_SH, os.X_OK)\n\n\ndef test_three_nodes_health_and_redis(cluster) -> None:\n    for port, node_id in ((8000, 0), (8001, 1), (8002, 2)):\n        code, body = _curl_health(port)\n        assert code == 200\n        assert body == {\"status\": \"ok\", \"node_id\": node_id}\n        assert isinstance(body[\"node_id\"], int)\n    assert _redis_ping()\n\n\ndef test_http_node_restarts_after_sigkill(cluster) -> None:\n    pid = _listener_pid(8001)\n    assert pid is not None, \"could not find listener for :8001\"\n    os.kill(pid, signal.SIGKILL)\n    # Other nodes stay up\n    code0, body0 = _curl_health(8000)\n    assert code0 == 200 and body0[\"node_id\"] == 0\n    code2, body2 = _curl_health(8002)\n    assert code2 == 200 and body2[\"node_id\"] == 2\n    # Killed node returns with same node_id within 60s\n    body = _wait_health(8001, 1, timeout=60.0)\n    assert body == {\"status\": \"ok\", \"node_id\": 1}\n\n\ndef test_redis_restart_does_not_break_health(cluster) -> None:\n    # Find redis-server pid\n    proc = subprocess.run(\n        [\"pgrep\", \"-f\", \"redis-server.*6379\"],\n        capture_output=True,\n        text=True,\n        check=False,\n    )\n    pids = [int(x) for x in proc.stdout.split() if x.strip()]\n    assert pids, \"no redis-server found\"\n    os.kill(pids[0], signal.SIGKILL)\n    # Health must still work while Redis is down\n    deadline = time.time() + 5\n    saw_ok = False\n    while time.time() < deadline:\n        code, body = _curl_health(8000)\n        if code == 200 and body.get(\"status\") == \"ok\":\n            saw_ok = True\n            break\n        time.sleep(0.2)\n    assert saw_ok, \"health failed while Redis was restarting\"\n    _wait_redis(timeout=60.0)\n    assert _redis_ping()\n"}},"hookAdditionalContexts":[],"toolCallId":"call-bdf29da9-7679-4f2d-aef3-3c273a906b99-16\nfc_fb686662-7141-94fd-8d26-a0383bc50430_3","startedAtMs":"1787424218174"},"model_call_id":"9ccf14b6-189b-44f9-b601-35a694d0c399-6-n551","session_id":"8443c196-4754-4f0c-b903-f1fed9d6be91","timestamp_ms":1787424218237}
