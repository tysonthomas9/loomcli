 time.time() < deadline:\n        if _redis_ping():\n            return\n        time.sleep(0.25)\n    raise AssertionError(\"Redis did not become ready\")\n\n\ndef _listener_pid(port: int) -> int | None:\n    proc = subprocess.run(\n        [\"ss\", \"-ltnp\"],\n        capture_output=True,\n        text=True,\n        timeout=5,\n        check=False,\n    )\n    for line in proc.stdout.splitlines():\n        if f\":{port}\" not in line:\n            continue\n        # users:((\"python\",pid=1234,fd=...))\n        if \"pid=\" in line:\n            part = line.split(\"pid=\")[1]\n            digits = \"\".join(ch for ch in part if ch.isdigit())\n            if digits:\n                return int(digits)\n    return None\n\n\n@pytest.fixture(scope=\"module\")\ndef cluster():\n    \"\"\"Boot start.sh under marathon-portlock; tear down after tests.\"\"\"\n    free = subprocess.run([\"marathon-freeports\"], capture_output=True, text=True)\n    assert free.returncode == 0, free.stderr\n\n    env = os.environ.copy()\n    proc = subprocess.Popen(\n        [\"marathon-portlock\", str(START_SH)],\n        cwd=str(APP_ROOT),\n        env=env,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.STDOUT,\n        text=True,\n        start_new_session=True,\n    )\n    try:\n        for port, node_id in ((8000, 0), (8001, 1), (8002, 2)):\n            _wait_health(port, node_id, timeout=60.0)\n        _wait_redis(timeout=30.0)\n        yield proc\n    finally:\n        try:\n            os.killpg(proc.pid, signal.SIGTERM)\n        except ProcessLookupError:\n            pass\n        try:\n            proc.wait(timeout=15)\n        except subprocess.TimeoutExpired:\n            os.killpg(proc.pid, signal.SIGKILL)\n            proc.wait(timeout=5)\n        subprocess.run([\"marathon-freeports\"], capture_output=True, text=True)\n\n\ndef test_start_sh_is_executable() -> None:\n    assert START_SH.is_file()\n    assert os.access(START_SH, os.X_OK)\n\n\ndef test_three_nodes_health_and_redis(cluster) -> None:\n    for port, node_id in ((8000, 0), (8001, 1), (8002, 2)):\n        code, body = _curl_health(port)\n        assert code == 200\n        assert body == {\"status\": \"ok\", \"node_id\": node_id}\n        assert isinstance(body[\"node_id\"], int)\n    assert _redis_ping()\n\n\ndef test_http_node_restarts_after_sigkill(cluster) -> None:\n    pid = _listener_pid(8001)\n    assert pid is not None, \"could not find listener for :8001\"\n    os.kill(pid, signal.SIGKILL)\n    # Other nodes stay up\n    code0, body0 = _curl_health(8000)\n    assert code0 == 200 and body0[\"node_id\"] == 0\n    code2, body2 = _curl_health(8002)\n    assert code2 == 200 and body2[\"node_id\"] == 2\n    # Killed node returns with same node_id within 60s\n    body = _wait_health(8001, 1, timeout=60.0)\n    assert body == {\"status\": \"ok\", \"node_id\": 1}\n\n\ndef test_redis_restart_does_not_break_health(cluster) -> None:\n    # Find redis-server pid\n    proc = subprocess.run(\n        [\"pgrep\", \"-f\", \"redis-server.*6379\"],\n        capture_output=True,\n        text=True,\n        check=False,\n    )\n    pids = [int(x) for x in proc.stdout.split() if x.strip()]\n    assert pids, \"no redis-server found\"\n    os.kill(pids[0], signal.SIGKILL)\n    # Health must still work while Redis is down\n    deadline = time.time() + 5\n    saw_ok = False\n    while time.time() < deadline:\n        code, body = _curl_health(8000)\n        if code == 200 and body.get(\"status\") == \"ok\":\n            saw_ok = True\n            break\n        time.sleep(0.2)\n    assert saw_ok, \"health failed while Redis was restarting\"\n    _wait_redis(timeout=60.0)\n    assert _redis_ping()\n"},"result":{"success":{"path":"/work/ws/worktrees/app/backend-dev-1/tests/test_cluster_integration.py","linesAdded":173,"linesRemoved":0,"diffString":"--- /dev/null\n+++ b//work/ws/worktrees/app/backend-dev-1/tests/test_cluster_integration.py\n@@ -1,0 +1,173 @@\n+\"\"\"Integration smoke