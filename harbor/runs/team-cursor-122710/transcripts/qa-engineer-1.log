ext":"head -400"}],"hasRedirects":true,"hasCommandSubstitution":false,"allRedirectsAreDevNull":true,"redirects":[{"operator":">&","destinationFds":[2],"targetNodeType":"number","targetText":"1"},{"operator":">&","destinationFds":[2],"targetNodeType":"number","targetText":"1"},{"operator":">&","destinationFds":[2],"targetNodeType":"number","targetText":"1"},{"operator":">&","destinationFds":[2],"targetNodeType":"number","targetText":"1"},{"operator":">&","destinationFds":[2],"targetNodeType":"number","targetText":"1"}]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Fetch designs and epic notes","closeStdin":true,"conversationId":"9d4ef768-2209-48bc-876a-56fa82f1ed2a","adminCommandDenylist":[]},"description":"Fetch designs and epic notes"},"hookAdditionalContexts":[],"toolCallId":"call-4dfd4f65-bad4-459d-b3f9-eb8df17e8d12-10\nfc_ecb1c529-925e-9ea0-a2a8-024565fc0c73_1","startedAtMs":"1787428813705"},"model_call_id":"eb41ddfd-aca0-46bd-8223-478ea5c43235-3-a4ef","session_id":"9d4ef768-2209-48bc-876a-56fa82f1ed2a","timestamp_ms":1787428813738}
{"type":"tool_call","subtype":"completed","call_id":"call-4dfd4f65-bad4-459d-b3f9-eb8df17e8d12-9\nfc_ecb1c529-925e-9ea0-a2a8-024565fc0c73_0","tool_call":{"readToolCall":{"args":{"path":"/root/.cursor/projects/work-ws-worktrees-app-qa-engineer-1/agent-tools/05ece91f-9288-452c-938e-72f8cb13bc41.txt","limit":220},"result":{"success":{"content":"The 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\ntime=2026-08-22T20:00:09.391Z level=INFO msg=\"opened existing embedded fleet-db client\" url=http://127.0.0.1:38569\n{\n  \"id\": \"MARATHON-3\",\n  \"title\": \"Auth: register, login, me, bearer tokens\",\n  \"status\": \"closed\",\n  \"priority\": 0,\n  \"issue_type\": \"task\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"backend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"design\": \"## Summary\\n\\nMARATHON-3 implements cluster-wide authentication for Huddle: `POST /api/auth/register`, `POST /api/auth/login`, and `GET /api/auth/me`, plus the shared durable user/token store that all three HTTP nodes read and write. It establishes the `UserObj` identity shape, opaque bearer tokens (`Authorization: Bearer …`), password hashing, username slug validation, and a reusable auth middleware that every later authenticated route (workspaces, channels, WS, IRC `PASS`, SPA) will call. Without this seam, no other feature can attribute callers or survive a request to a different node.\\n\\n## Technical Approach\\n\\n### Decision\\n- **Runtime:** Stay on the MARATHON-2 stack: Node.js stdlib `http` router in `server/index.js`, no Express/Fastify required.\\n- **Durable shared store:** One **SQLite** database file at `/app/data/huddle.db`, opened by each HTTP worker via Node’s built-in **`node:sqlite` (`DatabaseSync`)**. Enable **WAL** + a non-zero `busy_timeout` so concurrent register/login from nodes 0/1/2 serialize safely. This is the authoritative store for users and sessions; **Redis is not used for auth durability** (Redis may be killed; users/tokens must survive).\\n- **Passwords:** `crypto.scrypt` with a per-user random salt; store only `password_salt` + `password_hash` (never plaintext). Compare with timing-safe equality.\\n- **Tokens:** Opaque random strings from `crypto.randomBytes` (≥16 chars when encoded; generate **32 bytes → base64url ≈ 43 chars**). Persist token → `user_id` in SQLite. Each successful register/login **issues a new token** (multiple concurrent sessions allowed). Tokens are looked up as presented; no JWT.\\n- **IDs:** Stable cluster-wide `user.id` via `crypto.randomUUID()` (string UUID).\\n- **Auth helper:** Export `authenticateRequest(req) → user | null` and/or middleware used by `/api/auth/me` and reserved for MARATHON-4+.\\n\\n### Alternatives considered\\n| Alternative | Why rejected |\\n|-------------|--------------|\\n| Redis HASH for users/tokens | Not durable across Redis SIGKILL; epic requires cluster to keep working when Redis dies |\\n| Per-node in-memory maps | Breaks “shared durable store across all three nodes”; register on :8000 would 401 on :8001 |\\n| JWT without server-side session | Harder to revoke; contract only needs opaque bearer length ≥16; SQLite session rows are simpler and match IRC/WS token checks later |\\n| npm `better-sqlite3` / Express | Unnecessary dependency; `node:sqlite` is available on Node 24 in this environment |\\n| JSON file + flock only | Workable but weaker concurrency and no unique indexes for username race → prefer SQLite UNIQUE |\\n\\n### Trade-off accepted\\nSQLite file locking under three processes is simpler than a real DB server, but write throughput under heavy concurrent register is limited by WAL/busy waits. Acceptable for marathon scale. Using experimental `node:sqlite` avoids npm install in air-gapped/self-contained constraints; if the API shifts, implementer may pin Node flags or swap to an equivalent sync SQLite binding **without changing the HTTP contract**.\\n\\n### Conventions inherited from MARATHON-2 (authoritative)\\n| Convention | Value |\\n|------------|--------|\\n| App root | `/app` |\\n| HTTP entry | `server/index.js`, `NODE_ID` / `PORT` |\\n| Durable root | `/app/data/` |\\n| API prefix | `/api/...` |\\n| JSON | `Content-Type: application/json; charset=utf-8` |\\n| Health | Unchanged; still Redis-independent |\\n\\n### Conventions fixed here (for siblings)\\n| Convention | Value |\\n|------------|--------|\\n| DB path | `/app/data/huddle.db` (create parent dir if missing) |\\n| `UserObj` public fields | `{id, username, display_name, timezone, avatar_url, status_text, status_emoji}` — always present on auth responses |\\n| Username rules | Regex `^[A-Za-z0-9_]{1,32}$` (letters, digits, underscore only; no spaces/hyphens/dots) |\\n| Username uniqueness | Case-insensitive (`LOWER(username)` UNIQUE); store username with original casing from register |\\n| Password | UTF-8 string length ≥ 8 (code units / JS `.length`); no other complexity rules |\\n| Bearer | Header `Authorization: Bearer \\u003ctoken\\u003e` (single space); token string length ≥ 16 |\\n| Error JSON | `{ \\\"error\\\": \\\"\\u003cstring\\u003e\\\" }` for 400/401/409 (message text open; must be non-empty) |\\n| No email | Register/login bodies must not require `email`; ignore unknown fields |\\n\\n## Interface Contracts\\n\\n### Shared: `UserObj` (public; never include password/hash/salt/token)\\n\\n```json\\n{\\n  \\\"id\\\": \\\"\\u003cuuid-string\\u003e\\\",\\n  \\\"username\\\": \\\"\\u003cslug\\u003e\\\",\\n  \\\"display_name\\\": \\\"\\u003cstring\\u003e\\\",\\n  \\\"timezone\\\": \\\"\\u003cstring\\u003e\\\",\\n  \\\"avatar_url\\\": \\\"\\u003cstring\\u003e\\\",\\n  \\\"status_text\\\": \\\"\\u003cstring\\u003e\\\",\\n  \\\"status_emoji\\\": \\\"\\u003cstring\\u003e\\\"\\n}\\n```\\n\\n| Field | Type | Nullability | Default on register |\\n|-------|------|-------------|---------------------|\\n| `id` | string (UUID) | required | generated |\\n| `username` | string | required | from body |\\n| `display_name` | string | required in responses | `display_name` if provided non-empty, else copy of `username` |\\n| `timezone` | string | required in responses | `\\\"UTC\\\"` |\\n| `avatar_url` | string | required in responses | `\\\"\\\"` |\\n| `status_text` | string | required in responses | `\\\"\\\"` |\\n| `status_emoji` | string | required in responses | `\\\"\\\"` |\\n\\n**Owner of mutations beyond register defaults:** MARATHON-4 (`PATCH /api/users/me`). This task only sets defaults so envelopes are complete.\\n\\n---\\n\\n### C1 — `POST /api/auth/register`\\n\\n| | |\\n|--|--|\\n| Auth | None |\\n| Request body | JSON `{ \\\"username\\\": string, \\\"password\\\": string, \\\"display_name\\\"?: string }` |\\n| Success | `201` `{ \\\"user\\\": UserObj, \\\"token\\\": string }` |\\n| Validation failure | `400` `{ \\\"error\\\": string }` — invalid/missing username, password \\u0026lt; 8, non-object body, wrong types |\\n| Duplicate username | `409` `{ \\\"error\\\": string }` |\\n| Content-Type in | Prefer `application/json`; empty/malformed JSON → `400` |\\n\\n**Server validation (authoritative):**\\n1. Parse JSON object; missing `username` or `password` → `400`.\\n2. `username` must match `^[A-Za-z0-9_]{1,32}$` → else `400` (e.g. space, hyphen, empty).\\n3. `password` must be string with `.length \\u003e= 8` → else `400`.\\n4. Optional `display_name`: if present and not a string → `400`; if string, trim; empty after trim → treat as omitted (fall back to username).\\n5. Insert user; UNIQUE conflict on case-insensitive username → `409`.\\n6. Create session token; return `201`.\\n\\n**Client (SPA / MARATHON-21) while slow/failing:**\\n- Disable submit / show pending on `auth-submit` until response.\\n- On `201`: store `token` in `localStorage` key `huddle.token`; treat as logged-in; may call `GET /api/auth/me` or use returned `user`.\\n- On `400`/`409`: show `error` string visibly in the auth form (no silent fail).\\n- On network error / 5xx: show generic failure; do not clear unrelated UI state.\\n- **MUST NOT** send an `email` field as required.\\n\\n**Who validates what:** Server is source of truth for slug/password/duplicate. Client may pre-check length for UX but must still handle server `400`/`409`.\\n\\n---\\n\\n### C2 — `POST /api/auth/login`\\n\\n| | |\\n|--|--|\\n| Auth | None |\\n| Request body | JSON `{ \\\"username\\\": string, \\\"password\\\": string }` |\\n| Success | `200` `{ \\\"user\\\": UserObj, \\\"token\\\": string }` |\\n| Bad credentials | `401` `{ \\\"error\\\": string }` — wrong password **or** unknown username (same code; do not distinguish) |\\n| Malformed body | `400` `{ \\\"error\\\": string }` |\\n\\n**Server:**\\n1. Validate types/presence; malformed → `400`.\\n2. Look up user by case-insensitive username; missing → `401` (same as bad password).\\n3. Verify password with scrypt + stored salt; fail → `401`.\\n4. Issue new token; return `200` with full `UserObj` (current profile fields from DB).\\n\\n**Client:** Same token storage and error surfacing as register. Wrong password must show a visible error, not navigate as success.\\n\\n---\\n\\n### C3 — `GET /api/auth/me`\\n\\n| | |\\n|--|--|\\n| Auth | Required: `Authorization: Bearer \\u003ctoken\\u003e` |\\n| Body | None |\\n| Success | `200` `{ \\\"user\\\": UserObj }` |\\n| Missing/invalid/unknown token | `401` `{ \\\"error\\\": string }` |\\n\\n**Header parsing:**\\n- Require header matching `/^Bearer\\\\s+(\\\\S+)$/i` (trim); extract token.\\n- Missing header, wrong scheme, empty token, or token not in DB → `401`.\\n- Do not accept token via query string on this route (query `?token=` is SPA/WS concern later).\\n\\n**Client:** On app load, if `huddle.token` set, call `/api/auth/me`; on `401` clear token and show login; while pending, may show a loading shell without claiming a user.\\n\\n---\\n\\n### C4 — Cross-node durability (implicit contract)\\n\\nA user registered or token issued on any of `:8000`/`:8001`/`:8002` must be accepted by the other two within normal SQLite visibility (immediately after the successful response returns). QA will register on one port and `GET /api/auth/me` on another with the same token.\\n\\n---\\n\\n### C5 — Auth middleware seam (internal; for implementers of later tasks)\\n\\n```\\nresolveBearerUser(authorizationHeader: string | null) → UserObj | null\\nrequireUser(req, res) → UserObj | writes 401 and returns null\\n```\\n\\n- Input: raw `Authorization` header value.\\n- Output: public `UserObj` only.\\n- Used by MARATHON-4+, MARATHON-5+, MARATHON-18 (`?token=` maps to same session table), MARATHON-20 (IRC `PASS \\u003ctoken\\u003e`).\\n\\n## Data Model\\n\\n### Schema change\\n**New** SQLite DB `/app/data/huddle.db` (greenfield; backward compatible with empty `/app/data/`).\\n\\n#### Table `users`\\n| Column | Type | Null | Notes |\\n|--------|------|------|-------|\\n| `id` | TEXT | NOT NULL PK | UUID |\\n| `username` | TEXT | NOT NULL | Original casing |\\n| `username_lower` | TEXT | NOT NULL UNIQUE | `lower(username)` for conflict/login |\\n| `password_salt` | TEXT | NOT NULL | hex or base64 |\\n| `password_hash` | TEXT | NOT NULL | scrypt output encoding |\\n| `display_name` | TEXT | NOT NULL | |\\n| `timezone` | TEXT | NOT NULL DEFAULT `'UTC'` | |\\n| `avatar_url` | TEXT | NOT NULL DEFAULT `''` | |\\n| `status_text` | TEXT | NOT NULL DEFAULT `''` | |\\n| `status_emoji` | TEXT | NOT NULL DEFAULT `''` | |\\n| `created_at` | TEXT | NOT NULL | RFC3339 UTC |\\n\\n#### Table `tokens`\\n| Column | Type | Null | Notes |\\n|--------|------|------|-------|\\n| `token` | TEXT | NOT NULL PK | Opaque bearer (≥16 chars) |\\n| `user_id` | TEXT | NOT NULL | FK → `users.id` |\\n| `created_at` | TEXT | NOT NULL | RFC3339 UTC |\\n\\nIndexes: PK/UNIQUE as above; optional index `tokens(user_id)` for future logout-all (not required this task).\\n\\n**Migrations:** On worker boot, `CREATE TABLE IF NOT EXISTS` + WAL pragmas. No versioned migration framework required yet; keep DDL in one module (`server/db.js`) so MARATHON-4+ can extend columns carefully.\\n\\n**Password material and salts never appear in HTTP responses.**\\n\\n## Files to Create / Files to Modify\\n\\n### Create\\n| File | Change |\\n|------|--------|\\n| `server/db.js` | Open `/app/data/huddle.db`, ensure `/app/data` exists, set `journal_mode=WAL`, `busy_timeout`, run DDL for `users`/`tokens`, export `getDb()` |\\n| `server/auth/passwords.js` | `hashPassword(password) → {salt, hash}`, `verifyPassword(password, salt, hash) → boolean` using `crypto.scrypt` (sync or promisified consistently) |\\n| `server/auth/tokens.js` | `issueToken(userId) → string` (insert row); `findUserIdByToken(token) → string \\\\| null` |\\n| `server/auth/users.js` | `createUser(...)`, `findUserByUsername(username)`, `publicUser(row) → UserObj` |\\n| `server/auth/middleware.js` | `resolveBearerUser`, `requireUser` |\\n| `server/auth/routes.js` | Handlers for register, login, me; JSON parse helper; status codes per contract |\\n| `server/httpUtil.js` (optional) | `readJson(req)`, `sendJson(res, status, body)` shared with health — only if not already present from MARATHON-2 |\\n\\n### Modify\\n| File | Change |\\n|------|--------|\\n| `server/index.js` | Route `POST /api/auth/register`, `POST /api/auth/login`, `GET /api/auth/me` before generic 404; keep `GET /api/health` behavior unchanged; initialize DB once at process start (fail boot if DB cannot open) |\\n| `package.json` | No new dependencies required; may note Node ≥22 for `node:sqlite` |\\n| `start.sh` | **No change required** if it already creates `/app/data` (MARATHON-2). If not yet implemented when this lands, ensure `mkdir -p /app/data` remains. Do not move Redis dir. |\\n\\n### Do not modify\\n| File | Reason |\\n|------|--------|\\n| `timer.sh` | Harness timer |\\n| SPA / static HTML | MARATHON-21 |\\n\\n## Sequencing and Cross-Task Seams\\n\\n### Within this task\\n1. `db.js` + DDL  \\n2. passwords / users / tokens  \\n3. middleware  \\n4. routes + wire `index.js`  \\n5. Cross-node manual check (register :8000 → me :8001)\\n\\n### Parallelism\\n- Backend implementer owns all files above.\\n- Frontend MARATHON-21 **architecture** can proceed from contracts C1–C3; **implementation** of SPA auth UI should land after (or against mocked) these endpoints.\\n- MARATHON-4 (profiles) extends `users` columns usage and adds routes; must reuse `UserObj` + `requireUser`.\\n- MARATHON-5+ all depend on bearer middleware + durable users.\\n\\n### Seams this task owns\\n| Seam | Downstream |\\n|------|------------|\\n| C1/C2/C3 HTTP auth | MARATHON-21 SPA; QA grader |\\n| `UserObj` shape | MARATHON-4, channel members, messages `author`, WS `user.updated` |\\n| Session table / `resolveBearerUser` | MARATHON-5…20 authenticated APIs; WS `?token=`; IRC `PASS` |\\n| `/app/data/huddle.db` | All durable domain tables (siblings add tables, do not fork a second user DB) |\\n\\n### Build order vs siblings\\n- **Blocked on:** MARATHON-2 bootstrap (ports, `server/index.js`, `/app/data`). If MARATHON-2 is not merged, implementer still codes against its file layout and integrates when bootstrap lands.\\n- **Blocks:** MARATHON-5, MARATHON-11, MARATHON-21 (declared dependents), and practically every authenticated task.\\n\\n### Split follow-ups (do not do here)\\n| Cut | Owner |\\n|-----|--------|\\n| Profile GET/PATCH + field validation | MARATHON-4 |\\n| Logout / token revoke endpoint | Not in API contract — SPA clears `huddle.token` only; optional later if needed |\\n| WS token query param | MARATHON-18 |\\n| IRC PASS | MARATHON-20 |\\n\\n## Out of Scope (Needs a Separate Task)\\n\\nNeighborhood scan of architect worktree, `/app`, and repo tree (baseline `timer.sh` only; MARATHON-2 design not yet implemented in tree):\\n\\n| Finding | Why excluded |\\n|---------|----------------|\\n| `timer.sh` | Harness utility |\\n| `GET /api/health` / `start.sh` / Redis | MARATHON-2 |\\n| `GET /api/users/{id}`, `PATCH /api/users/me` | MARATHON-4 |\\n| Workspaces / channels / messages / … | MARATHON-5+ |\\n| SPA auth form, `huddle.token`, testids | MARATHON-21 (consumes C1–C3 only) |\\n| WS `/api/ws?token=` | MARATHON-18 (reuse token table) |\\n| IRC `PASS` / 464 | MARATHON-20 |\\n| Redis pub/sub fan-out | MARATHON-18/19 |\\n| Explicit logout API / token expiry TTL | Not in grader auth contract |\\n| Email verification, OAuth, Slack SDK | Prohibited / not specified |\\n| Rate limiting / CAPTCHA | Not required |\\n\\nNo existing `/api/auth` code or username references in-repo to update.\\n\\n## Edge Cases \\u0026 Error Handling\\n\\n| Situation | Expected behavior |\\n|-----------|-------------------|\\n| Username `\\\"alice\\\"` then `\\\"Alice\\\"` | Second register → `409` (case-insensitive unique) |\\n| Login with different casing than stored | Succeed if password matches (`username_lower` lookup) |\\n| Password length 7 | `400` on register; login of such user impossible if never created |\\n| Password exactly 8 | Allowed |\\n| `display_name` omitted | `user.display_name === username` |\\n| Extra body fields (`email`, etc.) | Ignore; do not `400` solely for unknown keys |\\n| Duplicate concurrent registers same username | One `201`, other `409` (UNIQUE + handle constraint error) |\\n| SQLite `SQLITE_BUSY` | Retry within `busy_timeout`; if still failing → `500` `{error}` (log stderr); do not corrupt partial user without token |\\n| DB file missing/unwritable at boot | Process exit non-zero; supervisor respawns — fix permissions/`mkdir` in start path |\\n| Token length | Generated tokens always ≥16; reject lookup of empty token as `401` |\\n| `Authorization: bearer \\u003ctoken\\u003e` | Accept case-insensitive `Bearer` scheme |\\n| `Authorization: Bearer` with no token | `401` |\\n| Method wrong (e.g. `GET /api/auth/register`) | `405` or `404`; must not `500` |\\n| Non-JSON Content-Type with JSON body | Best-effort parse; fail → `400` |\\n| Redis down | Auth **unaffected** (no Redis dependency) |\\n| Node killed mid-request | Client retries; durable commit is atomic per statement/transaction — use a transaction wrapping `INSERT user` + `INSERT token` on register so a crash does not leave user without usable session or orphan inconsistently (prefer: commit user first then token; if token insert fails after user commit, return `500` and allow login to mint a token) |\\n| Register success transaction | Prefer single transaction: insert user + insert token; on success return `201` |\\n| `/api/auth/me` with valid token after profile defaults | Returns current DB fields (same shape MARATHON-4 will later mutate) |\\n| Leading/trailing spaces in username | **Reject** (`400`) — must match regex exactly; do not auto-trim to accept `\\\" alice\\\"` |\\n| Unicode passwords | Allowed; length is JS string length ≥ 8 |\\n\\n## Acceptance Criteria\\n\\n1. `POST /api/auth/register` with valid `{username,password}` → `201`, body has `user` and `token`, `token.length \\u003e= 16`, `user` includes all seven `UserObj` fields.\\n2. Same username again (any casing) → `409` with JSON `error`.\\n3. Username containing a space (or hyphen/other special) → `400`.\\n4. Password length 7 → `400`.\\n5. No `email` required: body without email succeeds when username/password valid.\\n6. `POST /api/auth/login` with correct credentials → `200` `{user,token}`; new token usable on `/me`.\\n7. Wrong password → `401`; unknown username → `401` (not `404`).\\n8. `GET /api/auth/me` with `Authorization: Bearer \\u003ctoken\\u003e` → `200` `{user}` matching the registered user id/username.\\n9. Missing header, garbage token, or malformed Authorization → `401`.\\n10. Register on `127.0.0.1:8000`, then `GET /api/auth/me` on `:8001` and `:8002` with the same token → `200` (shared durable store).\\n11. Kill Redis; register/login/me still succeed on any node.\\n12. **MUST NOT:** put `password`, `password_hash`, or `password_salt` in any response body.\\n13. **MUST NOT:** change `GET /api/health` semantics or port/`node_id` mapping.\\n14. Responses use `Content-Type: application/json` (charset utf-8 preferred).\\n\\n## Testing Strategy\\n\\n### Scripted (implementer / QA)\\n```bash\\n# assume cluster up via start.sh\\ncurl -sS -D- -X POST http://127.0.0.1:8000/api/auth/register \\\\\\n  -H 'Content-Type: application/json' \\\\\\n  -d '{\\\"username\\\":\\\"alice\\\",\\\"password\\\":\\\"password1\\\"}'\\n# expect 201; capture token\\ncurl -sS -H \\\"Authorization: Bearer $TOKEN\\\" http://127.0.0.1:8001/api/auth/me\\n# expect 200 same user\\ncurl -sS -X POST http://127.0.0.1:8002/api/auth/login \\\\\\n  -H 'Content-Type: application/json' \\\\\\n  -d '{\\\"username\\\":\\\"Alice\\\",\\\"password\\\":\\\"password1\\\"}'\\n# negative cases: short password, space username, dup, bad login, me without token\\n```\\n\\n### Scenarios that matter\\n- Cross-node token acceptance (criterion 10).\\n- Case-insensitive duplicate + case-insensitive login.\\n- Redis-down auth still works.\\n- Concurrent double-register race → one 201 one 409.\\n\\n### Manual human verification\\nBoot cluster, run the curls above against all three ports, confirm `/app/data/huddle.db` exists and contains rows (`sqlite3 /app/data/huddle.db 'SELECT username FROM users;'`). Confirm health still ok during auth tests.\\n\\n### Out of scope for this task’s tests\\nSPA form, logout UI, profile PATCH, workspace creation, WS/IRC token use.\",\n  \"design_format\": \"markdown\",\n  \"has_design\": true,\n  \"notes\": \"Addressed FEEDBACK attempt=1: rebased auth onto MARATHON-2 head so start.sh, redis.conf, and bootstrap tests remain; DDL in server/db.js; register/login/me + cross-node SQLite verified; Redis-down auth verified.\",\n  \"created_at\": \"2026-08-22T19:28:48.996953698Z\",\n  \"updated_at\": \"2026-08-22T19:51:11.508470188Z\",\n  \"created_by\": \"marathon-harness\",\n  \"closed_at\": \"2026-08-22T19:51:11.508470188Z\",\n  \"close_reason\": \"integrated into /app by harness gate (attempt=2)\",\n  \"description\": \"Implement POST /api/auth/register, POST /api/auth/login, GET /api/auth/me per API contract. Username slug rules, password \\u003e=8, 201/200 envelopes {user,token} or {user}, 400/401/409 as specified. Token length \\u003e=16. Shared durable store across all three nodes.\",\n  \"comments\": [\n    {\n      \"id\": 4,\n      \"issue_id\": \"MARATHON-3\",\n      \"author\": \"frontend-dev-1\",\n      \"text\": \"IMPL-DONE attempt=1 commit=3701b6d0802a1e868de7f96121ea87432d0b8771\",\n      \"created_at\": \"2026-08-22T19:42:36.33692054Z\"\n    },\n    {\n      \"id\": 5,\n      \"issue_id\": \"MARATHON-3\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"CRITIC REVIEW attempt=1 commit=3701b6d0802a1e868de7f96121ea87432d0b8771 CHANGES-REQUESTED — Auth routes/SQLite/UserObj/bearer middleware match the design, but the candidate deletes MARATHON-2 `start.sh` and `redis.conf` (and tests), so the three-node cluster cannot boot and ACs 10–11 (cross-node me + Redis-down auth) are unverifiable; restore bootstrap unchanged per design.\",\n      \"created_at\": \"2026-08-22T19:44:07.922636306Z\"\n    },\n    {\n      \"id\": 6,\n      \"issue_id\": \"MARATHON-3\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"FEEDBACK attempt=1: critic requested changes; see CRITIC comment\",\n      \"created_at\": \"2026-08-22T19:44:07.962456799Z\"\n    },\n    {\n      \"id\": 12,\n      \"issue_id\": \"MARATHON-3\",\n      \"author\": \"backend-dev-1\",\n      \"text\": \"IMPL-DONE attempt=2 commit=55a11596219f952fc0bb9faca73e86969394be94\",\n      \"created_at\": \"2026-08-22T19:49:33.721055547Z\"\n    },\n    {\n      \"id\": 13,\n      \"issue_id\": \"MARATHON-3\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"CRITIC REVIEW attempt=2 commit=55a11596219f952fc0bb9faca73e86969394be94 APPROVED — Auth C1–C5 met: SQLite WAL users/tokens at huddle.db, scrypt+opaque bearer, UserObj envelopes, register/login/me status codes, middleware seam; start.sh/redis.conf preserved; unit tests pass and cross-node me verified.\",\n      \"created_at\": \"2026-08-22T19:51:11.25096815Z\"\n    },\n    {\n      \"id\": 14,\n      \"issue_id\": \"MARATHON-3\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"INTEGRATED attempt=2 app_before=7077d7f36a70d3cf5969335e75c028fdaeb131f6 app_after=9d37afca65c5c7dd8ce6a47f8bb165aea29d84bc\",\n      \"created_at\": \"2026-08-22T19:51:11.495142612Z\"\n    }\n  ]\n}\n---\ntime=2026-08-22T20:00:09.406Z level=INFO msg=\"opened existing embedded fleet-db client\" url=http://127.0.0.1:38569\n{\n  \"id\": \"MARATHON-25\",\n  \"title\": \"Verify: start.sh self-contained port topology\",\n  \"status\": \"closed\",\n  \"priority\": 2,\n  \"issue_type\": \"task\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"qa\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"has_design\": false,\n  \"created_at\": \"2026-08-22T19:41:32.04476087Z\",\n  \"updated_at\": \"2026-08-22T19:52:19.210486371Z\",\n  \"created_by\": \"marathon-harness\",\n  \"closed_at\": \"2026-08-22T19:52:19.210486371Z\",\n  \"close_reason\": \"integrated into /app by harness gate (attempt=1)\",\n  \"description\": \"On integrated head e2704f3 (MARATHON-2), verify against the product specification: the cluster is self-contained (no remote services, no Docker-in-Docker); only one start.sh supervisor owns Redis :6379 and HTTP :8000/:8001/:8002; killing start.sh stops keeping the service up as the harness entrypoint; health does not require Redis to be up; node_id mapping must not be remapped off 8000→0, 8001→1, 8002→2.\",\n  \"comments\": [\n    {\n      \"id\": 10,\n      \"issue_id\": \"MARATHON-25\",\n      \"author\": \"qa-engineer-1\",\n      \"text\": \"IMPL-DONE attempt=1 commit=3a519e59074fb6a1fbe8132f54d00fd76db04b5a\",\n      \"created_at\": \"2026-08-22T19:48:55.153355333Z\"\n    },\n    {\n      \"id\": 11,\n      \"issue_id\": \"MARATHON-25\",\n      \"author\": \"qa-engineer-1\",\n      \"text\": \"QA RESULTS: pass — qa-port-topology.sh 14/0 (self-contained, single supervisor owns :6379/:8000-8002, TERM start.sh tears down services, health without Redis, node_id map 8000→0/8001→1/8002→2 + inverted remap rejected); unit 5/0; defects filed: none\",\n      \"created_at\": \"2026-08-22T19:48:55.191212931Z\"\n    },\n    {\n      \"id\": 15,\n      \"issue_id\": \"MARATHON-25\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"CRITIC REVIEW attempt=1 commit=3a519e59074fb6a1fbe8132f54d00fd76db04b5a APPROVED — QA script covers self-contained topology (AC8), single-supervisor ownership of :6379/:8000–8002 (C2), no node_id remap (AC9), health without Redis (AC7/AC9), and start.sh teardown stopping the cluster; marathon-portlock run: 14 passed, 0 failed.\",\n      \"created_at\": \"2026-08-22T19:52:18.999141535Z\"\n    },\n    {\n      \"id\": 16,\n      \"issue_id\": \"MARATHON-25\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"INTEGRATED attempt=1 app_before=9d37afca65c5c7dd8ce6a47f8bb165aea29d84bc app_after=1235b176d18e5aa2ea128f892080237c04a91db6\",\n      \"created_at\": \"2026-08-22T19:52:19.200166094Z\"\n    }\n  ]\n}\n---\ntime=2026-08-22T20:00:09.416Z level=INFO msg=\"opened existing embedded fleet-db client\" url=http://127.0.0.1:38569\n{\n  \"id\": \"MARATHON-2\",\n  \"title\": \"Bootstrap cluster: start.sh, 3 HTTP nodes, Redis, health\",\n  \"status\": \"closed\",\n  \"priority\": 0,\n  \"issue_type\": \"task\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"backend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"design\": \"## Summary\\n\\nMARATHON-2 bootstraps the Huddle cluster runtime at `/app`: a foreground `start.sh` that launches local Redis on `127.0.0.1:6379` and three identical HTTP nodes on `127.0.0.1:8000/8001/8002`, keeps them alive under SIGKILL (HTTP respawn ≤60s; Redis respawn after kill), and exposes a stable `GET /api/health` contract returning `{status:\\\"ok\\\", node_id}` with `node_id` ∈ `{0,1,2}` matching ports. This is the foundation every later auth, messaging, WS, IRC, and SPA task assumes: process topology, port map, node identity, and local-only Redis.\\n\\n## Technical Approach\\n\\n### Decision\\n- **Process model:** One bash supervisor (`/app/start.sh`) stays in the foreground and owns child lifetimes. Children: one `redis-server` + three Node.js HTTP workers. The supervisor polls PIDs (≈1s cadence) and respawns any dead child without exiting.\\n- **HTTP runtime:** **Node.js** (v24 present in the environment) using the **stdlib `http` module only** for this task—no npm registry dependency for bootstrap. One shared entrypoint, differentiated solely by `NODE_ID` / `PORT` env vars.\\n- **Redis:** System `redis-server` (v7 present), bound to `127.0.0.1:6379`, persistence directory under `/app/data/redis`. Started as a non-daemon child of `start.sh` (no `--daemonize yes`) so the supervisor can track its PID.\\n- **Bind address:** HTTP listens on `127.0.0.1` (epic: nodes on `127.0.0.1:8000/8001/8002`). Redis on `127.0.0.1:6379`. No Docker, no remote broker, no cloud services.\\n\\n### Alternatives considered\\n| Alternative | Why rejected |\\n|-------------|--------------|\\n| systemd / supervisord / Docker Compose | Violates self-contained / no Docker-in-Docker; not available as the harness entrypoint |\\n| Python HTTP (stdlib) | Viable, but SPA + WS + IRC gateway later fit one Node process better; env has no FastAPI/Flask |\\n| Three separate start scripts | Harness expects a single foreground `/app/start.sh` |\\n| Health behind a reverse proxy | Extra moving part; epic requires each node to answer directly on its port |\\n\\n### Trade-off accepted\\nSupervisor simplicity (bash PID loop) over a real process manager: enough for marathon verification (kill + respawn windows), but no fancy backoff/jitter. Fixed ports mean `start.sh` must fail loudly if a protected harness process already owns a port rather than silently remapping.\\n\\n### Stack conventions fixed here (for siblings)\\nThese are **authoritative for subsequent MARATHON designs** unless a later design explicitly argues otherwise:\\n\\n| Convention | Value |\\n|------------|--------|\\n| Product | Huddle |\\n| App root | `/app` (repo working tree = deployment root) |\\n| HTTP runtime | Node.js, CommonJS or ESM; entry `server/index.js` |\\n| Node identity | Integer `NODE_ID` ∈ {0,1,2}; `PORT = 8000 + NODE_ID` |\\n| Redis | `127.0.0.1:6379`, no password, local-only |\\n| Durable shared state | Files under `/app/data/` (schema owned by MARATHON-3+; this task only creates dirs) |\\n| Pub/sub | Redis when healthy; fallback owned by MARATHON-19 (not implemented here) |\\n| API prefix | `/api/...` |\\n| JSON | `Content-Type: application/json; charset=utf-8` |\\n\\n## Interface Contracts\\n\\n### C1 — `GET /api/health` (each HTTP node)\\n\\n| Field | Value |\\n|-------|--------|\\n| Method / path | `GET /api/health` |\\n| Auth | None |\\n| Query / body | None; body ignored if present |\\n| Success status | `200` |\\n| Success body | `{\\\"status\\\":\\\"ok\\\",\\\"node_id\\\":\\u003cnumber\\u003e}` |\\n| `status` | Exactly the string `\\\"ok\\\"` (lowercase) |\\n| `node_id` | JSON number `0`, `1`, or `2` — **not** a string |\\n| Mapping | Port `8000` → `0`; `8001` → `1`; `8002` → `2` |\\n| Headers | `Content-Type: application/json; charset=utf-8` |\\n| Redis dependency | **None.** Health MUST succeed even if Redis is down or restarting (required so MARATHON-19 kill tests do not fail health probes). |\\n\\n**Owner:** Backend (this task). **Consumer:** QA harness, future load balancer checks, SPA may optionally display node identity later.\\n\\n**Client behavior while slow/failing:**\\n- Health is expected to respond in well under 1s; no loading UI required for this endpoint.\\n- Connection refused / reset → node is down or still respawning; client may retry; supervisor must restore listener within 60s of kill.\\n- Non-200 or malformed JSON → treat as failure (implementer must not return partial bodies).\\n\\n**Validation:**\\n- Server: derives `node_id` only from its configured `NODE_ID` env (integer parse once at boot); does not trust client input.\\n- Client/QA: assert status code, JSON parse, `status === \\\"ok\\\"`, `node_id === expected`.\\n\\n### C2 — Process / port topology (supervisor ↔ OS ↔ clients)\\n\\n| Process | Address | Identity |\\n|---------|---------|----------|\\n| Redis | `127.0.0.1:6379` | single shared instance |\\n| HTTP node 0 | `127.0.0.1:8000` | `NODE_ID=0` |\\n| HTTP node 1 | `127.0.0.1:8001` | `NODE_ID=1` |\\n| HTTP node 2 | `127.0.0.1:8002` | `NODE_ID=2` |\\n\\n`start.sh` remains in the foreground until terminated by signal; killing an HTTP child or Redis must not stop the supervisor or the other children.\\n\\n### C3 — Frontend/backend seam note (this task)\\nNo browser UI in this task. The only cross-seam contract is **C1**, which the SPA (MARATHON-21+) may call later from same-origin `fetch('/api/health')`. Until then, consumers are curl/QA. Unknown paths may return `404` with a small JSON error or plain 404—not part of acceptance beyond not crashing.\\n\\n## Data Model\\n\\nNo application database schema in this task.\\n\\n**Runtime configuration (env, not persisted):**\\n\\n| Name | Type | Required | Meaning |\\n|------|------|----------|---------|\\n| `NODE_ID` | integer 0\\\\|1\\\\|2 | yes (HTTP workers) | Stable node identity in health + future logs |\\n| `PORT` | integer | yes (HTTP workers) | Listen port; must equal `8000 + NODE_ID` |\\n| `REDIS_HOST` | string | optional, default `127.0.0.1` | Reserved for later tasks; unused by health |\\n| `REDIS_PORT` | integer | optional, default `6379` | Reserved for later tasks |\\n\\n**On-disk (created by `start.sh` if missing):**\\n\\n| Path | Purpose | Schema change |\\n|------|---------|---------------|\\n| `/app/data/redis/` | Redis working dir (`dir` config); RDB/AOF if enabled | New directory only; backward compatible (empty repo) |\\n| `/app/data/` | Parent for future durable store (MARATHON-3+) | Reserved; no files required by this task |\\n\\nNo migration. Greenfield baseline only had `timer.sh` + empty `data/`.\\n\\n## Files to Create / Files to Modify\\n\\n### Create\\n| File | Change |\\n|------|--------|\\n| `/app/start.sh` | Executable foreground supervisor: prepare dirs, spawn Redis + 3 nodes, trap signals, poll/respawn loop, log to stdout/stderr |\\n| `/app/server/index.js` | HTTP server entry: read `NODE_ID`/`PORT`, bind `127.0.0.1:$PORT`, route `GET /api/health`, reject invalid env at boot with non-zero exit |\\n| `/app/server/health.js` | Pure handler building `{status:\\\"ok\\\", node_id}` (keeps routing thin for later middleware) |\\n| `/app/package.json` | `{ \\\"name\\\": \\\"huddle\\\", \\\"private\\\": true, \\\"main\\\": \\\"server/index.js\\\" }` — documents Node entry; **no required dependencies** for this task |\\n\\n### Modify\\n| File | Change |\\n|------|--------|\\n| None required | Do not alter `timer.sh` (harness timer). Do not remove `.gitignore` entries unrelated to this task. |\\n\\n### Optional (allowed, not required)\\n| File | Change |\\n|------|--------|\\n| `/app/redis.conf` | Minimal conf: `bind 127.0.0.1`, `port 6379`, `dir /app/data/redis`, `protected-mode yes`, `save` optional; if omitted, pass equivalent flags on the `redis-server` CLI |\\n\\n## Sequencing and Cross-Task Seams\\n\\n### Build order for this task\\n1. `server/health.js` + `server/index.js` (can be verified with a one-off `NODE_ID=0 PORT=8000 node server/index.js` by the implementer—architect does not run the app).\\n2. `package.json`\\n3. `start.sh` (depends on server entry existing)\\n4. Manual/QA: boot via `start.sh`, hit three health URLs, kill tests\\n\\n### Parallelism\\n- All of this task is sequential within one implementer; nothing to split further.\\n- Sibling architecture designs (MARATHON-3+) can proceed in parallel **using the conventions table above**; implementation of those tasks **must wait** until this bootstrap lands so ports/processes exist.\\n\\n### Seams this task owns (downstream dependents)\\n| Seam | Contract | Downstream |\\n|------|----------|------------|\\n| Port/identity map | C2 | All HTTP/WS/SPA/IRC tasks |\\n| Health | C1 | QA, optional SPA |\\n| Redis listen address | `127.0.0.1:6379` | MARATHON-18/19 pub/sub |\\n| Foreground `start.sh` | stays up, respawns | Harness lifecycle; MARATHON-19/20 extend children later |\\n| `/app/data/` reservation | durable root | MARATHON-3 shared store |\\n\\n### Seams NOT owned here (follow-ups)\\n| Cut | Owner task |\\n|-----|------------|\\n| Auth + shared durable store schema | MARATHON-3 |\\n| WS `/api/ws` | MARATHON-18 |\\n| Redis-down fan-out fallback | MARATHON-19 |\\n| IRC `:6667` process under same supervisor | MARATHON-20 (will extend `start.sh` to launch IRC gateway + respawn) |\\n| SPA `GET /` | MARATHON-21 |\\n\\nWhen MARATHON-20/21 land, they **extend** `start.sh` and the HTTP router; they must not replace the health contract or port map.\\n\\n## Out of Scope (Needs a Separate Task)\\n\\nNeighborhood scan of `/app` and the architect worktree found:\\n\\n| Finding | Why excluded |\\n|---------|----------------|\\n| `timer.sh` | Harness countdown utility; unrelated to cluster bootstrap |\\n| Empty `/app/data/` | Reserved; durable schema is MARATHON-3+ |\\n| Auth `/api/auth/*` | MARATHON-3 |\\n| Profiles, workspaces, channels, messages, … | MARATHON-4…17 |\\n| WebSocket subscribe/resume/seq | MARATHON-18 |\\n| Cross-node fan-out without Redis | MARATHON-19 |\\n| IRC gateway `:6667` | MARATHON-20 |\\n| SPA shell and UI | MARATHON-21…23 |\\n| npm framework (Express/Fastify), WS libs, SQLite, etc. | Introduce when the owning feature task needs them |\\n| TLS, auth on Redis, binding `0.0.0.0` for HTTP | Not required by epic for HTTP nodes |\\n\\nNo prior `start.sh`, `/api/health`, or `node_id` references exist in-repo to update.\\n\\n## Edge Cases \\u0026 Error Handling\\n\\n| Situation | Expected behavior |\\n|-----------|-------------------|\\n| `NODE_ID` missing or not in `{0,1,2}` | Worker prints error to stderr and exits non-zero; supervisor respawns—**implementer must pass valid env from `start.sh` so this is a programming error, not a loop** |\\n| `PORT` missing or ≠ `8000+NODE_ID` | Same: fail fast at worker boot |\\n| Port already in use at bind | Worker exits non-zero; supervisor retries on next poll. Log clearly. Do not bind a different port. |\\n| Redis already running on 6379 (foreign process) | `redis-server` fails; supervisor respawns Redis child. Log bind failure. Do not kill arbitrary PIDs outside children started by this `start.sh` (harness `marathon-freeports` is for verifiers, not the app). |\\n| HTTP node SIGKILL | Supervisor detects dead PID within poll interval and restarts that node only; other nodes and Redis keep running. New process must again serve correct `node_id`. Wall-clock from kill to successful health: **≤ 60s** |\\n| Redis SIGKILL | Supervisor restarts Redis only; HTTP nodes **must keep serving health** (and later reads/writes per MARATHON-19). No HTTP restart required solely because Redis died |\\n| `start.sh` receives SIGINT/SIGTERM | Trap: stop respawn loop, signal/kill tracked children, then exit non-zero or 0 per convention (prefer 0 on clean TERM); do not leave orphaned node/redis children |\\n| `GET /api/health` during Redis outage | Still `200` + ok body |\\n| Methods other than GET on `/api/health` | `405` or `404`; must not 500 |\\n| Concurrent health requests | Safe; handler is pure |\\n| Double-start of `start.sh` | Second instance will fail binds; document that only one supervisor should run. No distributed lock required for marathon |\\n| Working directory | `start.sh` `cd`s to its own directory (`/app`) so relative paths work regardless of caller cwd |\\n| Logging | Prefix child logs with `[redis]`, `[node-0]`, etc., on stdout/stderr of supervisor |\\n\\n## Acceptance Criteria\\n\\n1. Running `/app/start.sh` does not daemonize away: the script process remains in the foreground and continues until signaled.\\n2. After start, `redis-cli -h 127.0.0.1 -p 6379 PING` returns `PONG` (or equivalent connectivity success).\\n3. `curl -sS http://127.0.0.1:8000/api/health` → HTTP 200, body JSON-equal to `{\\\"status\\\":\\\"ok\\\",\\\"node_id\\\":0}` (key order irrelevant; types matter).\\n4. Same for `:8001` → `node_id` **1**; `:8002` → `node_id` **2**.\\n5. `node_id` is a JSON number, not `\\\"0\\\"` string; `status` is exactly `\\\"ok\\\"`.\\n6. SIGKILL one HTTP node’s PID: within **60 seconds**, that port’s `/api/health` returns 200 again with the **same** `node_id`; the other two ports never permanently go down as a consequence.\\n7. SIGKILL Redis: Redis becomes reachable again after restart (supervisor respawn); each HTTP `/api/health` continues to return 200 during and after the outage.\\n8. No Docker, no external Redis/host, no Slack SDK, no cloud APIs required to pass the above.\\n9. **MUST NOT:** remap ports; change `node_id` mapping; require Redis up for health; exit `start.sh` when a single child dies.\\n\\n## Testing Strategy\\n\\n### Automated / scripted (implementer or QA)\\n- Boot: `/app/start.sh` in background job **only for the test harness** (script itself still runs as a foreground process in that job).\\n- Assert health on 8000/8001/8002.\\n- Assert Redis PING.\\n- `kill -9` one node PID (from `ss`/`lsof` or supervisor-known PID); poll health until success; assert elapsed ≤ 60s.\\n- `kill -9` Redis; assert health still 200; poll until Redis PING succeeds again.\\n- Tear down via SIGTERM to `start.sh`; confirm ports free (or document leftover only if trap failed—trap must succeed).\\n\\n### Manual human verification\\n```bash\\n/app/start.sh\\n# other terminal:\\ncurl -s http://127.0.0.1:8000/api/health\\ncurl -s http://127.0.0.1:8001/api/health\\ncurl -s http://127.0.0.1:8002/api/health\\nredis-cli -h 127.0.0.1 ping\\n# kill -9 \\u003cnode-pid\\u003e; wait; curl again\\n# kill -9 \\u003credis-pid\\u003e; curl health; redis-cli ping until PONG\\n```\\n\\n### Out of scope for this task’s tests\\nAuth, SPA, WS, IRC, message fan-out, multi-node data consistency.\",\n  \"design_format\": \"markdown\",\n  \"has_design\": true,\n  \"notes\": \"Implemented start.sh supervisor (Redis :6379 + nodes :8000/8001/8002 with ~1s respawn), server/index.js + health.js (GET /api/health → {status:ok, node_id} number, Redis-independent), package.json, redis.conf. Verified: unit tests, integration (health map, node SIGKILL respawn ≤60s, Redis SIGKILL with health still 200). No migration.\",\n  \"created_at\": \"2026-08-22T19:28:48.968790239Z\",\n  \"updated_at\": \"2026-08-22T19:39:36.180843586Z\",\n  \"created_by\": \"marathon-harness\",\n  \"closed_at\": \"2026-08-22T19:39:36.180843586Z\",\n  \"close_reason\": \"integrated into /app by harness gate (attempt=1)\",\n  \"description\": \"Implement /app/start.sh that stays in the foreground, launches Redis on 127.0.0.1:6379, and three HTTP nodes on :8000/:8001/:8002. Auto-respawn killed HTTP nodes within 60s and Redis after kill. GET /api/health on each node returns 200 {status:ok, node_id} with node_id 0/1/2 matching ports. Self-contained; no remote services or Docker-in-Docker.\",\n  \"comments\": [\n    {\n      \"id\": 1,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"backend-dev-1\",\n      \"text\": \"IMPL-DONE attempt=1 commit=e2704f33e188e66eba9d4d4225e79b74f8cd9ea1\",\n      \"created_at\": \"2026-08-22T19:36:35.677510582Z\"\n    },\n    {\n      \"id\": 2,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"CRITIC REVIEW attempt=1 commit=e2704f33e188e66eba9d4d4225e79b74f8cd9ea1 APPROVED — start.sh supervises Redis@127.0.0.1:6379 + nodes 8000/1/2 with ~1s respawn; GET /api/health returns {status:\\\"ok\\\", node_id} as JSON number with correct Content-Type and no Redis dependency; integration verified kill/respawn and health-during-Redis-outage.\",\n      \"created_at\": \"2026-08-22T19:39:36.063069362Z\"\n    },\n    {\n      \"id\": 3,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"INTEGRATED attempt=1 app_before=a152118acefde5daa0d42f1edf507de56b34dfec app_after=e2704f33e188e66eba9d4d4225e79b74f8cd9ea1\",\n      \"created_at\": \"2026-08-22T19:39:36.171130474Z\"\n    }\n  ]\n}","isEmpty":false,"exceededLimit":false,"totalLines":221,"fileSize":45115,"path":"/root/.cursor/projects/work-ws-worktrees-app-qa-engineer-1/agent-tools/05ece91f-9288-452c-938e-72f8cb13bc41.txt","readRange":{"startLine":1,"endLine":220},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-4dfd4f65-bad4-459d-b3f9-eb8df17e8d12-9\nfc_ecb1c529-925e-9ea0-a2a8-024565fc0c73_0","startedAtMs":"1787428812519","completedAtMs":"1787428813737"},"model_call_id":"eb41ddfd-aca0-46bd-8223-478ea5c43235-3-a4ef","session_id":"9d4ef768-2209-48bc-876a-56fa82f1ed2a","timestamp_ms":1787428813770}
{"type":"tool_call","subtype":"completed","call_id":"call-4dfd4f65-bad4-459d-b3f9-eb8df17e8d12-10\nfc_ecb1c529-925e-9ea0-a2a8-024565fc0c73_1","tool_call":{"shellToolCall":{"args":{"command":"loom data notes MARATHON-1 2>&1; loom data comments MARATHON-29 2>&1; loom data show MARATHON-3 2>&1 | head -200; echo '===='; loom data design MARATHON-3 2>&1 | head -300; echo '===='; loom data design MARATHON-2 2>&1 | head -400","workingDirectory":"","timeout":30000,"toolCallId":"call-4dfd4f65-bad4-459d-b3f9-eb8df17e8d12-10\nfc_ecb1c529-925e-9ea0-a2a8-024565fc0c73_1","simpleCommands":["loom","loom","loom","head","echo","loom","head","echo","loom","head"],"hasInputRedirect":false,"hasOutputRedirect":true,"parsingResult":{"parsingFailed":false,"executableCommands":[{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"notes"},{"type":"word","value":"MARATHON-1"}],"fullText":"loom data notes MARATHON-1"},{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"comments"},{"type":"word","value":"MARATHON-29"}],"fullText":"loom data comments MARATHON-29"},{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"show"},{"type":"word","value":"MARATHON-3"}],"fullText":"loom data show MARATHON-3"},{"name":"head","args":[{"type":"number","value":"-200"}],"fullText":"head -200"},{"name":"echo","args":[{"type":"raw_string","value":"'===='"}],"fullText":"echo '===='"},{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"design"},{"type":"word","value":"MARATHON-3"}],"fullText":"loom data design MARATHON-3"},{"name":"head","args":[{"type":"number","value":"-300"}],"fullText":"head -300"},{"name":"echo","args":[{"type":"raw_string","value":"'===='"}],"fullText":"echo '===='"},{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"design"},{"type":"word","value":"MARATHON-2"}],"fullText":"loom data design MARATHON-2"},{"name":"head","args":[{"type":"number","value":"-400"}],"fullText":"head -400"}],"hasRedirects":true,"hasCommandSubstitution":false,"allRedirectsAreDevNull":true,"redirects":[{"operator":">&","destinationFds":[2],"targetNodeType":"number","targetText":"1"},{"operator":">&","destinationFds":[2],"targetNodeType":"number","targetText":"1"},{"operator":">&","destinationFds":[2],"targetNodeType":"number","targetText":"1"},{"operator":">&","destinationFds":[2],"targetNodeType":"number","targetText":"1"},{"operator":">&","destinationFds":[2],"targetNodeType":"number","targetText":"1"}]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Fetch designs and epic notes","closeStdin":true,"conversationId":"9d4ef768-2209-48bc-876a-56fa82f1ed2a","adminCommandDenylist":[]},"result":{"success":{"command":"loom data notes MARATHON-1 2>&1; loom data comments MARATHON-29 2>&1; loom data show MARATHON-3 2>&1 | head -200; echo '===='; loom data design MARATHON-3 2>&1 | head -300; echo '===='; loom data design MARATHON-2 2>&1 | head -400","workingDirectory":"","exitCode":0,"signal":"","stdout":"The 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\nThe 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\ntime=2026-08-22T20:00:13.803Z level=INFO msg=\"opened existing embedded fleet-db client\" url=http://127.0.0.1:38569\nID:       MARATHON-3\nTitle:    Auth: register, login, me, bearer tokens\nStatus:   closed\nPriority: 0\nType:     task\nOwner:    marathon-harness\nParent:   MARATHON-1\nLabels:   [backend]\n\nDescription:\nImplement POST /api/auth/register, POST /api/auth/login, GET /api/auth/me per API contract. Username slug rules, password >=8, 201/200 envelopes {user,token} or {user}, 400/401/409 as specified. Token length >=16. Shared durable store across all three nodes.\n\nDesign (--design):\n## Summary\n\nMARATHON-3 implements cluster-wide authentication for Huddle: `POST /api/auth/register`, `POST /api/auth/login`, and `GET /api/auth/me`, plus the shared durable user/token store that all three HTTP nodes read and write. It establishes the `UserObj` identity shape, opaque bearer tokens (`Authorization: Bearer …`), password hashing, username slug validation, and a reusable auth middleware that every later authenticated route (workspaces, channels, WS, IRC `PASS`, SPA) will call. Without this seam, no other feature can attribute callers or survive a request to a different node.\n\n## Technical Approach\n\n### Decision\n- **Runtime:** Stay on the MARATHON-2 stack: Node.js stdlib `http` router in `server/index.js`, no Express/Fastify required.\n- **Durable shared store:** One **SQLite** database file at `/app/data/huddle.db`, opened by each HTTP worker via Node’s built-in **`node:sqlite` (`DatabaseSync`)**. Enable **WAL** + a non-zero `busy_timeout` so concurrent register/login from nodes 0/1/2 serialize safely. This is the authoritative store for users and sessions; **Redis is not used for auth durability** (Redis may be killed; users/tokens must survive).\n- **Passwords:** `crypto.scrypt` with a per-user random salt; store only `password_salt` + `password_hash` (never plaintext). Compare with timing-safe equality.\n- **Tokens:** Opaque random strings from `crypto.randomBytes` (≥16 chars when encoded; generate **32 bytes → base64url ≈ 43 chars**). Persist token → `user_id` in SQLite. Each successful register/login **issues a new token** (multiple concurrent sessions allowed). Tokens are looked up as presented; no JWT.\n- **IDs:** Stable cluster-wide `user.id` via `crypto.randomUUID()` (string UUID).\n- **Auth helper:** Export `authenticateRequest(req) → user | null` and/or middleware used by `/api/auth/me` and reserved for MARATHON-4+.\n\n### Alternatives considered\n| Alternative | Why rejected |\n|-------------|--------------|\n| Redis HASH for users/tokens | Not durable across Redis SIGKILL; epic requires cluster to keep working when Redis dies |\n| Per-node in-memory maps | Breaks “shared durable store across all three nodes”; register on :8000 would 401 on :8001 |\n| JWT without server-side session | Harder to revoke; contract only needs opaque bearer length ≥16; SQLite session rows are simpler and match IRC/WS token checks later |\n| npm `better-sqlite3` / Express | Unnecessary dependency; `node:sqlite` is available on Node 24 in this environment |\n| JSON file + flock only | Workable but weaker concurrency and no unique indexes for username race → prefer SQLite UNIQUE |\n\n### Trade-off accepted\nSQLite file locking under three processes is simpler than a real DB server, but write throughput under heavy concurrent register is limited by WAL/busy waits. Acceptable for marathon scale. Using experimental `node:sqlite` avoids npm install in air-gapped/self-contained constraints; if the API shifts, implementer may pin Node flags or swap to an equivalent sync SQLite binding **without changing the HTTP contract**.\n\n### Conventions inherited from MARATHON-2 (authoritative)\n| Convention | Value |\n|------------|--------|\n| App root | `/app` |\n| HTTP entry | `server/index.js`, `NODE_ID` / `PORT` |\n| Durable root | `/app/data/` |\n| API prefix | `/api/...` |\n| JSON | `Content-Type: application/json; charset=utf-8` |\n| Health | Unchanged; still Redis-independent |\n\n### Conventions fixed here (for siblings)\n| Convention | Value |\n|------------|--------|\n| DB path | `/app/data/huddle.db` (create parent dir if missing) |\n| `UserObj` public fields | `{id, username, display_name, timezone, avatar_url, status_text, status_emoji}` — always present on auth responses |\n| Username rules | Regex `^[A-Za-z0-9_]{1,32}$` (letters, digits, underscore only; no spaces/hyphens/dots) |\n| Username uniqueness | Case-insensitive (`LOWER(username)` UNIQUE); store username with original casing from register |\n| Password | UTF-8 string length ≥ 8 (code units / JS `.length`); no other complexity rules |\n| Bearer | Header `Authorization: Bearer <token>` (single space); token string length ≥ 16 |\n| Error JSON | `{ \"error\": \"<string>\" }` for 400/401/409 (message text open; must be non-empty) |\n| No email | Register/login bodies must not require `email`; ignore unknown fields |\n\n## Interface Contracts\n\n### Shared: `UserObj` (public; never include password/hash/salt/token)\n\n```json\n{\n  \"id\": \"<uuid-string>\",\n  \"username\": \"<slug>\",\n  \"display_name\": \"<string>\",\n  \"timezone\": \"<string>\",\n  \"avatar_url\": \"<string>\",\n  \"status_text\": \"<string>\",\n  \"status_emoji\": \"<string>\"\n}\n```\n\n| Field | Type | Nullability | Default on register |\n|-------|------|-------------|---------------------|\n| `id` | string (UUID) | required | generated |\n| `username` | string | required | from body |\n| `display_name` | string | required in responses | `display_name` if provided non-empty, else copy of `username` |\n| `timezone` | string | required in responses | `\"UTC\"` |\n| `avatar_url` | string | required in responses | `\"\"` |\n| `status_text` | string | required in responses | `\"\"` |\n| `status_emoji` | string | required in responses | `\"\"` |\n\n**Owner of mutations beyond register defaults:** MARATHON-4 (`PATCH /api/users/me`). This task only sets defaults so envelopes are complete.\n\n---\n\n### C1 — `POST /api/auth/register`\n\n| | |\n|--|--|\n| Auth | None |\n| Request body | JSON `{ \"username\": string, \"password\": string, \"display_name\"?: string }` |\n| Success | `201` `{ \"user\": UserObj, \"token\": string }` |\n| Validation failure | `400` `{ \"error\": string }` — invalid/missing username, password &lt; 8, non-object body, wrong types |\n| Duplicate username | `409` `{ \"error\": string }` |\n| Content-Type in | Prefer `application/json`; empty/malformed JSON → `400` |\n\n**Server validation (authoritative):**\n1. Parse JSON object; missing `username` or `password` → `400`.\n2. `username` must match `^[A-Za-z0-9_]{1,32}$` → else `400` (e.g. space, hyphen, empty).\n3. `password` must be string with `.length >= 8` → else `400`.\n4. Optional `display_name`: if present and not a string → `400`; if string, trim; empty after trim → treat as omitted (fall back to username).\n5. Insert user; UNIQUE conflict on case-insensitive username → `409`.\n6. Create session token; return `201`.\n\n**Client (SPA / MARATHON-21) while slow/failing:**\n- Disable submit / show pending on `auth-submit` until response.\n- On `201`: store `token` in `localStorage` key `huddle.token`; treat as logged-in; may call `GET /api/auth/me` or use returned `user`.\n- On `400`/`409`: show `error` string visibly in the auth form (no silent fail).\n- On network error / 5xx: show generic failure; do not clear unrelated UI state.\n- **MUST NOT** send an `email` field as required.\n\n**Who validates what:** Server is source of truth for slug/password/duplicate. Client may pre-check length for UX but must still handle server `400`/`409`.\n\n---\n\n### C2 — `POST /api/auth/login`\n\n| | |\n|--|--|\n| Auth | None |\n| Request body | JSON `{ \"username\": string, \"password\": string }` |\n| Success | `200` `{ \"user\": UserObj, \"token\": string }` |\n| Bad credentials | `401` `{ \"error\": string }` — wrong password **or** unknown username (same code; do not distinguish) |\n| Malformed body | `400` `{ \"error\": string }` |\n\n**Server:**\n1. Validate types/presence; malformed → `400`.\n2. Look up user by case-insensitive username; missing → `401` (same as bad password).\n3. Verify password with scrypt + stored salt; fail → `401`.\n4. Issue new token; return `200` with full `UserObj` (current profile fields from DB).\n\n**Client:** Same token storage and error surfacing as register. Wrong password must show a visible error, not navigate as success.\n\n---\n\n### C3 — `GET /api/auth/me`\n\n| | |\n|--|--|\n| Auth | Required: `Authorization: Bearer <token>` |\n| Body | None |\n| Success | `200` `{ \"user\": UserObj }` |\n| Missing/invalid/unknown token | `401` `{ \"error\": string }` |\n\n**Header parsing:**\n- Require header matching `/^Bearer\\s+(\\S+)$/i` (trim); extract token.\n- Missing header, wrong scheme, empty token, or token not in DB → `401`.\n- Do not accept token via query string on this route (query `?token=` is SPA/WS concern later).\n\n**Client:** On app load, if `huddle.token` set, call `/api/auth/me`; on `401` clear token and show login; while pending, may show a loading shell without claiming a user.\n\n---\n\n### C4 — Cross-node durability (implicit contract)\n\nA user registered or token issued on any of `:8000`/`:8001`/`:8002` must be accepted by the other two within normal SQLite visibility (immediately after the successful response returns). QA will register on one port and `GET /api/auth/me` on another with the same token.\n\n---\n\n### C5 — Auth middleware seam (internal; for implementers of later tasks)\n\n```\nresolveBearerUser(authorizationHeader: string | null) → UserObj | null\nrequireUser(req, res) → UserObj | writes 401 and returns null\n```\n\n- Input: raw `Authorization` header value.\n- Output: public `UserObj` only.\n- Used by MARATHON-4+, MARATHON-5+, MARATHON-18 (`?token=` maps to same session table), MARATHON-20 (IRC `PASS <token>`).\n\n## Data Model\n\n### Schema change\n**New** SQLite DB `/app/data/huddle.db` (greenfield; backward compatible with empty `/app/data/`).\n\n#### Table `users`\n| Column | Type | Null | Notes |\n|--------|------|------|-------|\n| `id` | TEXT | NOT NULL PK | UUID |\n| `username` | TEXT | NOT NULL | Original casing |\n| `username_lower` | TEXT | NOT NULL UNIQUE | `lower(username)` for conflict/login |\n| `password_salt` | TEXT | NOT NULL | hex or base64 |\n| `password_hash` | TEXT | NOT NULL | scrypt output encoding |\n| `display_name` | TEXT | NOT NULL | |\n| `timezone` | TEXT | NOT NULL DEFAULT `'UTC'` | |\n| `avatar_url` | TEXT | NOT NULL DEFAULT `''` | |\n| `status_text` | TEXT | NOT NULL DEFAULT `''` | |\n| `status_emoji` | TEXT | NOT NULL DEFAULT `''` | |\n| `created_at` | TEXT | NOT NULL | RFC3339 UTC |\n\n#### Table `tokens`\n| Column | Type | Null | Notes |\n|--------|------|------|-------|\n====\nThe 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\n====\nThe 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\n","stderr":"","executionTime":137,"interleavedOutput":"The 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\nThe 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\ntime=2026-08-22T20:00:13.803Z level=INFO msg=\"opened existing embedded fleet-db client\" url=http://127.0.0.1:38569\nID:       MARATHON-3\nTitle:    Auth: register, login, me, bearer tokens\nStatus:   closed\nPriority: 0\nType:     task\nOwner:    marathon-harness\nParent:   MARATHON-1\nLabels:   [backend]\n\nDescription:\nImplement POST /api/auth/register, POST /api/auth/login, GET /api/auth/me per API contract. Username slug rules, password >=8, 201/200 envelopes {user,token} or {user}, 400/401/409 as specified. Token length >=16. Shared durable store across all three nodes.\n\nDesign (--design):\n## Summary\n\nMARATHON-3 implements cluster-wide authentication for Huddle: `POST /api/auth/register`, `POST /api/auth/login`, and `GET /api/auth/me`, plus the shared durable user/token store that all three HTTP nodes read and write. It establishes the `UserObj` identity shape, opaque bearer tokens (`Authorization: Bearer …`), password hashing, username slug validation, and a reusable auth middleware that every later authenticated route (workspaces, channels, WS, IRC `PASS`, SPA) will call. Without this seam, no other feature can attribute callers or survive a request to a different node.\n\n## Technical Approach\n\n### Decision\n- **Runtime:** Stay on the MARATHON-2 stack: Node.js stdlib `http` router in `server/index.js`, no Express/Fastify required.\n- **Durable shared store:** One **SQLite** database file at `/app/data/huddle.db`, opened by each HTTP worker via Node’s built-in **`node:sqlite` (`DatabaseSync`)**. Enable **WAL** + a non-zero `busy_timeout` so concurrent register/login from nodes 0/1/2 serialize safely. This is the authoritative store for users and sessions; **Redis is not used for auth durability** (Redis may be killed; users/tokens must survive).\n- **Passwords:** `crypto.scrypt` with a per-user random salt; store only `password_salt` + `password_hash` (never plaintext). Compare with timing-safe equality.\n- **Tokens:** Opaque random strings from `crypto.randomBytes` (≥16 chars when encoded; generate **32 bytes → base64url ≈ 43 chars**). Persist token → `user_id` in SQLite. Each successful register/login **issues a new token** (multiple concurrent sessions allowed). Tokens are looked up as presented; no JWT.\n- **IDs:** Stable cluster-wide `user.id` via `crypto.randomUUID()` (string UUID).\n- **Auth helper:** Export `authenticateRequest(req) → user | null` and/or middleware used by `/api/auth/me` and reserved for MARATHON-4+.\n\n### Alternatives considered\n| Alternative | Why rejected |\n|-------------|--------------|\n| Redis HASH for users/tokens | Not durable across Redis SIGKILL; epic requires cluster to keep working when Redis dies |\n| Per-node in-memory maps | Breaks “shared durable store across all three nodes”; register on :8000 would 401 on :8001 |\n| JWT without server-side session | Harder to revoke; contract only needs opaque bearer length ≥16; SQLite session rows are simpler and match IRC/WS token checks later |\n| npm `better-sqlite3` / Express | Unnecessary dependency; `node:sqlite` is available on Node 24 in this environment |\n| JSON file + flock only | Workable but weaker concurrency and no unique indexes for username race → prefer SQLite UNIQUE |\n\n### Trade-off accepted\nSQLite file locking under three processes is simpler than a real DB server, but write throughput under heavy concurrent register is limited by WAL/busy waits. Acceptable for marathon scale. Using experimental `node:sqlite` avoids npm install in air-gapped/self-contained constraints; if the API shifts, implementer may pin Node flags or swap to an equivalent sync SQLite binding **without changing the HTTP contract**.\n\n### Conventions inherited from MARATHON-2 (authoritative)\n| Convention | Value |\n|------------|--------|\n| App root | `/app` |\n| HTTP entry | `server/index.js`, `NODE_ID` / `PORT` |\n| Durable root | `/app/data/` |\n| API prefix | `/api/...` |\n| JSON | `Content-Type: application/json; charset=utf-8` |\n| Health | Unchanged; still Redis-independent |\n\n### Conventions fixed here (for siblings)\n| Convention | Value |\n|------------|--------|\n| DB path | `/app/data/huddle.db` (create parent dir if missing) |\n| `UserObj` public fields | `{id, username, display_name, timezone, avatar_url, status_text, status_emoji}` — always present on auth responses |\n| Username rules | Regex `^[A-Za-z0-9_]{1,32}$` (letters, digits, underscore only; no spaces/hyphens/dots) |\n| Username uniqueness | Case-insensitive (`LOWER(username)` UNIQUE); store username with original casing from register |\n| Password | UTF-8 string length ≥ 8 (code units / JS `.length`); no other complexity rules |\n| Bearer | Header `Authorization: Bearer <token>` (single space); token string length ≥ 16 |\n| Error JSON | `{ \"error\": \"<string>\" }` for 400/401/409 (message text open; must be non-empty) |\n| No email | Register/login bodies must not require `email`; ignore unknown fields |\n\n## Interface Contracts\n\n### Shared: `UserObj` (public; never include password/hash/salt/token)\n\n```json\n{\n  \"id\": \"<uuid-string>\",\n  \"username\": \"<slug>\",\n  \"display_name\": \"<string>\",\n  \"timezone\": \"<string>\",\n  \"avatar_url\": \"<string>\",\n  \"status_text\": \"<string>\",\n  \"status_emoji\": \"<string>\"\n}\n```\n\n| Field | Type | Nullability | Default on register |\n|-------|------|-------------|---------------------|\n| `id` | string (UUID) | required | generated |\n| `username` | string | required | from body |\n| `display_name` | string | required in responses | `display_name` if provided non-empty, else copy of `username` |\n| `timezone` | string | required in responses | `\"UTC\"` |\n| `avatar_url` | string | required in responses | `\"\"` |\n| `status_text` | string | required in responses | `\"\"` |\n| `status_emoji` | string | required in responses | `\"\"` |\n\n**Owner of mutations beyond register defaults:** MARATHON-4 (`PATCH /api/users/me`). This task only sets defaults so envelopes are complete.\n\n---\n\n### C1 — `POST /api/auth/register`\n\n| | |\n|--|--|\n| Auth | None |\n| Request body | JSON `{ \"username\": string, \"password\": string, \"display_name\"?: string }` |\n| Success | `201` `{ \"user\": UserObj, \"token\": string }` |\n| Validation failure | `400` `{ \"error\": string }` — invalid/missing username, password &lt; 8, non-object body, wrong types |\n| Duplicate username | `409` `{ \"error\": string }` |\n| Content-Type in | Prefer `application/json`; empty/malformed JSON → `400` |\n\n**Server validation (authoritative):**\n1. Parse JSON object; missing `username` or `password` → `400`.\n2. `username` must match `^[A-Za-z0-9_]{1,32}$` → else `400` (e.g. space, hyphen, empty).\n3. `password` must be string with `.length >= 8` → else `400`.\n4. Optional `display_name`: if present and not a string → `400`; if string, trim; empty after trim → treat as omitted (fall back to username).\n5. Insert user; UNIQUE conflict on case-insensitive username → `409`.\n6. Create session token; return `201`.\n\n**Client (SPA / MARATHON-21) while slow/failing:**\n- Disable submit / show pending on `auth-submit` until response.\n- On `201`: store `token` in `localStorage` key `huddle.token`; treat as logged-in; may call `GET /api/auth/me` or use returned `user`.\n- On `400`/`409`: show `error` string visibly in the auth form (no silent fail).\n- On network error / 5xx: show generic failure; do not clear unrelated UI state.\n- **MUST NOT** send an `email` field as required.\n\n**Who validates what:** Server is source of truth for slug/password/duplicate. Client may pre-check length for UX but must still handle server `400`/`409`.\n\n---\n\n### C2 — `POST /api/auth/login`\n\n| | |\n|--|--|\n| Auth | None |\n| Request body | JSON `{ \"username\": string, \"password\": string }` |\n| Success | `200` `{ \"user\": UserObj, \"token\": string }` |\n| Bad credentials | `401` `{ \"error\": string }` — wrong password **or** unknown username (same code; do not distinguish) |\n| Malformed body | `400` `{ \"error\": string }` |\n\n**Server:**\n1. Validate types/presence; malformed → `400`.\n2. Look up user by case-insensitive username; missing → `401` (same as bad password).\n3. Verify password with scrypt + stored salt; fail → `401`.\n4. Issue new token; return `200` with full `UserObj` (current profile fields from DB).\n\n**Client:** Same token storage and error surfacing as register. Wrong password must show a visible error, not navigate as success.\n\n---\n\n### C3 — `GET /api/auth/me`\n\n| | |\n|--|--|\n| Auth | Required: `Authorization: Bearer <token>` |\n| Body | None |\n| Success | `200` `{ \"user\": UserObj }` |\n| Missing/invalid/unknown token | `401` `{ \"error\": string }` |\n\n**Header parsing:**\n- Require header matching `/^Bearer\\s+(\\S+)$/i` (trim); extract token.\n- Missing header, wrong scheme, empty token, or token not in DB → `401`.\n- Do not accept token via query string on this route (query `?token=` is SPA/WS concern later).\n\n**Client:** On app load, if `huddle.token` set, call `/api/auth/me`; on `401` clear token and show login; while pending, may show a loading shell without claiming a user.\n\n---\n\n### C4 — Cross-node durability (implicit contract)\n\nA user registered or token issued on any of `:8000`/`:8001`/`:8002` must be accepted by the other two within normal SQLite visibility (immediately after the successful response returns). QA will register on one port and `GET /api/auth/me` on another with the same token.\n\n---\n\n### C5 — Auth middleware seam (internal; for implementers of later tasks)\n\n```\nresolveBearerUser(authorizationHeader: string | null) → UserObj | null\nrequireUser(req, res) → UserObj | writes 401 and returns null\n```\n\n- Input: raw `Authorization` header value.\n- Output: public `UserObj` only.\n- Used by MARATHON-4+, MARATHON-5+, MARATHON-18 (`?token=` maps to same session table), MARATHON-20 (IRC `PASS <token>`).\n\n## Data Model\n\n### Schema change\n**New** SQLite DB `/app/data/huddle.db` (greenfield; backward compatible with empty `/app/data/`).\n\n#### Table `users`\n| Column | Type | Null | Notes |\n|--------|------|------|-------|\n| `id` | TEXT | NOT NULL PK | UUID |\n| `username` | TEXT | NOT NULL | Original casing |\n| `username_lower` | TEXT | NOT NULL UNIQUE | `lower(username)` for conflict/login |\n| `password_salt` | TEXT | NOT NULL | hex or base64 |\n| `password_hash` | TEXT | NOT NULL | scrypt output encoding |\n| `display_name` | TEXT | NOT NULL | |\n| `timezone` | TEXT | NOT NULL DEFAULT `'UTC'` | |\n| `avatar_url` | TEXT | NOT NULL DEFAULT `''` | |\n| `status_text` | TEXT | NOT NULL DEFAULT `''` | |\n| `status_emoji` | TEXT | NOT NULL DEFAULT `''` | |\n| `created_at` | TEXT | NOT NULL | RFC3339 UTC |\n\n#### Table `tokens`\n| Column | Type | Null | Notes |\n|--------|------|------|-------|\n====\nThe 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\n====\nThe 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands