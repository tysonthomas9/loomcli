ing","value":"\"import json,sys; d=json.load(sys.stdin); print('comments:', d.get('comments')); print('notes:', d.get('notes'))\""}],"fullText":"python3 -c \"import json,sys; d=json.load(sys.stdin); print('comments:', d.get('comments')); print('notes:', d.get('notes'))\""}],"hasRedirects":true,"hasCommandSubstitution":false,"allRedirectsAreDevNull":true,"redirects":[{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"},{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"}]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Read epic notes and task comments","closeStdin":true,"conversationId":"7d63ef8a-24c8-49fd-8698-10e4d4bbfe00","adminCommandDenylist":[]},"result":{"success":{"command":"loom data show MARATHON-1 --output json 2>/dev/null | python3 -c \"import json,sys; d=json.load(sys.stdin); print('NOTES:', d.get('notes')); print('DESIGN_LEN:', len(d.get('design') or ''))\"; loom data comments MARATHON-24 2>/dev/null; loom data show MARATHON-24 --output json | python3 -c \"import json,sys; d=json.load(sys.stdin); print('comments:', d.get('comments')); print('notes:', d.get('notes'))\"","workingDirectory":"","exitCode":0,"signal":"","stdout":"NOTES: None\nDESIGN_LEN: 0\nThe 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\ncomments: None\nnotes: None\n","stderr":"time=2026-08-22T19:42:07.991Z level=INFO msg=\"opened existing embedded fleet-db client\" url=http://127.0.0.1:38569\n","executionTime":139,"interleavedOutput":"NOTES: None\nDESIGN_LEN: 0\nThe 'loom data' subtree contains thin CLI commands that interact\nwith the configured loom issue backend. When --server or LOOM_SERVER_URL is\nset, commands talk to that loom server over HTTP. Without a server, issue\ncommands use the local backend selected by the workspace configuration and\ndaemon IPC environment.\n\nUse 'loom data' commands when:\n  • You want a backend-aware command surface for agents and scripts.\n  • You want to manage agents on a remote loom server.\n  • You are scripting against a hosted loom deployment.\n\nExamples:\n  loom data show <id> --server http://localhost:8080\n  loom data ready --limit 10\n  loom data list --server http://localhost:8080 -o json | jq '.[].id'\n  loom data monitor --server http://localhost:8080\n  loom data agent stop falcon --server http://localhost:8080\n\nRoot-level --server / --workspace are mirrored into LOOM_SERVER_URL /\nLOOM_WORKSPACE in PersistentPreRunE, so 'loom --server URL data show ID'\nand 'loom data show ID --server URL' resolve identically. The data\nsubcommand reads from env, not from its own flag.\n\nUsage:\n  loom data [command]\n\nAvailable Commands:\n  agent       Control a single agent on the loom server (stop/start/restart/yield)\n  agents      List agents managed by the loom server daemon (HTTP)\n  blocked     List issues that are blocked by other open issues (HTTP)\n  claim       Atomically claim an issue\n  close       Close an issue (HTTP)\n  comment     Add a comment to an issue (HTTP)\n  create      Create an issue\n  list        List issues (HTTP)\n  monitor     Show monitor dashboard from a loom server (HTTP, single-shot)\n  ready       List issues that are ready to work on (HTTP)\n  show        Show a single issue by ID (HTTP)\n  update      Update issue fields\n\nFlags:\n  -h, --help            help for data\n  -o, --output string   Output format: text|json (default \"text\")\n      --server string   Loom server base URL (or LOOM_SERVER_URL env var)\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n\nUse \"loom data [command] --help\" for more information about a command.\ntime=2026-08-22T19:42:07.991Z level=INFO msg=\"opened existing embedded fleet-db client\" url=http://127.0.0.1:38569\ncomments: None\nnotes: None\n","localExecutionTimeMs":77},"isBackground":false},"description":"Read epic notes and task comments"},"hookAdditionalContexts":[],"toolCallId":"call-38129246-7cc0-4233-864e-34d7da17e666-5\nfc_b5f84959-bc5e-9f28-aade-1e26fa36d6ab_1","startedAtMs":"1787427727869","completedAtMs":"1787427728008"},"model_call_id":"828c33d2-8882-40b6-8cb0-e9f6122fa44b-2-oj3l","session_id":"7d63ef8a-24c8-49fd-8698-10e4d4bbfe00","timestamp_ms":1787427728045}
