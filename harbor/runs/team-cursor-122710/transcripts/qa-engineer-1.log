{"type":"tool_call","subtype":"started","call_id":"call-d4442b39-c365-49a9-99b7-6998ff1ded42-5\nfc_026173af-8a05-94e7-9af1-ac4bcd37d011_0","tool_call":{"shellToolCall":{"args":{"command":"loom data notes MARATHON-1 2>&1; loom data show MARATHON-3 --output json 2>&1 | head -c 80000; echo '---'; loom data show MARATHON-25 --output json 2>&1 | head -c 80000; echo '---'; loom data show MARATHON-2 --output json 2>&1 | head -c 50000","workingDirectory":"","timeout":30000,"toolCallId":"call-d4442b39-c365-49a9-99b7-6998ff1ded42-5\nfc_026173af-8a05-94e7-9af1-ac4bcd37d011_0","simpleCommands":["loom","loom","head","echo","loom","head","echo","loom","head"],"hasInputRedirect":false,"hasOutputRedirect":true,"parsingResult":{"parsingFailed":false,"executableCommands":[{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"notes"},{"type":"word","value":"MARATHON-1"}],"fullText":"loom data notes MARATHON-1"},{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"show"},{"type":"word","value":"MARATHON-3"},{"type":"word","value":"--output"},{"type":"word","value":"json"}],"fullText":"loom data show MARATHON-3 --output json"},{"name":"head","args":[{"type":"word","value":"-c"},{"type":"number","value":"80000"}],"fullText":"head -c 80000"},{"name":"echo","args":[{"type":"raw_string","value":"'---'"}],"fullText":"echo '---'"},{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"show"},{"type":"word","value":"MARATHON-25"},{"type":"word","value":"--output"},{"type":"word","value":"json"}],"fullText":"loom data show MARATHON-25 --output json"},{"name":"head","args":[{"type":"word","value":"-c"},{"type":"number","value":"80000"}],"fullText":"head -c 80000"},{"name":"echo","args":[{"type":"raw_string","value":"'---'"}],"fullText":"echo '---'"},{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"show"},{"type":"word","value":"MARATHON-2"},{"type":"word","value":"--output"},{"type":"word","value