es.end(body);\n});\n\nserver.on('error', (err) => {\n  console.error(`[node-${nodeId}] Failed to bind 127.0.0.1:${port}: ${err.message}`);\n  process.exit(1);\n});\n\nserver.listen(port, '127.0.0.1', () => {\n  console.error(`[node-${nodeId}] listening on 127.0.0.1:${port}`);\n});\n","isEmpty":false,"exceededLimit":false,"totalLines":76,"fileSize":1934,"path":"/work/ws/worktrees/app/qa-engineer-1/server/index.js","readRange":{"startLine":1,"endLine":76},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-dba05b78-0ca5-4072-bbaa-446f514ffd3b-11\nfc_f89d1d96-d123-989c-9f12-4d232b5c6ee0_5","startedAtMs":"1787427731608","completedAtMs":"1787427731961"},"model_call_id":"828c33d2-8882-40b6-8cb0-e9f6122fa44b-3-5la5","session_id":"7d63ef8a-24c8-49fd-8698-10e4d4bbfe00","timestamp_ms":1787427732000}
