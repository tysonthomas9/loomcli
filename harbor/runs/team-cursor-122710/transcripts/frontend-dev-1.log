eateServer((req, res) => {\n  let pathname = '/';\n  try {\n    pathname = new URL(req.url || '/', `http://127.0.0.1:${port}`).pathname;\n  } catch {\n    pathname = '/';\n  }\n\n  if (pathname === '/api/health') {\n    if (req.method === 'GET') {\n      sendHealth(res, nodeId);\n      return;\n    }\n    sendJson(res, 405, { error: 'method_not_allowed' });\n    return;\n  }\n\n  Promise.resolve(handleAuthRoutes(req, res, pathname))\n    .then((handled) => {\n      if (handled) return;\n      sendJson(res, 404, { error: 'not_found' });\n    })\n    .catch((err) => {\n      console.error(`[node-${nodeId}] unhandled`, err);\n      if (!res.headersSent) {\n        sendJson(res, 500, { error: 'internal server error' });\n      }\n    });\n});\n\nserver.on('error', (err) => {\n  console.error(`[node-${nodeId}] Failed to bind 127.0.0.1:${port}: ${err.message}`);\n  process.exit(1);\n});\n\nserver.listen(port, '127.0.0.1', () => {\n  console.error(`[node-${nodeId}] listening on 127.0.0.1:${port}`);\n});\n","message":"Wrote contents to /work/ws/worktrees/app/frontend-dev-1/server/index.js"}}},"hookAdditionalContexts":[],"toolCallId":"call-8980c046-5c29-4e46-84a8-7d867ad5dfd3-22\nfc_13430aae-c48b-9c8e-aa63-b2322155845e_4","startedAtMs":"1787427528896","completedAtMs":"1787427529069"},"model_call_id":"2a37d5f9-56a3-4465-9a86-d97d098d1dd3-9-9an0","session_id":"b8e62675-1c0a-43a6-b50e-0b06cb55e7dc","timestamp_ms":1787427529109}
