ssert \"8\" in err.inner_text().lower() or \"password\" in err.inner_text().lower()\n    assert page.evaluate(\"() => localStorage.getItem(\\\"huddle.token\\\")\") is None\n\n    # successful signup + auto-login\n    page.fill(\"input[name=password]\", \"password1\")\n    page.fill(\"input[name=display_name]\", \"Alice\")\n    page.get_by_test_id(\"auth-submit\").click()\n    page.wait_for_selector(\"[data-testid=current-user]\", state=\"visible\", timeout=5000)\n    assert not page.locator(\"#auth-modal\").is_visible()\n    assert page.get_by_test_id(\"current-user\").inner_text() == \"Alice\"\n    token = page.evaluate(\"() => localStorage.getItem(\\\"huddle.token\\\")\")\n    assert token and len(token) >= 16, f\"token missing/short: {token!r}\"\n\n    # hard reload restores session\n    page.reload(wait_until=\"networkidle\")\n    page.wait_for_selector(\"[data-testid=current-user]\", state=\"visible\", timeout=5000)\n    assert page.get_by_test_id(\"current-user\").inner_text() == \"Alice\"\n    assert not page.locator(\"#auth-modal\").is_visible()\n\n    # logout\n    page.get_by_test_id(\"logout-btn\").click()\n    assert page.locator(\"#auth-modal\").is_visible()\n    assert page.evaluate(\"() => localStorage.getItem(\\\"huddle.token\\\")\") is None\n\n    # wrong password\n    page.get_by_test_id(\"auth-toggle\").click()  # may already be login mode after logout\n    # ensure login mode: if still showing Sign up, toggle\n    if page.get_by_test_id(\"auth-submit\").inner_text().strip().lower().startswith(\"sign\"):\n        page.get_by_test_id(\"auth-toggle\").click()\n    page.fill(\"input[name=username]\", \"alice21\")\n    page.fill(\"input[name=password]\", \"wrongpass\")\n    page.get_by_test_id(\"auth-submit\").click()\n    page.wait_for_selector(\"[data-testid=auth-error]:not([hidden])\", timeout=5000)\n    assert page.locator(\"#auth-modal\").is_visible()\n    assert page.evaluate(\"() => localStorage.getItem(\\\"huddle.token\\\")\") is None\n\n    #