sername\\\":\\\"Alice\\\",\\\"password\\\":\\\"password1\\\"}\"; echo; cat /tmp/dup.body; echo\n\necho \"=== space ===\"\ncurl -sS -o /tmp/sp.body -w \"%{http_code}\" -X POST http://127.0.0.1:8000/api/auth/register \\\n  -H \"Content-Type: application/json\" \\\n  -d \"{\\\"username\\\":\\\"a lice\\\",\\\"password\\\":\\\"password1\\\"}\"; echo; cat /tmp/sp.body; echo\n\necho \"=== short ===\"\ncurl -sS -o /tmp/pw.body -w \"%{http_code}\" -X POST http://127.0.0.1:8000/api/auth/register \\\n  -H \"Content-Type: application/json\" \\\n  -d \"{\\\"username\\\":\\\"bob\\\",\\\"password\\\":\\\"short\\\"}\"; echo; cat /tmp/pw.body; echo\n\necho \"=== bad ===\"\ncurl -sS -o /tmp/bad.body -w \"%{http_code}\" -X POST http://127.0.0.1:8000/api/auth/login \\\n  -H \"Content-Type: application/json\" \\\n  -d \"{\\\"username\\\":\\\"alice\\\",\\\"password\\\":\\\"wrongpass\\\"}\"; echo; cat /tmp/bad.body; echo\n\necho \"=== me none ===\"\ncurl -sS -o /tmp/me.body -w \"%{http_code}\" http://127.0.0.1:8000/api/auth/me; echo; cat /tmp/me.body; echo\n\necho \"=== unknown ===\"\ncurl -sS -o /tmp/unk.body -w \"%{http_code}\" -X POST http://127.0.0.1:8000/api/auth/login \\\n  -H \"Content-Type: application/json\" \\\n  -d \"{\\\"username\\\":\\\"nobody\\\",\\\"password\\\":\\\"password1\\\"}\"; echo; cat /tmp/unk.body; echo\n\necho \"=== hyphen user ===\"\ncurl -sS -o /tmp/hy.body -w \"%{http_code}\" -X POST http://127.0.0.1:8000/api/auth/register \\\n  -H \"Content-Type: application/json\" \\\n  -d \"{\\\"username\\\":\\\"a-b\\\",\\\"password\\\":\\\"password1\\\"}\"; echo; cat /tmp/hy.body; echo\n\n# login token works on me\nLTOKEN=$(python3 -c \"import json,sys; print(json.loads(sys.argv[1])[\\\"token\\\"])\" \"$LOGIN\")\ncurl -sS -H \"Authorization: Bearer $LTOKEN\" http://127.0.0.1:8000/api/auth/me; echo\n\npython3 - <<PY\nimport json\nreg=json.loads(\"\"\"$REG\"\"\")\nlogin=json.loads(\"\"\"$LOGIN\"\"\")\nme1=json.loads(\"\"\"$ME1\"\"\")\nassert reg[\"user\"][\"username\"]==\"alice\"\nassert reg[\"user\"][\"display_name\"]==\"alice\"\nassert len(reg[\"token\"])>=16\nassert me1[\"user\"][\"id\"]==reg[\"user\"][\"id\"]\nassert login[\"user\"][\"id\"]==reg[\"user\"][\"id\"]\nassert login[\"token\"]!=reg[\"token\"]\nfor d in (reg,login,me1):\n  s=json.dumps(d)\n  assert \"password_hash\" not in s and \"password_salt\" not in s\nprint(\"ALL ASSERTIONS OK\")\nPY\n'","workingDirectory":"","timeout":30000,"toolCallId":"call-1ef5f9e6-edf5-4d5b-97da-d3bf3a7a03ec-30\nfc_1461dd81-5e9c-9eea-b485-056f98573cc0_0","simpleCommands":["cd","marathon-freeports","marathon-portlock"],"hasInputRedirect":false,"hasOutputRedirect":false,"parsingResult":{"parsingFailed":false,"executableCommands":[{"name":"cd","args":[{"type":"word","value":"/work/ws/worktrees/app/frontend-dev-1"}],"fullText":"cd /work/ws/worktrees/app/frontend-dev-1"},{"name":"marathon-freeports","args":[],"fullText":"marathon-freeports"},{"name":"marathon-portlock","args":[{"type":"word","value":"bash"},{"type":"word","value":"-c"},{"type":"raw_string","value":"'\nset -e\nAPP_DIR=/work/ws/worktrees/app/frontend-dev-1\nNODE=/usr/bin/node\nmkdir -p /app/data\nrm -f /app/data/huddle.db /app/data/huddle.db-wal /app/data/huddle.db-shm\n\nNODE_ID=0 PORT=8000 $NODE \"$APP_DIR/server/index.js\" &\nP0=$!\nsleep 0.3\nNODE_ID=1 PORT=8001 $NODE \"$APP_DIR/server/index.js\" &\nP1=$!\nsleep 0.3\nNODE_ID=2 PORT=8002 $NODE \"$APP_DIR/server/index.js\" &\nP2=$!\nsleep 0.5\n\ncleanup() { kill $P0 $P1 $P2 2>/dev/null || true; }\ntrap cleanup EXIT\n\nfor p in 8000 8001 8002; do\n  curl -sf http://127.0.0.1:$p/api/health\n  echo\ndone\n\nREG=$(curl -sS -D /tmp/reg.hdr -X POST http://127.0.0.1:8000/api/auth/register \\\n  -H \"Content-Type: application/json\" \\\n  -d \"{\\\"username\\\":\\\"alice\\\",\\\"password\\\":\\\"password1\\\"}\")\necho \"REG_HDR=$(head -1 /tmp/reg.hdr)\"\necho \"REG=$REG\"\nTOKEN=$(python3 -c \"import json,sys; print(json.loads(sys.argv[1])[\\\"token\\\"])\" \"$REG\")\necho \"TOKEN_LEN=${#TO