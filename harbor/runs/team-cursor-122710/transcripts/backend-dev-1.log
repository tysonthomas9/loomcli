-. 1 root root  132 Aug 22 19:34 package.json\n-rw-------. 1 root root  116 Aug 22 19:34 redis.conf\ndrwx------. 2 root root   39 Aug 22 19:34 server\n-rwx------. 1 root root 2596 Aug 22 19:34 start.sh\ndrwx------. 2 root root   82 Aug 22 19:35 test\n-rwxr-xr-x. 1 root root  558 Aug 22 19:27 timer.sh\ntotal 8\ndrwxr-xr-x. 2 root root  34 Aug 22 19:27 .\ndrwxr-xr-x. 6 root root  63 Aug 22 19:27 ..\n-rw-r--r--. 1 root root  32 Aug 22 19:27 .git\n-rwxr-xr-x. 1 root root 558 Aug 22 19:27 timer.sh\ntotal 32\ndrwxr-xr-x. 6 root root 4096 Aug 22 19:41 .\ndrwxr-xr-x. 6 root root   93 Aug 22 19:27 ..\n-rw-------. 1 root root  264 Aug 22 19:41 .agent.lock\n-rw-------. 1 root root    0 Aug 22 19:32 .agent.lock.flock\n-rw-r--r--. 1 root root   42 Aug 22 19:27 .git\n-rw-r--r--. 1 root root   44 Aug 22 19:27 .gitignore\ndrwx------. 3 root root   19 Aug 22 19:35 data\ndrwxr-xr-x. 2 root root   33 Aug 22 19:27 loom-prompts\n-rw-------. 1 root root  132 Aug 22 19:34 package.json\n-rw-------. 1 root root  116 Aug 22 19:34 redis.conf\ndrwx------. 2 root root   39 Aug 22 19:34 server\n-rwx------. 1 root root 2596 Aug 22 19:34 start.sh\ndrwx------. 2 root root   82 Aug 22 19:35 test\n-rwxr-xr-x. 1 root root  558 Aug 22 19:27 timer.sh\n","localExecutionTimeMs":47},"isBackground":false},"description":"Inspect workspace and repo layout"},"hookAdditionalContexts":[],"toolCallId":"call-b787d36b-b3c9-4ae7-9901-0efd69431820-1\nfc_1f8470ab-fcec-914d-8f99-ba6465701754_1","startedAtMs":"1787427714708","completedAtMs":"1787427715162"},"model_call_id":"05e2797e-cf19-433d-b159-8241b12ca6db-0-mknk","session_id":"7c55add2-f2f2-40da-bacd-9bfda41bc16c","timestamp_ms":1787427715198}
{"type":"tool_call","subtype":"completed","call_id":"call-b787d36b-b3c9-4ae7-9901-0efd69431820-0\nfc_1f8470ab-fcec-914d-8f99-ba6465701754_0","tool_call":{"shellToolCall":{"args":{"command":"loom data show MARATHON-4 --output json && echo '---' && git merge --no-edit main && echo '---' && git status && git log --oneline -5 && git rev-parse HEAD && git branch --show-current && pwd && ls -la","workingDirectory":"","timeout":30000,"toolCallId":"call-b787d36b-b3c9-4ae7-9901-0efd69431820-0\nfc_1f8470ab-fcec-914d-8f99-ba6465701754_0","simpleCommands":["loom","echo","git","echo","git","git","git","git","pwd","ls"],"hasInputRedirect":false,"hasOutputRedirect":false,"parsingResult":{"parsingFailed":false,"executableCommands":[{"name":"loom","args":[{"type":"word","value":"data"},{"type":"word","value":"show"},{"type":"word","value":"MARATHON-4"},{"type":"word","value":"--output"},{"type":"word","value":"json"}],"fullText":"loom data show MARATHON-4 --output json"},{"name":"echo","args":[{"type":"raw_string","value":"'---'"}],"fullText":"echo '---'"},{"name":"git","args":[{"type":"word","value":"merge"},{"type":"word","value":"--no-edit"},{"type":"word","value":"main"}],"fullText":"git merge --no-edit main"},{"name":"echo","args":[{"type":"raw_string","value":"'---'"}],"fullText":"echo '---'"},{"name":"git","args":[{"type":"word","value":"status"}],"fullText":"git status"},{"name":"git","args":[{"type":"word","value":"log"},{"type":"word","value":"--oneline"},{"type":"number","value":"-5"}],"fullText":"git log --oneline -5"},{"name":"git","args":[{"type":"word","value":"rev-parse"},{"type":"word","value":"HEAD"}],"fullText":"git rev-parse HEAD"},{"name":"git","args":[{"type":"word","value":"branch"},{"type":"word","value":"--show-current"}],"fullText":"git branch --show-current"},{"name":"pwd","args":[],"fullText":"pwd"},{"name":"ls","args":[{"type":"word","value":"-la"}],"fullText":"ls -la"}],"hasRedirects":false,"hasCommandSubstitution":false,"redirects":[]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Show task, merge main, check state","closeStdin":true,"conversationId":"7c55add2-f2f2-40da-bacd-9bfda41bc16c","adminCommandDenylist":[]},"result":{"success":{"command":"loom data show MARATHON-4 --output json && echo '---' && git merge --no-edit main && echo '---' && git status && git log --oneline -5 && git rev-parse HEAD && git branch --show-current && pwd && ls -la","workingDirectory":"","exitCode":0,"signal":"","stdout":"{\n  \"id\": \"MARATHON-4\",\n  \"title\": \"Profiles: GET user and PATCH /api/users/me\",\n  \"status\": \"in_progress\",\n  \"priority\": 1,\n  \"issue_type\": \"task\",\n  \"assignee\": \"backend-dev-1\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"backend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"design\": \"## Summary\\n\\nMARATHON-4 adds authenticated profile read and self-update on top of the MARATHON-3 `UserObj` / `users` table: `GET /api/users/{id}` returns a public profile (`200` / `404`), and `PATCH /api/users/me` mutates a validated subset of profile fields (`400` on bad timezone or over-length strings). Successful patches persist in the shared SQLite store (visible on every node) and emit a cluster-wide `user.updated` event through a no-op-safe broadcast hook that MARATHON-18 wires to WebSocket fan-out. This closes the gap between register-time profile defaults and live profile editing the SPA/settings flows need.\\n\\n## Technical Approach\\n\\n### Decision\\n- **Reuse MARATHON-3 identity stack:** Same `/app/data/huddle.db` `users` row, same `publicUser(row) → UserObj`, same `requireUser` / bearer middleware. No second user store.\\n- **Routes live under `/api/users`:** New module `server/users/routes.js` (HTTP only). Persistence helpers (`findUserById`, `updateUserProfile`) extend `server/auth/users.js` so DDL ownership stays with auth.\\n- **Mutable PATCH subset only:** `display_name`, `timezone`, `avatar_url`, `status_text`, `status_emoji`. **Never** allow `id`, `username`, password fields, or token mutation via this route.\\n- **Timezone validation:** Accept only IANA time zone names. Prefer `Intl.supportedValuesOf('timeZone')` when available (Node 20+); otherwise validate by constructing `new Intl.DateTimeFormat('en-US', { timeZone })` and rejecting on throw. `\\\"UTC\\\"` remains valid. Do **not** invent offset-only strings like `\\\"UTC+1\\\"` as valid unless they appear in the IANA list.\\n- **Length caps (authoritative):** enforce on the server with JS string `.length` (same length model as MARATHON-3 passwords).\\n- **WS hook, not WS implementation:** After a successful DB commit, call `emitUserUpdated(userObj)` from `server/events/userUpdated.js`. Default export is a no-op (or in-process listener list). MARATHON-18 replaces/registers the real global WS broadcast. HTTP success **must not** depend on Redis or WS being up.\\n\\n### Alternatives considered\\n| Alternative | Why rejected |\\n|-------------|--------------|\\n| Return bare `UserObj` without `{ \\\"user\\\": ... }` wrapper | Breaks symmetry with `GET /api/auth/me` and register/login envelopes fixed in MARATHON-3 |\\n| Allow PATCH to rename `username` | Username is the durable login identity (case-insensitive unique); renaming needs a separate task and migration story |\\n| Require workspace membership to GET a user | Workspaces are MARATHON-5; until then any authenticated user may resolve any `user.id` (global directory) |\\n| Put profile columns in a separate `profiles` table | Unnecessary join; MARATHON-3 already defined columns on `users` |\\n| Block PATCH until MARATHON-18 ships | Task explicitly says hook up when WS exists; profile REST must work without WS |\\n| Soft-validate timezone (accept any string) | Task requires timezone validation → `400` |\\n\\n### Trade-off accepted\\nGlobal directory lookup (any authed user → any user id) is simpler than workspace-scoped visibility but leaks existence of all accounts by UUID. Acceptable for this marathon; MARATHON-5+ may tighten visibility later without changing `UserObj` shape.\\n\\n### Conventions inherited (authoritative)\\n| Source | Convention |\\n|--------|------------|\\n| MARATHON-2 | `/app`, `server/index.js`, `/api/...`, JSON `Content-Type: application/json; charset=utf-8`, three nodes, `/app/data/` |\\n| MARATHON-3 | `UserObj` seven fields; error `{ \\\"error\\\": string }`; bearer `Authorization: Bearer \\u003ctoken\\u003e`; SQLite `/app/data/huddle.db`; `requireUser`; ignore unknown JSON keys on write |\\n\\n## Interface Contracts\\n\\n### Shared: `UserObj` (unchanged from MARATHON-3)\\n\\n```json\\n{\\n  \\\"id\\\": \\\"\\u003cuuid-string\\u003e\\\",\\n  \\\"username\\\": \\\"\\u003cslug\\u003e\\\",\\n  \\\"display_name\\\": \\\"\\u003cstring\\u003e\\\",\\n  \\\"timezone\\\": \\\"\\u003cstring\\u003e\\\",\\n  \\\"avatar_url\\\": \\\"\\u003cstring\\u003e\\\",\\n  \\\"status_text\\\": \\\"\\u003cstring\\u003e\\\",\\n  \\\"status_emoji\\\": \\\"\\u003cstring\\u003e\\\"\\n}\\n```\\n\\nAll seven keys always present in responses. Never include password, hash, salt, or token.\\n\\n### Patchable field limits (server-authoritative)\\n\\n| Field | Type | Max `.length` | Empty string | Notes |\\n|-------|------|---------------|--------------|-------|\\n| `display_name` | string | 64 | allowed | Trim leading/trailing whitespace before length check and store; empty after trim → store `\\\"\\\"` |\\n| `timezone` | string | 64 (and IANA-valid) | **not** allowed | Must be non-empty IANA name (e.g. `UTC`, `America/New_York`) |\\n| `avatar_url` | string | 2048 | allowed | No scheme check required; store as given after type check (do not trim interior spaces) |\\n| `status_text` | string | 100 | allowed | Trim ends; empty → `\\\"\\\"` |\\n| `status_emoji` | string | 32 | allowed | Trim ends; empty → `\\\"\\\"`; multi-codepoint emoji OK within length |\\n\\n**Partial update semantics:** Only keys **present** in the JSON object are updated. Omitted keys stay unchanged. Wrong type (`null`, number, object, array) for a present key → `400`. Empty object `{}` → `200` with unchanged `UserObj` (no WS emit if nothing changed).\\n\\n**Forbidden keys if present with any value:** `id`, `username`, `password`, `password_hash`, `password_salt`, `token` → `400` `{ \\\"error\\\": string }` (do not silently ignore identity/credential fields).\\n\\nOther unknown keys → ignore (same as MARATHON-3 register).\\n\\n---\\n\\n### C1 — `GET /api/users/{id}`\\n\\n| | |\\n|--|--|\\n| Auth | Required (`requireUser`) |\\n| Path param | `id` — opaque user UUID string (exact match to `users.id`) |\\n| Success | `200` `{ \\\"user\\\": UserObj }` |\\n| Not found | `404` `{ \\\"error\\\": string }` |\\n| Unauthenticated | `401` `{ \\\"error\\\": string }` |\\n| Wrong method | `405` or `404`; must not `500` |\\n\\n**Server:**\\n1. Resolve bearer → user or `401`.\\n2. If path is exactly `/api/users/me` on GET: treat `id` as the literal string `me` → **404** (self profile remains `GET /api/auth/me`). Do not special-case.\\n3. Look up `users.id = id`; missing → `404`.\\n4. Return `publicUser` envelope.\\n\\n**Who validates:** Server owns UUID existence. Client must not assume every id from messages still exists.\\n\\n**Client (SPA / MARATHON-21–23) while slow/failing:**\\n- While pending: keep prior cached profile or show a neutral placeholder; do not flash logged-out.\\n- On `200`: render `user.display_name` (fallback UX: `username` if display_name empty).\\n- On `404`: show “user not found”; do not clear session.\\n- On `401`: clear `huddle.token`, show login (same as `/api/auth/me`).\\n- On network/5xx: show transient error; retry allowed.\\n\\n---\\n\\n### C2 — `PATCH /api/users/me`\\n\\n| | |\\n|--|--|\\n| Auth | Required (`requireUser`) — updates **only** the authenticated user |\\n| Body | JSON object; subset of patchable fields above |\\n| Success | `200` `{ \\\"user\\\": UserObj }` (post-update row) |\\n| Validation failure | `400` `{ \\\"error\\\": string }` |\\n| Unauthenticated | `401` `{ \\\"error\\\": string }` |\\n| Malformed JSON / non-object | `400` |\\n\\n**Server algorithm:**\\n1. `requireUser` or `401`.\\n2. `readJson` → must be a plain object.\\n3. Validate each present key per table; collect updates.\\n4. If any forbidden key present → `400` before writes.\\n5. If updates non-empty: `UPDATE users SET ... WHERE id = ?` in SQLite; re-read row; `publicUser`.\\n6. If at least one field actually changed: call `emitUserUpdated(userObj)` (best-effort; errors logged, HTTP still `200`).\\n7. If no fields changed: return `200` with current user; **do not** emit.\\n\\n**Who validates:** Server is source of truth for IANA timezone and lengths. Client may pre-check for UX but must handle `400`.\\n\\n**Client while slow/failing:**\\n- Disable save control / show pending on profile form until response.\\n- Optimistic UI optional; on `400` revert fields and show `error` string.\\n- On `200`: replace local current-user state with returned `user`; also expect eventual `user.updated` WS (when MARATHON-18 exists) and reconcile by `user.id`.\\n- On `401`: logout flow.\\n- On network/5xx: keep form dirty state; show retry; **MUST NOT** assume server applied the patch.\\n\\n---\\n\\n### C3 — `user.updated` broadcast seam (owned here; delivered by MARATHON-18)\\n\\n**Event name:** `user.updated`  \\n**Scope:** Global — all authenticated WS connections on all nodes (when hub exists), not channel-scoped.  \\n**Payload (WS frame / hub message body):**\\n\\n```json\\n{\\n  \\\"type\\\": \\\"user.updated\\\",\\n  \\\"user\\\": {\\n    \\\"id\\\": \\\"\\u003cuuid\\u003e\\\",\\n    \\\"username\\\": \\\"\\u003cslug\\u003e\\\",\\n    \\\"display_name\\\": \\\"\\u003cstring\\u003e\\\",\\n    \\\"timezone\\\": \\\"\\u003cstring\\u003e\\\",\\n    \\\"avatar_url\\\": \\\"\\u003cstring\\u003e\\\",\\n    \\\"status_text\\\": \\\"\\u003cstring\\u003e\\\",\\n    \\\"status_emoji\\\": \\\"\\u003cstring\\u003e\\\"\\n  }\\n}\\n```\\n\\n**Module contract:**\\n\\n```\\n// server/events/userUpdated.js\\nemitUserUpdated(user: UserObj): void\\nregisterUserUpdatedListener(fn: (user: UserObj) =\\u003e void): void  // optional helper for tests / WS hub\\n```\\n\\n- MARATHON-4 always calls `emitUserUpdated` after a mutating PATCH.\\n- Until MARATHON-18 registers a listener / Redis publish, emit is a no-op (in-process listeners only if registered).\\n- MARATHON-18/19 own cross-node fan-out; this task does **not** publish to Redis directly (avoids inventing the pub/sub envelope twice). If implementer prefers a tiny in-process EventEmitter only, that is enough for C3.\\n\\n**Client when WS exists:** On `user.updated`, update any rendered profile/message author chrome for matching `user.id`. If WS is down, HTTP GET/PATCH remain correct; stale UI until refresh is acceptable.\\n\\n## Data Model\\n\\n### Schema change\\n**None required** if MARATHON-3 DDL already created:\\n\\n| Column | Type | Null | Notes |\\n|--------|------|------|-------|\\n| `id` | TEXT PK | NOT NULL | Immutable via PATCH |\\n| `username` / `username_lower` | TEXT | NOT NULL | Immutable via PATCH |\\n| `display_name` | TEXT | NOT NULL | Mutable |\\n| `timezone` | TEXT | NOT NULL DEFAULT `'UTC'` | Mutable; IANA |\\n| `avatar_url` | TEXT | NOT NULL DEFAULT `''` | Mutable |\\n| `status_text` | TEXT | NOT NULL DEFAULT `''` | Mutable |\\n| `status_emoji` | TEXT | NOT NULL DEFAULT `''` | Mutable |\\n| password / salt / `created_at` | — | — | Untouched |\\n\\n**Backward compatibility:** Additive routes only. Existing auth responses keep working. No column drops/renames.\\n\\n**If MARATHON-3 columns are somehow missing** (partial implement): implementer adds the same `ALTER TABLE` / DDL defaults as MARATHON-3 — do not invent alternate names.\\n\\nNo new tables.\\n\\n## Files to Create / Files to Modify\\n\\n### Create\\n| File | Change |\\n|------|--------|\\n| `server/users/routes.js` | Handlers: `GET /api/users/:id`, `PATCH /api/users/me`; path parse; status codes per C1/C2; call validation + store + `emitUserUpdated` |\\n| `server/users/validate.js` | `assertPatchBody(obj) → { updates } \\\\| { error }` — length, type, IANA timezone, forbidden keys |\\n| `server/events/userUpdated.js` | `emitUserUpdated`, optional `registerUserUpdatedListener`; default no-op fan-out |\\n\\n### Modify\\n| File | Change |\\n|------|--------|\\n| `server/auth/users.js` | Add `findUserById(id) → row \\\\| null`, `updateUserProfile(id, updates) → row` (UPDATE only provided columns); keep `publicUser` as single serializer |\\n| `server/index.js` | After auth routes: dispatch `PATCH` `/api/users/me` and `GET` `/api/users/*` before generic 404; keep health + auth behavior unchanged |\\n| `server/httpUtil.js` | Reuse `readJson` / `sendJson` if MARATHON-3 added them; otherwise use the same helpers auth routes use (do not duplicate divergent JSON error shapes) |\\n\\n### Do not modify\\n| File | Reason |\\n|------|--------|\\n| `start.sh` / `redis.conf` / health | MARATHON-2 |\\n| `server/auth/routes.js` register/login/me contracts | Unchanged; PATCH is not `/api/auth/me` |\\n| SPA / static UI | MARATHON-21–23 |\\n| WS router / Redis pubsub | MARATHON-18/19 |\\n\\n## Sequencing and Cross-Task Seams\\n\\n### Within this task\\n1. `findUserById` / `updateUserProfile` + validator  \\n2. `userUpdated` event stub  \\n3. HTTP routes + `index.js` wiring  \\n4. Cross-node check: PATCH on :8000 → GET user on :8001  \\n\\n### Parallelism\\n- Backend-only implementation.\\n- Frontend settings UI (MARATHON-23) can be designed against C2; implement against live API after this lands.\\n- MARATHON-18 can implement WS listen/subscribe in parallel using C3 payload; must call `registerUserUpdatedListener` or equivalent from the hub boot.\\n\\n### Seams this task owns\\n| Seam | Downstream |\\n|------|------------|\\n| C1 GET user by id | Messages/members UIs; mentions; SPA profile popovers |\\n| C2 PATCH `/api/users/me` | SPA settings (MARATHON-23); any client editing status/timezone |\\n| C3 `user.updated` payload + `emitUserUpdated` | MARATHON-18 WS global broadcast; MARATHON-19 fan-out must carry this event type when Redis is down |\\n| Length/IANA rules | All writers of profile fields (no other writer should bypass validator) |\\n\\n### Build order vs siblings\\n- **Blocked on:** MARATHON-3 (`users` table, `requireUser`, `publicUser`). MARATHON-2 for process topology.\\n- **Soft-blocked on WS delivery:** none for HTTP acceptance; WS delivery blocked on MARATHON-18.\\n- **Does not block:** workspace/channel CRUD can proceed; they should embed `UserObj` via `publicUser` when returning members.\\n\\n### Split follow-ups (do not do here)\\n| Cut | Owner |\\n|-----|--------|\\n| Actual WS subscribe + global emit over Redis | MARATHON-18 / MARATHON-19 |\\n| SPA profile/settings forms + testids | MARATHON-21 / MARATHON-23 |\\n| Username change / password change APIs | New task if ever required |\\n| Workspace-scoped profile visibility | Optional later under MARATHON-5+ |\\n| Avatar file upload | MARATHON-11 (files); this task only stores URL string |\\n\\n## Out of Scope (Needs a Separate Task)\\n\\nNeighborhood scan (architect worktree = baseline `timer.sh` only; sibling `backend-dev-1` has MARATHON-2 `server/index.js`, `server/health.js`, `start.sh`, tests — **no** `/api/users` or auth modules yet; `/app` same baseline; grep for `UserObj` / `timezone` / `user.updated` / `/api/users` → no implementation hits):\\n\\n| Finding | Why excluded |\\n|---------|----------------|\\n| `server/health.js`, `GET /api/health`, `start.sh`, Redis | MARATHON-2 |\\n| `POST /api/auth/*`, `GET /api/auth/me`, token/password DDL | MARATHON-3 (prerequisite; do not re-specify) |\\n| `timer.sh` | Harness |\\n| WS `/api/ws`, dense seq, resume | MARATHON-18 |\\n| Redis-down fan-out | MARATHON-19 |\\n| IRC nick/profile bridging | MARATHON-20 |\\n| SPA auth + settings UI | MARATHON-21–23 |\\n| File upload for avatars | MARATHON-11 |\\n| Workspaces/members embedding users | MARATHON-5 |\\n| Rate limiting profile writes | Not required |\\n\\n## Edge Cases \\u0026 Error Handling\\n\\n| Situation | Expected behavior |\\n|-----------|-------------------|\\n| GET unknown UUID | `404` `{error}` |\\n| GET valid id without auth | `401` |\\n| GET `/api/users/me` | `404` (literal id `me`); use `/api/auth/me` |\\n| PATCH without auth | `401` |\\n| PATCH `timezone: \\\"Not/AZone\\\"` | `400` |\\n| PATCH `timezone: \\\"\\\"` | `400` |\\n| PATCH `display_name` length 65 | `400` |\\n| PATCH `status_text` length 101 | `400` |\\n| PATCH `status_emoji` length 33 | `400` |\\n| PATCH `avatar_url` length 2049 | `400` |\\n| PATCH includes `username` | `400` (forbidden key) |\\n| PATCH includes only unknown keys | Treat as `{}` → `200`, no emit |\\n| PATCH `display_name: \\\"  Alice  \\\"` | Store `\\\"Alice\\\"` (trimmed) |\\n| PATCH `display_name: \\\"   \\\"` | Store `\\\"\\\"` |\\n| PATCH `status_emoji: \\\"🚀\\\"` | `200` if `.length ≤ 32` |\\n| Concurrent PATCH same user on two nodes | Last writer wins per field set; both may emit `user.updated`; acceptable |\\n| SQLITE_BUSY | Respect `busy_timeout`; if still failing → `500` `{error}`; no partial HTTP success |\\n| `emitUserUpdated` throws | Log stderr; still return `200` with saved user |\\n| Redis down | PATCH/GET unaffected |\\n| User deleted (future) while GET | N/A now (no delete API); if row missing → `404` |\\n| Non-JSON PATCH body | `400` |\\n| `Content-Type` missing but body is JSON | Best-effort parse; fail → `400` |\\n| Method `PUT`/`POST` on `/api/users/me` | `405` or `404`; must not apply updates |\\n| Extra whitespace in IANA zone `\\\" America/New_York\\\"` | `400` (do not auto-trim timezone; must match IANA exactly) |\\n\\n## Acceptance Criteria\\n\\n1. Authenticated `GET /api/users/{id}` for an existing user → `200` `{user}` with all seven `UserObj` fields matching DB.\\n2. Authenticated GET for unknown id → `404` with JSON `error`.\\n3. GET without bearer (or bad token) → `401`.\\n4. `PATCH /api/users/me` with valid `{ \\\"display_name\\\": \\\"Ada\\\", \\\"timezone\\\": \\\"America/New_York\\\" }` → `200`; subsequent `GET /api/auth/me` and `GET /api/users/{id}` on **another node** reflect updates.\\n5. PATCH with invalid timezone → `400`; DB row unchanged.\\n6. PATCH with over-length `status_text` / `display_name` / `avatar_url` / `status_emoji` → `400`; DB unchanged.\\n7. PATCH body attempting `username` or `id` change → `400`; username unchanged.\\n8. PATCH `{}` → `200`; user unchanged.\\n9. After a mutating PATCH, `emitUserUpdated` is invoked with the new `UserObj` (verifiable via test listener); HTTP still `200` if no WS hub registered.\\n10. **MUST NOT** include password/hash/salt/token in GET/PATCH responses.\\n11. **MUST NOT** require Redis or WS for GET/PATCH success.\\n12. **MUST NOT** change `GET /api/health` or auth register/login/me success contracts.\\n13. Responses use `Content-Type: application/json` (charset utf-8 preferred).\\n\\n## Testing Strategy\\n\\n### Scripted (implementer / QA)\\n```bash\\n# cluster up; TOKEN from register on :8000; USER_ID from response\\ncurl -sS -H \\\"Authorization: Bearer $TOKEN\\\" \\\\\\n  http://127.0.0.1:8001/api/users/$USER_ID\\n# expect 200\\n\\ncurl -sS -H \\\"Authorization: Bearer $TOKEN\\\" \\\\\\n  http://127.0.0.1:8000/api/users/$(uuidgen)\\n# expect 404\\n\\ncurl -sS -X PATCH http://127.0.0.1:8000/api/users/me \\\\\\n  -H \\\"Authorization: Bearer $TOKEN\\\" -H 'Content-Type: application/json' \\\\\\n  -d '{\\\"display_name\\\":\\\"Ada\\\",\\\"timezone\\\":\\\"America/New_York\\\",\\\"status_text\\\":\\\"ship it\\\",\\\"status_emoji\\\":\\\"🚀\\\"}'\\n# expect 200\\n\\ncurl -sS -H \\\"Authorization: Bearer $TOKEN\\\" http://127.0.0.1:8002/api/auth/me\\n# expect updated fields\\n\\ncurl -sS -X PATCH http://127.0.0.1:8000/api/users/me \\\\\\n  -H \\\"Authorization: Bearer $TOKEN\\\" -H 'Content-Type: application/json' \\\\\\n  -d '{\\\"timezone\\\":\\\"Not/A_Real_Zone\\\"}'\\n# expect 400\\n\\ncurl -sS -X PATCH http://127.0.0.1:8000/api/users/me \\\\\\n  -H \\\"Authorization: Bearer $TOKEN\\\" -H 'Content-Type: application/json' \\\\\\n  -d '{\\\"status_text\\\":\\\"'\\\"$(python3 -c 'print(\\\"x\\\"*101)\\\"')\\\"'\\\"}'\\n# expect 400\\n```\\n\\n### Scenarios that matter\\n- Cross-node read-after-write for profile fields.\\n- Forbidden username patch.\\n- IANA reject vs `UTC` / `Europe/London` accept.\\n- Emit hook called only when a field changes.\\n- Redis killed: PATCH still `200`.\\n\\n### Manual human verification\\nRegister a user, PATCH status/timezone, confirm GET on another port, confirm `/api/auth/me` matches. Optionally register a temporary listener in a REPL/unit test to assert `user.updated` payload shape.\\n\\n### Out of scope for this task’s tests\\nSPA forms, actual WS client receipt, IRC, workspace member lists.\",\n  \"design_format\": \"markdown\",\n  \"has_design\": true,\n  \"notes\": \"New design (no needs-revision). Profiles GET/PATCH on MARATHON-3 UserObj + SQLite; IANA timezone + length caps; emitUserUpdated no-op seam for MARATHON-18. After lead removes architect label, implementer is backend (label already present). Blocked on MARATHON-3 landing for users table/middleware.\",\n  \"created_at\": \"2026-08-22T19:28:49.02437807Z\",\n  \"updated_at\": \"2026-08-22T19:41:32.013643645Z\",\n  \"created_by\": \"marathon-harness\",\n  \"description\": \"UserObj fields {id,username,display_name,timezone,avatar_url,status_text,status_emoji}. GET /api/users/{id} → 200/404. PATCH /api/users/me accepts subset, validates timezone/lengths → 400. Profile updates broadcast WS user.updated globally (hook up when WS exists).\"\n}\n---\nAlready up to date.\n---\nOn branch agents/MARATHON/backend-dev-1\nUntracked files:\n  (use \"git add <file>...\" to include in what will be committed)\n\t.agent.lock\n\t.agent.lock.flock\n\nnothing added to commit but untracked files present (use \"git add\" to track)\ne2704f3 Bootstrap Huddle cluster: start.sh, Redis, 3 HTTP nodes, health (MARATHON-2)\na152118 marathon baseline\ne2704f33e188e66eba9d4d4225e79b74f8cd9ea1\nagents/MARATHON/backend-dev-1\n/work/ws/worktrees/app/backend-dev-1\ntotal 32\ndrwxr-xr-x. 6 root root 4096 Aug 22 19:41 .\ndrwxr-xr-x. 6 root root   93 Aug 22 19:27 ..\n-rw-------. 1 root root  264 Aug 22 19:41 .agent.lock\n-rw-------. 1 root root    0 Aug 22 19:32 .agent.lock.flock\n-rw-r--r--. 1 root root   42 Aug 22 19:27 .git\n-rw-r--r--. 1 root root   44 Aug 22 19:27 .gitignore\ndrwx------. 3 root root   19 Aug 22 19:35 data\ndrwxr-xr-x. 2 root root   33 Aug 22 19:27 loom-prompts\n-rw-------. 1 root root  132 Aug 22 19:34 package.json\n-rw-------. 1 root root  116 Aug 22 19:34 redis.conf\ndrwx------. 2 root root   39 Aug 22 19:34 server\n-rwx------. 1 root root 2596 Aug 22 19:34 start.sh\ndrwx------. 2 root root   82 Aug 22 19:35 test\n-rwxr-xr-x. 1 root root  558 Aug 22 19:27 timer.sh\n","stderr":"time=2026-08-22T19:41:55.069Z level=INFO msg=\"opened existing embedded fleet-db client\" url=http://127.0.0.1:38569\n","executionTime":482,"interleavedOutput":"time=2026-08-22T19:41:55.069Z level=INFO msg=\"opened existing embedded fleet-db client\" url=http://127.0.0.1:38569\n{\n  \"id\": \"MARATHON-4\",\n  \"title\": \"Profiles: GET user and PATCH /api/users/me\",\n  \"status\": \"in_progress\",\n  \"priority\": 1,\n  \"issue_type\": \"task\",\n  \"assignee\": \"backend-dev-1\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"backend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"design\": \"## Summary\\n\\nMARATHON-4 adds authenticated profile read and self-update on top of the MARATHON-3 `UserObj` / `users` table: `GET /api/users/{id}` returns a public profile (`200` / `404`), and `PATCH /api/users/me` mutates a validated subset of profile fields (`400` on bad timezone or over-length strings). Successful patches persist in the shared SQLite store (visible on every node) and emit a cluster-wide `user.updated` event through a no-op-safe broadcast hook that MARATHON-18 wires to WebSocket fan-out. This closes the gap between register-time profile defaults and live profile editing the SPA/settings flows need.\\n\\n## Technical Approach\\n\\n### Decision\\n- **Reuse MARATHON-3 identity stack:** Same `/app/data/huddle.db` `users` row, same `publicUser(row) → UserObj`, same `requireUser` / bearer middleware. No second user store.\\n- **Routes live under `/api/users`:** New module `server/users/routes.js` (HTTP only). Persistence helpers (`findUserById`, `updateUserProfile`) extend `server/auth/users.js` so DDL ownership stays with auth.\\n- **Mutable PATCH subset only:** `display_name`, `timezone`, `avatar_url`, `status_text`, `status_emoji`. **Never** allow `id`, `username`, password fields, or token mutation via this route.\\n- **Timezone validation:** Accept only IANA time zone names. Prefer `Intl.supportedValuesOf('timeZone')` when available (Node 20+); otherwise validate by constructing `new Intl.DateTimeFormat('en-US', { timeZone })` and rejecting on throw. `\\\"UTC\\\"` remains valid. Do **not** invent offset-only strings like `\\\"UTC+1\\\"` as valid unless they appear in the IANA list.\\n- **Length caps (authoritative):** enforce on the server with JS string `.length` (same length model as MARATHON-3 passwords).\\n- **WS hook, not WS implementation:** After a successful DB commit, call `emitUserUpdated(userObj)` from `server/events/userUpdated.js`. Default export is a no-op (or in-process listener list). MARATHON-18 replaces/registers the real global WS broadcast. HTTP success **must not** depend on Redis or WS being up.\\n\\n### Alternatives considered\\n| Alternative | Why rejected |\\n|-------------|--------------|\\n| Return bare `UserObj` without `{ \\\"user\\\": ... }` wrapper | Breaks symmetry with `GET /api/auth/me` and register/login envelopes fixed in MARATHON-3 |\\n| Allow PATCH to rename `username` | Username is the durable login identity (case-insensitive unique); renaming needs a separate task and migration story |\\n| Require workspace membership to GET a user | Workspaces are MARATHON-5; until then any authenticated user may resolve any `user.id` (global directory) |\\n| Put profile columns in a separate `profiles` table | Unnecessary join; MARATHON-3 already defined columns on `users` |\\n| Block PATCH until MARATHON-18 ships | Task explicitly says hook up when WS exists; profile REST must work without WS |\\n| Soft-validate timezone (accept any string) | Task requires timezone validation → `400` |\\n\\n### Trade-off accepted\\nGlobal directory lookup (any authed user → any user id) is simpler than workspace-scoped visibility but leaks existence of all accounts by UUID. Acceptable for this marathon; MARATHON-5+ may tighten visibility later without changing `UserObj` shape.\\n\\n### Conventions inherited (authoritative)\\n| Source | Convention |\\n|--------|------------|\\n| MARATHON-2 | `/app`, `server/index.js`, `/api/...`, JSON `Content-Type: application/json; charset=utf-8`, three nodes, `/app/data/` |\\n| MARATHON-3 | `UserObj` seven fields; error `{ \\\"error\\\": string }`; bearer `Authorization: Bearer \\u003ctoken\\u003e`; SQLite `/app/data/huddle.db`; `requireUser`; ignore unknown JSON keys on write |\\n\\n## Interface Contracts\\n\\n### Shared: `UserObj` (unchanged from MARATHON-3)\\n\\n```json\\n{\\n  \\\"id\\\": \\\"\\u003cuuid-string\\u003e\\\",\\n  \\\"username\\\": \\\"\\u003cslug\\u003e\\\",\\n  \\\"display_name\\\": \\\"\\u003cstring\\u003e\\\",\\n  \\\"timezone\\\": \\\"\\u003cstring\\u003e\\\",\\n  \\\"avatar_url\\\": \\\"\\u003cstring\\u003e\\\",\\n  \\\"status_text\\\": \\\"\\u003cstring\\u003e\\\",\\n  \\\"status_emoji\\\": \\\"\\u003cstring\\u003e\\\"\\n}\\n```\\n\\nAll seven keys always present in responses. Never include password, hash, salt, or token.\\n\\n### Patchable field limits (server-authoritative)\\n\\n| Field | Type | Max `.length` | Empty string | Notes |\\n|-------|------|---------------|--------------|-------|\\n| `display_name` | string | 64 | allowed | Trim leading/trailing whitespace before length check and store; empty after trim → store `\\\"\\\"` |\\n| `timezone` | string | 64 (and IANA-valid) | **not** allowed | Must be non-empty IANA name (e.g. `UTC`, `America/New_York`) |\\n| `avatar_url` | string | 2048 | allowed | No scheme check required; store as given after type check (do not trim interior spaces) |\\n| `status_text` | string | 100 | allowed | Trim ends; empty → `\\\"\\\"` |\\n| `status_emoji` | string | 32 | allowed | Trim ends; empty → `\\\"\\\"`; multi-codepoint emoji OK within length |\\n\\n**Partial update semantics:** Only keys **present** in the JSON object are updated. Omitted keys stay unchanged. Wrong type (`null`, number, object, array) for a present key → `400`. Empty object `{}` → `200` with unchanged `UserObj` (no WS emit if nothing changed).\\n\\n**Forbidden keys if present with any value:** `id`, `username`, `password`, `password_hash`, `password_salt`, `token` → `400` `{ \\\"error\\\": string }` (do not silently ignore identity/credential fields).\\n\\nOther unknown keys → ignore (same as MARATHON-3 register).\\n\\n---\\n\\n### C1 — `GET /api/users/{id}`\\n\\n| | |\\n|--|--|\\n| Auth | Required (`requireUser`) |\\n| Path param | `id` — opaque user UUID string (exact match to `users.id`) |\\n| Success | `200` `{ \\\"user\\\": UserObj }` |\\n| Not found | `404` `{ \\\"error\\\": string }` |\\n| Unauthenticated | `401` `{ \\\"error\\\": string }` |\\n| Wrong method | `405` or `404`; must not `500` |\\n\\n**Server:**\\n1. Resolve bearer → user or `401`.\\n2. If path is exactly `/api/users/me` on GET: treat `id` as the literal string `me` → **404** (self profile remains `GET /api/auth/me`). Do not special-case.\\n3. Look up `users.id = id`; missing → `404`.\\n4. Return `publicUser` envelope.\\n\\n**Who validates:** Server owns UUID existence. Client must not assume every id from messages still exists.\\n\\n**Client (SPA / MARATHON-21–23) while slow/failing:**\\n- While pending: keep prior cached profile or show a neutral placeholder; do not flash logged-out.\\n- On `200`: render `user.display_name` (fallback UX: `username` if display_name empty).\\n- On `404`: show “user not found”; do not clear session.\\n- On `401`: clear `huddle.token`, show login (same as `/api/auth/me`).\\n- On network/5xx: show transient error; retry allowed.\\n\\n---\\n\\n### C2 — `PATCH /api/users/me`\\n\\n| | |\\n|--|--|\\n| Auth | Required (`requireUser`) — updates **only** the authenticated user |\\n| Body | JSON object; subset of patchable fields above |\\n| Success | `200` `{ \\\"user\\\": UserObj }` (post-update row) |\\n| Validation failure | `400` `{ \\\"error\\\": string }` |\\n| Unauthenticated | `401` `{ \\\"error\\\": string }` |\\n| Malformed JSON / non-object | `400` |\\n\\n**Server algorithm:**\\n1. `requireUser` or `401`.\\n2. `readJson` → must be a plain object.\\n3. Validate each present key per table; collect updates.\\n4. If any forbidden key present → `400` before writes.\\n5. If updates non-empty: `UPDATE users SET ... WHERE id = ?` in SQLite; re-read row; `publicUser`.\\n6. If at least one field actually changed: call `emitUserUpdated(userObj)` (best-effort; errors logged, HTTP still `200`).\\n7. If no fields changed: return `200` with current user; **do not** emit.\\n\\n**Who validates:** Server is source of truth for IANA timezone and lengths. Client may pre-check for UX but must handle `400`.\\n\\n**Client while slow/failing:**\\n- Disable save control / show pending on profile form until response.\\n- Optimistic UI optional; on `400` revert fields and show `error` string.\\n- On `200`: replace local current-user state with returned `user`; also expect eventual `user.updated` WS (when MARATHON-18 exists) and reconcile by `user.id`.\\n- On `401`: logout flow.\\n- On network/5xx: keep form dirty state; show retry; **MUST NOT** assume server applied the patch.\\n\\n---\\n\\n### C3 — `user.updated` broadcast seam (owned here; delivered by MARATHON-18)\\n\\n**Event name:** `user.updated`  \\n**Scope:** Global — all authenticated WS connections on all nodes (when hub exists), not channel-scoped.  \\n**Payload (WS frame / hub message body):**\\n\\n```json\\n{\\n  \\\"type\\\": \\\"user.updated\\\",\\n  \\\"user\\\": {\\n    \\\"id\\\": \\\"\\u003cuuid\\u003e\\\",\\n    \\\"username\\\": \\\"\\u003cslug\\u003e\\\",\\n    \\\"display_name\\\": \\\"\\u003cstring\\u003e\\\",\\n    \\\"timezone\\\": \\\"\\u003cstring\\u003e\\\",\\n    \\\"avatar_url\\\": \\\"\\u003cstring\\u003e\\\",\\n    \\\"status_text\\\": \\\"\\u003cstring\\u003e\\\",\\n    \\\"status_emoji\\\": \\\"\\u003cstring\\u003e\\\"\\n  }\\n}\\n```\\n\\n**Module contract:**\\n\\n```\\n// server/events/userUpdated.js\\nemitUserUpdated(user: UserObj): void\\nregisterUserUpdatedListener(fn: (user: UserObj) =\\u003e void): void  // optional helper for tests / WS hub\\n```\\n\\n- MARATHON-4 always calls `emitUserUpdated` after a mutating PATCH.\\n- Until MARATHON-18 registers a listener / Redis publish, emit is a no-op (in-process listeners only if registered).\\n- MARATHON-18/19 own cross-node fan-out; this task does **not** publish to Redis directly (avoids inventing the pub/sub envelope twice). If implementer prefers a tiny in-process EventEmitter only, that is enough for C3.\\n\\n**Client when WS exists:** On `user.updated`, update any rendered profile/message author chrome for matching `user.id`. If WS is down, HTTP GET/PATCH remain correct; stale UI until refresh is acceptable.\\n\\n## Data Model\\n\\n### Schema change\\n**None required** if MARATHON-3 DDL already created:\\n\\n| Column | Type | Null | Notes |\\n|--------|------|------|-------|\\n| `id` | TEXT PK | NOT NULL | Immutable via PATCH |\\n| `username` / `username_lower` | TEXT | NOT NULL | Immutable via PATCH |\\n| `display_name` | TEXT | NOT NULL | Mutable |\\n| `timezone` | TEXT | NOT NULL DEFAULT `'UTC'` | Mutable; IANA |\\n| `avatar_url` | TEXT | NOT NULL DEFAULT `''` | Mutable |\\n| `status_text` | TEXT | NOT NULL DEFAULT `''` | Mutable |\\n| `status_emoji` | TEXT | NOT NULL DEFAULT `''` | Mutable |\\n| password / salt / `created_at` | — | — | Untouched |\\n\\n**Backward compatibility:** Additive routes only. Existing auth responses keep working. No column drops/renames.\\n\\n**If MARATHON-3 columns are somehow missing** (partial implement): implementer adds the same `ALTER TABLE` / DDL defaults as MARATHON-3 — do not invent alternate names.\\n\\nNo new tables.\\n\\n## Files to Create / Files to Modify\\n\\n### Create\\n| File | Change |\\n|------|--------|\\n| `server/users/routes.js` | Handlers: `GET /api/users/:id`, `PATCH /api/users/me`; path parse; status codes per C1/C2; call validation + store + `emitUserUpdated` |\\n| `server/users/validate.js` | `assertPatchBody(obj) → { updates } \\\\| { error }` — length, type, IANA timezone, forbidden keys |\\n| `server/events/userUpdated.js` | `emitUserUpdated`, optional `registerUserUpdatedListener`; default no-op fan-out |\\n\\n### Modify\\n| File | Change |\\n|------|--------|\\n| `server/auth/users.js` | Add `findUserById(id) → row \\\\| null`, `updateUserProfile(id, updates) → row` (UPDATE only provided columns); keep `publicUser` as single serializer |\\n| `server/index.js` | After auth routes: dispatch `PATCH` `/api/users/me` and `GET` `/api/users/*` before generic 404; keep health + auth behavior unchanged |\\n| `server/httpUtil.js` | Reuse `readJson` / `sendJson` if MARATHON-3 added them; otherwise use the same helpers auth routes use (do not duplicate divergent JSON error shapes) |\\n\\n### Do not modify\\n| File | Reason |\\n|------|--------|\\n| `start.sh` / `redis.conf` / health | MARATHON-2 |\\n| `server/auth/routes.js` register/login/me contracts | Unchanged; PATCH is not `/api/auth/me` |\\n| SPA / static UI | MARATHON-21–23 |\\n| WS router / Redis pubsub | MARATHON-18/19 |\\n\\n## Sequencing and Cross-Task Seams\\n\\n### Within this task\\n1. `findUserById` / `updateUserProfile` + validator  \\n2. `userUpdated` event stub  \\n3. HTTP routes + `index.js` wiring  \\n4. Cross-node check: PATCH on :8000 → GET user on :8001  \\n\\n### Parallelism\\n- Backend-only implementation.\\n- Frontend settings UI (MARATHON-23) can be designed against C2; implement against live API after this lands.\\n- MARATHON-18 can implement WS listen/subscribe in parallel using C3 payload; must call `registerUserUpdatedListener` or equivalent from the hub boot.\\n\\n### Seams this task owns\\n| Seam | Downstream |\\n|------|------------|\\n| C1 GET user by id | Messages/members UIs; mentions; SPA profile popovers |\\n| C2 PATCH `/api/users/me` | SPA settings (MARATHON-23); any client editing status/timezone |\\n| C3 `user.updated` payload + `emitUserUpdated` | MARATHON-18 WS global broadcast; MARATHON-19 fan-out must carry this event type when Redis is down |\\n| Length/IANA rules | All writers of profile fields (no other writer should bypass validator) |\\n\\n### Build order vs siblings\\n- **Blocked on:** MARATHON-3 (`users` table, `requireUser`, `publicUser`). MARATHON-2 for process topology.\\n- **Soft-blocked on WS delivery:** none for HTTP acceptance; WS delivery blocked on MARATHON-18.\\n- **Does not block:** workspace/channel CRUD can proceed; they should embed `UserObj` via `publicUser` when returning members.\\n\\n### Split follow-ups (do not do here)\\n| Cut | Owner |\\n|-----|--------|\\n| Actual WS subscribe + global emit over Redis | MARATHON-18 / MARATHON-19 |\\n| SPA profile/settings forms + testids | MARATHON-21 / MARATHON-23 |\\n| Username change / password change APIs | New task if ever required |\\n| Workspace-scoped profile visibility | Optional later under MARATHON-5+ |\\n| Avatar file upload | MARATHON-11 (files); this task only stores URL string |\\n\\n## Out of Scope (Needs a Separate Task)\\n\\nNeighborhood scan (architect worktree = baseline `timer.sh` only; sibling `backend-dev-1` has MARATHON-2 `server/index.js`, `server/health.js`, `start.sh`, tests — **no** `/api/users` or auth modules yet; `/app` same baseline; grep for `UserObj` / `timezone` / `user.updated` / `/api/users` → no implementation hits):\\n\\n| Finding | Why excluded |\\n|---------|----------------|\\n| `server/health.js`, `GET /api/health`, `start.sh`, Redis | MARATHON-2 |\\n| `POST /api/auth/*`, `GET /api/auth/me`, token/password DDL | MARATHON-3 (prerequisite; do not re-specify) |\\n| `timer.sh` | Harness |\\n| WS `/api/ws`, dense seq, resume | MARATHON-18 |\\n| Redis-down fan-out | MARATHON-19 |\\n| IRC nick/profile bridging | MARATHON-20 |\\n| SPA auth + settings UI | MARATHON-21–23 |\\n| File upload for avatars | MARATHON-11 |\\n| Workspaces/members embedding users | MARATHON-5 |\\n| Rate limiting profile writes | Not required |\\n\\n## Edge Cases \\u0026 Error Handling\\n\\n| Situation | Expected behavior |\\n|-----------|-------------------|\\n| GET unknown UUID | `404` `{error}` |\\n| GET valid id without auth | `401` |\\n| GET `/api/users/me` | `404` (literal id `me`); use `/api/auth/me` |\\n| PATCH without auth | `401` |\\n| PATCH `timezone: \\\"Not/AZone\\\"` | `400` |\\n| PATCH `timezone: \\\"\\\"` | `400` |\\n| PATCH `display_name` length 65 | `400` |\\n| PATCH `status_text` length 101 | `400` |\\n| PATCH `status_emoji` length 33 | `400` |\\n| PATCH `avatar_url` length 2049 | `400` |\\n| PATCH includes `username` | `400` (forbidden key) |\\n| PATCH includes only unknown keys | Treat as `{}` → `200`, no emit |\\n| PATCH `display_name: \\\"  Alice  \\\"` | Store `\\\"Alice\\\"` (trimmed) |\\n| PATCH `display_name: \\\"   \\\"` | Store `\\\"\\\"` |\\n| PATCH `status_emoji: \\\"🚀\\\"` | `200` if `.length ≤ 32` |\\n| Concurrent PATCH same user on two nodes | Last writer wins per field set; both may emit `user.updated`; acceptable |\\n| SQLITE_BUSY | Respect `busy_timeout`; if still failing → `500` `{error}`; no partial HTTP success |\\n| `emitUserUpdated` throws | Log stderr; still return `200` with saved user |\\n| Redis down | PATCH/GET unaffected |\\n| User deleted (future) while GET | N/A now (no delete API); if row missing → `404` |\\n| Non-JSON PATCH body | `400` |\\n| `Content-Type` missing but body is JSON | Best-effort parse; fail → `400` |\\n| Method `PUT`/`POST` on `/api/users/me` | `405` or `404`; must not apply updates |\\n| Extra whitespace in IANA zone `\\\" America/New_York\\\"` | `400` (do not auto-trim timezone; must match IANA exactly) |\\n\\n## Acceptance Criteria\\n\\n1. Authenticated `GET /api/users/{id}` for an existing user → `200` `{user}` with all seven `UserObj` fields matching DB.\\n2. Authenticated GET for unknown id → `404` with JSON `error`.\\n3. GET without bearer (or bad token) → `401`.\\n4. `PATCH /api/users/me` with valid `{ \\\"display_name\\\": \\\"Ada\\\", \\\"timezone\\\": \\\"America/New_York\\\" }` → `200`; subsequent `GET /api/auth/me` and `GET /api/users/{id}` on **another node** reflect updates.\\n5. PATCH with invalid timezone → `400`; DB row unchanged.\\n6. PATCH with over-length `status_text` / `display_name` / `avatar_url` / `status_emoji` → `400`; DB unchanged.\\n7. PATCH body attempting `username` or `id` change → `400`; username unchanged.\\n8. PATCH `{}` → `200`; user unchanged.\\n9. After a mutating PATCH, `emitUserUpdated` is invoked with the new `UserObj` (verifiable via test listener); HTTP still `200` if no WS hub registered.\\n10. **MUST NOT** include password/hash/salt/token in GET/PATCH responses.\\n11. **MUST NOT** require Redis or WS for GET/PATCH success.\\n12. **MUST NOT** change `GET /api/health` or auth register/login/me success contracts.\\n13. Responses use `Content-Type: application/json` (charset utf-8 preferred).\\n\\n## Testing Strategy\\n\\n### Scripted (implementer / QA)\\n```bash\\n# cluster up; TOKEN from register on :8000; USER_ID from response\\ncurl -sS -H \\\"Authorization: Bearer $TOKEN\\\" \\\\\\n  http://127.0.0.1:8001/api/users/$USER_ID\\n# expect 200\\n\\ncurl -sS -H \\\"Authorization: Bearer $TOKEN\\\" \\\\\\n  http://127.0.0.1:8000/api/users/$(uuidgen)\\n# expect 404\\n\\ncurl -sS -X PATCH http://127.0.0.1:8000/api/users/me \\\\\\n  -H \\\"Authorization: Bearer $TOKEN\\\" -H 'Content-Type: application/json' \\\\\\n  -d '{\\\"display_name\\\":\\\"Ada\\\",\\\"timezone\\\":\\\"America/New_York\\\",\\\"status_text\\\":\\\"ship it\\\",\\\"status_emoji\\\":\\\"🚀\\\"}'\\n# expect 200\\n\\ncurl -sS -H \\\"Authorization: Bearer $TOKEN\\\" http://127.0.0.1:8002/api/auth/me\\n# expect updated fields\\n\\ncurl -sS -X PATCH http://127.0.0.1:8000/api/users/me \\\\\\n  -H \\\"Authorization: Bearer $TOKEN\\\" -H 'Content-Type: application/json' \\\\\\n  -d '{\\\"timezone\\\":\\\"Not/A_Real_Zone\\\"}'\\n# expect 400\\n\\ncurl -sS -X PATCH http://127.0.0.1:8000/api/users/me \\\\\\n  -H \\\"Authorization: Bearer $TOKEN\\\" -H 'Content-Type: application/json' \\\\\\n  -d '{\\\"status_text\\\":\\\"'\\\"$(python3 -c 'print(\\\"x\\\"*101)\\\"')\\\"'\\\"}'\\n# expect 400\\n```\\n\\n### Scenarios that matter\\n- Cross-node read-after-write for profile fields.\\n- Forbidden username patch.\\n- IANA reject vs `UTC` / `Europe/London` accept.\\n- Emit hook called only when a field changes.\\n- Redis killed: PATCH still `200`.\\n\\n### Manual human verification\\nRegister a user, PATCH status/timezone, confirm GET on another port, confirm `/api/auth/me` matches. Optionally register a temporary listener in a REPL/unit test to assert `user.updated` payload shape.\\n\\n### Out of scope for this task’s tests\\nSPA forms, actual WS client receipt, IRC, workspace member lists.\",\n  \"design_format\": \"markdown\",\n  \"has_design\": true,\n  \"notes\": \"New design (no needs-revision). Profiles GET/PATCH on MARATHON-3 UserObj + SQLite; IANA timezone + length caps; emitUserUpdated no-op seam for MARATHON-18. After lead removes architect label, implementer is backend (label already present). Blocked on MARATHON-3 landing for users table/middleware.\",\n  \"created_at\": \"2026-08-22T19:28:49.02437807Z\",\n  \"updated_at\": \"2026-08-22T19:41:32.013643645Z\",\n  \"created_by\": \"marathon-harness\",\n  \"description\": \"UserObj fields {id,username,display_name,timezone,avatar_url,status_text,status_emoji}. GET /api/users/{id} → 200/404. PATCH /api/users/me accepts subset, validates timezone/lengths → 400. Profile updates broadcast WS user.updated globally (hook up when WS exists).\"\n}\n---\nAlready up to date.\n---\nOn branch agents/MARATHON/backend-dev-1\nUntracked files:\n  (use \"git add <file>...\" to include in what will be committed)\n\t.agent.lock\n\t.agent.lock.flock\n\nnothing added to commit but untracked files present (use \"git add\" to track)\ne2704f3 Bootstrap Huddle cluster: start.sh, Redis, 3 HTTP nodes, health (MARATHON-2)\na152118 marathon baseline\ne2704f33e188e66eba9d4d4225e79b74f8cd9ea1\nagents/MARATHON/backend-dev-1\n/work/ws/worktrees/app/backend-dev-1\ntotal 32\ndrwxr-xr-x. 6 root root 4096 Aug 22 19:41 .\ndrwxr-xr-x. 6 root root   93 Aug 22 19:27 ..\n-rw-------. 1 root root  264 Aug 22 19:41 .agent.lock\n-rw-------. 1 root root    0 Aug 22 19:32 .agent.lock.flock\n-rw-r--r--. 1 root root   42 Aug 22 19:27 .git\n-rw-r--r--. 1 root root   44 Aug 22 19:27 .gitignore\ndrwx------. 3 root root   19 Aug 22 19:35 data\ndrwxr-xr-x. 2 root root   33 Aug 22 19:27 loom-prompts\n-rw-------. 1 root root  132 Aug 22 19:34 package.json\n-rw-------. 1 root root  116 Aug 22 19:34 redis.conf\ndrwx------. 2 root root   39 Aug 22 19:34 server\n-rwx------. 1 root root 2596 Aug 22 19:34 start.sh\ndrwx------. 2 root root   82 Aug 22 19:35 test\n-rwxr-xr-x. 1 root root  558 Aug 22 19:27 timer.sh\n","localExecutionTimeMs":100},"isBackground":false},"description":"Show task, merge main, check state"},"hookAdditionalContexts":[],"toolCallId":"call-b787d36b