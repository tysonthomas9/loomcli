sername_lower, password_salt, password_hash,\n      display_name, timezone, avatar_url, status_text, status_emoji, created_at\n    ) VALUES (?, ?, ?, ?, ?, ?, 'UTC', '', '', '', ?)`\n  ).run(\n    id,\n    input.username,\n    usernameLower,\n    salt,\n    hash,\n    input.displayName,\n    createdAt\n  );\n\n  const row = findUserById(id);\n  if (!row) {\n    throw new Error('user insert failed');\n  }\n  return { user: publicUser(row), row };\n}\n\nmodule.exports = {\n  publicUser,\n  findUserByUsername,\n  findUserById,\n  createUser,\n};\n","isEmpty":false,"exceededLimit":false,"totalLines":94,"fileSize":2178,"path":"/work/ws/worktrees/app/backend-dev-1/server/auth/users.js","readRange":{"startLine":1,"endLine":94},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-ec17b088-5473-4b41-bba5-119c637f291d-10\nfc_a5a670ba-ff65-91a4-959c-1aeb51471544_3","startedAtMs":"1787427944240","completedAtMs":"1787427944613"},"model_call_id":"d7f94889-3abc-4686-92fe-b6557b351b69-6-m6d0","session_id":"6b0bb5d8-2e5d-4c96-912d-ac99e088e5d4","timestamp_ms":1787427944638}
