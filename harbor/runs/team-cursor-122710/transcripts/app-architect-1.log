 on :6379 with fan-out that survives Redis kill. Covers auth, profiles, workspaces, invitations, roles, channels, DMs, messages, threads, reactions, pins, files, search, groups, slash commands, mentions, read state, settings, SPA with pinned testids, WebSocket dense seq, and IRC bridging. No remote services, no Slack SDK, no Docker-in-Docker.\",\n  \"dependents\": [\n    {\n      \"issue_id\": \"MARATHON-10\",\n      \"depends_on_id\": \"MARATHON-1\",\n      \"type\": \"parent-child\",\n      \"title\": \"DMs: get-or-create pairwise channel\",\n      \"status\": \"open\",\n      \"priority\": 1,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T19:29:08.808998976Z\",\n      \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-11\",\n      \"depends_on_id\": \"MARATHON-1\",\n      \"type\": \"parent-child\",\n      \"title\": \"Files: upload, metadata, download, attach to messages\",\n      \"status\": \"open\",\n      \"priority\": 1,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T19:29:08.871230869Z\",\n      \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-12\",\n      \"depends_on_id\": \"MARATHON-1\",\n      \"type\": \"parent-child\",\n      \"title\": \"Search across accessible channels\",\n      \"status\": \"open\",\n      \"priority\": 1,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T19:29:16.60312666Z\",\n      \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-13\",\n      \"depends_on_id\": \"MARATHON-1\",\n      \"type\": \"parent-child\",\n      \"title\": \"Slash commands: me, shrug, topic, invite, archive\",\n      \"status\": \"open\",\n      \"priority\": 1,\n      \"issue_type\": \"task\",\n      \"created_at\": \"2026-08-22T19:29:16.626578687Z\",\n      \"created_by\": \"marathon-harness\"\n    },\n    {\n      \"issue_id\": \"MARATHON-14\",\n      \"depends_on_id\": \"MARATHON-1\",\n  