"command":"loom data update --help 2>&1 | head -80; loom data comment --help 2>&1 | head -20; cat /usr/local/bin/marathon-portlock; cat /usr/local/bin/marathon-freeports","workingDirectory":"","exitCode":0,"signal":"","stdout":"Update issue fields\n\nUsage:\n  loom data update <issue-id> [flags]\n\nFlags:\n      --add-label stringArray           Add label (repeatable); other labels are preserved\n      --assignee string                 Set assignee\n      --depends-on stringArray          Add dependency on issue ID (repeatable)\n      --description string              Set description\n      --description-from-file string    Read description from file (use - for stdin)\n      --design string                   Set design\n      --design-format string            Set design format (markdown or html)\n  -h, --help                            help for update\n      --notes string                    Set notes\n      --priority int                    Set priority\n      --remove-depends-on stringArray   Remove dependency on issue ID (repeatable)\n      --remove-label stringArray        Remove label (repeatable); other labels are preserved\n      --status string                   Set status\n      --title string                    Set title\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n  -o, --output string       Output format: text|json (default \"text\")\n      --server string       Loom server base URL (or LOOM_SERVER_URL env var)\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\nAdd a comment to an issue (HTTP)\n\nUsage:\n  loom data comment <issue-id> <text> [flags]\n\nFlags:\n      --author string   Comment author (defaults to server-side session user)\n  -h, --help            help for comment\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n  -o, --output string       Output format: text|json (default \"text\")\n      --server string       Loom server base URL (or LOOM_SERVER_URL env var)\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n#!/usr/bin/env bash\nexec 9>/work/.app-ports.lock\nflock 9\nexec \"$@\"\n#!/usr/bin/env python3\n\"\"\"Free the app's fixed ports by killing their listeners, sparing harness\ninfrastructure. Verifier roles run this before booting the app when leftover\nworker test processes hold a port.\"\"\"\nimport os, socket, time\nPORTS = {8000, 8001, 8002, 6667, 6379}\nPROTECT = (\"fleet-db\", \"loom daemon\", \"loom lead\", \"codex app-server\",\n           \"codex --remote\", \"tmux\")\nSELF = {os.getpid(), os.getppid()}\ndef busy(p):\n    s = socket.socket()\n    try:\n        s.bind((\"127.0.0.1\", p)); return False\n    except OSError:\n        return True\n    finally:\n        s.close()\ndef owners(ports):\n    inodes = {}\n    for path in (\"/proc/net/tcp\", \"/proc/net/tcp6\"):\n        try:\n            lines = open(path).read().splitlines()[1:]\n        except OSError:\n            continue\n        for line in lines:\n            f = line.split()\n            if len(f) > 9 and f[3] == \"0A\":\n                port = int(f[1].rsplit(\":\", 1)[1], 16)\n                if port in ports:\n                    inodes[f[9]] = port\n    hits = {}\n    for pid in filter(str.isdigit, os.listdir(\"/proc\")):\n        if int(pid) in SELF:\n            continue\n        try:\n            cmd = open(f\"/proc/{pid}/cmdline\", \"rb\").read().replace(b\"\\0\", b\" \").decode(errors=\"replace\")\n            if any(pat in cmd for pat in PROTECT):\n                continue\n            for fd in os.listdir(f\"/proc/{pid}/fd\"):\n                t = os.readlink(f\"/proc/{pid}/fd/{fd}\")\n                if t.startswith(\"socket:[\") and t[8:-1] in inodes:\n                    hits.setdefault(pid, set()).add(inodes[t[8:-1]])\n        except OSError:\n            continue\n    return hits\nfor _ in range(3):\n    stale = {p for p in PORTS if busy(p)}\n    if not stale:\n        break\n    h = owners(stale)\n    for pid, ports in h.items():\n        print(f\"freeports: kill {pid} ({sorted(ports)})\")\n        try:\n            os.kill(int(pid), 9)\n        except OSError:\n            pass\n    if not h:\n        print(f\"freeports: {sorted(stale)} busy but unowned/protected\")\n        break\n    time.sleep(1)\nprint(\"freeports:\", {p: (\"BUSY\" if busy(p) else \"free\") for p in PORTS})\n","stderr":"","executionTime":136,"interleavedOutput":"Update issue fields\n\nUsage:\n  loom data update <issue-id> [flags]\n\nFlags:\n      --add-label stringArray           Add label (repeatable); other labels are preserved\n      --assignee string                 Set assignee\n      --depends-on stringArray          Add dependency on issue ID (repeatable)\n      --description string              Set description\n      --description-from-file string    Read description from file (use - for stdin)\n      --design string                   Set design\n      --design-format string            Set design format (markdown or html)\n  -h, --help                            help for update\n      --notes string                    Set notes\n      --priority int                    Set priority\n      --remove-depends-on stringArray   Remove dependency on issue ID (repeatable)\n      --remove-label stringArray        Remove label (repeatable); other labels are preserved\n      --status string                   Set status\n      --title string                    Set title\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n  -o, --output string       Output format: text|json (default \"text\")\n      --server string       Loom server base URL (or LOOM_SERVER_URL env var)\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\nAdd a comment to an issue (HTTP)\n\nUsage:\n  loom data comment <issue-id> <text> [flags]\n\nFlags:\n      --author string   Comment author (defaults to server-side session user)\n  -h, --help            help for comment\n\nGlobal Flags:\n      --backend string      AI backend CLI to use (codex, claude, opencode). Env: LOOM_BACKEND\n      --log-format string   Log format (text|json) (default \"text\")\n      --log-output string   Log output destination (stderr|<filepath>) (default \"stderr\")\n  -o, --output string       Output format: text|json (default \"text\")\n      --server string       Loom server base URL (or LOOM_SERVER_URL env var)\n      --workspace string    Workspace ID. Env: LOOM_WORKSPACE\n#!/usr/bin/env bash\nexec 9>/work/.app-ports.lock\nflock 9\nexec \"$@\"\n#!/usr/bin/env python3\n\"\"\"Free the app's fixed ports by killing their listeners, sparing harness\ninfrastructure. Verifier roles run this before booting the app when leftover\nworker test processes hold a port.\"\"\"\nimport os, socket, time\nPORTS = {8000, 8001, 8002, 6667, 6379}\nPROTECT = (\"fleet-db\", \"loom daemon\", \"loom lead\", \"codex app-server\",\n           \"codex --remote\", \"tmux\")\nSELF = {os.getpid(), os.getppid()}\ndef busy(p):\n    s = socket.socket()\n    try:\n        s.bind((\"127.0.0.1\", p)); return False\n    except OSError:\n        return True\n    finally:\n        s.close()\ndef owners(ports):\n    inodes = {}\n    for path in (\"/proc/net/tcp\", \"/proc/net/tcp6\"):\n        try:\n            lines = open(path).read().splitlines()[1:]\n        except OSError:\n            continue\n        for line in lines:\n            f = line.split()\n            if len(f) > 9 and f[3] == \"0A\":\n                port = int(f[1].rsplit(\":\", 1)[1], 16)\n                if port in ports:\n                    inodes[f[9]] = port\n    hits = {}\n    for pid in filter(str.isdigit, os.listdir(\"/proc\")):\n        if int(pid) in SELF:\n            continue\n        try:\n            cmd = open(f\"/proc/{pid}/cmdline\", \"rb\").read().replace(b\"\\0\", b\" \").decode(errors=\"replace\")\n            if any(pat in cmd for pat in PROTECT):\n                continue\n            for fd in os.listdir(f\"/proc/{pid}/fd\"):\n                t = os.readlink(f\"/proc/{pid}/fd/{fd}\")\n                if t.startswith(\"socket:[\") and t[8:-1] in inodes:\n                    hits.setdefault(pid, set()).add(inodes[t[8:-1]])\n        except OSError:\n            continue\n    return hits\nfor _ in range(3):\n    stale = {p for p in PORTS if busy(p)}\n    if not stale:\n        break\n    h = owners(stale)\n    for pid, ports in h.items():\n        print(f\"freeports: kill {pid} ({sorted(ports)})\")\n        try:\n            os.kill(int(pid), 9)\n        except OSError:\n            pass\n    if not h:\n        print(f\"freeports: {sorted(stale)} busy but unowned/protected\")\n        break\n    time.sleep(1)\nprint(\"freeports:\", {p: (\"BUSY\" if busy(p) else \"free\") for p in PORTS})\n","localExecutionTimeMs":79},"isBackground":false},"description":"Check loom update flags and marathon helpers"},"hookAdditionalContexts":[],"toolCallId":"call-2a94300d-09d0-478d-b4da-f8963dd1691a-20\nfc_a3d23ae5-1f0e-9979-af16-604ebe04b8ac_0","startedAtMs":"1787426997905","completedAtMs":"1787426998050"},"model_call_id":"e14468ee-46b5-420b-ad87-eb3b9612a5ae-7-zhie","session_id":"491156aa-902f-434f-9211-7e6f7cdd3838","timestamp_ms":1787426998084}
