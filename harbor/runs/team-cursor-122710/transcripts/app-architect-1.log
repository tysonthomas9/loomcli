{"type":"tool_call","subtype":"completed","call_id":"call-345f4428-524d-4765-a85b-ceb909d44224-17\nfc_e20519b8-9d1e-995a-aa03-cf2e0acdaf6a_1","tool_call":{"readToolCall":{"args":{"path":"/work/ws/worktrees/app/app-architect-1/server/auth/middleware.js"},"result":{"success":{"content":"'use strict';\n\nconst { findUserIdByToken } = require('./tokens');\nconst { findUserById, publicUser } = require('./users');\nconst { sendJson } = require('../httpUtil');\n\nconst BEARER_RE = /^Bearer\\s+(\\S+)$/i;\n\n/**\n * Resolve Authorization header to a public UserObj, or null.\n * @param {string | null | undefined} authorizationHeader\n * @returns {import('./users').UserObj | null}\n */\nfunction resolveBearerUser(authorizationHeader) {\n  if (!authorizationHeader || typeof authorizationHeader !== 'string') {\n    return null;\n  }\n  const trimmed = authorizationHeader.trim();\n  const match = BEARER_RE.exec(trimmed);\n  if (!match) {\n    return null;\n  }\n  const token = match[1];\n  const userId = findUserIdByToken(token);\n  if (!userId) {\n    return null;\n  }\n  const row = findUserById(userId);\n  if (!row) {\n    return null;\n  }\n  return publicUser(row);\n}\n\n/**\n * Require an authenticated user; writes 401 and returns null on failure.\n * @param {import('http').IncomingMessage} req\n * @param {import('http').ServerResponse} res\n * @returns {import('./users').UserObj | null}\n */\nfunction requireUser(req, res) {\n  const header = req.headers.authorization;\n  const user = resolveBearerUser(\n    Array.isArray(header) ? header[0] : header\n  );\n  if (!user) {\n    sendJson(res, 401, { error: 'unauthorized' });\n    return null;\n  }\n  return user;\n}\n\nmodule.exports = { resolveBearerUser, requireUser };\n","isEmpty":false,"exceededLimit":false,"totalLines":54,"fileSize":1402,"path":"/work/ws/worktrees/app/app-architect-1/server/auth/middleware.js","readRange":{"startLine":1,"endLine":54},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-345f4428-524d-4765-a85b-ceb909d44224-17\nfc_e20519b8-9d1e-995a-aa03-cf2e0acdaf6a_1","startedAtMs":"1787428492291","completedAtMs":"1787428492674"},"model_call_id":"b9a0c0ee-9e46-4644-82ab-81a363f15c4c-6-ncbi","session_id":"659f50d8-61f9-4772-9eff-1622d4a8078e","timestamp_ms":1787428492698}
