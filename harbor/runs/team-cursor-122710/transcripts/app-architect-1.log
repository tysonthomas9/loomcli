/root"},{"name":"head","args":[{"type":"number","value":"-50"}],"fullText":"head -50"},{"name":"find","args":[{"type":"word","value":"/work/ws/app"},{"type":"word","value":"-type"},{"type":"word","value":"f"}],"fullText":"find /work/ws/app -type f"},{"name":"head","args":[{"type":"number","value":"-80"}],"fullText":"head -80"},{"name":"ls","args":[{"type":"word","value":"/work/ws/app"}],"fullText":"ls /work/ws/app"},{"name":"ls","args":[{"type":"word","value":"/work/ws/sessions/20260822-195343-app-architect-1--af982737/"}],"fullText":"ls /work/ws/sessions/20260822-195343-app-architect-1--af982737/"},{"name":"head","args":[],"fullText":"head"}],"hasRedirects":true,"hasCommandSubstitution":false,"allRedirectsAreDevNull":true,"redirects":[{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"},{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"},{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"},{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"}]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Find workspace API contract sources","closeStdin":true,"conversationId":"659f50d8-61f9-4772-9eff-1622d4a8078e","adminCommandDenylist":[]},"description":"Find workspace API contract sources"},"hookAdditionalContexts":[],"toolCallId":"call-78e1c035-369e-467d-b69e-17750c0d2c3a-14\nfc_9c407e55-96f7-96c4-bb25-b0021178f9aa_0","startedAtMs":"1787428481176"},"model_call_id":"b9a0c0ee-9e46-4644-82ab-81a363f15c4c-5-vj8d","session_id":"659f50d8-61f9-4772-9eff-1622d4a8078e","timestamp_ms":1787428481200}
