"word","value":"-name"},{"type":"raw_string","value":"'*DESIGN*'"},{"type":"word","value":"-o"},{"type":"word","value":"-name"},{"type":"raw_string","value":"'*MARATHON-2*'"}],"fullText":"find /work/ws -name '*design*' -o -name '*DESIGN*' -o -name '*MARATHON-2*'"},{"name":"head","args":[{"type":"number","value":"-40"}],"fullText":"head -40"}],"hasRedirects":true,"hasCommandSubstitution":false,"allRedirectsAreDevNull":true,"redirects":[{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"},{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"},{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"},{"operator":">","destinationFds":[2],"targetNodeType":"word","targetText":"/dev/null"}]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Fetch MARATHON-24 and epic design","closeStdin":true,"conversationId":"59ceda70-1dd6-464c-b3fc-7426e8fccde7","adminCommandDenylist":[]},"result":{"success":{"command":"cd /work/ws && loom data show MARATHON-24 --output json 2>/dev/null | head -200; echo '---'; loom data show MARATHON-2 --output json 2>/dev/null | head -300; echo '---'; ls /work/ws/.loom 2>/dev/null; find /work/ws -name '*design*' -o -name '*DESIGN*' -o -name '*MARATHON-2*' 2>/dev/null | head -40","workingDirectory":"","exitCode":0,"signal":"","stdout":"{\n  \"id\": \"MARATHON-24\",\n  \"title\": \"Verify: cluster bootstrap health and respawn\",\n  \"status\": \"review\",\n  \"priority\": 2,\n  \"issue_type\": \"task\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"qa\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"has_design\": false,\n  \"created_at\": \"2026-08-22T19:41:32.029300129Z\",\n  \"updated_at\": \"2026-08-22T19:44:17.786879552Z\",\n  \"created_by\": \"marathon-harness\",\n  \"description\": \"On integrated head e2704f3 (MARATHON-2), verify against the product specification: /app/start.sh stays foreground and serves three HTTP nodes on 127.0.0.1:8000/8001/8002 plus Redis on 127.0.0.1:6379; GET /api/health on each node returns 200 {\\\"status\\\":\\\"ok\\\",\\\"node_id\\\":N} with node_id 0/1/2 matching ports (JSON number); SIGKILL of one HTTP node restores that port's health within 60s without stopping the other two; SIGKILL of redis-server leaves health still 200 on all nodes and Redis is respawned by start.sh. No Docker or remote services.\",\n  \"comments\": [\n    {\n      \"id\": 7,\n      \"issue_id\": \"MARATHON-24\",\n      \"author\": \"qa-engineer-1\",\n      \"text\": \"IMPL-DONE attempt=1 commit=7077d7f36a70d3cf5969335e75c028fdaeb131f6\",\n      \"created_at\": \"2026-08-22T19:44:17.767607717Z\"\n    }\n  ]\n}\n---\n{\n  \"id\": \"MARATHON-2\",\n  \"title\": \"Bootstrap cluster: start.sh, 3 HTTP nodes, Redis, health\",\n  \"status\": \"closed\",\n  \"priority\": 0,\n  \"issue_type\": \"task\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"backend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"design\": \"## Summary\\n\\nMARATHON-2 bootstraps the Huddle cluster runtime at `/app`: a foreground `start.sh` that launches local Redis on `127.0.0.1:6379` and three identical HTTP nodes on `127.0.0.1:8000/8001/8002`, keeps them alive under SIGKILL (HTTP respawn ≤60s; Redis respawn after kill), and exposes a stable `GET /api/health` contract returning `{status:\\\"ok\\\", node_id}` with `node_id` ∈ `{0,1,2}` matching ports. This is the foundation every later auth, messaging, WS, IRC, and SPA task assumes: process topology, port map, node identity, and local-only Redis.\\n\\n## Technical Approach\\n\\n### Decision\\n- **Process model:** One bash supervisor (`/app/start.sh`) stays in the foreground and owns child lifetimes. Children: one `redis-server` + three Node.js HTTP workers. The supervisor polls PIDs (≈1s cadence) and respawns any dead child without exiting.\\n- **HTTP runtime:** **Node.js** (v24 present in the environment) using the **stdlib `http` module only** for this task—no npm registry dependency for bootstrap. One shared entrypoint, differentiated solely by `NODE_ID` / `PORT` env vars.\\n- **Redis:** System `redis-server` (v7 present), bound to `127.0.0.1:6379`, persistence directory under `/app/data/redis`. Started as a non-daemon child of `start.sh` (no `--daemonize yes`) so the supervisor can track its PID.\\n- **Bind address:** HTTP listens on `127.0.0.1` (epic: nodes on `127.0.0.1:8000/8001/8002`). Redis on `127.0.0.1:6379`. No Docker, no remote broker, no cloud services.\\n\\n### Alternatives considered\\n| Alternative | Why rejected |\\n|-------------|--------------|\\n| systemd / supervisord / Docker Compose | Violates self-contained / no Docker-in-Docker; not available as the harness entrypoint |\\n| Python HTTP (stdlib) | Viable, but SPA + WS + IRC gateway later fit one Node process better; env has no FastAPI/Flask |\\n| Three separate start scripts | Harness expects a single foreground `/app/start.sh` |\\n| Health behind a reverse proxy | Extra moving part; epic requires each node to answer directly on its port |\\n\\n### Trade-off accepted\\nSupervisor simplicity (bash PID loop) over a real process manager: enough for marathon verification (kill + respawn windows), but no fancy backoff/jitter. Fixed ports mean `start.sh` must fail loudly if a protected harness process already owns a port rather than silently remapping.\\n\\n### Stack conventions fixed here (for siblings)\\nThese are **authoritative for subsequent MARATHON designs** unless a later design explicitly argues otherwise:\\n\\n| Convention | Value |\\n|------------|--------|\\n| Product | Huddle |\\n| App root | `/app` (repo working tree = deployment root) |\\n| HTTP runtime | Node.js, CommonJS or ESM; entry `server/index.js` |\\n| Node identity | Integer `NODE_ID` ∈ {0,1,2}; `PORT = 8000 + NODE_ID` |\\n| Redis | `127.0.0.1:6379`, no password, local-only |\\n| Durable shared state | Files under `/app/data/` (schema owned by MARATHON-3+; this task only creates dirs) |\\n| Pub/sub | Redis when healthy; fallback owned by MARATHON-19 (not implemented here) |\\n| API prefix | `/api/...` |\\n| JSON | `Content-Type: application/json; charset=utf-8` |\\n\\n## Interface Contracts\\n\\n### C1 — `GET /api/health` (each HTTP node)\\n\\n| Field | Value |\\n|-------|--------|\\n| Method / path | `GET /api/health` |\\n| Auth | None |\\n| Query / body | None; body ignored if present |\\n| Success status | `200` |\\n| Success body | `{\\\"status\\\":\\\"ok\\\",\\\"node_id\\\":\\u003cnumber\\u003e}` |\\n| `status` | Exactly the string `\\\"ok\\\"` (lowercase) |\\n| `node_id` | JSON number `0`, `1`, or `2` — **not** a string |\\n| Mapping | Port `8000` → `0`; `8001` → `1`; `8002` → `2` |\\n| Headers | `Content-Type: application/json; charset=utf-8` |\\n| Redis dependency | **None.** Health MUST succeed even if Redis is down or restarting (required so MARATHON-19 kill tests do not fail health probes). |\\n\\n**Owner:** Backend (this task). **Consumer:** QA harness, future load balancer checks, SPA may optionally display node identity later.\\n\\n**Client behavior while slow/failing:**\\n- Health is expected to respond in well under 1s; no loading UI required for this endpoint.\\n- Connection refused / reset → node is down or still respawning; client may retry; supervisor must restore listener within 60s of kill.\\n- Non-200 or malformed JSON → treat as failure (implementer must not return partial bodies).\\n\\n**Validation:**\\n- Server: derives `node_id` only from its configured `NODE_ID` env (integer parse once at boot); does not trust client input.\\n- Client/QA: assert status code, JSON parse, `status === \\\"ok\\\"`, `node_id === expected`.\\n\\n### C2 — Process / port topology (supervisor ↔ OS ↔ clients)\\n\\n| Process | Address | Identity |\\n|---------|---------|----------|\\n| Redis | `127.0.0.1:6379` | single shared instance |\\n| HTTP node 0 | `127.0.0.1:8000` | `NODE_ID=0` |\\n| HTTP node 1 | `127.0.0.1:8001` | `NODE_ID=1` |\\n| HTTP node 2 | `127.0.0.1:8002` | `NODE_ID=2` |\\n\\n`start.sh` remains in the foreground until terminated by signal; killing an HTTP child or Redis must not stop the supervisor or the other children.\\n\\n### C3 — Frontend/backend seam note (this task)\\nNo browser UI in this task. The only cross-seam contract is **C1**, which the SPA (MARATHON-21+) may call later from same-origin `fetch('/api/health')`. Until then, consumers are curl/QA. Unknown paths may return `404` with a small JSON error or plain 404—not part of acceptance beyond not crashing.\\n\\n## Data Model\\n\\nNo application database schema in this task.\\n\\n**Runtime configuration (env, not persisted):**\\n\\n| Name | Type | Required | Meaning |\\n|------|------|----------|---------|\\n| `NODE_ID` | integer 0\\\\|1\\\\|2 | yes (HTTP workers) | Stable node identity in health + future logs |\\n| `PORT` | integer | yes (HTTP workers) | Listen port; must equal `8000 + NODE_ID` |\\n| `REDIS_HOST` | string | optional, default `127.0.0.1` | Reserved for later tasks; unused by health |\\n| `REDIS_PORT` | integer | optional, default `6379` | Reserved for later tasks |\\n\\n**On-disk (created by `start.sh` if missing):**\\n\\n| Path | Purpose | Schema change |\\n|------|---------|---------------|\\n| `/app/data/redis/` | Redis working dir (`dir` config); RDB/AOF if enabled | New directory only; backward compatible (empty repo) |\\n| `/app/data/` | Parent for future durable store (MARATHON-3+) | Reserved; no files required by this task |\\n\\nNo migration. Greenfield baseline only had `timer.sh` + empty `data/`.\\n\\n## Files to Create / Files to Modify\\n\\n### Create\\n| File | Change |\\n|------|--------|\\n| `/app/start.sh` | Executable foreground supervisor: prepare dirs, spawn Redis + 3 nodes, trap signals, poll/respawn loop, log to stdout/stderr |\\n| `/app/server/index.js` | HTTP server entry: read `NODE_ID`/`PORT`, bind `127.0.0.1:$PORT`, route `GET /api/health`, reject invalid env at boot with non-zero exit |\\n| `/app/server/health.js` | Pure handler building `{status:\\\"ok\\\", node_id}` (keeps routing thin for later middleware) |\\n| `/app/package.json` | `{ \\\"name\\\": \\\"huddle\\\", \\\"private\\\": true, \\\"main\\\": \\\"server/index.js\\\" }` — documents Node entry; **no required dependencies** for this task |\\n\\n### Modify\\n| File | Change |\\n|------|--------|\\n| None required | Do not alter `timer.sh` (harness timer). Do not remove `.gitignore` entries unrelated to this task. |\\n\\n### Optional (allowed, not required)\\n| File | Change |\\n|------|--------|\\n| `/app/redis.conf` | Minimal conf: `bind 127.0.0.1`, `port 6379`, `dir /app/data/redis`, `protected-mode yes`, `save` optional; if omitted, pass equivalent flags on the `redis-server` CLI |\\n\\n## Sequencing and Cross-Task Seams\\n\\n### Build order for this task\\n1. `server/health.js` + `server/index.js` (can be verified with a one-off `NODE_ID=0 PORT=8000 node server/index.js` by the implementer—architect does not run the app).\\n2. `package.json`\\n3. `start.sh` (depends on server entry existing)\\n4. Manual/QA: boot via `start.sh`, hit three health URLs, kill tests\\n\\n### Parallelism\\n- All of this task is sequential within one implementer; nothing to split further.\\n- Sibling architecture designs (MARATHON-3+) can proceed in parallel **using the conventions table above**; implementation of those tasks **must wait** until this bootstrap lands so ports/processes exist.\\n\\n### Seams this task owns (downstream dependents)\\n| Seam | Contract | Downstream |\\n|------|----------|------------|\\n| Port/identity map | C2 | All HTTP/WS/SPA/IRC tasks |\\n| Health | C1 | QA, optional SPA |\\n| Redis listen address | `127.0.0.1:6379` | MARATHON-18/19 pub/sub |\\n| Foreground `start.sh` | stays up, respawns | Harness lifecycle; MARATHON-19/20 extend children later |\\n| `/app/data/` reservation | durable root | MARATHON-3 shared store |\\n\\n### Seams NOT owned here (follow-ups)\\n| Cut | Owner task |\\n|-----|------------|\\n| Auth + shared durable store schema | MARATHON-3 |\\n| WS `/api/ws` | MARATHON-18 |\\n| Redis-down fan-out fallback | MARATHON-19 |\\n| IRC `:6667` process under same supervisor | MARATHON-20 (will extend `start.sh` to launch IRC gateway + respawn) |\\n| SPA `GET /` | MARATHON-21 |\\n\\nWhen MARATHON-20/21 land, they **extend** `start.sh` and the HTTP router; they must not replace the health contract or port map.\\n\\n## Out of Scope (Needs a Separate Task)\\n\\nNeighborhood scan of `/app` and the architect worktree found:\\n\\n| Finding | Why excluded |\\n|---------|----------------|\\n| `timer.sh` | Harness countdown utility; unrelated to cluster bootstrap |\\n| Empty `/app/data/` | Reserved; durable schema is MARATHON-3+ |\\n| Auth `/api/auth/*` | MARATHON-3 |\\n| Profiles, workspaces, channels, messages, … | MARATHON-4…17 |\\n| WebSocket subscribe/resume/seq | MARATHON-18 |\\n| Cross-node fan-out without Redis | MARATHON-19 |\\n| IRC gateway `:6667` | MARATHON-20 |\\n| SPA shell and UI | MARATHON-21…23 |\\n| npm framework (Express/Fastify), WS libs, SQLite, etc. | Introduce when the owning feature task needs them |\\n| TLS, auth on Redis, binding `0.0.0.0` for HTTP | Not required by epic for HTTP nodes |\\n\\nNo prior `start.sh`, `/api/health`, or `node_id` references exist in-repo to update.\\n\\n## Edge Cases \\u0026 Error Handling\\n\\n| Situation | Expected behavior |\\n|-----------|-------------------|\\n| `NODE_ID` missing or not in `{0,1,2}` | Worker prints error to stderr and exits non-zero; supervisor respawns—**implementer must pass valid env from `start.sh` so this is a programming error, not a loop** |\\n| `PORT` missing or ≠ `8000+NODE_ID` | Same: fail fast at worker boot |\\n| Port already in use at bind | Worker exits non-zero; supervisor retries on next poll. Log clearly. Do not bind a different port. |\\n| Redis already running on 6379 (foreign process) | `redis-server` fails; supervisor respawns Redis child. Log bind failure. Do not kill arbitrary PIDs outside children started by this `start.sh` (harness `marathon-freeports` is for verifiers, not the app). |\\n| HTTP node SIGKILL | Supervisor detects dead PID within poll interval and restarts that node only; other nodes and Redis keep running. New process must again serve correct `node_id`. Wall-clock from kill to successful health: **≤ 60s** |\\n| Redis SIGKILL | Supervisor restarts Redis only; HTTP nodes **must keep serving health** (and later reads/writes per MARATHON-19). No HTTP restart required solely because Redis died |\\n| `start.sh` receives SIGINT/SIGTERM | Trap: stop respawn loop, signal/kill tracked children, then exit non-zero or 0 per convention (prefer 0 on clean TERM); do not leave orphaned node/redis children |\\n| `GET /api/health` during Redis outage | Still `200` + ok body |\\n| Methods other than GET on `/api/health` | `405` or `404`; must not 500 |\\n| Concurrent health requests | Safe; handler is pure |\\n| Double-start of `start.sh` | Second instance will fail binds; document that only one supervisor should run. No distributed lock required for marathon |\\n| Working directory | `start.sh` `cd`s to its own directory (`/app`) so relative paths work regardless of caller cwd |\\n| Logging | Prefix child logs with `[redis]`, `[node-0]`, etc., on stdout/stderr of supervisor |\\n\\n## Acceptance Criteria\\n\\n1. Running `/app/start.sh` does not daemonize away: the script process remains in the foreground and continues until signaled.\\n2. After start, `redis-cli -h 127.0.0.1 -p 6379 PING` returns `PONG` (or equivalent connectivity success).\\n3. `curl -sS http://127.0.0.1:8000/api/health` → HTTP 200, body JSON-equal to `{\\\"status\\\":\\\"ok\\\",\\\"node_id\\\":0}` (key order irrelevant; types matter).\\n4. Same for `:8001` → `node_id` **1**; `:8002` → `node_id` **2**.\\n5. `node_id` is a JSON number, not `\\\"0\\\"` string; `status` is exactly `\\\"ok\\\"`.\\n6. SIGKILL one HTTP node’s PID: within **60 seconds**, that port’s `/api/health` returns 200 again with the **same** `node_id`; the other two ports never permanently go down as a consequence.\\n7. SIGKILL Redis: Redis becomes reachable again after restart (supervisor respawn); each HTTP `/api/health` continues to return 200 during and after the outage.\\n8. No Docker, no external Redis/host, no Slack SDK, no cloud APIs required to pass the above.\\n9. **MUST NOT:** remap ports; change `node_id` mapping; require Redis up for health; exit `start.sh` when a single child dies.\\n\\n## Testing Strategy\\n\\n### Automated / scripted (implementer or QA)\\n- Boot: `/app/start.sh` in background job **only for the test harness** (script itself still runs as a foreground process in that job).\\n- Assert health on 8000/8001/8002.\\n- Assert Redis PING.\\n- `kill -9` one node PID (from `ss`/`lsof` or supervisor-known PID); poll health until success; assert elapsed ≤ 60s.\\n- `kill -9` Redis; assert health still 200; poll until Redis PING succeeds again.\\n- Tear down via SIGTERM to `start.sh`; confirm ports free (or document leftover only if trap failed—trap must succeed).\\n\\n### Manual human verification\\n```bash\\n/app/start.sh\\n# other terminal:\\ncurl -s http://127.0.0.1:8000/api/health\\ncurl -s http://127.0.0.1:8001/api/health\\ncurl -s http://127.0.0.1:8002/api/health\\nredis-cli -h 127.0.0.1 ping\\n# kill -9 \\u003cnode-pid\\u003e; wait; curl again\\n# kill -9 \\u003credis-pid\\u003e; curl health; redis-cli ping until PONG\\n```\\n\\n### Out of scope for this task’s tests\\nAuth, SPA, WS, IRC, message fan-out, multi-node data consistency.\",\n  \"design_format\": \"markdown\",\n  \"has_design\": true,\n  \"notes\": \"Implemented start.sh supervisor (Redis :6379 + nodes :8000/8001/8002 with ~1s respawn), server/index.js + health.js (GET /api/health → {status:ok, node_id} number, Redis-independent), package.json, redis.conf. Verified: unit tests, integration (health map, node SIGKILL respawn ≤60s, Redis SIGKILL with health still 200). No migration.\",\n  \"created_at\": \"2026-08-22T19:28:48.968790239Z\",\n  \"updated_at\": \"2026-08-22T19:39:36.180843586Z\",\n  \"created_by\": \"marathon-harness\",\n  \"closed_at\": \"2026-08-22T19:39:36.180843586Z\",\n  \"close_reason\": \"integrated into /app by harness gate (attempt=1)\",\n  \"description\": \"Implement /app/start.sh that stays in the foreground, launches Redis on 127.0.0.1:6379, and three HTTP nodes on :8000/:8001/:8002. Auto-respawn killed HTTP nodes within 60s and Redis after kill. GET /api/health on each node returns 200 {status:ok, node_id} with node_id 0/1/2 matching ports. Self-contained; no remote services or Docker-in-Docker.\",\n  \"comments\": [\n    {\n      \"id\": 1,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"backend-dev-1\",\n      \"text\": \"IMPL-DONE attempt=1 commit=e2704f33e188e66eba9d4d4225e79b74f8cd9ea1\",\n      \"created_at\": \"2026-08-22T19:36:35.677510582Z\"\n    },\n    {\n      \"id\": 2,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"CRITIC REVIEW attempt=1 commit=e2704f33e188e66eba9d4d4225e79b74f8cd9ea1 APPROVED — start.sh supervises Redis@127.0.0.1:6379 + nodes 8000/1/2 with ~1s respawn; GET /api/health returns {status:\\\"ok\\\", node_id} as JSON number with correct Content-Type and no Redis dependency; integration verified kill/respawn and health-during-Redis-outage.\",\n      \"created_at\": \"2026-08-22T19:39:36.063069362Z\"\n    },\n    {\n      \"id\": 3,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"INTEGRATED attempt=1 app_before=a152118acefde5daa0d42f1edf507de56b34dfec app_after=e2704f33e188e66eba9d4d4225e79b74f8cd9ea1\",\n      \"created_at\": \"2026-08-22T19:39:36.171130474Z\"\n    }\n  ]\n}\n---\nagent-ipc.sock\ndaemon-agents.json\ndaemon.lock\ndaemon.pid\ndaemon.sock\nevents\n","stderr":"","executionTime":142,"interleavedOutput":"{\n  \"id\": \"MARATHON-24\",\n  \"title\": \"Verify: cluster bootstrap health and respawn\",\n  \"status\": \"review\",\n  \"priority\": 2,\n  \"issue_type\": \"task\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"qa\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"has_design\": false,\n  \"created_at\": \"2026-08-22T19:41:32.029300129Z\",\n  \"updated_at\": \"2026-08-22T19:44:17.786879552Z\",\n  \"created_by\": \"marathon-harness\",\n  \"description\": \"On integrated head e2704f3 (MARATHON-2), verify against the product specification: /app/start.sh stays foreground and serves three HTTP nodes on 127.0.0.1:8000/8001/8002 plus Redis on 127.0.0.1:6379; GET /api/health on each node returns 200 {\\\"status\\\":\\\"ok\\\",\\\"node_id\\\":N} with node_id 0/1/2 matching ports (JSON number); SIGKILL of one HTTP node restores that port's health within 60s without stopping the other two; SIGKILL of redis-server leaves health still 200 on all nodes and Redis is respawned by start.sh. No Docker or remote services.\",\n  \"comments\": [\n    {\n      \"id\": 7,\n      \"issue_id\": \"MARATHON-24\",\n      \"author\": \"qa-engineer-1\",\n      \"text\": \"IMPL-DONE attempt=1 commit=7077d7f36a70d3cf5969335e75c028fdaeb131f6\",\n      \"created_at\": \"2026-08-22T19:44:17.767607717Z\"\n    }\n  ]\n}\n---\n{\n  \"id\": \"MARATHON-2\",\n  \"title\": \"Bootstrap cluster: start.sh, 3 HTTP nodes, Redis, health\",\n  \"status\": \"closed\",\n  \"priority\": 0,\n  \"issue_type\": \"task\",\n  \"owner\": \"marathon-harness\",\n  \"labels\": [\n    \"backend\"\n  ],\n  \"source_repo\": \"app\",\n  \"parent\": \"MARATHON-1\",\n  \"design\": \"## Summary\\n\\nMARATHON-2 bootstraps the Huddle cluster runtime at `/app`: a foreground `start.sh` that launches local Redis on `127.0.0.1:6379` and three identical HTTP nodes on `127.0.0.1:8000/8001/8002`, keeps them alive under SIGKILL (HTTP respawn ≤60s; Redis respawn after kill), and exposes a stable `GET /api/health` contract returning `{status:\\\"ok\\\", node_id}` with `node_id` ∈ `{0,1,2}` matching ports. This is the foundation every later auth, messaging, WS, IRC, and SPA task assumes: process topology, port map, node identity, and local-only Redis.\\n\\n## Technical Approach\\n\\n### Decision\\n- **Process model:** One bash supervisor (`/app/start.sh`) stays in the foreground and owns child lifetimes. Children: one `redis-server` + three Node.js HTTP workers. The supervisor polls PIDs (≈1s cadence) and respawns any dead child without exiting.\\n- **HTTP runtime:** **Node.js** (v24 present in the environment) using the **stdlib `http` module only** for this task—no npm registry dependency for bootstrap. One shared entrypoint, differentiated solely by `NODE_ID` / `PORT` env vars.\\n- **Redis:** System `redis-server` (v7 present), bound to `127.0.0.1:6379`, persistence directory under `/app/data/redis`. Started as a non-daemon child of `start.sh` (no `--daemonize yes`) so the supervisor can track its PID.\\n- **Bind address:** HTTP listens on `127.0.0.1` (epic: nodes on `127.0.0.1:8000/8001/8002`). Redis on `127.0.0.1:6379`. No Docker, no remote broker, no cloud services.\\n\\n### Alternatives considered\\n| Alternative | Why rejected |\\n|-------------|--------------|\\n| systemd / supervisord / Docker Compose | Violates self-contained / no Docker-in-Docker; not available as the harness entrypoint |\\n| Python HTTP (stdlib) | Viable, but SPA + WS + IRC gateway later fit one Node process better; env has no FastAPI/Flask |\\n| Three separate start scripts | Harness expects a single foreground `/app/start.sh` |\\n| Health behind a reverse proxy | Extra moving part; epic requires each node to answer directly on its port |\\n\\n### Trade-off accepted\\nSupervisor simplicity (bash PID loop) over a real process manager: enough for marathon verification (kill + respawn windows), but no fancy backoff/jitter. Fixed ports mean `start.sh` must fail loudly if a protected harness process already owns a port rather than silently remapping.\\n\\n### Stack conventions fixed here (for siblings)\\nThese are **authoritative for subsequent MARATHON designs** unless a later design explicitly argues otherwise:\\n\\n| Convention | Value |\\n|------------|--------|\\n| Product | Huddle |\\n| App root | `/app` (repo working tree = deployment root) |\\n| HTTP runtime | Node.js, CommonJS or ESM; entry `server/index.js` |\\n| Node identity | Integer `NODE_ID` ∈ {0,1,2}; `PORT = 8000 + NODE_ID` |\\n| Redis | `127.0.0.1:6379`, no password, local-only |\\n| Durable shared state | Files under `/app/data/` (schema owned by MARATHON-3+; this task only creates dirs) |\\n| Pub/sub | Redis when healthy; fallback owned by MARATHON-19 (not implemented here) |\\n| API prefix | `/api/...` |\\n| JSON | `Content-Type: application/json; charset=utf-8` |\\n\\n## Interface Contracts\\n\\n### C1 — `GET /api/health` (each HTTP node)\\n\\n| Field | Value |\\n|-------|--------|\\n| Method / path | `GET /api/health` |\\n| Auth | None |\\n| Query / body | None; body ignored if present |\\n| Success status | `200` |\\n| Success body | `{\\\"status\\\":\\\"ok\\\",\\\"node_id\\\":\\u003cnumber\\u003e}` |\\n| `status` | Exactly the string `\\\"ok\\\"` (lowercase) |\\n| `node_id` | JSON number `0`, `1`, or `2` — **not** a string |\\n| Mapping | Port `8000` → `0`; `8001` → `1`; `8002` → `2` |\\n| Headers | `Content-Type: application/json; charset=utf-8` |\\n| Redis dependency | **None.** Health MUST succeed even if Redis is down or restarting (required so MARATHON-19 kill tests do not fail health probes). |\\n\\n**Owner:** Backend (this task). **Consumer:** QA harness, future load balancer checks, SPA may optionally display node identity later.\\n\\n**Client behavior while slow/failing:**\\n- Health is expected to respond in well under 1s; no loading UI required for this endpoint.\\n- Connection refused / reset → node is down or still respawning; client may retry; supervisor must restore listener within 60s of kill.\\n- Non-200 or malformed JSON → treat as failure (implementer must not return partial bodies).\\n\\n**Validation:**\\n- Server: derives `node_id` only from its configured `NODE_ID` env (integer parse once at boot); does not trust client input.\\n- Client/QA: assert status code, JSON parse, `status === \\\"ok\\\"`, `node_id === expected`.\\n\\n### C2 — Process / port topology (supervisor ↔ OS ↔ clients)\\n\\n| Process | Address | Identity |\\n|---------|---------|----------|\\n| Redis | `127.0.0.1:6379` | single shared instance |\\n| HTTP node 0 | `127.0.0.1:8000` | `NODE_ID=0` |\\n| HTTP node 1 | `127.0.0.1:8001` | `NODE_ID=1` |\\n| HTTP node 2 | `127.0.0.1:8002` | `NODE_ID=2` |\\n\\n`start.sh` remains in the foreground until terminated by signal; killing an HTTP child or Redis must not stop the supervisor or the other children.\\n\\n### C3 — Frontend/backend seam note (this task)\\nNo browser UI in this task. The only cross-seam contract is **C1**, which the SPA (MARATHON-21+) may call later from same-origin `fetch('/api/health')`. Until then, consumers are curl/QA. Unknown paths may return `404` with a small JSON error or plain 404—not part of acceptance beyond not crashing.\\n\\n## Data Model\\n\\nNo application database schema in this task.\\n\\n**Runtime configuration (env, not persisted):**\\n\\n| Name | Type | Required | Meaning |\\n|------|------|----------|---------|\\n| `NODE_ID` | integer 0\\\\|1\\\\|2 | yes (HTTP workers) | Stable node identity in health + future logs |\\n| `PORT` | integer | yes (HTTP workers) | Listen port; must equal `8000 + NODE_ID` |\\n| `REDIS_HOST` | string | optional, default `127.0.0.1` | Reserved for later tasks; unused by health |\\n| `REDIS_PORT` | integer | optional, default `6379` | Reserved for later tasks |\\n\\n**On-disk (created by `start.sh` if missing):**\\n\\n| Path | Purpose | Schema change |\\n|------|---------|---------------|\\n| `/app/data/redis/` | Redis working dir (`dir` config); RDB/AOF if enabled | New directory only; backward compatible (empty repo) |\\n| `/app/data/` | Parent for future durable store (MARATHON-3+) | Reserved; no files required by this task |\\n\\nNo migration. Greenfield baseline only had `timer.sh` + empty `data/`.\\n\\n## Files to Create / Files to Modify\\n\\n### Create\\n| File | Change |\\n|------|--------|\\n| `/app/start.sh` | Executable foreground supervisor: prepare dirs, spawn Redis + 3 nodes, trap signals, poll/respawn loop, log to stdout/stderr |\\n| `/app/server/index.js` | HTTP server entry: read `NODE_ID`/`PORT`, bind `127.0.0.1:$PORT`, route `GET /api/health`, reject invalid env at boot with non-zero exit |\\n| `/app/server/health.js` | Pure handler building `{status:\\\"ok\\\", node_id}` (keeps routing thin for later middleware) |\\n| `/app/package.json` | `{ \\\"name\\\": \\\"huddle\\\", \\\"private\\\": true, \\\"main\\\": \\\"server/index.js\\\" }` — documents Node entry; **no required dependencies** for this task |\\n\\n### Modify\\n| File | Change |\\n|------|--------|\\n| None required | Do not alter `timer.sh` (harness timer). Do not remove `.gitignore` entries unrelated to this task. |\\n\\n### Optional (allowed, not required)\\n| File | Change |\\n|------|--------|\\n| `/app/redis.conf` | Minimal conf: `bind 127.0.0.1`, `port 6379`, `dir /app/data/redis`, `protected-mode yes`, `save` optional; if omitted, pass equivalent flags on the `redis-server` CLI |\\n\\n## Sequencing and Cross-Task Seams\\n\\n### Build order for this task\\n1. `server/health.js` + `server/index.js` (can be verified with a one-off `NODE_ID=0 PORT=8000 node server/index.js` by the implementer—architect does not run the app).\\n2. `package.json`\\n3. `start.sh` (depends on server entry existing)\\n4. Manual/QA: boot via `start.sh`, hit three health URLs, kill tests\\n\\n### Parallelism\\n- All of this task is sequential within one implementer; nothing to split further.\\n- Sibling architecture designs (MARATHON-3+) can proceed in parallel **using the conventions table above**; implementation of those tasks **must wait** until this bootstrap lands so ports/processes exist.\\n\\n### Seams this task owns (downstream dependents)\\n| Seam | Contract | Downstream |\\n|------|----------|------------|\\n| Port/identity map | C2 | All HTTP/WS/SPA/IRC tasks |\\n| Health | C1 | QA, optional SPA |\\n| Redis listen address | `127.0.0.1:6379` | MARATHON-18/19 pub/sub |\\n| Foreground `start.sh` | stays up, respawns | Harness lifecycle; MARATHON-19/20 extend children later |\\n| `/app/data/` reservation | durable root | MARATHON-3 shared store |\\n\\n### Seams NOT owned here (follow-ups)\\n| Cut | Owner task |\\n|-----|------------|\\n| Auth + shared durable store schema | MARATHON-3 |\\n| WS `/api/ws` | MARATHON-18 |\\n| Redis-down fan-out fallback | MARATHON-19 |\\n| IRC `:6667` process under same supervisor | MARATHON-20 (will extend `start.sh` to launch IRC gateway + respawn) |\\n| SPA `GET /` | MARATHON-21 |\\n\\nWhen MARATHON-20/21 land, they **extend** `start.sh` and the HTTP router; they must not replace the health contract or port map.\\n\\n## Out of Scope (Needs a Separate Task)\\n\\nNeighborhood scan of `/app` and the architect worktree found:\\n\\n| Finding | Why excluded |\\n|---------|----------------|\\n| `timer.sh` | Harness countdown utility; unrelated to cluster bootstrap |\\n| Empty `/app/data/` | Reserved; durable schema is MARATHON-3+ |\\n| Auth `/api/auth/*` | MARATHON-3 |\\n| Profiles, workspaces, channels, messages, … | MARATHON-4…17 |\\n| WebSocket subscribe/resume/seq | MARATHON-18 |\\n| Cross-node fan-out without Redis | MARATHON-19 |\\n| IRC gateway `:6667` | MARATHON-20 |\\n| SPA shell and UI | MARATHON-21…23 |\\n| npm framework (Express/Fastify), WS libs, SQLite, etc. | Introduce when the owning feature task needs them |\\n| TLS, auth on Redis, binding `0.0.0.0` for HTTP | Not required by epic for HTTP nodes |\\n\\nNo prior `start.sh`, `/api/health`, or `node_id` references exist in-repo to update.\\n\\n## Edge Cases \\u0026 Error Handling\\n\\n| Situation | Expected behavior |\\n|-----------|-------------------|\\n| `NODE_ID` missing or not in `{0,1,2}` | Worker prints error to stderr and exits non-zero; supervisor respawns—**implementer must pass valid env from `start.sh` so this is a programming error, not a loop** |\\n| `PORT` missing or ≠ `8000+NODE_ID` | Same: fail fast at worker boot |\\n| Port already in use at bind | Worker exits non-zero; supervisor retries on next poll. Log clearly. Do not bind a different port. |\\n| Redis already running on 6379 (foreign process) | `redis-server` fails; supervisor respawns Redis child. Log bind failure. Do not kill arbitrary PIDs outside children started by this `start.sh` (harness `marathon-freeports` is for verifiers, not the app). |\\n| HTTP node SIGKILL | Supervisor detects dead PID within poll interval and restarts that node only; other nodes and Redis keep running. New process must again serve correct `node_id`. Wall-clock from kill to successful health: **≤ 60s** |\\n| Redis SIGKILL | Supervisor restarts Redis only; HTTP nodes **must keep serving health** (and later reads/writes per MARATHON-19). No HTTP restart required solely because Redis died |\\n| `start.sh` receives SIGINT/SIGTERM | Trap: stop respawn loop, signal/kill tracked children, then exit non-zero or 0 per convention (prefer 0 on clean TERM); do not leave orphaned node/redis children |\\n| `GET /api/health` during Redis outage | Still `200` + ok body |\\n| Methods other than GET on `/api/health` | `405` or `404`; must not 500 |\\n| Concurrent health requests | Safe; handler is pure |\\n| Double-start of `start.sh` | Second instance will fail binds; document that only one supervisor should run. No distributed lock required for marathon |\\n| Working directory | `start.sh` `cd`s to its own directory (`/app`) so relative paths work regardless of caller cwd |\\n| Logging | Prefix child logs with `[redis]`, `[node-0]`, etc., on stdout/stderr of supervisor |\\n\\n## Acceptance Criteria\\n\\n1. Running `/app/start.sh` does not daemonize away: the script process remains in the foreground and continues until signaled.\\n2. After start, `redis-cli -h 127.0.0.1 -p 6379 PING` returns `PONG` (or equivalent connectivity success).\\n3. `curl -sS http://127.0.0.1:8000/api/health` → HTTP 200, body JSON-equal to `{\\\"status\\\":\\\"ok\\\",\\\"node_id\\\":0}` (key order irrelevant; types matter).\\n4. Same for `:8001` → `node_id` **1**; `:8002` → `node_id` **2**.\\n5. `node_id` is a JSON number, not `\\\"0\\\"` string; `status` is exactly `\\\"ok\\\"`.\\n6. SIGKILL one HTTP node’s PID: within **60 seconds**, that port’s `/api/health` returns 200 again with the **same** `node_id`; the other two ports never permanently go down as a consequence.\\n7. SIGKILL Redis: Redis becomes reachable again after restart (supervisor respawn); each HTTP `/api/health` continues to return 200 during and after the outage.\\n8. No Docker, no external Redis/host, no Slack SDK, no cloud APIs required to pass the above.\\n9. **MUST NOT:** remap ports; change `node_id` mapping; require Redis up for health; exit `start.sh` when a single child dies.\\n\\n## Testing Strategy\\n\\n### Automated / scripted (implementer or QA)\\n- Boot: `/app/start.sh` in background job **only for the test harness** (script itself still runs as a foreground process in that job).\\n- Assert health on 8000/8001/8002.\\n- Assert Redis PING.\\n- `kill -9` one node PID (from `ss`/`lsof` or supervisor-known PID); poll health until success; assert elapsed ≤ 60s.\\n- `kill -9` Redis; assert health still 200; poll until Redis PING succeeds again.\\n- Tear down via SIGTERM to `start.sh`; confirm ports free (or document leftover only if trap failed—trap must succeed).\\n\\n### Manual human verification\\n```bash\\n/app/start.sh\\n# other terminal:\\ncurl -s http://127.0.0.1:8000/api/health\\ncurl -s http://127.0.0.1:8001/api/health\\ncurl -s http://127.0.0.1:8002/api/health\\nredis-cli -h 127.0.0.1 ping\\n# kill -9 \\u003cnode-pid\\u003e; wait; curl again\\n# kill -9 \\u003credis-pid\\u003e; curl health; redis-cli ping until PONG\\n```\\n\\n### Out of scope for this task’s tests\\nAuth, SPA, WS, IRC, message fan-out, multi-node data consistency.\",\n  \"design_format\": \"markdown\",\n  \"has_design\": true,\n  \"notes\": \"Implemented start.sh supervisor (Redis :6379 + nodes :8000/8001/8002 with ~1s respawn), server/index.js + health.js (GET /api/health → {status:ok, node_id} number, Redis-independent), package.json, redis.conf. Verified: unit tests, integration (health map, node SIGKILL respawn ≤60s, Redis SIGKILL with health still 200). No migration.\",\n  \"created_at\": \"2026-08-22T19:28:48.968790239Z\",\n  \"updated_at\": \"2026-08-22T19:39:36.180843586Z\",\n  \"created_by\": \"marathon-harness\",\n  \"closed_at\": \"2026-08-22T19:39:36.180843586Z\",\n  \"close_reason\": \"integrated into /app by harness gate (attempt=1)\",\n  \"description\": \"Implement /app/start.sh that stays in the foreground, launches Redis on 127.0.0.1:6379, and three HTTP nodes on :8000/:8001/:8002. Auto-respawn killed HTTP nodes within 60s and Redis after kill. GET /api/health on each node returns 200 {status:ok, node_id} with node_id 0/1/2 matching ports. Self-contained; no remote services or Docker-in-Docker.\",\n  \"comments\": [\n    {\n      \"id\": 1,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"backend-dev-1\",\n      \"text\": \"IMPL-DONE attempt=1 commit=e2704f33e188e66eba9d4d4225e79b74f8cd9ea1\",\n      \"created_at\": \"2026-08-22T19:36:35.677510582Z\"\n    },\n    {\n      \"id\": 2,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"CRITIC REVIEW attempt=1 commit=e2704f33e188e66eba9d4d4225e79b74f8cd9ea1 APPROVED — start.sh supervises Redis@127.0.0.1:6379 + nodes 8000/1/2 with ~1s respawn; GET /api/health returns {status:\\\"ok\\\", node_id} as JSON number with correct Content-Type and no Redis dependency; integration verified kill/respawn and health-during-Redis-outage.\",\n      \"created_at\": \"2026-08-22T19:39:36.063069362Z\"\n    },\n    {\n      \"id\": 3,\n      \"issue_id\": \"MARATHON-2\",\n      \"author\": \"marathon-harness\",\n      \"text\": \"INTEGRATED attempt=1 app_before=a152118acefde5daa0d42f1edf507de56b34dfec app_after=e2704f33e188e66eba9d4d4225e79b74f8cd9ea1\",\n      \"created_at\": \"2026-08-22T19:39:36.171130474Z\"\n    }\n  ]\n}\n---\nagent-ipc.sock\ndaemon-agents.json\ndaemon.lock\ndaemon.pid\ndaemon.sock\nevents\n","localExecutionTimeMs":85},"isBackground":false},"description":"Fetch MARATHON-24 and epic design"},"hookAdditionalContexts":[],"toolCallId":"call-7814ae86-c76f-4eab-a156-bae6a374b53f-12\nfc_df8d3071-4f2c-959e-8946-fea693aadc58_0","startedAtMs":"1787427956842","completedAtMs":"1787427956984"},"model_call_id":"ce00cad4-0ad0-4c48-8634-1912dce6b10a-4-n1gu","session_id":"59ceda70-1dd6-464c-b3fc-7426e8fccde7","timestamp_ms":1787427957032}
{"type":"tool_call","subtype":"started","call_id":"call-7814ae86-c76f-4eab-a156-bae6a374b53f-13\nfc_df8d3071-4f2c-959e-8946-fea693aadc58_1","tool_call":{"readToolCall":{"args":{"path":"/work/ws/sessions/20260822-193220-backend-dev-1--a57b0489/prompt.txt","limit":150}},"hookAdditionalContexts":[],"toolCallId":"call-7814ae86-c76f-4eab-a156-bae6a374b53f-13\nfc_df8d3071-4f2c-959e-8946-fea693aadc58_1","startedAtMs":"1787427956843"},"model_call_id":"ce00cad4-0ad0-4c48-8634-1912dce6b10a-4-n1gu","session_id":"59ceda70-1dd6-464c-b3fc-7426e8fccde7","timestamp_ms":1787427957100}
{"type":"tool_call","subtype":"started","call_id":"call-7814ae86-c76f-4eab-a156-bae6a374b53f-14\nfc_df8d3071-4f2c-959e-8946-fea693aadc58_2","tool_call":{"globToolCall":{"args":{"targetDirectory":"/work","globPattern":"**/CRITIC*"}},"hookAdditionalContexts":[],"toolCallId":"call-7814ae86-c76f-4eab-a156-bae6a374b53f-14\nfc_df8d3071-4f2c-959e-8946-fea693aadc58_2","startedAtMs":"1787427957078"},"model_call_id":"ce00cad4-0ad0-4c48-8634-1912dce6b10a-4-n1gu","session_id":"59ceda70-1dd6-464c-b3fc-7426e8fccde7","timestamp_ms":1787427957114}
{"type":"tool_call","subtype":"completed","call_id":"call-7814ae86-c76f-4eab-a156-bae6a374b53f-13\nfc_df8d3071-4f2c-959e-8946-fea693aadc58_1","tool_call":{"readToolCall":{"args":{"path":"/work/ws/sessions/20260822-193220-backend-dev-1--a57b0489/prompt.txt","limit":150},"result":{"success":{"content":"<!-- ROLE-MARKER: team-dev -->\n## WORKFLOW: Backend Implementation Task (Build, Verify, Deliver)\n\nYou are a disciplined backend engineer. Follow this workflow EXACTLY for ONE task.\n\n**Your agent name is: backend-dev-1** (Loom actor is set automatically)\n**You are working as the backend-dev agent role.**\n\n### Workspace Mode: Multi-Repo Environment\nYou are working in a multi-repo workspace. The workspace root is your current working directory.\nRepositories are subdirectories within this workspace:\n\n| Repo | Path | Default Branch |\n|------|------|----------------|\n| app | .//work/ws/app | marathon |\n\n**Important workspace rules:**\n- Run `loom data` commands from the workspace root (current directory)\n- Run git commands (git status, git add, git commit, git push) from the specific repo subdirectory\n- Run build/test commands from the specific repo subdirectory\n- Changes may span multiple repos — coordinate commits across them\n\n\n### Multi-Agent Safety Rules\n\nYou are running in a parallel multi-agent environment. Follow these rules strictly:\n\n- **Only modify files directly related to your assigned task** — do not touch files outside your task scope\n- **Never run** `git stash`, `git checkout main`, or `git clean` outside your assigned worktree\n- **Never force-push or reset --hard** without explicit instruction from the user\n- **If you encounter files/changes from another agent**, leave them alone — do not modify, revert, or clean them up\n- **Commit only your changes** — do not stage unrelated modifications with `git add -A` or `git add .`; use specific file paths\n- **If your worktree has unexpected state**, report it via task notes or `loom complete` rather than cleaning it up\n- **Do not switch branches** — you are confined to your assigned worktree branch\n\n### Your Lane\n\n- You implement server-side behavior from a design. The design's API contract is **verbatim law**: the paths, methods, field names, types, nullability, and status codes are what the client already assumes. Changing one silently breaks a caller you cannot see.\n- If the contract in the design is wrong, you do not \"improve\" it in code. Say so in the task notes and follow Step 6b so the contract is fixed where the clients can see it.\n- Every behavior change lands with a test that would have failed before it.\n- Migrations and handlers go in **separate commits**. A schema change and the code that depends on it must be reviewable and revertable apart from each other.\n- You do NOT edit frontend files outside this task's scope. If the UI needs to change, that is a task for the frontend agent role.\n- Never commit credentials, tokens, or connection strings. Configuration comes from the environment, and the environment is not yours to invent.\n\n### Step 0: Sync with the Integrated Head\n\n- Run `git merge --no-edit main` before implementation. `main` is the harness-integrated branch shared through the common git directory.\n- Merge conflicts are yours to resolve. After resolving them, re-run the tests before delivering.\n- Inspect the task comments. If a `STALE-BASE` or `FEEDBACK` line names a previous candidate commit that is not an ancestor of HEAD (`git merge-base --is-ancestor <sha> HEAD` fails), run `git cherry-pick <sha>` first. It may be another implementer's work on this same task. Resolve any conflicts and re-run the tests.\n\n### Step 1: Select ONE Task\n\nA task is already claimed for you: **MARATHON-2**. Work on that one and no other.\n\nID: MARATHON-2\nTitle: Bootstrap cluster: start.sh, 3 HTTP nodes, Redis, health\nStatus: in_progress\nPriority: P0\nType: task\nAssignee: backend-dev-1\nLabels: backend\n\nDescription:\nImplement /app/start.sh that stays in the foreground, launches Redis on 127.0.0.1:6379, and three HTTP nodes on :8000/:8001/:8002. Auto-respawn killed HTTP nodes within 60s and Redis after kill. GET /api/health on each node returns 200 {status:ok, node_id} with node_id 0/1/2 matching ports. Self-contained; no remote services or Docker-in-Docker.\n\nDesign:\n## Summary\n\nMARATHON-2 bootstraps the Huddle cluster runtime at `/app`: a foreground `start.sh` that launches local Redis on `127.0.0.1:6379` and three identical HTTP nodes on `127.0.0.1:8000/8001/8002`, keeps them alive under SIGKILL (HTTP respawn ≤60s; Redis respawn after kill), and exposes a stable `GET /api/health` contract returning `{status:\"ok\", node_id}` with `node_id` ∈ `{0,1,2}` matching ports. This is the foundation every later auth, messaging, WS, IRC, and SPA task assumes: process topology, port map, node identity, and local-only Redis.\n\n## Technical Approach\n\n### Decision\n- **Process model:** One bash supervisor (`/app/start.sh`) stays in the foreground and owns child lifetimes. Children: one `redis-server` + three Node.js HTTP workers. The supervisor polls PIDs (≈1s cadence) and respawns any dead child without exiting.\n- **HTTP runtime:** **Node.js** (v24 present in the environment) using the **stdlib `http` module only** for this task—no npm registry dependency for bootstrap. One shared entrypoint, differentiated solely by `NODE_ID` / `PORT` env vars.\n- **Redis:** System `redis-server` (v7 present), bound to `127.0.0.1:6379`, persistence directory under `/app/data/redis`. Started as a non-daemon child of `start.sh` (no `--daemonize yes`) so the supervisor can track its PID.\n- **Bind address:** HTTP listens on `127.0.0.1` (epic: nodes on `127.0.0.1:8000/8001/8002`). Redis on `127.0.0.1:6379`. No Docker, no remote broker, no cloud services.\n\n### Alternatives considered\n| Alternative | Why rejected |\n|-------------|--------------|\n| systemd / supervisord / Docker Compose | Violates self-contained / no Docker-in-Docker; not available as the harness entrypoint |\n| Python HTTP (stdlib) | Viable, but SPA + WS + IRC gateway later fit one Node process better; env has no FastAPI/Flask |\n| Three separate start scripts | Harness expects a single foreground `/app/start.sh` |\n| Health behind a reverse proxy | Extra moving part; epic requires each node to answer directly on its port |\n\n### Trade-off accepted\nSupervisor simplicity (bash PID loop) over a real process manager: enough for marathon verification (kill + respawn windows), but no fancy backoff/jitter. Fixed ports mean `start.sh` must fail loudly if a protected harness process already owns a port rather than silently remapping.\n\n### Stack conventions fixed here (for siblings)\nThese are **authoritative for subsequent MARATHON designs** unless a later design explicitly argues otherwise:\n\n| Convention | Value |\n|------------|--------|\n| Product | Huddle |\n| App root | `/app` (repo working tree = deployment root) |\n| HTTP runtime | Node.js, CommonJS or ESM; entry `server/index.js` |\n| Node identity | Integer `NODE_ID` ∈ {0,1,2}; `PORT = 8000 + NODE_ID` |\n| Redis | `127.0.0.1:6379`, no password, local-only |\n| Durable shared state | Files under `/app/data/` (schema owned by MARATHON-3+; this task only creates dirs) |\n| Pub/sub | Redis when healthy; fallback owned by MARATHON-19 (not implemented here) |\n| API prefix | `/api/...` |\n| JSON | `Content-Type: application/json; charset=utf-8` |\n\n## Interface Contracts\n\n### C1 — `GET /api/health` (each HTTP node)\n\n| Field | Value |\n|-------|--------|\n| Method / path | `GET /api/health` |\n| Auth | None |\n| Query / body | None; body ignored if present |\n| Success status | `200` |\n| Success body | `{\"status\":\"ok\",\"node_id\":<number>}` |\n| `status` | Exactly the string `\"ok\"` (lowercase) |\n| `node_id` | JSON number `0`, `1`, or `2` — **not** a string |\n| Mapping | Port `8000` → `0`; `8001` → `1`; `8002` → `2` |\n| Headers | `Content-Type: application/json; charset=utf-8` |\n| Redis dependency | **None.** Health MUST succeed even if Redis is down or restarting (required so MARATHON-19 kill tests do not fail health probes). |\n\n**Owner:** Backend (this task). **Consumer:** QA harness, future load balancer checks, SPA may optionally display node identity later.\n\n**Client behavior while slow/failing:**\n- Health is expected\n... [truncated]\n\nNotes:\nNew design (no needs-revision). Greenfield bootstrap: Node.js stdlib HTTP + bash supervisor + local Redis. Fixed conventions for siblings: NODE_ID/PORT map, /app/data reservation, health independent of Redis. After lead removes architect label, implementer is backend (label already present).\n\n\n### Step 2: Ground Yourself Before Implementing\n\n#### 2a. Read the Epic\n- Determine the parent epic from the task ID or the parent field of 'loom data show <id> --output json'\n- Run 'loom data show <epic-id>' and read its notes — the conventions there are **authoritative**\n\n#### 2b. Read Dependencies and Siblings\n- Check depends_on in 'loom data show <id> --output json'. A dependency still open means Step 6a.\n- Read two or three closed siblings in the epic. Extract their error semantics, naming, validation placement, and transaction boundaries — and match them.\n\n#### 2c. Read the Design and Reconcile Against the Code\n- Read the whole design: contract, data model, edge cases, acceptance criteria\n- Open every file the design names and read it as it stands today; run 'git log --oneline -5 -- <file>' to see whether a sibling already moved it\n- Follow the design's **intent** against the code's **current** conventions. If the design's approach cannot work at all, go to Step 6b.\n\n#### 2d. Read the Neighborhood\nRead the handlers, services, and repositories next to the ones you are touching. Copy their layering, their error wrapping, and their logging conventions.\n\n### Step 3: Implement","isEmpty":false,"exceededLimit":false,"totalLines":214,