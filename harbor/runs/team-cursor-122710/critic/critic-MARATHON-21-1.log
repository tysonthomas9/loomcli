ont-size: 0.95rem;\n  line-height: 1.45;\n}\n\n.field {\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n  margin-bottom: 0.9rem;\n}\n\n.field label {\n  font-size: 0.82rem;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  color: var(--ink-muted);\n}\n\n.field input {\n  font: inherit;\n  color: var(--ink);\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  padding: 0.65rem 0.75rem;\n  background: #fbfcfb;\n}\n\n.field input:hover {\n  border-color: #a9bab3;\n}\n\n.auth-error {\n  margin: 0 0 0.9rem;\n  padding: 0.65rem 0.75rem;\n  border-radius: 6px;\n  background: var(--danger-soft);\n  color: var(--danger);\n  font-size: 0.9rem;\n  line-height: 1.35;\n}\n\n#auth-submit {\n  width: 100%;\n  font: inherit;\n  font-weight: 600;\n  cursor: pointer;\n  border: none;\n  border-radius: 6px;\n  padding: 0.75rem 1rem;\n  background: var(--accent);\n  color: #fff;\n}\n\n#auth-submit:hover:not(:disabled) {\n  background: var(--accent-hover);\n}\n\n#auth-submit:disabled {\n  opacity: 0.65;\n  cursor: wait;\n}\n\n.auth-toggle {\n  display: block;\n  width: 100%;\n  margin-top: 1rem;\n  padding: 0.5rem;\n  border: none;\n  background: transparent;\n  color: var(--accent);\n  font: inherit;\n  font-size: 0.92rem;\n  cursor: pointer;\n  text-align: center;\n  text-decoration: underline;\n  text-underline-offset: 3px;\n}\n\n.auth-toggle:hover {\n  color: var(--accent-hover);\n}\n\n@keyframes auth-fade {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n@keyframes auth-rise {\n  from {\n    opacity: 0;\n    transform: translateY(10px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@media (max-width: 520px) {\n  .auth-modal__panel {\n    padding: 1.5rem 1.15rem 1.25rem;\n  }\n\n  .auth-modal__brand {\n    font-size: 1.85rem;\n  }\n\n  .app-chrome {\n    padding: 0.75rem 1rem;\n  }\n}\n","isEmpty":false,"exceededLimit":false,"totalLines":280,"fileSize":5019,"path":"/work/critic-MARATHON-21-1/public/css/app.css","re