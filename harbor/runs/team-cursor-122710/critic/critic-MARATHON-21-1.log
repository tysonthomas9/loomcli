s, 404, { error: 'not_found' });\n    })\n    .catch((err) => {\n      console.error(`[node-${nodeId}] unhandled`, err);\n      if (!res.headersSent) {\n        sendJson(res, 500, { error: 'internal server error' });\n      }\n    });\n});\n\nserver.on('error', (err) => {\n  console.error(`[node-${nodeId}] Failed to bind 127.0.0.1:${port}: ${err.message}`);\n  process.exit(1);\n});\n\nserver.listen(port, '127.0.0.1', () => {\n  console.error(`[node-${nodeId}] listening on 127.0.0.1:${port}`);\n});\n","isEmpty":false,"exceededLimit":false,"totalLines":82,"fileSize":2160,"path":"/work/critic-MARATHON-21-1/server/index.js","readRange":{"startLine":1,"endLine":82},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"call-d902a753-a783-49d8-a4f6-74b1de74142f-8\nfc_a1d45c83-b9b6-9415-b44c-0ff404bd9e65_4","startedAtMs":"1787428758579","completedAtMs":"1787428758868"},"model_call_id":"aea25036-a8b1-4c82-8550-6752316bd60c-1-tdrg","session_id":"8c969c8e-77c9-4261-a386-a66451852833","timestamp_ms":1787428758892}
