       44 +// DetectIntegrationBranch analyzes worktree branches to find a common integration                                                                                                                         
       45 +// branch that is closer than main. Returns empty string if no such branch is found.                                                                                                                       
       46 +func DetectIntegrationBranch(worktrees []WorktreeInfo) string {                                                                                                                                            
       47 +  if len(worktrees) < 2 {                                                                                                                                                                                  
       48 +    return ""                                                                                                                                                                                              
       49 +  }                                                                                                                                                                                                        
       50 +                                                                                                                                                                                                           
       51 +  repoPath := worktrees[0].Path                                                                                                                                                                            
       52 +                                                                                                                                                                                                           
       53 +  // Get all remote branches as candidates                                                                                                                                                                 
       54 +  output, err := RunGitCommand(repoPath, "branch", "-r", "--format=%(refname:short)")                                                                                                                      
       55 +  if err != nil {                                                                                                                                                                                          
       56 +    return ""                                                                                                                                                                                              
       57 +  }                                                                                                                                                                                                        
       58 +                                                                                                                                                                                                           
       59 +  // Build set of worktree branch names (with origin/ prefix) to exclude                                                                                                                                   
       60 +  wtBranches := make(map[string]bool)                                                                                                                                                                      
       61 +  for _, wt := range worktrees {                                                                                                                                                                           
       62 +    wtBranches["origin/"+wt.Branch] = true                                                                                                                                                                 
       63 +  }                                                                                                                                                                                                        
       64 +                                                                                                                                                                                                           
       65 +  var candidates []string                                                                                                                                                                                  
       66 +  for _, line := range strings.Split(strings.TrimSpace(output), "\n") {                                                                                                                                    
       67 +    branch := strings.TrimSpace(line)                                                                                                                                                                      
       68 +    if branch == "" || branch == "origin/HEAD" {                                                                                                                                                           
       69 +      continue                                                                                                                                                                                             
       70 +    }                                                                                                                                                                                                      
       71 +    // Skip worktree branches themselves and main/master                                                                                                                                                   
       72 +    if wtBranches[branch] || branch == "origin/main" || branch == "origin/master" {                                                                                                                        
       73 +      continue                                                                                                                                                                                             
       74 +    }                                                                                                                                                                                                      
       75 +    candidates = append(candidates, branch)                                                                                                                                                                
       76 +  }                                                                                                                                                                                                        
       77 +                                                                                                                                                                                                           
       78 +  // For each candidate, check if it's an ancestor of ALL worktree branches                                                                                                                                
       79 +  bestBranch := ""                                                                                                                                                                                         
       80 +  bestMaxDist := -1                                                                                                                                                                                        
       81 +                                                                                                                                                                                                           
       82 +  for _, candidate := range candidates {                                                                                                                                                                   
       83 +    isAncestorOfAll := true                                                                                                                                                                                
       84 +    maxDist := 0                                                                                                                                                                                           
       85 +                                                                                                                                                                                                           
       86 +    for _, wt := range worktrees {                                                                                                                                                                         
       87 +      // Check if candidate is ancestor of worktree branch                                                                                                                                                 
       88 +      _, err := RunGitCommand(repoPath, "merge-base", "--is-ancestor", candidate, "origin/"+wt.Branch)                                                                                                     
       89 +      if err != nil {                                                                                                                                                                                      
       90 +        isAncestorOfAll = false                                                                                                                                                                            
       91 +        break                                                                                                                                                                                              
       92 +      }                                                                                                                                                                                                    
       93 +                                                                                                                                                                                                           
       94 +      // Get distance (commits between candidate and worktree branch)                                                                                                                                      
       95 +      distOutput, err := RunGitCommand(repoPath, "rev-list", "--count", candidate+"..origin/"+wt.Branch)                                                                                                   
       96 +      if err != nil {                                                                                                                                                                                      
       97 +        isAncestorOfAll = false                                                                                                                                                                            
       98 +        break                                                                                                                                                                                              
       99 +      }                                                                                                                                                                                                    
      100 +      dist, _ := strconv.Atoi(strings.TrimSpace(distOutput))                                                                                                                                               
      101 +      if dist > maxDist {                                                                                                                                                                                  
      102 +        maxDist = dist                                                                                                                                                                                     
      103 +      }                                                                                                                                                                                                    
      104 +    }                                                                                                                                                                                                      
      105 +                                                                                                                                                                                                           
      106 +    if !isAncestorOfAll {                                                                                                                                                                                  
      107 +      continue                                                                                                                                                                                             
      108 +    }                                                                                                                                                                                                      
      109 +                                                                                                                                                                                                           
      110 +    // Pick the candidate closest to all worktrees (smallest max distance)                                                                                                                                 
      111 +    if bestBranch == "" || maxDist < bestMaxDist {                                                                                                                                                         
      112 +      bestBranch = candidate                                                                                                                                                                               
      113 +      bestMaxDist = maxDist                                                                                                                                                                                
      114 +    }                                                                                                                                                                                                      
      115 +  }                                                                                                                                                                                                        
      116 +                                                                                                                                                                                                           
      117 +  if bestBranch == "" {                                                                                                                                                                                    
      118 +    return ""                                                                                                                                                                                              
      119 +  }                                                                                                                                                                                                        
      120 +                                                                                                                                                                                                           
      121 +  // Only use detected branch if it's actually closer than main                                                                                                                                            
      122 +  mainMaxDist := 0                                                                                                                                                                                         
      123 +  for _, wt := range worktrees {                                                                                                                                                                           
      124 +    distOutput, err := RunGitCommand(repoPath, "rev-list", "--count", "origin/main..origin/"+wt.Branch)                                                                                                    
      125 +    if err != nil {                                                                                                                                                                                        
      126 +      return ""                                                                                                                                                                                            
      127 +    }                                                                                                                                                                                                      
      128 +    dist, _ := strconv.Atoi(strings.TrimSpace(distOutput))                                                                                                                                                 
      129 +    if dist > mainMaxDist {                                                                                                                                                                                
      130 +      mainMaxDist = dist                                                                                                                                                                                   
      131 +    }                                                                                                                                                                                                      
      132 +  }                                                                                                                                                                                                        
      133 +  if bestMaxDist >= mainMaxDist {                                                                                                                                                                          
      134 +    return ""                                                                                                                                                                                              
      135 +  }                                                                                                                                                                                                        
      136 +                                                                                                                                                                                                           
      137 +  return strings.TrimPrefix(bestBranch, "origin/")                                                                                                                                                         
      138 +}                                                                                                                                                                                                          
