[?2026l]0;⠐ Implementation Workflow[?2026h[6A●[1CUpdate(internal/cli/recover_test.go)  [1C [1C       [1C   [1C   [2C[1B⎿[1C Added[1C63[1Clines[1B      456                                                                                                                                                                                                             [1B  [4C457[4ChandleOrphanedTask("/test/worktree",[1C"task-orphan3",[1Cfalse)[1B      458  }                                                                                                                                                                                                          [2C[1B  [1C 459 +[1C           [1C  [1C          [1C  [1C      [1C [1C [1C     [1C   [1C  [1C [1C   [1C  [1C         [1B      460 +func TestKillProcess_Success(t *testing.T) {                                                                                                                                                               
