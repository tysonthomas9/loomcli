      471 +  }                                                                                                                                                                                                        
      472 +                                                                                                                                                                                                           
      473 +  // Kill it                                                                                                                                                                                               
      474 +  err := killProcess(pid)                                                                                                                                                                                  
      475 +  if err != nil {                                                                                                                                                                                          
