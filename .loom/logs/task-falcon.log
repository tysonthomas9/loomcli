      463 +  if err := cmd.Start(); err != nil {                                                                                                                                                                      
      464 +    t.Fatalf("failed to start sleep process: %v", err)                                                                                                                                                     
      465 +  }                                                                                                                                                                                                        
      466 +  pid := cmd.Process.Pid                                                                                                                                                                                   
      467 +                                                                                                                                                                                                           
      468 +  // Verify it's running                                                                                                                                                                                   
