# ============================================================
# Better Auth Service — Environment Configuration
# ============================================================
# Copy to .env and fill in values. [REQUIRED] = must be set.
# ============================================================

# --- Core Auth ---
# [REQUIRED] Signing/encryption secret. Min 32 chars.
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=

# [REQUIRED] Public URL where auth service is reachable.
# Local: http://localhost:3001  Self-hosted: https://auth.mycompany.com
BETTER_AUTH_URL=http://localhost:3001

# --- Database ---
# When using docker-compose.yml, DATABASE_URL is set automatically.
# DATABASE_PROVIDER=pg
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- GitHub OAuth (optional) ---
# Create: https://github.com/settings/developers -> "New OAuth App"
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
# IMPORTANT: Enable "user:email" scope for email access.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Google OAuth (optional) ---
# Create: https://console.cloud.google.com/apis/credentials
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Trusted Origins ---
# Comma-separated origins for CORS. Include the Loom WebUI origin.
TRUSTED_ORIGINS=

# --- Admin Bootstrap ---
ADMIN_USER_IDS=

# --- Server ---
PORT=3001
# METRICS_PORT=9090
LOG_LEVEL=info
NODE_ENV=production

# --- Docker Compose Only ---
# [REQUIRED for docker-compose] PostgreSQL password.
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# Host port mapping (default: 3001)
AUTH_PORT=3001

# --- Production (docker-compose.prod.yml) ---
# [REQUIRED for prod] Domain for Caddy auto-HTTPS.
# AUTH_DOMAIN=auth.mycompany.com
