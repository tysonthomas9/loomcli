{
  "name": "@loom/auth-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "generate-secret": "node --input-type=commonjs -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "better-auth": "1.5.6",
    "hono": "4.12.9",
    "@hono/node-server": "1.19.11",
    "drizzle-orm": "0.45.1",
    "better-sqlite3": "12.0.0",
    "pg": "8.16.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "typescript": "5.6.2",
    "tsx": "4.20.0",
    "@types/better-sqlite3": "7.6.0",
    "@types/pg": "8.15.0",
    "@types/node": "22.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
