#!/usr/bin/env bash
set -euo pipefail

WORKSPACE="${LOOM_WORKSPACE:-LOCALMODE}"
export LOOM_WORKSPACE="$WORKSPACE"
export LOOM_WORKSPACE_ID="$WORKSPACE"
SOURCE_REPO="${LOOM_LOCAL_MODE_SOURCE_REPO:-/workspace/source-repo}"
ORIGIN_REPO="${LOOM_LOCAL_MODE_ORIGIN_REPO:-/workspace/source-repo-origin.git}"
WORKSPACE_ROOT="${LOOM_LOCAL_MODE_WORKSPACE_ROOT:-/root/.loom/workspaces/${WORKSPACE}}"
WORKSPACE_REPO="${WORKSPACE_ROOT}/source-repo"
CHECKOUT_ID="${LOCAL_MODE_CHECKOUT_ID:?LOCAL_MODE_CHECKOUT_ID is required}"
SOURCE_ROOT="${LOCAL_MODE_SOURCE_ROOT:?LOCAL_MODE_SOURCE_ROOT is required}"
COMPOSE_PROJECT="${LOCAL_MODE_COMPOSE_PROJECT:?LOCAL_MODE_COMPOSE_PROJECT is required}"
RUN_ID="${LOCAL_MODE_RUN_ID:?LOCAL_MODE_RUN_ID is required}"
RUN_STARTED_AT=""
RUN_MANIFEST="${LOCAL_MODE_RUN_MANIFEST:-/tmp/loom-local-mode-run.json}"
RUN_MANIFEST_RECOVERY="${RUN_MANIFEST}.recovery"
RUN_MANIFEST_RESUMED=0
PREVIOUS_PLAN_TASK_ID=""
PREVIOUS_CODE_TASK_ID=""
AGENT_BACKEND="${LOOM_LOCAL_MODE_BACKEND:-${LOOM_BACKEND:-localdogfood}}"
case "$AGENT_BACKEND" in
  codex)
    DEFAULT_PLAN_AGENT="codex-planner"
    DEFAULT_CODE_AGENT="codex-coder"
    ;;
  claude)
    DEFAULT_PLAN_AGENT="claude-planner"
    DEFAULT_CODE_AGENT="claude-coder"
    ;;
  *)
    DEFAULT_PLAN_AGENT="local-planner"
    DEFAULT_CODE_AGENT="local-coder"
    ;;
esac
PLAN_AGENT="${LOOM_LOCAL_MODE_PLAN_AGENT:-$DEFAULT_PLAN_AGENT}"
CODE_AGENT="${LOOM_LOCAL_MODE_CODE_AGENT:-$DEFAULT_CODE_AGENT}"
TS_PLAN_AGENT_NAME="${LOOM_LOCAL_MODE_TS_PLAN_AGENT_NAME:-Local mode TS planner}"
TS_CODE_AGENT_NAME="${LOOM_LOCAL_MODE_TS_CODE_AGENT_NAME:-Local mode TS coder}"
TS_PLAN_ROLE="${LOOM_LOCAL_MODE_TS_PLAN_ROLE:-local-mode-ts-plan}"
TS_CODE_ROLE="${LOOM_LOCAL_MODE_TS_CODE_ROLE:-local-mode-ts-task}"
TS_PLAN_BINDING="${LOOM_LOCAL_MODE_TS_PLAN_BINDING:-local-mode-ts-planner}"
TS_CODE_BINDING="${LOOM_LOCAL_MODE_TS_CODE_BINDING:-local-mode-ts-coder}"
PLAN_AGENT_RECORD_ID=""
CODE_AGENT_RECORD_ID=""
FLEET_API_BASE="${LOOM_FLEET_DB_URL:-http://fleet-db:8080}"
FLEET_API_KEY="${LOOM_FLEET_DB_API_KEY:-}"
FLEET_API_ACTOR="${LOOM_FLEET_DB_ACTOR:-local-mode-harness@fixture.local}"
PLAN_TASK_ID=""
CODE_TASK_ID=""
PLAN_TASK_TITLE="${LOOM_LOCAL_MODE_PLAN_TASK_TITLE:-Local mode planner dogfood} [run:${RUN_ID}]"
CODE_TASK_TITLE="${LOOM_LOCAL_MODE_CODE_TASK_TITLE:-Local mode coder dogfood} [run:${RUN_ID}]"
LOOM_BIND="${LOOM_LOCAL_MODE_BIND:-0.0.0.0}"
LOOM_PORT="${LOOM_LOCAL_MODE_API_PORT:-8080}"
DAEMON_SCAN_INTERVAL="${LOOM_LOCAL_MODE_DAEMON_SCAN_INTERVAL:-5}"
DAEMON_STDOUT_DIR="${LOOM_LOCAL_MODE_DAEMON_STDOUT_DIR:-/tmp/loom-local-mode-daemons}"
export LOOM_BACKEND="$AGENT_BACKEND"

# LOOM_LOCAL_MODE_PLANE selects which agent plane local mode seeds (Decision 5,
# OPT-IN — default unchanged). Unset/empty keeps current behavior: seed the Go
# role agents (planner/coder daemons) plus their worktrees. "ts" skips that Go
# seeding entirely so the TS/workflow plane (prompt-agent bindings on
# internal.task.ready) owns the task queue uncontested — the interim two-plane
# arbitration for the TS-parity loop. Any other value falls back to the Go plane.
LOCAL_MODE_PLANE="${LOOM_LOCAL_MODE_PLANE:-}"

# plane_is_ts reports whether the TS/workflow plane is selected, i.e. the Go
# role-agent seeding (agentdefs + worktrees) must be suppressed.
plane_is_ts() {
  [ "$LOCAL_MODE_PLANE" = "ts" ]
}

ensure_stack_provenance() {
  config_dir="${LOOM_CONFIG_DIR:-/root/.loom}"
  marker="${config_dir}/.local-mode-provenance.json"
  mkdir -p "$config_dir"

  if [ ! -f "$marker" ]; then
    if find "$config_dir" -mindepth 1 -maxdepth 1 ! -name '.local-mode-provenance.json' -print -quit | grep -q .; then
      echo "[local-mode] FATAL: existing local-mode data has no checkout provenance marker" >&2
      echo "[local-mode] Refusing to adopt it for checkout ${CHECKOUT_ID}; use a new project or run local-mode-down for the old project." >&2
      return 1
    fi
    jq -n \
      --arg checkout_id "$CHECKOUT_ID" \
      --arg source_root "$SOURCE_ROOT" \
      --arg project "$COMPOSE_PROJECT" \
      '{checkout_id:$checkout_id, source_root:$source_root, compose_project:$project}' > "$marker"
    chmod 600 "$marker"
    return 0
  fi

  stored_checkout="$(jq -r '.checkout_id // empty' "$marker" 2>/dev/null || true)"
  stored_root="$(jq -r '.source_root // empty' "$marker" 2>/dev/null || true)"
  stored_project="$(jq -r '.compose_project // empty' "$marker" 2>/dev/null || true)"
  if [ "$stored_checkout" != "$CHECKOUT_ID" ] || [ "$stored_root" != "$SOURCE_ROOT" ] || [ "$stored_project" != "$COMPOSE_PROJECT" ]; then
    echo "[local-mode] FATAL: local-mode volume provenance mismatch" >&2
    echo "[local-mode] stored root/checkout/project=${stored_root}/${stored_checkout}/${stored_project}" >&2
    echo "[local-mode] current root/checkout/project=${SOURCE_ROOT}/${CHECKOUT_ID}/${COMPOSE_PROJECT}" >&2
    return 1
  fi
}

# prepare_run_manifest_epoch makes the manifest unavailable while a restarted
# container is rebuilding its live evidence. A valid manifest for this exact
# run preserves the original container-clock threshold and exact task IDs;
# without that preservation, reusing the run-tagged tasks would make their
# creation timestamps older than a newly minted threshold. A valid manifest
# from an older run in this same checkout/project starts a fresh proof epoch;
# same-run corruption and cross-checkout state fail closed after invalidation.
prepare_run_manifest_epoch() {
  if [ -e "$RUN_MANIFEST" ]; then
    # Atomic rename hides the prior proof from the verifier without destroying
    # the only recovery record. If startup is interrupted, the next entrypoint
    # resumes from this verifier-invisible journal.
    mv -f "$RUN_MANIFEST" "$RUN_MANIFEST_RECOVERY"
  elif [ ! -e "$RUN_MANIFEST_RECOVERY" ]; then
    return 0
  fi

  previous_manifest="$(cat "$RUN_MANIFEST_RECOVERY" 2>/dev/null || true)"
  previous_checkout="$(printf '%s' "$previous_manifest" | jq -r '.checkout_id // empty' 2>/dev/null || true)"
  previous_root="$(printf '%s' "$previous_manifest" | jq -r '.source_root // empty' 2>/dev/null || true)"
  previous_project="$(printf '%s' "$previous_manifest" | jq -r '.compose_project // empty' 2>/dev/null || true)"
  previous_run_id="$(printf '%s' "$previous_manifest" | jq -r '.run_id // empty' 2>/dev/null || true)"
  if [ "$previous_checkout" = "$CHECKOUT_ID" ] &&
    [ "$previous_root" = "$SOURCE_ROOT" ] &&
    [ "$previous_project" = "$COMPOSE_PROJECT" ] &&
    [ -n "$previous_run_id" ] && [ "$previous_run_id" != "$RUN_ID" ]; then
    rm -f "$RUN_MANIFEST_RECOVERY"
    echo "[local-mode] starting fresh proof epoch ${RUN_ID} after ${previous_run_id}" >&2
    return 0
  fi

  if ! printf '%s' "$previous_manifest" | jq -e \
    --arg checkout_id "$CHECKOUT_ID" \
    --arg source_root "$SOURCE_ROOT" \
    --arg compose_project "$COMPOSE_PROJECT" \
    --arg run_id "$RUN_ID" \
    --arg workspace "$WORKSPACE" \
    --arg backend "$AGENT_BACKEND" \
    --arg plan_task_title "$PLAN_TASK_TITLE" \
    --arg code_task_title "$CODE_TASK_TITLE" '
      .checkout_id == $checkout_id and
      .source_root == $source_root and
      .compose_project == $compose_project and
      .run_id == $run_id and
      .workspace == $workspace and
      .backend == $backend and
      .plan_task_title == $plan_task_title and
      .code_task_title == $code_task_title and
      ((.started_at | fromdateiso8601?) != null) and
      ((.plan_task_id // "") | length > 0) and
      ((.code_task_id // "") | length > 0)
    ' >/dev/null; then
    rm -f "$RUN_MANIFEST_RECOVERY"
    echo "[local-mode] FATAL: existing run manifest does not match this container proof epoch" >&2
    echo "[local-mode] Recreate loom-local with a new LOCAL_MODE_RUN_ID; stale proof has been invalidated." >&2
    return 1
  fi

  RUN_STARTED_AT="$(printf '%s' "$previous_manifest" | jq -r '.started_at')"
  PREVIOUS_PLAN_TASK_ID="$(printf '%s' "$previous_manifest" | jq -r '.plan_task_id')"
  PREVIOUS_CODE_TASK_ID="$(printf '%s' "$previous_manifest" | jq -r '.code_task_id')"
  RUN_MANIFEST_RESUMED=1
}

# This narrow mode lets the host-side unit test exercise volume ownership
# without starting FleetDB, loom serve, or a daemon. It is also useful for
# diagnosing a volume that startup refuses to adopt.
if [ "${1:-}" = "--check-provenance-only" ]; then
  ensure_stack_provenance
  exit 0
fi

if [ "${1:-}" = "--prepare-run-manifest-only" ]; then
  prepare_run_manifest_epoch
  printf '%s\n' "$RUN_STARTED_AT"
  exit 0
fi

http_get() {
  url="$1"
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --max-time 2 "$url"
    return $?
  fi
  wget -qO- --timeout=2 --tries=1 "$url"
}

http_post_json() {
  url="$1"
  body="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --max-time 5 -H "Content-Type: application/json" --data "$body" "$url"
    return $?
  fi
  wget -qO- --timeout=5 --tries=1 --header="Content-Type: application/json" --post-data="$body" "$url"
}

http_request_json() {
  method="$1"
  url="$2"
  body="${3:-}"
  args=(-fsS --max-time 180 -X "$method" -H "Accept: application/json" -H "Content-Type: application/json")
  if [ "$body" != "" ]; then
    args+=(--data "$body")
  fi
  curl "${args[@]}" "$url"
}

fleet_request_json() {
  method="$1"
  url="$2"
  body="${3:-}"
  if [ "$FLEET_API_KEY" = "" ]; then
    echo "[local-mode] FATAL: LOOM_FLEET_DB_API_KEY is required for authenticated FleetDB setup" >&2
    return 1
  fi
  args=(-fsS --max-time 180 -X "$method" -H "Accept: application/json" -H "Content-Type: application/json"
    -H "Authorization: Bearer ${FLEET_API_KEY}" -H "X-API-Key: ${FLEET_API_KEY}" -H "X-Actor: ${FLEET_API_ACTOR}")
  if [ "$body" != "" ]; then
    args+=(--data "$body")
  fi
  curl "${args[@]}" "$url"
}

wait_for_url() {
  url="$1"
  label="$2"
  i=1
  while [ "$i" -le 60 ]; do
    if http_get "$url" >/dev/null 2>&1; then
      return 0
    fi
    echo "[local-mode] waiting for ${label} (${i}/60)"
    sleep 1
    i=$((i + 1))
  done
  echo "[local-mode] FATAL: ${label} did not become reachable at ${url}" >&2
  return 1
}

ensure_local_origin() {
  if [ ! -d "$ORIGIN_REPO" ]; then
    mkdir -p "$(dirname "$ORIGIN_REPO")"
    git init -q --bare "$ORIGIN_REPO"
  fi
}

configure_origin_remote() {
  path="$1"
  ensure_local_origin
  if git -C "$path" remote get-url origin >/dev/null 2>&1; then
    git -C "$path" remote set-url origin "$ORIGIN_REPO"
  else
    git -C "$path" remote add origin "$ORIGIN_REPO"
  fi
}

push_current_branch() {
  path="$1"
  branch="$(git -C "$path" branch --show-current)"
  if [ "$branch" != "" ]; then
    git -C "$path" push -u origin "$branch" >/dev/null
  fi
}

create_source_repo() {
  if [ -d "${SOURCE_REPO}/.git" ]; then
    configure_origin_remote "$SOURCE_REPO"
    return 0
  fi
  mkdir -p "$SOURCE_REPO"
  git -C "$SOURCE_REPO" init -q -b main
  git -C "$SOURCE_REPO" config user.email "local-mode@fixture.local"
  git -C "$SOURCE_REPO" config user.name "local-mode"
  printf '# Local Mode Dogfood Repo\n' > "${SOURCE_REPO}/README.md"
  cat > "${SOURCE_REPO}/Makefile" <<'EOF'
gate:
	@echo "local mode gate ok"
EOF
  git -C "$SOURCE_REPO" add README.md Makefile
  git -C "$SOURCE_REPO" commit -q -m "Initial local mode fixture"
  configure_origin_remote "$SOURCE_REPO"
  push_current_branch "$SOURCE_REPO"
}

create_workspace() {
  mkdir -p "$(dirname "$WORKSPACE_ROOT")"
  if [ ! -e "${WORKSPACE_REPO}/.git" ]; then
    loom workspace create "$WORKSPACE" --repos "$SOURCE_REPO" --path "$WORKSPACE_ROOT" --branch localmode
  else
    loom workspace list >/dev/null
  fi
  configure_origin_remote "$WORKSPACE_REPO"
  push_current_branch "$WORKSPACE_REPO"
}

prepare_ts_patchback_repo() {
  # prompt-agent asks coder runs for local-branch delivery. This deterministic
  # execution proof needs the persisted diff/patch-back artifact instead, so the
  # disposable TS-plane fixture deliberately has no publish remote. The runner's
  # explicit fallback then returns a patch for the host bridge to apply and audit.
  if git -C "$WORKSPACE_REPO" remote get-url origin >/dev/null 2>&1; then
    git -C "$WORKSPACE_REPO" remote remove origin
  fi
}

create_agent_worktree() {
  agent="$1"
  path="${WORKSPACE_ROOT}/worktrees/source-repo/${agent}"
  mkdir -p "$(dirname "$path")"
  if [ ! -e "${path}/.git" ]; then
    if git -C "$WORKSPACE_REPO" show-ref --verify --quiet "refs/heads/${agent}"; then
      git -C "$WORKSPACE_REPO" worktree add "$path" "$agent"
    else
      git -C "$WORKSPACE_REPO" worktree add "$path" -b "$agent"
    fi
  fi
  git -C "$path" config user.email "local-mode@fixture.local"
  git -C "$path" config user.name "local-mode"
}

toml_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

trust_codex_project_path() {
  path="$1"
  config="/root/.codex/config.toml"
  escaped_path="$(toml_escape "$path")"

  mkdir -p /root/.codex
  if [ -f "$config" ] && grep -Fqx "[projects.\"${escaped_path}\"]" "$config"; then
    return 0
  fi
  {
    printf '\n[projects."%s"]\n' "$escaped_path"
    printf 'trust_level = "trusted"\n'
  } >> "$config"
}

trust_codex_local_mode_paths() {
  if [ "$AGENT_BACKEND" != "codex" ]; then
    return 0
  fi

  trust_codex_project_path "$SOURCE_REPO"
  trust_codex_project_path "$WORKSPACE_ROOT"
  trust_codex_project_path "$WORKSPACE_REPO"
  trust_codex_project_path "${WORKSPACE_ROOT}/worktrees/source-repo/${PLAN_AGENT}"
  trust_codex_project_path "${WORKSPACE_ROOT}/worktrees/source-repo/${CODE_AGENT}"
}

register_agents() {
  loom daemon profile set issue_backend fleetdb
  loom daemon profile set log_dir "${WORKSPACE_ROOT}/.loom/daemon-logs"
  loom daemon profile set events_dir "${WORKSPACE_ROOT}/.loom/events"
  loom daemon profile set max_agents 2
  loom daemon profile set startup_timeout 30

  if [ "$AGENT_BACKEND" != "localdogfood" ]; then
    [ "$PLAN_AGENT" = "local-planner" ] || loom agentdef remove local-planner >/dev/null 2>&1 || true
    [ "$CODE_AGENT" = "local-coder" ] || loom agentdef remove local-coder >/dev/null 2>&1 || true
  fi

  loom agentdef remove "$PLAN_AGENT" >/dev/null 2>&1 || true
  loom agentdef remove "$CODE_AGENT" >/dev/null 2>&1 || true
  loom agentdef add "$PLAN_AGENT" --role plan --auto --backend "$AGENT_BACKEND" --repos source-repo
  loom agentdef add "$CODE_AGENT" --role task --auto --backend "$AGENT_BACKEND" --repos source-repo
}

prepare_codex_credentials() {
  if [ "$AGENT_BACKEND" != "codex" ]; then
    return 0
  fi
  if ! command -v codex >/dev/null 2>&1; then
    echo "[local-mode] FATAL: codex binary is not installed in the image" >&2
    return 1
  fi
  mkdir -p /root/.codex
  if [ -f /codex-host/auth.json ]; then
    cp /codex-host/auth.json /root/.codex/auth.json
    chmod 600 /root/.codex/auth.json
  fi
  if [ -f /codex-host/config.toml ]; then
    cp /codex-host/config.toml /root/.codex/config.toml
    chmod 600 /root/.codex/config.toml
  fi
  if [ ! -s /root/.codex/auth.json ]; then
    echo "[local-mode] FATAL: codex auth missing. Mount local CODEX_HOME at /codex-host or set LOCAL_MODE_CODEX_HOME." >&2
    return 1
  fi
  codex --version || true
}

prepare_claude_credentials() {
  if [ "$AGENT_BACKEND" != "claude" ]; then
    return 0
  fi
  if ! command -v claude >/dev/null 2>&1; then
    echo "[local-mode] FATAL: claude binary is not installed in the image" >&2
    return 1
  fi
  mkdir -p /root/.claude
  # Claude Code stores its OAuth token in ~/.claude/.credentials.json. Copy it into
  # the container's writable HOME so token refresh writes don't hit the RO mount.
  if [ -f /claude-host/.credentials.json ]; then
    cp /claude-host/.credentials.json /root/.claude/.credentials.json
    chmod 600 /root/.claude/.credentials.json
  fi
  # Carry over model/permission settings if the host has them.
  if [ -f /claude-host/settings.json ]; then
    cp /claude-host/settings.json /root/.claude/settings.json
  fi
  if [ ! -s /root/.claude/.credentials.json ]; then
    echo "[local-mode] FATAL: claude auth missing. Mount local CLAUDE_HOME at /claude-host or set LOCAL_MODE_CLAUDE_HOME (needs ~/.claude/.credentials.json)." >&2
    return 1
  fi
  claude --version || true
}

prepare_daytona_credentials() {
  # When the daemon leaf is routed to the Daytona runner, the runner resolves its
  # API key via loom's runtime-credential API (LOOM_FLEET_DB_URL) or a credential
  # file. Write the host-provided DAYTONA_API_KEY to a file and point the runner at
  # it; the daemon subprocess inherits DAYTONA_CREDENTIAL_FILE from this shell.
  if [ -z "${DAYTONA_API_KEY:-}" ]; then
    return 0
  fi
  key_file="${LOOM_CONFIG_DIR:-/root/.loom}/daytona-key"
  mkdir -p "$(dirname "$key_file")"
  printf '%s' "$DAYTONA_API_KEY" > "$key_file"
  chmod 600 "$key_file"
  export DAYTONA_CREDENTIAL_FILE="$key_file"
  echo "[local-mode] daytona credential file staged at ${key_file}"
}

issues_api() {
  printf 'http://127.0.0.1:%s/api/workspaces/%s' "$LOOM_PORT" "$WORKSPACE"
}

prompt_agent_by_name() {
  name="$1"
  http_get "$(issues_api)/agents" |
    jq -c --arg name "$name" '[.data[]? | select(.kind == "prompt" and .name == $name)] | if length == 1 then .[0] else empty end'
}

seed_prompt_agent() {
  name="$1"
  role="$2"
  binding="$3"
  task_filter="$4"
  prompt="$5"

  record="$(prompt_agent_by_name "$name")"
  if [ "$record" = "" ]; then
    body="$(jq -cn \
      --arg name "$name" \
      --arg backend "$AGENT_BACKEND" \
      --arg role "$role" \
      --arg binding "$binding" \
      --arg task_filter "$task_filter" \
      --arg prompt "$prompt" \
      '{kind:"prompt",name:$name,backend:$backend,behavior:{role_name:$role,role_create:{description:"Deterministic supervisor-disabled execution proof",prompt:$prompt,prompt_filename:($role + ".md"),task_filter:$task_filter,backend:$backend}},trigger:{source_kind:"internal",binding_id:$binding,event_type_patterns:["internal.task.ready"]},enabled:true}')"
    record="$(http_request_json POST "$(issues_api)/agents" "$body")" || {
      echo "[local-mode] FATAL: public API failed to create prompt agent ${name}" >&2
      return 1
    }
    echo "[local-mode] public API created prompt agent ${name}" >&2
  else
    echo "[local-mode] public API prompt agent ${name} already exists" >&2
  fi

  if ! printf '%s' "$record" | jq -e \
    --arg role "$role" --arg binding "$binding" '
      .kind == "prompt" and .enabled == true and .behavior.role_name == $role and
      any(.bindings[]?; .binding_id == $binding and .source_kind == "internal" and
        .enabled == true and (.event_type_patterns | index("internal.task.ready") != null))
    ' >/dev/null; then
    echo "[local-mode] FATAL: prompt agent ${name} does not match its requested role/binding" >&2
    printf '%s\n' "$record" >&2
    return 1
  fi
  SEED_AGENT_ID="$(printf '%s' "$record" | jq -r '.id // empty')"
  if [ "$SEED_AGENT_ID" = "" ]; then
    echo "[local-mode] FATAL: prompt agent ${name} response omitted id" >&2
    return 1
  fi
}

seed_ts_prompt_agents() {
  # The task-run host resolves the local runner backend from the durable
  # workspace profile. Configure that profile through FleetDB's authenticated
  # public API: localdogfood is a harness-only backend and is intentionally not
  # added to the production backend dropdown accepted by Loom's UI endpoint.
  # A daemon profile is configuration data only; this does not launch a daemon
  # or create any PID/socket/control artifact (the negative verifier proves it).
  backend_body="$(jq -cn --arg backend "$AGENT_BACKEND" '{agent_backend:$backend}')"
  backend_profile="$(fleet_request_json PATCH "${FLEET_API_BASE%/}/api/v1/${WORKSPACE}/daemon" "$backend_body")" || {
    echo "[local-mode] FATAL: public FleetDB API failed to configure workspace backend ${AGENT_BACKEND}" >&2
    return 1
  }
  if ! printf '%s' "$backend_profile" | jq -e --arg workspace "$WORKSPACE" --arg backend "$AGENT_BACKEND" \
    '.workspace_key == $workspace and .agent_backend == $backend' >/dev/null; then
    echo "[local-mode] FATAL: public FleetDB API returned an invalid workspace backend profile" >&2
    printf '%s\n' "$backend_profile" >&2
    return 1
  fi
  echo "[local-mode] public FleetDB API configured workspace backend ${AGENT_BACKEND}" >&2

  seed_prompt_agent "$TS_PLAN_AGENT_NAME" "$TS_PLAN_ROLE" "$TS_PLAN_BINDING" "needs_plan" \
    'LOOM_LOCALDOGFOOD_PHASE=plan
Write an approved implementation design for the assigned task and make no repository changes. Do not change status or assignee; the workflow host moves it to review after the terminal receipt.'
  PLAN_AGENT_RECORD_ID="$SEED_AGENT_ID"
  seed_prompt_agent "$TS_CODE_AGENT_NAME" "$TS_CODE_ROLE" "$TS_CODE_BINDING" "has_design" \
    'LOOM_LOCALDOGFOOD_PHASE=task
Implement the approved task by changing and committing local-mode-agent-output.txt. Do not close or release the task; the workflow host owns terminalization.'
  CODE_AGENT_RECORD_ID="$SEED_AGENT_ID"
  echo "[local-mode] TS prompt agents are active before task creation: ${PLAN_AGENT_RECORD_ID}, ${CODE_AGENT_RECORD_ID}"
}

issue_json_field() {
  id="$1"
  field="$2"
  http_get "$(issues_api)/issues/${id}" |
    jq -r ".data.${field} // .${field} // empty" 2>/dev/null
}

find_issue_id_by_title() {
  title="$1"
  issue_type="${2:-}"
  encoded_title="$(jq -nr --arg value "$title" '$value | @uri')"
  # FleetDB's ordinary list endpoint has no title filter. Route through Loom's
  # real search service (which delegates to FleetDB /issues/search), then keep
  # the identity check exact so relevance/prefix matches cannot satisfy it.
  http_get "$(issues_api)/issues/search?q=${encoded_title}&limit=200" |
    jq -r --arg title "$title" --arg issue_type "$issue_type" '
      [(.data // .issues // [])[] |
        select(.title == $title and ($issue_type == "" or .issue_type == $issue_type))] |
      .[0].id // empty
    ' 2>/dev/null
}

find_epic_id() {
  find_issue_id_by_title "Local mode dogfood epic" "epic"
}

# Narrow diagnostic/test mode for proving title lookup against a populated
# workspace without starting the full local-mode process tree.
if [ "${1:-}" = "--find-issue-title-only" ]; then
  find_issue_id_by_title "${2:?issue title is required}" "${3:-}"
  exit 0
fi

ensure_epic_id() {
  existing="$(find_epic_id)"
  if [ -n "$existing" ]; then
    printf '%s' "$existing"
    return 0
  fi
  epic_body='{"title":"Local mode dogfood epic","issue_type":"epic","priority":1,"source_repo":"source-repo","description":"End-to-end local-mode planner and coder validation."}'
  resp="$(http_post_json "$(issues_api)/issues" "$epic_body")" || return 1
  printf '%s' "$resp" | jq -r '.data.id // empty' 2>/dev/null
}

link_parent_child() {
  child="$1"
  parent="$2"
  if [ -z "$child" ] || [ -z "$parent" ] || [ "$child" = "$parent" ]; then
    return 0
  fi
  status="$(issue_json_field "$child" status)"
  if [ "$status" = "closed" ]; then
    return 0
  fi
  current_parent="$(issue_json_field "$child" parent)"
  if [ "$current_parent" = "$parent" ]; then
    return 0
  fi
  dep_body="$(printf '{"depends_on_id":"%s","dep_type":"parent-child"}' "$parent")"
  if http_post_json "$(issues_api)/issues/${child}/dependencies" "$dep_body" >/dev/null 2>&1; then
    echo "[local-mode] linked ${child} -> epic ${parent}"
  fi
}

seed_issue_if_missing() {
  id="$1"
  body="$2"
  api="$(issues_api)"
  if http_get "${api}/issues/${id}" >/dev/null 2>&1; then
    echo "[local-mode] task ${id} already exists"
    return 0
  fi
  if http_post_json "${api}/issues" "$body" >/tmp/local-mode-seed.out 2>/tmp/local-mode-seed.err; then
    echo "[local-mode] seeded task ${id}"
    return 0
  fi
  echo "[local-mode] FATAL: failed to seed task ${id}" >&2
  cat /tmp/local-mode-seed.err >&2 || true
  cat /tmp/local-mode-seed.out >&2 || true
  return 1
}

seed_issue_by_title_if_missing() {
  title="$1"
  body="$2"
  api="$(issues_api)"
  if [ -n "$(find_issue_id_by_title "$title")" ]; then
    echo "[local-mode] issue \"${title}\" already exists"
    return 0
  fi
  if http_post_json "${api}/issues" "$body" >/tmp/local-mode-seed.out 2>/tmp/local-mode-seed.err; then
    seeded_id="$(jq -r '.data.id // empty' /tmp/local-mode-seed.out 2>/dev/null)"
    echo "[local-mode] seeded issue \"${title}\" (${seeded_id})"
    return 0
  fi
  echo "[local-mode] warning: failed to seed issue \"${title}\"" >&2
  cat /tmp/local-mode-seed.err >&2 || true
  return 0
}

ensure_run_issue() {
  title="$1"
  body="$2"
  expected_id="${3:-}"
  api="$(issues_api)"
  if [ -n "$expected_id" ]; then
    existing_issue="$(http_get "${api}/issues/${expected_id}" 2>/dev/null || true)"
    existing_title="$(printf '%s' "$existing_issue" | jq -r '.data.title // .title // empty' 2>/dev/null)"
    if [ "$existing_title" = "" ]; then
      echo "[local-mode] FATAL: manifest-owned run issue \"${title}\" (${expected_id}) is missing" >&2
      return 1
    fi
    if [ "$existing_title" != "$title" ]; then
      echo "[local-mode] FATAL: manifest-owned issue ${expected_id} has title \"${existing_title}\", expected \"${title}\"" >&2
      return 1
    fi
    RUN_ISSUE_ID="$expected_id"
    echo "[local-mode] run issue \"${title}\" already exists (${RUN_ISSUE_ID})"
    return 0
  fi

  # First-start collision detection uses the supported full-text search route
  # and then requires an exact title match. The ordinary Loom list route has no
  # title filter, and its adapter does not expose FleetDB's offset pagination.
  RUN_ISSUE_ID="$(find_issue_id_by_title "$title")"
  if [ -n "$RUN_ISSUE_ID" ]; then
    echo "[local-mode] FATAL: run issue \"${title}\" exists without a valid prior run manifest" >&2
    echo "[local-mode] Use a new LOCAL_MODE_RUN_ID so preserved data cannot satisfy a fresh proof." >&2
    return 1
  fi

  if [ "$RUN_MANIFEST_RESUMED" -eq 1 ]; then
    echo "[local-mode] FATAL: resumed proof epoch did not provide an expected task id for \"${title}\"" >&2
    return 1
  fi

  response="$(http_post_json "${api}/issues" "$body")" || {
    echo "[local-mode] FATAL: failed to seed run issue \"${title}\"" >&2
    return 1
  }
  RUN_ISSUE_ID="$(printf '%s' "$response" | jq -r '.data.id // .id // empty' 2>/dev/null)"
  if [ -z "$RUN_ISSUE_ID" ]; then
    echo "[local-mode] FATAL: seed response for \"${title}\" did not include an issue id" >&2
    printf '%s\n' "$response" >&2
    return 1
  fi
  echo "[local-mode] seeded run issue \"${title}\" (${RUN_ISSUE_ID})"
}

seed_tasks() {
  epic_id="$(ensure_epic_id)" || {
    echo "[local-mode] FATAL: could not create epic lane" >&2
    return 1
  }
  echo "[local-mode] epic lane: ${epic_id}"

  plan_body="$(jq -cn --arg title "$PLAN_TASK_TITLE" --arg parent "$epic_id" '{title:$title,issue_type:"task",priority:0,parent:$parent,source_repo:"source-repo",description:"Planner agent should claim this task and write an approved implementation design.",acceptance_criteria:"Design field is populated and the task moves to review."}')"
  code_body="$(jq -cn --arg title "$CODE_TASK_TITLE" --arg parent "$epic_id" '{title:$title,issue_type:"task",priority:0,parent:$parent,source_repo:"source-repo",description:"Coder agent should claim this task and make a small committed fixture change.",design:"Approved design: append a short local-mode dogfood result to local-mode-agent-output.txt, commit it, then close the task.",acceptance_criteria:"A commit exists in the coder worktree and the task is closed."}')"
  ensure_run_issue "$PLAN_TASK_TITLE" "$plan_body" "$PREVIOUS_PLAN_TASK_ID"
  PLAN_TASK_ID="$RUN_ISSUE_ID"
  ensure_run_issue "$CODE_TASK_TITLE" "$code_body" "$PREVIOUS_CODE_TASK_ID"
  CODE_TASK_ID="$RUN_ISSUE_ID"
  link_parent_child "$PLAN_TASK_ID" "$epic_id"
  link_parent_child "$CODE_TASK_ID" "$epic_id"

  # The deterministic TS proof creates only its two manifest-owned tasks. Extra
  # ready fixtures would correctly fan out through both bindings but add unrelated
  # DriverRuns to the acceptance evidence. Keep the richer board on the legacy
  # supervised profile where it already belongs.
  if ! plane_is_ts; then
    seed_issue_by_title_if_missing "Document local-mode runbook" \
      "$(printf '{"title":"Document local-mode runbook","issue_type":"task","priority":2,"parent":"%s","source_repo":"source-repo","owner":"local-mode","description":"Add troubleshooting notes for Podman machine failures."}' "$epic_id")"
    seed_issue_by_title_if_missing "Exercise epic swimlane UI" \
      "$(printf '{"title":"Exercise epic swimlane UI","issue_type":"task","priority":2,"parent":"%s","source_repo":"source-repo","assignee":"%s","owner":"local-mode","description":"Verify epic grouping on the kanban board."}' "$epic_id" "$PLAN_AGENT")"
    seed_issue_by_title_if_missing "Backlog grooming placeholder" \
      "$(printf '{"title":"Backlog grooming placeholder","issue_type":"task","priority":4,"parent":"%s","status":"deferred","source_repo":"source-repo","owner":"local-mode","description":"Deferred task for backlog column demo."}' "$epic_id")"

    swim_id="$(find_issue_id_by_title "Exercise epic swimlane UI" "task")"
    if [ -n "$swim_id" ] && [ "$(issue_json_field "$swim_id" status)" = "open" ]; then
      if command -v curl >/dev/null 2>&1; then
        curl -fsS --max-time 5 -X PATCH -H "Content-Type: application/json" \
          --data '{"status":"in_progress"}' "$(issues_api)/issues/${swim_id}" >/dev/null 2>&1 || true
      fi
    fi
  fi
}

capture_run_started_at() {
  if [ -n "$RUN_STARTED_AT" ]; then
    echo "[local-mode] resuming proof epoch ${RUN_ID} from ${RUN_STARTED_AT}"
    return 0
  fi
  # FleetDB timestamps are produced inside the container VM. Capture the
  # verifier threshold here, immediately before task creation, so freshness
  # never compares FleetDB evidence against the macOS host clock.
  RUN_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

write_run_manifest() {
  manifest_tmp="${RUN_MANIFEST}.tmp.$$"
  jq -n \
    --arg checkout_id "$CHECKOUT_ID" \
    --arg source_root "$SOURCE_ROOT" \
    --arg compose_project "$COMPOSE_PROJECT" \
    --arg run_id "$RUN_ID" \
    --arg started_at "$RUN_STARTED_AT" \
    --arg workspace "$WORKSPACE" \
    --arg backend "$AGENT_BACKEND" \
    --arg plane "$LOCAL_MODE_PLANE" \
    --arg plan_agent_record_id "$PLAN_AGENT_RECORD_ID" \
    --arg code_agent_record_id "$CODE_AGENT_RECORD_ID" \
    --arg plan_agent_name "$TS_PLAN_AGENT_NAME" \
    --arg code_agent_name "$TS_CODE_AGENT_NAME" \
    --arg plan_agent_role "$TS_PLAN_ROLE" \
    --arg code_agent_role "$TS_CODE_ROLE" \
    --arg plan_binding_id "$TS_PLAN_BINDING" \
    --arg code_binding_id "$TS_CODE_BINDING" \
    --arg plan_task_id "$PLAN_TASK_ID" \
    --arg code_task_id "$CODE_TASK_ID" \
    --arg plan_task_title "$PLAN_TASK_TITLE" \
    --arg code_task_title "$CODE_TASK_TITLE" \
    '{checkout_id:$checkout_id,source_root:$source_root,compose_project:$compose_project,run_id:$run_id,started_at:$started_at,workspace:$workspace,backend:$backend,plane:$plane,plan_agent_record_id:$plan_agent_record_id,code_agent_record_id:$code_agent_record_id,plan_agent_name:$plan_agent_name,code_agent_name:$code_agent_name,plan_agent_role:$plan_agent_role,code_agent_role:$code_agent_role,plan_binding_id:$plan_binding_id,code_binding_id:$code_binding_id,plan_task_id:$plan_task_id,code_task_id:$code_task_id,plan_task_title:$plan_task_title,code_task_title:$code_task_title}' \
    > "$manifest_tmp"
  chmod 600 "$manifest_tmp"
  mv "$manifest_tmp" "$RUN_MANIFEST"
  rm -f "$RUN_MANIFEST_RECOVERY"
}

start_serve() {
  cd "$WORKSPACE_ROOT"
  loom serve --bind "$LOOM_BIND" --port "$LOOM_PORT" --fleet-mode >/tmp/loom-serve.log 2>&1 &
  serve_pid="$!"
  wait_for_url "http://127.0.0.1:${LOOM_PORT}/api/config" "loom serve"
}

workspace_daemon_pid() {
  ws_path="$1"
  pid_file="${ws_path}/.loom/daemon.pid"
  if [ ! -f "$pid_file" ]; then
    return 1
  fi

  pid="$(tr -dc '0-9' < "$pid_file" || true)"
  if [ "$pid" = "" ]; then
    return 1
  fi
  if kill -0 "$pid" >/dev/null 2>&1; then
    printf '%s\n' "$pid"
    return 0
  fi
  return 1
}

workspace_has_auto_agents() {
  ws_key="$1"
  agents_json="$(LOOM_WORKSPACE="$ws_key" LOOM_WORKSPACE_ID="$ws_key" loom agentdef list --json 2>/tmp/local-mode-agentdef.err || true)"
  if [ "$agents_json" = "" ]; then
    return 1
  fi
  auto_count="$(printf '%s' "$agents_json" | jq '[.[] | select(.auto == true)] | length' 2>/dev/null || printf '0')"
  [ "${auto_count:-0}" -gt 0 ]
}

start_workspace_daemon() {
  ws_key="$1"
  ws_path="$2"
  mkdir -p "${ws_path}/.loom" "$DAEMON_STDOUT_DIR"

  log_file="${DAEMON_STDOUT_DIR}/${ws_key}.log"
  echo "[local-mode] starting daemon for workspace ${ws_key} (${ws_path})"
  (
    cd "$ws_path"
    export LOOM_WORKSPACE="$ws_key"
    export LOOM_WORKSPACE_ID="$ws_key"
    export LOOM_BACKEND="$AGENT_BACKEND"
    export LOOM_ISSUE_BACKEND=fleetdb
    export LOOM_FLEET_DB_URL="${LOOM_FLEET_DB_URL:-http://fleet-db:8080}"
    export LOOM_FLEET_URL="${LOOM_FLEET_URL:-http://fleet-db:8080}"
    export LOOM_FLEET_DB_ACTOR="${LOOM_FLEET_DB_ACTOR:-local-mode-harness@fixture.local}"
    export LOOM_FLEET_ACTOR="${LOOM_FLEET_ACTOR:-local-mode-harness@fixture.local}"
    loom daemon
  ) >>"$log_file" 2>&1 &
}

reconcile_workspace_daemons() {
  workspace_json="$(loom workspace list --json 2>/tmp/local-mode-workspaces.err || true)"
  if [ "$workspace_json" = "" ]; then
    echo "[local-mode] workspace daemon manager: no workspaces returned"
    return 0
  fi

  printf '%s' "$workspace_json" |
    jq -r '.[] | select((.path // "") != "") | [.key, .path] | @tsv' 2>/tmp/local-mode-workspaces-jq.err |
    while IFS="$(printf '\t')" read -r ws_key ws_path; do
      if [ "$ws_key" = "" ] || [ "$ws_path" = "" ]; then
        continue
      fi
      if ! workspace_has_auto_agents "$ws_key"; then
        continue
      fi
      if workspace_daemon_pid "$ws_path" >/dev/null 2>&1; then
        continue
      fi
      start_workspace_daemon "$ws_key" "$ws_path"
    done
}

run_daemon_manager() {
  echo "[local-mode] daemon manager: keeping daemons alive for workspaces with auto agents"
  echo "[local-mode] daemon manager: scan interval ${DAEMON_SCAN_INTERVAL}s"
  while true; do
    reconcile_workspace_daemons || true
    sleep "$DAEMON_SCAN_INTERVAL" &
    wait "$!" || return 0
  done
}

stop_workspace_daemons() {
  workspace_json="$(loom workspace list --json 2>/dev/null || true)"
  if [ "$workspace_json" = "" ]; then
    return 0
  fi

  printf '%s' "$workspace_json" |
    jq -r '.[] | select((.path // "") != "") | .path' 2>/dev/null |
    while read -r ws_path; do
      pid="$(workspace_daemon_pid "$ws_path" || true)"
      if [ "$pid" != "" ]; then
        kill "$pid" >/dev/null 2>&1 || true
      fi
    done
}

cleanup() {
  stop_workspace_daemons || true
  if [ "${serve_pid:-}" != "" ]; then
    kill "$serve_pid" >/dev/null 2>&1 || true
  fi
}

trap 'cleanup; exit 0' INT TERM
trap cleanup EXIT

mkdir -p "${HOME:-/root}" "${LOOM_CONFIG_DIR:-/root/.loom}"
ensure_stack_provenance
prepare_run_manifest_epoch
git config --global user.email "local-mode@fixture.local"
git config --global user.name "local-mode"
git config --global --add safe.directory "*" >/dev/null 2>&1 || true

wait_for_url "${LOOM_FLEET_DB_URL:-http://fleet-db:8080}/healthz" "fleet-db"
prepare_codex_credentials
prepare_claude_credentials
prepare_daytona_credentials
create_source_repo
create_workspace
if plane_is_ts; then
  echo "[local-mode] plane=ts: skipping Go role-agent seeding (${PLAN_AGENT}/${CODE_AGENT}) and their worktrees; the TS/workflow plane owns the task queue"
  prepare_ts_patchback_repo
else
  create_agent_worktree "$PLAN_AGENT"
  create_agent_worktree "$CODE_AGENT"
fi
trust_codex_local_mode_paths
plane_is_ts || register_agents
start_serve
capture_run_started_at
plane_is_ts && seed_ts_prompt_agents
seed_tasks
write_run_manifest

echo "[local-mode] ready"
echo "[local-mode] UI:  ${LOCAL_MODE_UI_URL:-http://localhost:8283}/ws/${WORKSPACE}/kanban"
echo "[local-mode] API: ${LOCAL_MODE_API_URL:-http://localhost:8282}"
echo "[local-mode] epic lane:    $(find_epic_id)"
echo "[local-mode] planner task: ${PLAN_TASK_ID}"
echo "[local-mode] coder task:   ${CODE_TASK_ID}"

if plane_is_ts; then
  echo "[local-mode] plane=ts: daemon manager disabled; waiting on loom serve"
  wait "$serve_pid"
else
  run_daemon_manager
fi
