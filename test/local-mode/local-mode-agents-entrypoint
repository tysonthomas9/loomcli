#!/usr/bin/env bash
# Agent API variant: start the scripted fake model, point OpenCode's XDG roots
# at a sandbox on the loom-data volume (so sessions survive a container
# restart) whose opencode.json routes provider "aft" to it, then run the
# default local-mode entrypoint, which builds its workspace from the 2.0f
# Slack-clone fixture seeded here as the source repo. Script replies from the
# host with:
#   podman exec <loom-local container> curl -s -X POST \
#     http://127.0.0.1:4010/__script -d '{"steps":[{"text":"hi"}]}'
set -euo pipefail

sbx="${LOOM_CONFIG_DIR:-/root/.loom}/agents-opencode"
mkdir -p "$sbx/config/opencode"
cat > "$sbx/config/opencode/opencode.json" <<JSON
{"provider":{"aft":{"name":"AFT fake","npm":"@ai-sdk/openai-compatible",
  "options":{"baseURL":"http://127.0.0.1:${FAKE_MODEL_PORT}/v1","apiKey":"x"},
  "models":{"m":{"name":"M","limit":{"context":100000,"output":4000}}}}},"model":"aft/m"}
JSON
export XDG_CONFIG_HOME="$sbx/config" XDG_DATA_HOME="$sbx/data" \
  XDG_STATE_HOME="$sbx/state" XDG_CACHE_HOME="$sbx/cache"

src="${LOOM_LOCAL_MODE_SOURCE_REPO:-/workspace/source-repo}"
origin="${LOOM_LOCAL_MODE_ORIGIN_REPO:-/workspace/source-repo-origin.git}"
if [ ! -d "$src/.git" ]; then
  /opt/fixtures/scripts/seed-slack-clone.sh "$src"
  git init -q --bare "$origin"
  git -C "$src" remote add origin "$origin"
  git -C "$src" push -q -u origin main
fi

node /opt/fake-model/server.mjs >/tmp/fake-model.log 2>&1 &

exec /usr/local/bin/local-mode-entrypoint "$@"
