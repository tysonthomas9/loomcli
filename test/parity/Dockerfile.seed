# Dockerfile.seed — tiny seeder image carrying fdb.
#
# Built in-place by docker-compose.parity.yml. Multi-stage copies the
# fdb CLI from the fleet-db image so seed.sh can use it directly
# instead of hand-rolling curl + JSON. (fdb is the user-facing
# fleet-db client; using it here also exercises the real CLI path.)
#
# Stage 1: pick fdb out of the fleet-db image.
FROM localhost/loomcli-parity_fleet-db:latest AS fdb-source

# Stage 2: minimal seeder runtime.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl jq git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=fdb-source /usr/local/bin/fdb /usr/local/bin/fdb
WORKDIR /workspace
ENTRYPOINT ["/bin/sh"]
