#!/bin/sh
# Stall-or-work mock backend for task-quarantine tests.
#
# Failure mode: a task whose title contains "[STALL]" claims, then sleeps
# silently past the daemon's output timeout. The watchdog kills the run,
# recovery resets the task to open, and the picker re-selects the same task —
# the exact boomerang that task-level quarantine exists to break. Every other
# task takes the happy path (commit + close, copied from
# loom-backend-playground's run_coder), proving the agent moves on to real
# work once the poisoned task is quarantined.
#
# Stall detection: LOOM_PLAYGROUND_STALL_TASK_ID wins when set (exact task-id
# match, no lookup); otherwise `loom data show <id>` output is grepped for
# the literal "[STALL]" marker (the show format prints "Title:    <title>").
#
# Contract: meta / health / invoke (same as loom-backend-playground).
# Env knobs:
#   LOOM_PLAYGROUND_HANG_SECONDS    — silent sleep duration (default 120)
#   LOOM_PLAYGROUND_STALL_TASK_ID   — stall iff the assigned task id equals this
#   LOOM_PLAYGROUND_HANG_MARKER_DIR — override marker dir (testing only)

set -eu

cmd="${1:-}"
hang_seconds="${LOOM_PLAYGROUND_HANG_SECONDS:-120}"
marker_root="${LOOM_PLAYGROUND_HANG_MARKER_DIR:-${LOOM_WORKSPACE_RUNTIME_DIR:-/tmp/playground-stall-task}/stall-task}"

should_stall() {
  task_id="$1"
  if [ -n "${LOOM_PLAYGROUND_STALL_TASK_ID:-}" ]; then
    [ "$task_id" = "$LOOM_PLAYGROUND_STALL_TASK_ID" ]
    return
  fi
  loom data show "$task_id" 2>/dev/null | grep -Fq '[STALL]'
}

run_happy_path() {
  task_id="$1"
  agent="$2"
  output_file="playground.txt"

  {
    printf 'Task: %s\n' "$task_id"
    printf 'Agent: %s\n' "$agent"
    printf 'Result: playground deterministic backend produced a committed artifact.\n'
    printf 'Updated: %s\n\n' "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  } >> "$output_file"

  git add "$output_file"
  git -c user.email=playground@loom.local -c user.name=Playground \
    commit -m "Playground implementation (${task_id})" || true
  loom data close "$task_id" --session "${LOOM_SESSION_ID:-}" --reason "Playground deterministic implementation completed."
  loom complete
}

run_invoke() {
  task_id="${LOOM_ASSIGNED_TASK_ID:-}"
  agent="${LOOM_AGENT_NAME:-stall-task-worker}"

  if [ -z "$task_id" ]; then
    echo "[playground-stall-task] ${agent}: no assigned task, exiting"
    exit 0
  fi

  echo "[playground-stall-task] ${agent} claiming ${task_id}"
  loom claim "$task_id" || true

  if should_stall "$task_id"; then
    mkdir -p "$marker_root"
    : > "$marker_root/started.flag"
    echo "[playground-stall-task] ${agent} stalling silently on ${task_id}"
    # Stay silent past the watchdog threshold. With no descendants, the
    # daemon's hung-process kill only needs to signal our primary pgroup.
    exec sleep "$hang_seconds"
  fi

  echo "[playground-stall-task] ${agent} implementing ${task_id}"
  run_happy_path "$task_id" "$agent"
}

case "$cmd" in
  meta)
    printf '{"display_name":"Playground Stall Task","version":"1","description":"Stalls on [STALL]-titled tasks to exercise task quarantine; happy-path otherwise","binary_name":"loom-backend-playground-stall-task"}\n'
    ;;
  health)
    printf '{"installed":true,"healthy":true,"message":"ready"}\n'
    ;;
  invoke)
    run_invoke
    ;;
  *)
    echo "usage: loom-backend-playground-stall-task {meta|health|invoke}" >&2
    exit 2
    ;;
esac
