#!/usr/bin/env bash
set -euo pipefail

# Skip quality gate for data-only branches
branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = "beads-sync" ]; then
  exit 0
fi

echo "[pre-push] Running quality gate..."
# Unset GIT_DIR/GIT_WORK_TREE so tests that create temp repos don't
# accidentally commit to the real repository.
unset GIT_DIR GIT_WORK_TREE
make check
