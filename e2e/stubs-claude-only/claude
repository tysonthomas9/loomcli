#!/bin/sh
# Stub for the Claude CLI used in E2E tests.
# Mimics both interactive and non-interactive invocation patterns.
#
# Environment variables:
#   STUB_CLAUDE_EXIT_CODE  - exit code (default: 0)
#   STUB_CLAUDE_RESPONSE   - custom response text (default: built-in)
#   STUB_CLAUDE_DELAY      - seconds to sleep before responding (default: 0)
#   STUB_CLAUDE_LEAD       - when 1, expose a persistent controlled lead TUI

set -e

EXIT_CODE="${STUB_CLAUDE_EXIT_CODE:-0}"
RESPONSE="${STUB_CLAUDE_RESPONSE:-I completed the requested task successfully.}"
DELAY="${STUB_CLAUDE_DELAY:-0}"

# Handle SIGTERM gracefully (must be before sleep/cat which can block)
trap 'exit 0' TERM

if [ "$DELAY" != "0" ]; then
    sleep "$DELAY"
fi

# Parse arguments
IS_PIPE=false
IS_STREAM_JSON=false
HAS_SKIP_PERMS=false
HAS_SESSION_ID=false
SESSION_ID=""
PROMPT_TEXT=""

while [ $# -gt 0 ]; do
    case "$1" in
        -p|--print) IS_PIPE=true ;;
        --output-format)
            shift
            if [ "$1" = "stream-json" ]; then IS_STREAM_JSON=true; fi
            ;;
        --session-id)
            if [ "$#" -gt 1 ]; then
                shift
                SESSION_ID="$1"
                if printf '%s\n' "$SESSION_ID" | grep -Eq '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'; then
                    HAS_SESSION_ID=true
                fi
            fi
            ;;
        --dangerously-skip-permissions) HAS_SKIP_PERMS=true ;;
        --*) ;;
        *)
            if [ -z "$PROMPT_TEXT" ]; then
                PROMPT_TEXT="$1"
            else
                PROMPT_TEXT="$PROMPT_TEXT $1"
            fi
            ;;
    esac
    shift
done

if [ "${STUB_CLAUDE_LEAD:-0}" = "1" ] &&
    [ "$HAS_SKIP_PERMS" = "true" ] &&
    [ "$HAS_SESSION_ID" = "true" ] &&
    [ "$IS_PIPE" = "false" ] &&
    [ "$IS_STREAM_JSON" = "false" ]; then
    if [ "$EXIT_CODE" != "0" ]; then
        exit "$EXIT_CODE"
    fi
    PROMPT_CONTRACT="$(printf '%s' "$PROMPT_TEXT" | python3 -c 'import hashlib, sys
data = sys.stdin.buffer.read()
separator = b"\n\n\n### Multi-Agent Safety Rules"
authored = data.rsplit(separator, 1)[0] if separator in data else data
safety_blocks = 1 if separator in data else 0
print(f"authored-sha256={hashlib.sha256(authored).hexdigest()} authored-bytes={len(authored)} safety-blocks={safety_blocks}")')"
    render_controlled_lead() {
        # Real TUIs redraw after their PTY is resized. The controlled stub does
        # the same so the post-attach frame is deterministic without slowing
        # startup or replaying raw PTY bytes in production. Keep the redraw in
        # one printf: a resize trap between separate echo calls can otherwise
        # clear and partially overwrite the frame it interrupted.
        printf '\033[2J\033[HClaude Code\n❯\nControlled Claude stub ready: %s\nControlled Claude prompt contract: %s\nControlled Claude session: %s\n' \
            "${LOOM_AGENT_NAME:-unknown}" "$PROMPT_CONTRACT" "$SESSION_ID"
    }
    trap 'render_controlled_lead' WINCH
    render_controlled_lead
    i=1
    while IFS= read -r _line; do
        echo "$RESPONSE"
        echo "claude --resume $SESSION_ID"
        echo "✻ Baked for ${i}s"
        echo "❯"
        i=$((i + 1))
    done
elif [ "$IS_PIPE" = "true" ] && [ "$IS_STREAM_JSON" = "true" ]; then
    # Non-interactive stream-json mode: read prompt from stdin, output stream events
    if [ ! -t 0 ]; then
        cat > /dev/null
    fi

    # Use jq to safely escape RESPONSE into JSON (handles quotes, backslashes, newlines)
    jq -nc --arg t "$RESPONSE" '{"type":"assistant","message":{"content":[{"type":"text","text":$t}]}}'
    printf '{"type":"result","duration_ms":1234,"cost_usd":0.01,"is_error":false}\n'
elif [ "$HAS_SKIP_PERMS" = "true" ]; then
    # Minimal Claude Code TUI mode for Harness Wrapper RunTurn.
    echo "Claude Code"
    echo "❯"
    if [ -n "$PROMPT_TEXT" ]; then
        echo "$RESPONSE"
        echo "claude --resume ${SESSION_ID:-123e4567-e89b-12d3-a456-426614174000}"
        echo "✻ Baked for 1s"
    else
        i=1
        while IFS= read -r _line; do
            echo "$RESPONSE"
            echo "claude --resume ${SESSION_ID:-123e4567-e89b-12d3-a456-426614174000}"
            echo "✻ Baked for ${i}s"
            echo "❯"
            i=$((i + 1))
        done
    fi
else
    # Fallback: just print response
    echo "$RESPONSE"
fi

exit "$EXIT_CODE"
