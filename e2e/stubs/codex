#!/usr/bin/env bash
# Stub for the Codex CLI used in E2E tests.
# Mimics both interactive and non-interactive invocation patterns.
#
# Environment variables:
#   STUB_CODEX_EXIT_CODE  - exit code (default: 0)
#   STUB_CODEX_RESPONSE   - custom response text (default: built-in)
#   STUB_CODEX_DELAY      - seconds to sleep before responding (default: 0)
#   STUB_CODEX_EPIC_RUNNER - when 1, perform the deterministic epic-runner task flow
#   STUB_ARGV_LOG         - append atomic NUL-delimited argv records when set

set -euo pipefail

EXIT_CODE="${STUB_CODEX_EXIT_CODE:-0}"
RESPONSE="${STUB_CODEX_RESPONSE:-I completed the requested task successfully.}"
DELAY="${STUB_CODEX_DELAY:-0}"

# Handle SIGTERM gracefully (must be before sleep/cat which can block)
trap 'exit 0' TERM

if [ -n "${STUB_ARGV_LOG:-}" ]; then
    python3 - "$STUB_ARGV_LOG" "$$" "$0" "$@" <<'PY'
import fcntl
import os
import sys

path = sys.argv[1]
record = b"\0".join(arg.encode("utf-8") for arg in sys.argv[2:]) + b"\0\0"
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
try:
    fcntl.flock(fd, fcntl.LOCK_EX)
    remaining = memoryview(record)
    while remaining:
        written = os.write(fd, remaining)
        if written <= 0:
            raise OSError("short write while recording Codex argv")
        remaining = remaining[written:]
finally:
    fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)
PY
fi

if [ "$DELAY" != "0" ]; then
    sleep "$DELAY"
fi

if [ "${1:-}" = "app-server" ]; then
    if [ "$EXIT_CODE" != "0" ]; then
        exit "$EXIT_CODE"
    fi
    STUB_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
    exec python3 -u "$STUB_DIR/codex-app-server.py" "$@"
fi

if [ "${1:-}" = "--remote" ]; then
    if [ "$EXIT_CODE" != "0" ]; then
        exit "$EXIT_CODE"
    fi
    STUB_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
    exec python3 -u "$STUB_DIR/codex-app-server.py" --remote-client "$@"
fi

# Parse arguments
IS_EXEC=false
IS_JSON=false

while [ $# -gt 0 ]; do
    case "$1" in
        exec) IS_EXEC=true ;;
        --json) IS_JSON=true ;;
    esac
    shift
done

extract_design_value() {
    key="$1"
    printf '%s\n' "$DESIGN" | sed -n "s/^${key}=//p" | head -n 1
}

validate_relative_path() {
    path="$1"
    case "$path" in
        ""|/*|*../*|../*)
            echo "unsafe or empty path: $path" >&2
            exit 1
            ;;
    esac
}

run_epic_runner_task() {
    prompt_file="$(mktemp)"
    if [ ! -t 0 ]; then
        cat > "$prompt_file"
    else
        : > "$prompt_file"
    fi

    task_id="${LOOM_ASSIGNED_TASK_ID:-}"
    if [ -z "$task_id" ]; then
        task_id="$(sed -n 's/.*pre-assigned[^:]*: \([^[:space:]]*\).*/\1/p' "$prompt_file" | head -n 1)"
    fi
    if [ -z "$task_id" ]; then
        echo "STUB_CODEX_EPIC_RUNNER requires LOOM_ASSIGNED_TASK_ID or a pre-assigned task in the prompt" >&2
        exit 1
    fi

    agent_name="${LOOM_AGENT_NAME:-}"
    if [ -z "$agent_name" ]; then
        echo "STUB_CODEX_EPIC_RUNNER requires LOOM_AGENT_NAME" >&2
        exit 1
    fi

    if [ -n "${STUB_CODEX_INVOCATIONS:-}" ]; then
        {
            printf 'task=%s\n' "$task_id"
            printf 'agent=%s\n' "$agent_name"
            printf 'workdir=%s\n' "$(pwd)"
            printf '\n'
        } >> "$STUB_CODEX_INVOCATIONS"
    fi

    if [ -z "${LOOM_ASSIGNED_TASK_ID:-}" ]; then
        loom claim "$task_id"
    fi
    DESIGN="$(loom data --output json show "$task_id" | jq -r '.design // ""')"

    require_path="$(extract_design_value STUB_CODEX_REQUIRE)"
    if [ -n "$require_path" ]; then
        validate_relative_path "$require_path"
        if [ ! -f "$require_path" ]; then
            echo "required file is missing before task $task_id: $require_path" >&2
            exit 1
        fi
    fi

    write_path="$(extract_design_value STUB_CODEX_WRITE)"
    if [ -z "$write_path" ]; then
        write_path="epic-runner-output/${task_id}.txt"
    fi
    validate_relative_path "$write_path"

    mkdir -p "$(dirname "$write_path")"
    {
        printf 'task=%s\n' "$task_id"
        printf 'agent=%s\n' "$agent_name"
        printf 'workdir=%s\n' "$(pwd)"
        if [ -n "$require_path" ]; then
            printf 'required=%s\n' "$require_path"
        fi
    } > "$write_path"
    printf '%s\n' "$task_id" >> epic-runner-output/order.log

    make gate
    git status --short
    git add -- "$write_path" epic-runner-output/order.log
    git commit -m "Complete ${task_id}"
    loom push "$agent_name"
    loom data close "$task_id" --reason "Completed by Codex E2E stub"
    loom complete

    jq -nc --arg o "completed ${task_id}" '{"status":"completed","output":$o}'
}

if [ "$IS_EXEC" = "true" ] && [ "$IS_JSON" = "true" ]; then
    if [ "${STUB_CODEX_EPIC_RUNNER:-0}" = "1" ]; then
        run_epic_runner_task
        exit "$EXIT_CODE"
    fi

    # Non-interactive JSON mode: read prompt from stdin
    if [ ! -t 0 ]; then
        cat > /dev/null
    fi

    jq -nc --arg o "$RESPONSE" '{"status":"completed","output":$o}'
elif [ "$IS_EXEC" = "true" ]; then
    # Exec mode without JSON
    if [ ! -t 0 ]; then
        cat > /dev/null
    fi
    echo "$RESPONSE"
else
    # Interactive mode (--full-auto <prompt>)
    echo "Codex"
    echo ""
    echo "$RESPONSE"
    echo ""
    echo "Done."
fi

exit "$EXIT_CODE"
