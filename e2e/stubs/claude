#!/bin/sh
# Stub for the Claude CLI used in E2E tests.
# Mimics both interactive and non-interactive invocation patterns.
#
# Environment variables:
#   STUB_CLAUDE_EXIT_CODE  - exit code (default: 0)
#   STUB_CLAUDE_RESPONSE   - custom response text (default: built-in)
#   STUB_CLAUDE_DELAY      - seconds to sleep before responding (default: 0)

set -e

EXIT_CODE="${STUB_CLAUDE_EXIT_CODE:-0}"
RESPONSE="${STUB_CLAUDE_RESPONSE:-I completed the requested task successfully.}"
DELAY="${STUB_CLAUDE_DELAY:-0}"

# Handle SIGTERM gracefully (must be before sleep/cat which can block)
trap 'exit 0' TERM

if [ "$DELAY" != "0" ]; then
    sleep "$DELAY"
fi

# Parse arguments
IS_PIPE=false
IS_STREAM_JSON=false
HAS_SKIP_PERMS=false
PROMPT_TEXT=""

while [ $# -gt 0 ]; do
    case "$1" in
        -p) IS_PIPE=true ;;
        --output-format)
            shift
            if [ "$1" = "stream-json" ]; then IS_STREAM_JSON=true; fi
            ;;
        --dangerously-skip-permissions) HAS_SKIP_PERMS=true ;;
        --*) ;;
        *)
            if [ -z "$PROMPT_TEXT" ]; then
                PROMPT_TEXT="$1"
            else
                PROMPT_TEXT="$PROMPT_TEXT $1"
            fi
            ;;
    esac
    shift
done

if [ "$IS_PIPE" = "true" ] && [ "$IS_STREAM_JSON" = "true" ]; then
    # Non-interactive stream-json mode: read prompt from stdin, output stream events
    if [ ! -t 0 ]; then
        cat > /dev/null
    fi

    # Use jq to safely escape RESPONSE into JSON (handles quotes, backslashes, newlines)
    jq -nc --arg t "$RESPONSE" '{"type":"assistant","message":{"content":[{"type":"text","text":$t}]}}'
    printf '{"type":"result","duration_ms":1234,"cost_usd":0.01,"is_error":false}\n'
elif [ "$HAS_SKIP_PERMS" = "true" ]; then
    # Minimal Claude Code TUI mode for Harness Wrapper RunTurn.
    echo "Claude Code"
    echo "❯"
    if [ -n "$PROMPT_TEXT" ]; then
        echo "$RESPONSE"
        echo "claude --resume 123e4567-e89b-12d3-a456-426614174000"
        echo "✻ Baked for 1s"
    else
        i=1
        while IFS= read -r _line; do
            echo "$RESPONSE"
            echo "claude --resume 123e4567-e89b-12d3-a456-426614174000"
            echo "✻ Baked for ${i}s"
            echo "❯"
            i=$((i + 1))
        done
    fi
else
    # Fallback: just print response
    echo "$RESPONSE"
fi

exit "$EXIT_CODE"
