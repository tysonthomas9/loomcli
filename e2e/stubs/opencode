#!/bin/sh
# Stub for the OpenCode CLI used in E2E tests.
# Mimics both interactive and non-interactive invocation patterns.
#
# Environment variables:
#   STUB_OPENCODE_EXIT_CODE  - exit code (default: 0)
#   STUB_OPENCODE_RESPONSE   - custom response text (default: built-in)
#   STUB_OPENCODE_DELAY      - seconds to sleep before responding (default: 0)

set -e

EXIT_CODE="${STUB_OPENCODE_EXIT_CODE:-0}"
RESPONSE="${STUB_OPENCODE_RESPONSE:-I completed the requested task successfully.}"
DELAY="${STUB_OPENCODE_DELAY:-0}"

# Handle SIGTERM gracefully (must be before sleep/cat which can block)
trap 'exit 0' TERM

if [ "$DELAY" != "0" ]; then
    sleep "$DELAY"
fi

# Parse arguments
IS_RUN=false
IS_JSON=false

while [ $# -gt 0 ]; do
    case "$1" in
        run) IS_RUN=true ;;
        --format)
            shift
            if [ "$1" = "json" ]; then IS_JSON=true; fi
            ;;
    esac
    shift
done

if [ "$IS_RUN" = "true" ] && [ "$IS_JSON" = "true" ]; then
    # Non-interactive JSON mode: read prompt from stdin
    if [ ! -t 0 ]; then
        cat > /dev/null
    fi

    printf '{"status":"completed","output":"%s"}\n' "$RESPONSE"
elif [ "$IS_RUN" = "true" ]; then
    # Run mode without JSON
    if [ ! -t 0 ]; then
        cat > /dev/null
    fi
    echo "$RESPONSE"
else
    # Interactive mode (--prompt <prompt>)
    echo "OpenCode"
    echo ""
    echo "$RESPONSE"
    echo ""
    echo "Done."
fi

exit "$EXIT_CODE"
