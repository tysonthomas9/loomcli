# Base image for loomcli E2E tests.
# Contains Go, Node.js, tmux, git, Playwright (chromium), and system deps.
# Rebuild only when toolchain versions change:
#
#   docker build -f e2e/Dockerfile.base -t loomcli-e2e-base .
#
ARG GO_VERSION=1.27.1

FROM golang:${GO_VERSION}-trixie
COPY scripts/check-git-version.sh internal/loomgit/gitversion/minimum.txt /tmp/git-check/

# System packages + Node.js 20 in one layer
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tmux git jq curl ca-certificates gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && sh /tmp/git-check/check-git-version.sh /tmp/git-check/minimum.txt \
    && rm -rf /var/lib/apt/lists/*

# Playwright chromium (the expensive part — ~2-3 min)
RUN npx playwright install --with-deps chromium

ENV TERM=xterm-256color
