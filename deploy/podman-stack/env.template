# podman-stack environment template.
#
# DO NOT fill secrets into this file — copy it:
#   cp env.template .env && chmod 600 .env
# then fill the SECRET section, or just run
#   loomcli/scripts/test-podman-stack.sh
# which generates .env with fresh per-run secrets automatically.
# .env is gitignored; never commit it, never echo its values.

# ─── Stack identity / host ports (loopback-only publishes) ──────────────────
LOOM_STACK_PROJECT=loom-podman-stack
# loom serve API/UI — the surface under test.
LOOM_STACK_SERVE_PORT=18282
# fleet-db admin API — driver script needs it for workspace seeding and
# negative auth assertions.
LOOM_STACK_FLEET_DB_PORT=18280
# stub-upstream /__requests — driver script verifies connector egress hits.
LOOM_STACK_STUB_PORT=18299

# ─── Workspace / actors ──────────────────────────────────────────────────────
# Workspace key the driver script creates in fleet-db and workers register in.
LOOM_STACK_WORKSPACE=PODSTACK
# Actor identity bound to the seeded fleet-db API key. Gets FLEET_SEED_ROLE
# as a GLOBAL role (await-timeout sweeper needs admin/maintainer).
FLEET_SEED_ACTOR=loom-serve@podman-stack.local
FLEET_SEED_ROLE=admin

# ─── Tuning ──────────────────────────────────────────────────────────────────
# Embedded TaskRun worker loops inside loom serve (default 2).
LOOM_DRIVER_TASK_WORKER_CONCURRENCY=2
# TaskRun attempts before blocking failed (default 2).
LOOM_DRIVER_TASK_RUN_MAX_ATTEMPTS=2
# Driver sandbox: empty = process launcher (the capped serve container IS the
# isolation boundary). "container" needs nested podman — native Linux only.
LOOM_STACK_DRIVER_SANDBOX=
# AI backend for `loom worker` replicas (empty = worker default).
LOOM_STACK_WORKER_BACKEND=
# CORS origin(s) for a host-side frontend, comma-separated.
LOOM_STACK_FRONTEND_URL=http://127.0.0.1:18282
# fleet-db log level (debug|info|warn|error).
FLEET_LOG_LEVEL=info

# ─── SECRETS — generate fresh per run, never commit, never echo ─────────────
# fleet-db API key (X-API-Key) for loom serve AND the driver script.
# Generate: printf 'fldb_%s' "$(openssl rand -hex 24)"
LOOM_FLEET_DB_API_KEY=
# Hex-encoded 32-byte HS256 key for run-scoped tokens (LOOM_RUN_TOKEN).
# Generate: openssl rand -hex 32
LOOM_RUN_TOKEN_SIGNING_KEY=
# Standard-base64 32-byte AES-256-GCM key for the connector vault.
# Generate: openssl rand -base64 32
LOOM_CONNECTOR_VAULT_KEY=
# Shared secret for the fleet worker-registration endpoint on serve.
# Generate: openssl rand -hex 24
LOOM_FLEET_API_KEY=
# Shared secret for /api/internal/workers/ bearer auth (serve <-> workers).
# Generate: openssl rand -hex 24
LOOM_WORKER_TOKEN=
# Webhook secret the stub upstream expects (connector egress assertions).
# Generate: openssl rand -hex 16
LOOM_STACK_STUB_SECRET=
