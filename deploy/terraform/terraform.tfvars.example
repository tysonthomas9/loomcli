project_id   = "my-gcp-project"
region       = "us-central1"
zone         = "us-central1-a"
name         = "loom-ab12cd"
network_name = "loom"

# `make` computes these automatically. Set them explicitly only when running
# OpenTofu without the Makefile.
expires_at        = 1788393600   # Unix seconds; stack TTL used by `make reap`.
auto_stop_minutes = 50           # 0 disables the guest auto-stop timer.
owner             = "alice"      # Lowercase, label-safe user name.
owner_id          = "012345abcdef" # 12 hex chars identifying the checkout.

# Pin by commit tag or digest. :latest makes a redeploy unreproducible and
# gives you no way to say which build is running.
fleetdb_image = "us-central1-docker.pkg.dev/my-gcp-project/loom/fleet-db:ac3412e"
loom_image    = "us-central1-docker.pkg.dev/my-gcp-project/loom/loom:452a877"
ui_image      = "us-central1-docker.pkg.dev/my-gcp-project/loom/loom-ui:452a877"

# false keeps the VM off the public internet; shared Cloud NAT gives it
# outbound access for image pulls.
enable_external_ip = false

# machine_type = "e2-standard-2"   # ~$49/mo running, ~$2/mo stopped
# machine_type = "e2-medium"       # ~$24/mo, only if you drop the loom daemon

labels = {
  owner = "platform"
  env   = "dev"
}
