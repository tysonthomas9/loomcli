#!/usr/bin/env bash
set -euo pipefail

# Git exports repository-local environment into hooks. Clear it before running
# tests so nested git commands in temp repos do not mutate this checkout.
while IFS= read -r git_env; do
  unset "$git_env"
done < <(git rev-parse --local-env-vars)

echo "[pre-push] Running quality gate..."
make check
