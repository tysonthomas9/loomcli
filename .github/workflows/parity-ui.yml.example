# Example GitHub Actions workflow for the UI Parity Test Suite.
#
# NOT auto-enabled — rename to parity-ui.yml to activate. This is a
# reference snippet showing the hermetic CI shape needed for the suite
# to produce meaningful screenshots (pinned Playwright Docker image,
# docker-compose stack boot, seed, run, upload artifacts).
#
# Prerequisites in the GitHub org:
#   - Secret PARITY_FLEET_DB_REPO_READ_TOKEN if fleet-db is private.
#
# Gotchas:
#   - This job needs a big runner (20 min) or the compose build alone
#     will exhaust the default timeout.
#   - Buildx + Docker layer caching is strongly recommended; the naive
#     build recompiles Go and fleet-db each run.

name: UI Parity

on:
  # Run manually or on a schedule — not on every PR; this is heavyweight.
  workflow_dispatch:
  schedule:
    - cron: "0 6 * * *" # Daily at 06:00 UTC

concurrency:
  group: parity-ui-${{ github.ref }}
  cancel-in-progress: false

jobs:
  parity-ui:
    name: UI Parity (reference vs fleet)
    runs-on: ubuntu-latest-16core
    timeout-minutes: 45
    # Run the tests inside the Microsoft-pinned Playwright image so screenshots
    # don't drift by host fonts / DPI.
    container:
      image: mcr.microsoft.com/playwright:v1.45.0-jammy
      options: --user 1001
    services:
      # No runtime services here — the docker-compose stack is started
      # explicitly below because it needs a sibling repo checkout.

    steps:
      - name: Checkout loomcli
        uses: actions/checkout@v4
        with:
          path: loomcli

      - name: Checkout fleet-db (sibling repo)
        uses: actions/checkout@v4
        with:
          repository: tysonthomas9/fleet-db
          path: fleet-db
          token: ${{ secrets.PARITY_FLEET_DB_REPO_READ_TOKEN || secrets.GITHUB_TOKEN }}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Bring up parity stack
        working-directory: loomcli
        run: |
          docker compose -f test/parity/docker-compose.parity.yml up -d --wait

      - name: Seed identical fixtures
        working-directory: loomcli
        run: |
          docker compose -f test/parity/docker-compose.parity.yml run --rm parity-seed

      - name: Wait for both loom tabs to be healthy
        working-directory: loomcli
        run: |
          for i in $(seq 1 60); do
            BEADS=$(curl -sf http://localhost:8081/api/config | jq -r '.issue_backend // empty' || true)
            FLEET=$(curl -sf http://localhost:8082/api/config | jq -r '.issue_backend // empty' || true)
            if [ "$BEADS" = "reference" ] && [ "$FLEET" = "fleet" ]; then
              echo "both healthy"
              exit 0
            fi
            echo "waiting for healthy ($i/60) reference=$BEADS fleet=$FLEET"
            sleep 2
          done
          exit 1

      - name: Install UI test deps
        working-directory: loomcli/test/parity/ui
        run: |
          npm install --no-audit --no-fund
          # The container already has Chromium; no need to re-install.

      - name: Run UI parity suite
        working-directory: loomcli/test/parity/ui
        env:
          LOOM_REFERENCE_URL: http://localhost:8081
          LOOM_FLEET_URL: http://localhost:8082
          FLEET_DB_URL: http://localhost:8080
          PARITY_WORKSPACE: PARITY
        run: |
          npx playwright test

      - name: Upload artifacts on failure
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: parity-ui-artifacts
          path: |
            loomcli/test/parity/ui/artifacts/
          retention-days: 14

      - name: Tear down parity stack
        if: always()
        working-directory: loomcli
        run: |
          docker compose -f test/parity/docker-compose.parity.yml logs fleet-db > fleet-db-logs.txt 2>&1 || true
          docker compose -f test/parity/docker-compose.parity.yml logs loom-reference > loom-reference-logs.txt 2>&1 || true
          docker compose -f test/parity/docker-compose.parity.yml logs loom-fleet > loom-fleet-logs.txt 2>&1 || true
          docker compose -f test/parity/docker-compose.parity.yml down -v
