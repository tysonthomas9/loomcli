{
  "name": "@loom/sdk",
  "version": "1.0.0",
  "description": "Loom workflow SDK: run-scoped driver client (flue) and task-run runner client with published TypeScript types",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./runner": {
      "types": "./runner.d.ts",
      "import": "./runner.js"
    },
    "./flue": {
      "types": "./flue.d.ts",
      "import": "./flue.js"
    },
    "./api-surface.v1.json": "./api-surface.v1.json",
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "sideEffects": false,
  "scripts": {
    "test": "node --test *.test.mjs && npm run typecheck",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "internal.js",
    "flue.js",
    "flue.d.ts",
    "runner.js",
    "runner.d.ts",
    "api-surface.v1.json",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tysonthomas9/loomcli.git",
    "directory": "sdk"
  },
  "keywords": [
    "loom",
    "fleet-db",
    "runner",
    "task-run"
  ],
  "author": "Tyson Thomas",
  "license": "MIT"
}
