    {"id": "MM-2", "status": "approved", "owner": "architecture-review", "rationale": "Local operator mutations require a server-issued 256-bit credential stored in a mode-0600 runtime file; loopback location alone grants no authority.", "reviewed_by": "phase-1-completion-directive", "reviewed_at": "2026-07-15"},
