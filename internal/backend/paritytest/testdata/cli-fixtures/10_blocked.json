{
  "id": "cli_blocked",
  "title": "Add a blocking dep then check blocked queue",
  "description": "Create two issues, make A depend on B, then check the blocked queue — A should appear. Tests both dep add and blocked.",
  "tags": ["cli", "blocked", "dep"],
  "steps": [
    {
      "id": "seed_blocker",
      "bd_args":  ["--json", "create", "--title", "blocker", "--type", "task", "--priority", "2"],
      "fdb_args": ["-json", "create", "-title", "blocker", "-type", "task", "-priority", "2"],
      "capture_vars": {"blocker_id": "$.id"}
    },
    {
      "id": "seed_blocked",
      "bd_args":  ["--json", "create", "--title", "blocked", "--type", "task", "--priority", "2"],
      "fdb_args": ["-json", "create", "-title", "blocked", "-type", "task", "-priority", "2"],
      "capture_vars": {"blocked_id": "$.id"}
    },
    {
      "id": "dep_add",
      "description": "blocked depends on blocker",
      "bd_args":  ["dep", "add", "${blocked_id}", "${blocker_id}"],
      "fdb_args": ["dep", "add", "${blocked_id}", "${blocker_id}"]
    },
    {
      "id": "step_blocked",
      "description": "List blocked issues",
      "bd_args":  ["--json", "blocked"],
      "fdb_args": ["-json", "blocked"],
      "expect_result_count": 1,
      "expect_json": {
        "$[0].issue.id": "${blocked_id}",
        "$[0].issue.title": "blocked",
        "$[0].blockers[0].id": "${blocker_id}",
        "$[0].blockers[0].title": "blocker",
        "$[0].blockers[0].dep_type": "blocks"
      }
    }
  ]
}
