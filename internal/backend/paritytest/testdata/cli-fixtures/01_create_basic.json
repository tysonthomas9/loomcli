{
  "id": "cli_create_basic",
  "title": "Create issue with --title --priority --type",
  "description": "Smallest create — title + type + priority. Both CLIs must emit JSON with the same title/status/priority values after --json.",
  "tags": ["cli", "create", "basic"],
  "steps": [
    {
      "id": "step_01",
      "description": "Create a basic task",
      "bd_args":  ["--json", "create", "--title", "cli basic", "--type", "task", "--priority", "2"],
      "fdb_args": ["-json", "create", "-title", "cli basic", "-type", "task", "-priority", "2"],
      "capture_vars": {"issue_id": "$.id"}
    },
    {
      "id": "step_02",
      "description": "Show the newly-created issue",
      "bd_args":  ["--json", "show", "${issue_id}"],
      "fdb_args": ["-json", "show", "${issue_id}"]
    }
  ]
}
