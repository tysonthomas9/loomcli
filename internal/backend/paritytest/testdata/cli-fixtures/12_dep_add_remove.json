{
  "id": "cli_dep_add_remove",
  "title": "Add and remove dependency",
  "description": "Create two issues, add a blocks-dep, remove it, and verify the blocked queue behavior updates. Exercises both the add and remove sides of the dep subcommand.",
  "tags": ["cli", "dep", "blocking"],
  "steps": [
    {
      "id": "seed_a",
      "bd_args":  ["--json", "create", "--title", "dep A", "--type", "task", "--priority", "2"],
      "fdb_args": ["-json", "create", "-title", "dep A", "-type", "task", "-priority", "2"],
      "capture_vars": {"a_id": "$.id"}
    },
    {
      "id": "seed_b",
      "bd_args":  ["--json", "create", "--title", "dep B", "--type", "task", "--priority", "2"],
      "fdb_args": ["-json", "create", "-title", "dep B", "-type", "task", "-priority", "2"],
      "capture_vars": {"b_id": "$.id"}
    },
    {
      "id": "dep_add",
      "description": "A depends on B",
      "bd_args":  ["dep", "add", "${a_id}", "${b_id}"],
      "fdb_args": ["-json", "dep", "add", "${a_id}", "${b_id}"],
      "expect_json": {
        "$.ok": true
      }
    },
    {
      "id": "dep_list_after_add",
      "description": "Dependency list should contain A -> B",
      "bd_args":  ["--json", "dep", "list", "${a_id}"],
      "fdb_args": ["-json", "dep", "list", "${a_id}"],
      "expect_result_count": 1,
      "expect_json": {
        "$[0].issue_id": "${a_id}",
        "$[0].depends_on_id": "${b_id}",
        "$[0].type": "blocks"
      }
    },
    {
      "id": "blocked_after_add",
      "description": "Blocked queue should include A",
      "bd_args":  ["--json", "blocked"],
      "fdb_args": ["-json", "blocked"],
      "expect_result_count": 1,
      "expect_json": {
        "$[0].issue.id": "${a_id}",
        "$[0].blockers[0].id": "${b_id}",
        "$[0].blockers[0].dep_type": "blocks"
      }
    },
    {
      "id": "ready_after_add",
      "description": "Ready queue should contain only the unblocked blocker",
      "bd_args":  ["--json", "ready", "--limit", "10"],
      "fdb_args": ["-json", "ready", "-limit", "10"],
      "expect_result_count": 1,
      "expect_json": {
        "$[0].id": "${b_id}"
      }
    },
    {
      "id": "graph_after_add",
      "description": "Graph should expose one edge and one blocked depth layer",
      "bd_args":  ["--json", "graph"],
      "fdb_args": ["-json", "graph"],
      "expect_json": {
        "$.stats.total_issues": 2,
        "$.stats.total_edges": 1,
        "$.stats.max_depth": 1,
        "$.stats.cycle_count": 0
      }
    },
    {
      "id": "dep_remove",
      "description": "Remove the dep",
      "bd_args":  ["dep", "remove", "${a_id}", "${b_id}"],
      "fdb_args": ["-json", "dep", "remove", "${a_id}", "${b_id}"],
      "expect_json": {
        "$.ok": true
      }
    },
    {
      "id": "dep_list_after_remove",
      "description": "Dependency list should be empty after remove",
      "bd_args":  ["--json", "dep", "list", "${a_id}"],
      "fdb_args": ["-json", "dep", "list", "${a_id}"],
      "expect_result_count": 0
    },
    {
      "id": "blocked_after_remove",
      "description": "Blocked queue should now be empty (or lack A)",
      "bd_args":  ["--json", "blocked"],
      "fdb_args": ["-json", "blocked"],
      "expect_result_count": 0
    },
    {
      "id": "ready_after_remove",
      "description": "Both issues should be ready again",
      "bd_args":  ["--json", "ready", "--limit", "10"],
      "fdb_args": ["-json", "ready", "-limit", "10"],
      "expect_result_count": 2
    }
  ]
}
