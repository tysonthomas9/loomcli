{
  "id": "cli_validation_errors",
  "title": "CRUD validation errors",
  "description": "Checks that malformed CRUD commands fail instead of silently succeeding. Fleet-db-only mode treats the expected errors as passing outcomes.",
  "tags": ["cli", "crud", "validation", "error"],
  "steps": [
    {
      "id": "create_missing_title",
      "description": "Create without title",
      "bd_args": ["--json", "create", "--type", "task", "--priority", "2"],
      "fdb_args": ["-json", "create", "-type", "task", "-priority", "2"],
      "expect_error": true
    },
    {
      "id": "update_missing_fields",
      "description": "Update with no changed fields",
      "bd_args": ["update", "does-not-exist-ever-parity-probe"],
      "fdb_args": ["update", "does-not-exist-ever-parity-probe"],
      "expect_error": true
    },
    {
      "id": "delete_missing_id",
      "description": "Delete without ID",
      "bd_args": ["delete", "--force"],
      "fdb_args": ["delete"],
      "expect_error": true
    }
  ]
}
