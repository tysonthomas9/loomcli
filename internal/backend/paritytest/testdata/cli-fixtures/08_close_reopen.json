{
  "id": "cli_close_reopen",
  "title": "Close with --reason, show, reopen",
  "description": "Create, close with a reason, verify status=closed, reopen, verify status=open. Close reason semantics differ — see the parity report for the drift on the `close_reason` field between backends.",
  "tags": ["cli", "close", "reopen", "lifecycle"],
  "steps": [
    {
      "id": "step_01",
      "bd_args":  ["--json", "create", "--title", "lifecycle probe", "--type", "task", "--priority", "2"],
      "fdb_args": ["-json", "create", "-title", "lifecycle probe", "-type", "task", "-priority", "2"],
      "capture_vars": {"issue_id": "$.id"}
    },
    {
      "id": "step_02",
      "description": "Close with a reason",
      "bd_args":  ["close", "${issue_id}", "--reason", "done via parity"],
      "fdb_args": ["close", "${issue_id}", "-reason", "done via parity"]
    },
    {
      "id": "step_03",
      "description": "Show closed — status should be closed on both",
      "bd_args":  ["--json", "show", "${issue_id}"],
      "fdb_args": ["-json", "show", "${issue_id}"],
      "compare_field": "$.status"
    },
    {
      "id": "step_04",
      "description": "Reopen the issue",
      "bd_args":  ["reopen", "${issue_id}"],
      "fdb_args": ["reopen", "${issue_id}"]
    },
    {
      "id": "step_05",
      "description": "Show reopened — status should be open on both",
      "bd_args":  ["--json", "show", "${issue_id}"],
      "fdb_args": ["-json", "show", "${issue_id}"],
      "compare_field": "$.status"
    }
  ]
}
