{
  "id": "cli_metadata_roundtrip",
  "title": "Metadata round-trip coverage",
  "description": "Strict fleet-db-only coverage for issue metadata used by UI and agent routing.",
  "tags": ["cli", "metadata", "fleetdb"],
  "steps": [
    {
      "id": "step_01",
      "description": "Create with every create-supported metadata field",
      "bd_args":  ["--json", "create", "--title", "metadata probe", "--description", "initial metadata description", "--owner", "owner-a", "--assignee", "agent-a", "--labels", "backend,urgent", "--type", "feature", "--priority", "0", "--source-repo", "org/repo-a", "--design", "initial design", "--notes", "initial notes", "--due", "2026-06-02T00:00:00Z"],
      "fdb_args": ["-json", "create", "-title", "metadata probe", "-description", "initial metadata description", "-owner", "owner-a", "-assignee", "agent-a", "-labels", "backend,urgent", "-type", "feature", "-priority", "0", "-repo", "org/repo-a", "-design", "initial design", "-notes", "initial notes", "-due-at", "2026-06-02T00:00:00Z"],
      "capture_vars": {"issue_id": "$.id"},
      "expect_json": {
        "$.title": "metadata probe",
        "$.description": "initial metadata description",
        "$.owner": "owner-a",
        "$.assignee": "agent-a",
        "$.labels": ["backend", "urgent"],
        "$.type": "feature",
        "$.priority": 0,
        "$.repo": "org/repo-a",
        "$.source_repo": "org/repo-a",
        "$.design": "initial design",
        "$.notes": "initial notes",
        "$.due_at": "2026-06-02T00:00:00Z"
      }
    },
    {
      "id": "step_02",
      "description": "Show preserves create metadata",
      "bd_args":  ["--json", "show", "${issue_id}"],
      "fdb_args": ["-json", "show", "${issue_id}"],
      "expect_json": {
        "$.title": "metadata probe",
        "$.description": "initial metadata description",
        "$.owner": "owner-a",
        "$.assignee": "agent-a",
        "$.labels": ["backend", "urgent"],
        "$.type": "feature",
        "$.priority": 0,
        "$.repo": "org/repo-a",
        "$.source_repo": "org/repo-a",
        "$.design": "initial design",
        "$.notes": "initial notes",
        "$.due_at": "2026-06-02T00:00:00Z"
      }
    },
    {
      "id": "step_03",
      "description": "Update mutable metadata fields",
      "bd_args":  ["--json", "update", "${issue_id}", "--title", "metadata updated", "--description", "updated metadata description", "--owner", "owner-b", "--design", "updated design", "--notes", "updated notes", "--priority", "1", "--type", "bug", "--due", "2026-06-03T00:00:00Z"],
      "fdb_args": ["-json", "update", "${issue_id}", "-title", "metadata updated", "-description", "updated metadata description", "-owner", "owner-b", "-design", "updated design", "-notes", "updated notes", "-priority", "1", "-type", "bug", "-due-at", "2026-06-03T00:00:00Z"],
      "expect_json": {
        "$.title": "metadata updated",
        "$.description": "updated metadata description",
        "$.owner": "owner-b",
        "$.design": "updated design",
        "$.notes": "updated notes",
        "$.priority": 1,
        "$.type": "bug",
        "$.due_at": "2026-06-03T00:00:00Z"
      }
    },
    {
      "id": "step_04",
      "description": "Show preserves updated metadata plus unchanged routing metadata",
      "bd_args":  ["--json", "show", "${issue_id}"],
      "fdb_args": ["-json", "show", "${issue_id}"],
      "expect_json": {
        "$.title": "metadata updated",
        "$.description": "updated metadata description",
        "$.owner": "owner-b",
        "$.assignee": "agent-a",
        "$.labels": ["backend", "urgent"],
        "$.type": "bug",
        "$.priority": 1,
        "$.repo": "org/repo-a",
        "$.source_repo": "org/repo-a",
        "$.design": "updated design",
        "$.notes": "updated notes",
        "$.due_at": "2026-06-03T00:00:00Z"
      }
    },
    {
      "id": "step_05",
      "description": "Label add keeps existing labels",
      "bd_args":  ["update", "${issue_id}", "--add-label", "triaged"],
      "fdb_args": ["label", "add", "${issue_id}", "triaged"]
    },
    {
      "id": "step_06",
      "description": "Label remove updates final set",
      "bd_args":  ["update", "${issue_id}", "--remove-label", "urgent"],
      "fdb_args": ["label", "remove", "${issue_id}", "urgent"]
    },
    {
      "id": "step_07",
      "description": "Show preserves label mutation",
      "bd_args":  ["--json", "show", "${issue_id}"],
      "fdb_args": ["-json", "show", "${issue_id}"],
      "expect_json": {
        "$.labels": ["backend", "triaged"]
      }
    },
    {
      "id": "step_08",
      "description": "Defer issue with explicit date",
      "bd_args":  ["update", "${issue_id}", "--defer", "2026-06-05T00:00:00Z"],
      "fdb_args": ["defer", "${issue_id}", "-until", "2026-06-05T00:00:00Z"]
    },
    {
      "id": "step_09",
      "description": "Show preserves defer state",
      "bd_args":  ["--json", "show", "${issue_id}"],
      "fdb_args": ["-json", "show", "${issue_id}"],
      "expect_json": {
        "$.status": "deferred",
        "$.defer_until": "2026-06-05T00:00:00Z"
      }
    },
    {
      "id": "step_10",
      "description": "Undefer issue",
      "bd_args":  ["update", "${issue_id}", "--defer", ""],
      "fdb_args": ["undefer", "${issue_id}"]
    },
    {
      "id": "step_11",
      "description": "Show clears defer state",
      "bd_args":  ["--json", "show", "${issue_id}"],
      "fdb_args": ["-json", "show", "${issue_id}"],
      "expect_json": {
        "$.status": "open"
      }
    }
  ]
}
