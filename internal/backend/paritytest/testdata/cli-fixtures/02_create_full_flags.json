{
  "id": "cli_create_full_flags",
  "title": "Create with description, owner, assignee, labels",
  "description": "Exercises the most common flag combo operators use: title + description + owner + assignee + labels. Verifies all five round-trip via show --json.",
  "tags": ["cli", "create", "flags"],
  "steps": [
    {
      "id": "step_01",
      "description": "Create with full baseline flags",
      "bd_args":  ["--json", "create", "--title", "full flags", "--description", "a thorough description", "--owner", "parity-harness", "--assignee", "alice", "--labels", "bug,urgent", "--type", "bug", "--priority", "1"],
      "fdb_args": ["-json", "create", "-title", "full flags", "-description", "a thorough description", "-owner", "parity-harness", "-assignee", "alice", "-labels", "bug,urgent", "-type", "bug", "-priority", "1"],
      "capture_vars": {"issue_id": "$.id"}
    },
    {
      "id": "step_02",
      "description": "Show to verify round-trip",
      "bd_args":  ["--json", "show", "${issue_id}"],
      "fdb_args": ["-json", "show", "${issue_id}"]
    }
  ]
}
