{
  "id": "cli_delete_not_found",
  "title": "Delete issue and verify not-found read",
  "description": "Creates an issue, deletes it, then verifies show reports an error. This covers destructive CRUD lifecycle without requiring a beads sidecar in fleet-db-only mode.",
  "tags": ["cli", "crud", "delete", "not_found"],
  "steps": [
    {
      "id": "create",
      "description": "Create issue to delete",
      "bd_args": ["--json", "create", "--title", "delete probe", "--type", "task", "--priority", "2"],
      "fdb_args": ["-json", "create", "-title", "delete probe", "-type", "task", "-priority", "2"],
      "capture_vars": {"issue_id": "$.id"}
    },
    {
      "id": "delete",
      "description": "Delete issue",
      "bd_args": ["delete", "${issue_id}", "--force"],
      "fdb_args": ["delete", "${issue_id}"]
    },
    {
      "id": "show_deleted",
      "description": "Show should fail after delete",
      "bd_args": ["--json", "show", "${issue_id}"],
      "fdb_args": ["-json", "show", "${issue_id}"],
      "expect_error": true
    }
  ]
}
