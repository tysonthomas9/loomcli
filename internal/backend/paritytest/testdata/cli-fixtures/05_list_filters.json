{
  "id": "cli_list_filters",
  "title": "List with --status / --type / --assignee / --limit filters",
  "description": "Seed a small set of issues with varied types and assignees, then exercise list filters. We don't diff every row (IDs differ) — we diff the count only via a narrow compare_field.",
  "tags": ["cli", "list", "filter"],
  "steps": [
    {
      "id": "seed_01",
      "bd_args":  ["--json", "create", "--title", "list probe A", "--type", "task", "--priority", "2", "--assignee", "alice"],
      "fdb_args": ["-json", "create", "-title", "list probe A", "-type", "task", "-priority", "2", "-assignee", "alice"]
    },
    {
      "id": "seed_02",
      "bd_args":  ["--json", "create", "--title", "list probe B", "--type", "bug", "--priority", "1", "--assignee", "bob"],
      "fdb_args": ["-json", "create", "-title", "list probe B", "-type", "bug", "-priority", "1", "-assignee", "bob"]
    },
    {
      "id": "seed_03",
      "bd_args":  ["--json", "create", "--title", "list probe C", "--type", "task", "--priority", "3", "--assignee", "alice"],
      "fdb_args": ["-json", "create", "-title", "list probe C", "-type", "task", "-priority", "3", "-assignee", "alice"]
    },
    {
      "id": "step_list_all",
      "description": "List everything — total should match",
      "bd_args":  ["--json", "list", "--limit", "50"],
      "fdb_args": ["-json", "list", "-limit", "50"],
      "expect_result_count": 3
    },
    {
      "id": "step_list_by_type",
      "description": "Filter by type=bug",
      "bd_args":  ["--json", "list", "--type", "bug", "--limit", "50"],
      "fdb_args": ["-json", "list", "-type", "bug", "-limit", "50"],
      "expect_result_count": 1
    },
    {
      "id": "step_list_by_assignee",
      "description": "Filter by assignee=alice",
      "bd_args":  ["--json", "list", "--assignee", "alice", "--limit", "50"],
      "fdb_args": ["-json", "list", "-assignee", "alice", "-limit", "50"],
      "expect_result_count": 2
    },
    {
      "id": "step_list_by_status_open",
      "description": "Filter by status=open",
      "bd_args":  ["--json", "list", "--status", "open", "--limit", "50"],
      "fdb_args": ["-json", "list", "-status", "open", "-limit", "50"],
      "expect_result_count": 3
    }
  ]
}
