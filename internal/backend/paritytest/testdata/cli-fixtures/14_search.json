{
  "id": "cli_search",
  "title": "Search issues by text query",
  "description": "Seed distinct issue titles, then search for a keyword that should match exactly one of them on each backend.",
  "tags": ["cli", "search"],
  "steps": [
    {
      "id": "seed_alpha",
      "bd_args":  ["--json", "create", "--title", "alphabetical frobnicator", "--type", "task", "--priority", "2"],
      "fdb_args": ["-json", "create", "-title", "alphabetical frobnicator", "-type", "task", "-priority", "2"]
    },
    {
      "id": "seed_beta",
      "bd_args":  ["--json", "create", "--title", "betazoid widget", "--type", "bug", "--priority", "3"],
      "fdb_args": ["-json", "create", "-title", "betazoid widget", "-type", "bug", "-priority", "3"]
    },
    {
      "id": "search_alpha",
      "description": "Search for 'frobnicator' — should find only the alpha issue",
      "bd_args":  ["--json", "search", "frobnicator"],
      "fdb_args": ["-json", "search", "frobnicator"]
    },
    {
      "id": "search_none",
      "description": "Search for a term that matches nothing",
      "bd_args":  ["--json", "search", "xyzqwopasdnomatch"],
      "fdb_args": ["-json", "search", "xyzqwopasdnomatch"]
    }
  ]
}
