{
  "id": "cli_count",
  "title": "Count with grouping flags",
  "description": "Seed a small set of issues with different statuses/types, then count with --by-status and --by-type. Totals should match across CLIs.",
  "tags": ["cli", "count"],
  "steps": [
    {
      "id": "seed_01",
      "bd_args":  ["--json", "create", "--title", "ct1", "--type", "task", "--priority", "2"],
      "fdb_args": ["-json", "create", "-title", "ct1", "-type", "task", "-priority", "2"]
    },
    {
      "id": "seed_02",
      "bd_args":  ["--json", "create", "--title", "ct2", "--type", "bug", "--priority", "1"],
      "fdb_args": ["-json", "create", "-title", "ct2", "-type", "bug", "-priority", "1"]
    },
    {
      "id": "seed_03",
      "bd_args":  ["--json", "create", "--title", "ct3", "--type", "task", "--priority", "3"],
      "fdb_args": ["-json", "create", "-title", "ct3", "-type", "task", "-priority", "3"]
    },
    {
      "id": "count_all",
      "description": "Total count",
      "bd_args":  ["--json", "count"],
      "fdb_args": ["-json", "count"]
    },
    {
      "id": "count_by_type",
      "description": "Group by type",
      "bd_args":  ["--json", "count", "--by-type"],
      "fdb_args": ["-json", "count", "-by-type"]
    },
    {
      "id": "count_by_status",
      "description": "Group by status",
      "bd_args":  ["--json", "count", "--by-status"],
      "fdb_args": ["-json", "count", "-by-status"]
    }
  ]
}
