{
  "id": "cli_label_add_remove",
  "title": "Add and remove labels",
  "description": "Create an issue, add a label, remove the first label, add a second — verify final label set via show. Note bd uses `bd update --add-label <x>` while fdb uses `fdb label add <issue> <label>` — the CLIs differ in shape here but should produce the same semantic outcome.",
  "tags": ["cli", "label", "update"],
  "steps": [
    {
      "id": "step_01",
      "bd_args":  ["--json", "create", "--title", "label probe", "--type", "task", "--priority", "2"],
      "fdb_args": ["-json", "create", "-title", "label probe", "-type", "task", "-priority", "2"],
      "capture_vars": {"issue_id": "$.id"}
    },
    {
      "id": "step_02",
      "description": "Add label 'frontend' — bd via update, fdb via label subcmd",
      "bd_args":  ["update", "${issue_id}", "--add-label", "frontend"],
      "fdb_args": ["label", "add", "${issue_id}", "frontend"]
    },
    {
      "id": "step_03",
      "description": "Add label 'urgent'",
      "bd_args":  ["update", "${issue_id}", "--add-label", "urgent"],
      "fdb_args": ["label", "add", "${issue_id}", "urgent"]
    },
    {
      "id": "step_04",
      "description": "Remove label 'frontend'",
      "bd_args":  ["update", "${issue_id}", "--remove-label", "frontend"],
      "fdb_args": ["label", "remove", "${issue_id}", "frontend"]
    },
    {
      "id": "step_05",
      "description": "Show — final labels should be ['urgent']",
      "bd_args":  ["--json", "show", "${issue_id}"],
      "fdb_args": ["-json", "show", "${issue_id}"],
      "compare_field": "$.labels",
      "expect_json": {
        "$.labels": ["urgent"]
      }
    }
  ]
}
