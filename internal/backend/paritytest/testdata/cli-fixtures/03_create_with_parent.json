{
  "id": "cli_create_with_parent",
  "title": "Create parent epic + child task with --parent",
  "description": "Create an epic, capture its id, then create a task under it via --parent. The child's parent_id should equal the epic's id on both backends.",
  "tags": ["cli", "create", "parent", "epic"],
  "steps": [
    {
      "id": "step_01",
      "description": "Create parent epic",
      "bd_args":  ["--json", "create", "--title", "parent epic", "--type", "epic", "--priority", "1"],
      "fdb_args": ["-json", "create", "-title", "parent epic", "-type", "epic", "-priority", "1"],
      "capture_vars": {"parent_id": "$.id"}
    },
    {
      "id": "step_02",
      "description": "Create child task under epic",
      "bd_args":  ["--json", "create", "--title", "child task", "--type", "task", "--priority", "2", "--parent", "${parent_id}"],
      "fdb_args": ["-json", "create", "-title", "child task", "-type", "task", "-priority", "2", "-parent", "${parent_id}"],
      "capture_vars": {"child_id": "$.id"}
    },
    {
      "id": "step_03",
      "description": "Show child — verify parent link round-trips",
      "bd_args":  ["--json", "show", "${child_id}"],
      "fdb_args": ["-json", "show", "${child_id}"]
    }
  ]
}
