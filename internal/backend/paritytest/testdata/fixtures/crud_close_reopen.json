{
  "id": "crud_close_reopen",
  "title": "Close and reopen lifecycle",
  "description": "Creates an issue, closes it (status should flip to closed on both backends), shows it to verify, reopens it (status back to open), and shows it again. Exercises issue.close and issue.reopen plus the status field diff on issue.show.",
  "tags": ["crud", "close", "reopen", "status", "lifecycle"],
  "steps": [
    {
      "id": "step_01",
      "description": "Create issue for close/reopen lifecycle",
      "method": "issue.create",
      "params": {
        "title": "Lifecycle fixture",
        "priority": 2,
        "type": "task",
        "owner": "parity-harness",
        "actor": "parity-harness"
      }
    },
    {
      "id": "step_02",
      "description": "Close the issue with a reason",
      "method": "issue.close",
      "params": {
        "id": "${issue_id}",
        "reason": "parity close test"
      }
    },
    {
      "id": "step_03",
      "description": "Show the closed issue — status should be closed on both sides",
      "method": "issue.show",
      "params": {
        "id": "${issue_id}"
      }
    },
    {
      "id": "step_04",
      "description": "Reopen the issue",
      "method": "issue.reopen",
      "params": {
        "id": "${issue_id}",
        "reason": "parity reopen test"
      }
    },
    {
      "id": "step_05",
      "description": "Show the reopened issue — status should be open on both sides",
      "method": "issue.show",
      "params": {
        "id": "${issue_id}"
      }
    }
  ]
}
