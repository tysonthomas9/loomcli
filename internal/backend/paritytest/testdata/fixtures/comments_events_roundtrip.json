{
  "id": "comments_events_roundtrip",
  "title": "Comments and event history round trip",
  "description": "Creates an issue, adds comments, lists them with ordering/actor/content checks, and verifies the issue event endpoint honors limits.",
  "tags": ["comments", "events", "history"],
  "steps": [
    {
      "id": "seed_issue",
      "description": "Create issue for comment and history checks",
      "method": "issue.create",
      "params": {
        "title": "Comments events fixture",
        "priority": 2,
        "type": "task",
        "owner": "parity-harness",
        "actor": "parity-harness"
      }
    },
    {
      "id": "comment_add_1",
      "description": "Add first comment",
      "method": "comment.add",
      "params": {
        "issue_id": "${issue_id}",
        "author": "parity-harness",
        "text": "backend first comment"
      }
    },
    {
      "id": "comment_add_2",
      "description": "Add second comment",
      "method": "comment.add",
      "params": {
        "issue_id": "${issue_id}",
        "author": "parity-harness",
        "text": "backend second comment"
      }
    },
    {
      "id": "comment_list",
      "description": "List comments and compare content ordering",
      "method": "comment.list",
      "params": {
        "issue_id": "${issue_id}"
      }
    },
    {
      "id": "event_list_limited",
      "description": "List one event to verify history limit behavior",
      "method": "event.list",
      "params": {
        "issue_id": "${issue_id}",
        "limit": 1
      }
    }
  ]
}
